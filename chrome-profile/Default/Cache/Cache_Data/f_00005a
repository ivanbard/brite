ve;\n    width: $modal-width;\n    overflow: hidden;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n\n    @include medium-narrow-up {\n        height: auto;\n        width: $modal-width-large;\n    }\n\n    &FadeIn {\n        opacity: 0;\n        height: 100%;\n        animation: {\n            name: fadeIn;\n            duration: 300ms;\n            delay: 500ms;\n            timing-function: cubic-bezier(0.42, 0, 1, 1);\n            fill-mode: forwards;\n        }\n    }\n\n    @media (max-width: $medium-width) {\n        &TakeoverPadding {\n            padding-top: 36px;\n        }\n    }\n}\n\n.edsModalSetHeight {\n    .edsModalBody {\n        @include medium-narrow-up {\n            height: $modal-height-large;\n        }\n    }\n}\n// Attention, Hack!\n// We always want to set a minimum height on ie11 to show the modal\n// Check https://github.com/philipwalton/flexbugs#flexbug-3 for more details\n.edsModalBody {\n    @include medium-narrow-up {\n        height: $modal-height-large;\n    }\n}\n\n.edsModalContent {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    height: 100%;\n    width: 100%;\n    flex: 1 100%;\n\n    overflow: hidden;\n\n    // Use momentum-based scrolling for iOS. This fixes an issue where modals don't scroll\n    // if a user's finger hits an input at the start of their scroll: EB-28583, EB-61201, EB-61426\n    -webkit-overflow-scrolling: touch;\n}\n\n.edsModalFade {\n    @extend %eds-fx--fade-in;\n}\n\n.edsModalcomplex {\n    .edsModalBody {\n        width: 100%;\n        height: 100%;\n    }\n}\n\n.edsModalAperture {\n    .edsModalBody {\n        @include small-wide-up {\n            width: 95%;\n            height: 95%;\n            max-width: $modal-aperture-max-width;\n            max-height: $modal-aperture-max-height;\n        }\n    }\n}\n\n@keyframes showNotification {\n    from {\n        transform: translateY(-$modal-header-min-height * 5);\n    }