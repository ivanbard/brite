ic-halo-medium,\n    'large': $graphic-halo-large,\n    'xlarge': $graphic-halo-xlarge,\n);\n\n/* ========== Background Colors =========== */\n$disabled-bg-color: $grey-200;\n$highlight-background-color: $grey-200;\n$focus-bg-color: linear-gradient(\n    90deg,\n    $theme-background 0%,\n    $theme-ui-100 51.13%,\n    $theme-background 100%\n);\n\n/* ========== Grid =========== */\n$grid-unit: 4px;\n\n/* ========== Text =========== */\n// Fallback to system fonts for performance boost and to\n// match the OS if Neue Plak doesn't load\n$font-family-neue-plak: 'Neue Plak';\n$font-family-neue-plak-extra-black: 'Neue Plak Extended ExtraBlack';\n$font-family-neue-plak-extended-bold: 'Neue Plak Extended Bold';\n$system-font-family:\n    -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', Helvetica, Tahoma, Arial,\n    sans-serif;\n$default-font-family: $font-family-neue-plak, $system-font-family;\n\n$text-line-height: 22px;\n\n$text-letter-spacing-heading: -0.1px;\n\n$text-line-height-heading: 1.5;\n$text-line-height-body: 1.5;\n\n// New font weights\n$text-weight-regular: 400; // Neue Plak Text Regular\n$text-weight-text-semibold: 600; // Neue Plak Text Semibold\n$text-weight-bold: 700; // Neue Plak Bold\n$text-weight-black: 800; // Neue Plak Black\n\n// Old font weights\n$text-weight-heavy: $text-weight-text-semibold;\n\n$text-weights: (\n    'light': $text-weight-regular,\n    'regular': $text-weight-regular,\n    'heavy': $text-weight-text-semibold,\n    'semibold': $text-weight-text-semibold,\n    'bold': $text-weight-bold,\n);\n\n/* ========== Inputs =========== */\n\n$input-border-radius: 2px;\n$input-spacing: 12px;\n$input-spacing-top: 8px;\n$input-spacing-bottom: 9px;\n$input-padding: $input-spacing-top $input-spacing $input-spacing-bottom;\n$input-background: $theme-background !default;\n$input-height: 44px !default;\n$input-border-color: $grey-300;\n$input-border-hover-color: $grey-400;\n$input-disabled-color: $grey-100;\n$input-error-color: $ui-red;\