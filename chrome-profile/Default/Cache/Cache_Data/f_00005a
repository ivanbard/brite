px;\n$typography-font-size-heading-medium: 28px;\n$typography-font-size-heading-medium-desktop: 30px;\n$typography-font-size-heading-large: 32px;\n$typography-font-size-heading-xl: 52px;\n$typography-font-size-heading-xl-desktop: 84px;\n\n/* ========== Typography Line Heights =========== */\n\n$typography-line-height-quarter: 0.25rem;\n$typography-line-height-base: 1rem;\n$typography-line-height-base-quarter: $typography-line-height-base + $typography-line-height-quarter; // 1.25\n$typography-line-height-base-half: $typography-line-height-base-quarter +\n    $typography-line-height-quarter; // 1.5\n$typography-line-height-base-three-quarter: $typography-line-height-base-half +\n    $typography-line-height-quarter; // 1.75\n$typography-line-height-double: $typography-line-height-base * 2; // 2\n$typography-line-height-double-quarter: $typography-line-height-double +\n    $typography-line-height-quarter; // 2.25\n$typography-line-height-double-half: $typography-line-height-base-quarter * 2; // 2.5\n$typography-line-height-quad: $typography-line-height-double * 2; // 4\n$typography-line-height-six-half: $typography-line-height-quad + $typography-line-height-double-half; // 6.5\n$typography-line-height-body-open: 1.6rem;\n\n/* ========== Typography Letter Spacings =========== */\n\n$typography-letter-spacing-quarter: 0.25px;\n$typography-letter-spacing-half: $typography-letter-spacing-quarter * 2; // .5\n$typography-letter-spacing-three-quarter: $typography-letter-spacing-quarter * 3; // .75\n$typography-letter-spacing-whole: $typography-letter-spacing-quarter * 4; // 1\n$typography-letter-spacing-five-quarter: $typography-letter-spacing-quarter * 5; // 1.25\n\n/* ========== Margin sizes =========== */\n$margin-one-twelfth: 8.33333%;\n$margin-one-sixth: 16.66667%;\n//The 56px accounts for width of creator-nav-standalone ($creator-nav-component-width)\n$margin-one-twelfth-with-nav-offset: calc(8.33333% - 56px);\n$margin-one-sixth-with-nav-offset: calc(16.66667% - 56px);\n","@import './fxMixins.scss';\n@import './fx.scss';\n\n%eds-fx--hide {\n    opacity: 0;\n}\n\n%animation-fade {\n    @include animation-duration($promptly);\n    @include animation-timing-function(linear);\n    @include animation-iteration-count(1);\n    @include animation-fill-mode(forwards);\n\n    @extend %eds-fx--hide;\n}\n\n%eds-fx--animate {\n    @include animation-duration($quickly);\n    @include animation-timing-function(linear);\n    @include animation-iteration-count(1);\n    @include animation-fill-mode(forwards);\n}\n\n%eds-fx--fade-in {\n    @extend %animation-fade;\n\n    @extend %fadeIn;\n}\n\n%eds-fx--fade-in-down {\n    @extend %animation-fade;\n\n    @extend %fadeInDown;\n}\n\n%eds-fx--fade-in-up {\n    @extend %animation-fade;\n\n    @extend %fadeInUp;\n}\n\n%eds-fx--fade-in-left {\n    @extend %fadeInLeft;\n\n    @extend %animation-fade;\n}\n\n%eds-fx--fade-in-right {\n    @extend %animation-fade;\n\n    @extend %fadeInRight;\n}\n\n%eds-fx--fade-out {\n    @extend %animation-fade;\n\n    @extend %fadeOut;\n}\n\n%eds-fx--fade-out-down {\n    @extend %animation-fade;\n\n    @extend %fadeOutDown;\n}\n\n%eds-fx--fade-out-up {\n    @extend %animation-fade;\n\n    @extend %fadeOutUp;\n}\n\n%eds-fx--fade-move-out {\n    @extend %animation-fade;\n\n    @extend %fadeMoveOut;\n}\n\n%eds-fx--fade-move-in {\n    @extend %animation-fade;\n\n    @extend %fadeMoveIn;\n}\n\n%eds-fx--move-in {\n    @extend %eds-fx--animate;\n\n    @extend %moveIn;\n}\n\n%eds-fx--move-out {\n    @extend %eds-fx--animate;\n\n    @extend %moveOut;\n}\n\n%eds-fx--elevate {\n    @extend %eds-fx--animate;\n\n    @extend %elevate;\n}\n\n%eds-fx--shake {\n    @extend %eds-fx--animate;\n\n    @extend %shake;\n}\n\n%eds-fx--grow {\n    @extend %eds-fx--animate;\n\n    @extend %grow;\n}\n\n%eds-fx--slide-up {\n    @extend %slideUp;\n}\n\n%eds-fx--depress {\n    @extend %eds-fx--animate;\n\n    @extend %depress;\n}\n\n%eds-fx--shorten {\n    @extend %eds-fx--animate;\n\n    @extend %shorten;\n}\n\n%eds-fx--pop {\n    @extend %eds-fx--animate;\n\n    @extend %pop;\n}\n\n%eds-fx--bounce {\n    @extend %eds-fx--animate;\n\n    @extend %bounce;\n}\n\n%eds-fx--rotateX {\n    @extend %eds-fx--animate;\n\n    @extend %rotateX;\n}\n\n%eds-fx--rotateY {\n    @extend %eds-fx--animate;\n\n    @extend %rotateY;\n}\n\n%eds-fx--rotate {\n    @include animation-iteration-count(infinite);\n    @include animation-fill-mode(forwards);\n\n    @extend %rotate;\n}\n\n// Delaying an animation\n//\n// Animation delay classes can be used to add delays to your animations\n// You can use eds-fx--delay-1 to eds-fx--delay-30\n//\n// .eds-fx--delay-1 - 1 * our base unit\n// .eds-fx--delay-30 - 30 * our base unit\n//\n// Markup:\n// <div class=\"ImageContainer eds-fx--fade-in-down {{modifier_class}}\">\n//     <img src=\"https://s3.amazonaws.com/eventbrite-s3/marketing/emails/images/logos/eb-wordmarkx2.png\" />\n// </div>\n\n@for $i from 1 through 30 {\n    %eds-fx--delay-#{$i} {\n        @include animation-delay($i * $animation-increment);\n    }\n}\n\n// Custom animation duration\n//\n// Animation duration classes can be used to add diffrent durations to your animations\n// You can use eds-fx--duration_-9 to eds-fx--duration_10\n//\n// .eds-fx--duration_-9 - 1 second - 0.9s = 0.1s\n// .eds-fx--duration_9 - 1 second + 0.9s = 1.9s\n//\n// Markup:\n// <div class=\"ImageContainer eds-fx--fade-in {{modifier_class}}\">\n//     <img src=\"https://s3.amazonaws.com/eventbrite-s3/marketing/emails/images/logos/eb-wordmarkx2.png\" />\n// </div>\n\n@for $i from -10 through 10 {\n    %eds-fx--duration_#{$i} {\n        @include animation-duration($animation-increment + (($animation-increment * $i) * 0.1));\n    }\n}\n","@use 'sass:math';\n\n@import '../functions/functions.scss';\n\n@mixin truncate-text($value: on, $white-space: nowrap) {\n    @if $value == on {\n        text-overflow: ellipsis;\n        overflow: hidden;\n        white-space: $white-space;\n    } @else {\n        overflow: visible;\n        white-space: normal;\n    }\n}\n\n@mixin prefixer($property, $value, $prefixes) {\n    $prefix-for-webkit: true;\n    $prefix-for-mozilla: true;\n    $prefix-for-microsoft: true;\n    $prefix-for-opera: true;\n    $prefix-for-spec: true;\n\n    @each $prefix in $prefixes {\n        @if $prefix == webkit {\n            @if $prefix-for-webkit {\n                -webkit-#{$property}: $value;\n            }\n        } @else if $prefix == moz {\n            @if $prefix-for-mozilla {\n                -moz-#{$property}: $value;\n            }\n        } @else if $prefix == ms {\n            @if $prefix-for-microsoft {\n                -ms-#{$property}: $value;\n            }\n        } @else if $prefix == o {\n            @if $prefix-for-opera {\n                -o-#{$property}: $value;\n            }\n        } @else if $prefix == spec {\n            @if $prefix-for-spec {\n                #{$property}: $value;\n            }\n        } @else {\n            @warn \"Unrecognized prefix: #{$prefix}\";\n        }\n    }\n}\n\n$alignment-map: (\n    'left': flex-start,\n    'right': flex-end,\n    'center': center,\n    'space-around': space-around,\n    'space-between': space-between,\n);\n\n@mixin responsive-alignment($responsive-size) {\n    @each $alignment-abbr, $alignment in $alignment-map {\n        %eds-align--#{$responsive-size}-#{$alignment-abbr} {\n            display: flex;\n            justify-content: #{$alignment};\n        }\n    }\n}\n\n// takes the real width of an image and divides it by the resolution\n// to reduce fuzzy images on high pixel density screens\n@mixin calculateRwdWidth($width, $resolution: 2) {\n    $calculatedWidth: math.div($width, $resolution);\n\n    max-width: addUnits($calculatedWidth);\n}\n","@import '@eventbrite/legacy-eds.styles/spacing/spacing.scss';\n@import '@eventbrite/legacy-eds.styles/motion/motion.scss';\n@import './variables.scss';\n\n// Aggressively specific overrides for EDS modal.\n// Prevents conflict with