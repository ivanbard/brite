veOut;\n}\n\n%eds-fx--elevate {\n  @extend %eds-fx--animate;\n\n  @extend %elevate;\n}\n\n%eds-fx--shake {\n  @extend %eds-fx--animate;\n\n  @extend %shake;\n}\n\n%eds-fx--grow {\n  @extend %eds-fx--animate;\n\n  @extend %grow;\n}\n\n%eds-fx--slide-up {\n  @extend %slideUp;\n}\n\n%eds-fx--depress {\n  @extend %eds-fx--animate;\n\n  @extend %depress;\n}\n\n%eds-fx--shorten {\n  @extend %eds-fx--animate;\n\n  @extend %shorten;\n}\n\n%eds-fx--pop {\n  @extend %eds-fx--animate;\n\n  @extend %pop;\n}\n\n%eds-fx--bounce {\n  @extend %eds-fx--animate;\n\n  @extend %bounce;\n}\n\n%eds-fx--rotateX {\n  @extend %eds-fx--animate;\n\n  @extend %rotateX;\n}\n\n%eds-fx--rotateY {\n  @extend %eds-fx--animate;\n\n  @extend %rotateY;\n}\n\n%eds-fx--rotate {\n  @include animation-iteration-count(infinite);\n  @include animation-fill-mode(forwards);\n\n  @extend %rotate;\n}\n\n// Delaying an animation\n//\n// Animation delay classes can be used to add delays to your animations\n// You can use eds-fx--delay-1 to eds-fx--delay-30\n//\n// .eds-fx--delay-1 - 1 * our base unit\n// .eds-fx--delay-30 - 30 * our base unit\n//\n// Markup:\n// <div class=\"ImageContainer eds-fx--fade-in-down {{modifier_class}}\">\n//     <img src=\"https://s3.amazonaws.com/eventbrite-s3/marketing/emails/images/logos/eb-wordmarkx2.png\" />\n// </div>\n\n@for $i from 1 through 30 {\n  %eds-fx--delay-#{$i} {\n    @include animation-delay($i * $animation-increment);\n  }\n}\n\n// Custom animation duration\n//\n// Animation duration classes can be used to add diffrent durations to your animations\n// You can use eds-fx--duration_-9 to eds-fx--duration_10\n//\n// .eds-fx--duration_-9 - 1 second - 0.9s = 0.1s\n// .eds-fx--duration_9 - 1 second + 0.9s = 1.9s\n//\n// Markup:\n// <div class=\"ImageContainer eds-fx--fade-in {{modifier_class}}\">\n//     <img src=\"https://s3.amazonaws.com/eventbrite-s3/marketing/emails/images/logos/eb-wordmarkx2.png\" />\n// </div>\n\n@for $i from -10 through 10 {\n  %eds-fx--duration_#{$i} {\n    @include animation-duration($animation-increment + (($animation-increment * $i) * 0.1));\n  }\n}","@mixin spacing-classes($type-abbr, $type, $size-abbr, $size) {\n  %eds-l-#{$type-abbr}-all-#{$size-abbr} {\n    #{$type}: $size;\n  }\n\n  %eds-l-#{$type-abbr}-hor-#{$size-abbr} {\n    #{$type}-left: $size;\n    #{$type}-right: $size;\n  }\n\n  %eds-l-#{$type-abbr}-vert-#{$size-abbr} {\n    #{$type}-top: $size;\n    #{$type}-bottom: $size;\n  }\n\n  %eds-l-#{$type-abbr}-left-#{$size-abbr} {\n    #{$type}-left: $size;\n  }\n\n  %eds-l-#{$type-abbr}-right-#{$size-abbr} {\n    #{$type}-right: $size;\n  }\n\n  %eds-l-#{$type-abbr}-top-#{$size-abbr} {\n    #{$type}-top: $size;\n  }\n\n  %eds-l-#{$type-abbr}-bot-#{$size-abbr} {\n    #{$type}-bottom: $size;\n  }\n}\n\n@mixin spacing-mapper($key, $type-abbr, $type) {\n  $spacingKey: $key + '-' + $type-abbr;\n\n  @each $size-abbr, $size in $size-map {\n    @include spacing-classes($spacingKey, $type, $size-abbr, $size);\n  }\n}\n\n$shorthand-sizings: 'sn', 'sm', 'sw', 'mn', 'md', 'mw', 'ln', 'lg', 'lw';\n\n@function get-sizing-index($sizing) {\n  $index: index($shorthand-sizings, $sizing);\n\n  @if $index == null {\n    @warn \"#{$sizing} isn't a valid sizing. Must be one of #{$shorthand-sizings}\";\n  }\n\n  @return $index;\n}\n\n@mixin class-range($spacing, $start-size, $stop-size: null, $base: 'eds-l') {\n  $start-index: get-sizing-index($start-size);\n  $end-index: length($shorthand-sizings);\n\n  @if $stop-size != null {\n    $end-index: get-sizing-index($stop-size);\n  }\n\n  @if $end-index < $start-index {\n    $temp: $start-index;\n    $start-index: $end-index;\n    $end-index: $temp;\n  }\n\n  @for $i from $start-index through $end-index {\n    $size: nth($shorthand-sizings, $i);\n    @extend %#{$base}-#{$size}-#{$spacing};\n  }\n}\n","@import '../settings/settings';\n\n// Settings for the sizes\n$spacing-0: 0;\n$spacing-1: $grid-unit; // 4px\n$spacing-2: $grid-unit * 2; // 8px\n$spacing-3: $grid-unit * 3; // 10px\n$spacing-4: $grid-unit * 4; // 16px\n$spacing-5: $grid-unit * 5; // 20px\n$spacing-6: $grid-unit * 6; // 24px\n$spacing-8: $grid-unit * 8; // 32px\n$spacing-10: $grid-unit * 10; // 40px\n$spacing-12: $grid-unit * 12; // 48px\n$spacing-14: $grid-unit * 14; // 56px\n$spacing-16: $grid-unit * 16; // 64px\n$spacing-18: $grid-unit * 18; // 72px\n$spacing-20: $grid-unit * 20; // 80px\n\n// Size map\n$size-map: (\n  '0': $spacing-0,\n  '1': $spacing-1,\n  '2': $spacing-2,\n  '3': $spacing-3,\n  '4': $spacing-4,\n  '5': $spacing-5,\n  '6': $spacing-6,\n  '8': $spacing-8,\n  '10': $spacing-10,\n  '12': $spacing-12,\n  '14': $spacing-14,\n  '16': $spacing-16,\n  '18': $spacing-18,\n  '20': $spacing-20,\n);\n","@import '../settings/settings';\n@import '../media-queries/mediaQueries';\n@import './typographyMixins';\n\n// Please do not @extend any of these classes\n\n// TODO: these two non-class selectors break CSS Modules due to their global nature, so\n// they've been moved into a separate root.scss typography stylesheet that needs to be\n// imported at the app level. Should revisit approach after initial POC.\n//:root {\n//  font-size: $typography-font-size-base;\n//}\n//\n//body {\n//  font-family: $default-font-family;\n//  font-weight: $text-weight-regular;\n//  -moz-osx-font-smoothing: grayscale;\n//  -webkit-font-smoothing: antialiased;\n//  color: $theme-ui-800;\n//}\n\n%eds-text-hxl,\n%eds-text-hxl--fixed,\n%eds-text-hl,\n%eds-text-hl--fixed,\n%eds-text-hm,\n%eds-text-hm--fixed,\n%eds-text-hs,\n%eds-text-hs--fixed,\n%eds-text-bl,\n%eds-text-bl--fixed,\n%eds-text-bm,\n%eds-text-bm--fixed,\n%eds-text-bs,\n%eds-text-bs--fixed {\n  text-rendering: optimizeLegibility;\n}\n%eds-text-hxl,\n%eds-text-hxl--fixed,\n%eds-text-hl,\n%eds-text-hl--fixed,\n%eds-text-hm,\n%eds-text-hm--fixed,\n%eds-text-hs,\n%eds-text-hs--fixed {\n  color: $theme-ui-900;\n}\n\n%eds-text- {\n  &hxl,\n  &hxl--fixed {\n    @include rhythm(\n      $typography-font-size-heading-xl,\n      $typography-line-height-quad\n    );\n    @include letter-spacing($typography-letter-spacing-five-quarter);\n    font-weight: $text-weight-black;\n  }\n  &hl,\n  &hl--fixed {\n    @include rhythm(\n      $typography-font-size-heading-large,\n      $typography-line-height-double-half\n    );\n    @include letter-spacing($typography-letter-spacing-whole);\n    font-weight: $text-weight-black;\n  }\n  &hm,\n  &hm--fixed {\n    @include rhythm(\n      $typography-font-size-heading-medium,\n      $typography-line-height-double-quarter\n    );\n    @include letter-spacing($typography-letter-spacing-three-quarter);\n    font-weight: $text-weight-bold;\n  }\n  &hs,\n  &hs--fixed {\n    @include rhythm(\n      $typography-font-size-heading-small,\n      $typography-line-height-double\n    );\n    @include letter-spacing($typography-letter-spacing-quarter);\n    font-weight: $text-weight-bold;\n  }\n  &bl,\n  &bl--fixed {\n    @include rhythm(\n      $typography-font-size-body-large,\n      $typography-line-height-base-three-quarter\n    );\n    @include letter-spacing($typography-letter-spacing-quarter);\n    font-weight: $text-weight-text-semibold;\n\n    &%eds-text-height--open {\n      line-height: $typography-line-height-body-open;\n    }\n  }\n  &bm,\n  &bm--fixed {\n    @include rhythm(\n      $typography-font-size-base,\n      $typography-line-height-base-half\n    );\n    font-weight: $text-weight-regular;\n\n    &%eds-text-height--open {\n      line-height: $typography-line-height-body-open;\n    }\n  }\n  &bs,\n  &bs--fixed {\n    @include rhythm(\n      $typography-font-size-body-small,\n      $typography-line-height-base-quarter\n    );\n  }\n\n  @include medium-up {\n    &hxl,\n    &hxl--fixed {\n      @include rhythm(\n        $typography-font-size-heading-xl-desktop,\n        $typography-line-height-six-half\n      );\n    }\n\n    &hl,\n    &hl--fixed {\n      @include rhythm(\n        $typography-font-size-heading-xl,\n        $typography-line-height-quad\n      );\n    }\n\n    &hm,\n    &hm--fixed {\n      @include rhythm(\n        $typography-font-size-heading-medium-desktop,\n        $typography-line-height-double-half\n      );\n      @include letter-spacing($typography-letter-spacing-half);\n    }\n\n    &hs,\n    &hs--fixed {\n      @include rhythm(\n        $typography-font-size-heading-small,\n        $typography-line-height-double\n      );\n    }\n\n    &bl,\n    &bl--fixed {\n      @include rhythm(\n        $typography-font-size-body-large-desktop,\n        $typography-line-height-base-half\n      );\n    }\n\n    &bm,\n    &bm--fixed {\n      // Body Medium flexes to Body Small on Desktop hence the usage of $typography-font-size-body-small\n      @include rhythm(\n        $typography-font-size-body-small,\n        $typography-line-height-base-quarter\n      );\n    }\n\n    &bs,\n    &bs--fixed {\n      @include rhythm(\n        $typography-font-size-body-small-desktop,\n        $typography-line-height-base\n      );\n    }\n  }\n}\n\n%eds-text--underline {\n  border-bottom: 1px solid $grey-300;\n  margin: $grid-unit * 2 0 $grid-unit * 4;\n  padding: $grid-unit * 2 0;\n}\n\n%eds-text--strikethrough {\n  text-decoration: line-through;\n}\n\n%eds-text--uppercase {\n  text-transform: uppercase;\n}\n\n%eds-text--left {\n  text-align: left;\n}\n\n%eds-text--right {\n  text-align: right;\n}\n\n%eds-text--center {\n  text-align: center;\n}\n\n@each $key, $value in $text-weights {\n  %eds-text-weight--#{$key} {\n    font-weight: $value;\n  }\n}\n","@import '../functions/functions';\n@import '../settings/settings';\n\n/* ************ Typography Mixins ************ */\n\n//Adds font-size in rem\n@mixin font-size($sizeValue: 12px, $base: $typography-font-size-base) {\n  font-size: rem($sizeValue, $base);\n}\n\n//Adds line-height\n@mixin line-height($heightValue) {\n  line-height: $heightValue;\n}\n\n//Adds letter-spacing and accounts for center and right aligned text correction\n@mixin letter-spacing($spacing) {\n  letter-spacing: $spacing;\n  margin-right: -$spacing;\n}\n\n//Rhythm adds font-size and line-height in rem\n@mixin rhythm($sizeValue: 12px, $heightValue: 1rem) {\n  @include font-size($sizeValue);\n  @include line-height($heightValue);\n}\n","@function eds-hide($important: false) {\n  $none: none;\n  $noneWithImportant: #{$none} !important;\n\n  @if $important {\n    @return $noneWithImportant;\n  }\n  @return $none;\n}\n\n/* Hide the element for a responsive size */\n@mixin responsive-hide($responsive-size) {\n  %eds-hide-#{$responsive-size} {\n    display: eds-hide(true);\n  }\n\n  %eds-hide-#{$responsive-size}-accessible {\n    position: absolute !important;\n    left: -999999px !important;\n  }\n}\n\n/* Hide the element for a responsive size */\n@mixin responsive-show-helper($classPartial, $list) {\n  @each $size in $list {\n    %eds-#{$classPartial}-#{$size} {\n      display: eds-hide(true);\n    }\n  }\n}\n\n@mixin responsive-show($responsive-sizes...) {\n  @include responsive-show-helper('show', $responsive-sizes);\n}\n\n@mixin responsive-show-up($responsive-sizes...) {\n  @include responsive-show-helper('show-up', $responsive-sizes);\n}\n\n@mixin responsive-show-down($responsive-sizes...) {\n  @include responsive-show-helper('show-down', $responsive-sizes);\n}\n","%takeoverExit {\n  border-top: 1px solid $ui-100;\n  top: 100%;\n}","@import '~@eventbrite/valkyrie-eds-styles/settings/settings';\n@import '~@eventbrite/valkyrie-eds-styles/alignment/alignment';\n@import '~@eventbrite/valkyrie-eds-theming/themeHelpers';\n@import '~@eventbrite/valkyrie-eds-styles/helpers/helpers';\n@import '~@eventbrite/valkyrie-eds-styles/grid/grid';\n@import '~@eventbrite/valkyrie-eds-styles/motion/fxMixins';\n@import '~@eventbrite/valkyrie-eds-styles/motion/fxSettings';\n@import '~@eventbrite/valkyrie-eds-styles/motion/motion';\n@import '~@eventbrite/valkyrie-eds-styles/media-queries/mediaQueries';\n@import '~@eventbrite/valkyrie-eds-styles/spacing/spacing';\n@import '~@eventbrite/valkyrie-eds-styles/typography/typography';\n@import '~@eventbrite/valkyrie-eds-styles/visibility/visibility';\n@import 'variables';\n@import 'styles';\n\n$medium-narrow-width-minus-one: $medium-narrow-width - 1px;\n\n// Aggressively specific overrides for EDS modal.\n// Prevents conflict with old styles and custom styles\n.hiddenOverflow {\n  overflow: hidden !important;\n\n  @media (max-width: #{$medium-narrow-width-minus-one}) {\n    // To stop body from scrolling while modal is open, overflow:hidden works and\n    // is cross-browser compatible for desktop but in Safari on iOS the body still scrolls.\n    // To counteract this, on mobile sized viewports we add these to prevent scrolling.\n    // We don't use it universally here since it causes the page to appear to scroll to the top of the screen.\n    // It's fine for this behaviour on mobile though since the modal is full screen anyway.\n    position: fixed;\n    width: 100%;\n    -webkit-overflow-scrolling: auto !important;\n  }\n}\n\n@keyframes drawerSlide {\n  0% {\n    top: 100%;\n    border-height: 1px;\n  }\n\n  100% {\n    top: 0;\n    border-height: 0;\n  }\n}\n\n.root {\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: $modal-index-wrapper;\n  overflow: hidden;\n  position: fixed;\n  background: rgba($theme-ui-800-rgb, $modal-bg-opacity);\n\n  display: flex;\n  justify-content: center;\n  align-items: center;\n\n  &.takeover {\n    transition: top cubic-bezier(0.75, 0, 0.6, 1) 500ms;\n\n    animation: {\n      name: drawerSlide;\n      duration: 500ms;\n      timing-function: cubic-bezier(0.75, 0, 0.6, 1);\n      animation-fill-mode: forwards;\n    }\n\n    background: transparent;\n    top: 0;\n\n    .body {\n      width: 100%;\n      height: 100%;\n    }\n\n    &Exit {\n      @extend %takeoverExit;\n    }\n\n    @media (max-width: $medium-width) {\n      .contentChildren {\n        padding-top: 0px !important;\n      }\n    }\n  }\n}\n\n.body {\n  background-color: $theme-background;\n  he