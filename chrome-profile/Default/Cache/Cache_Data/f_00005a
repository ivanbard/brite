e-offset-aliased($responsive-offset-small-wide);\n}\n\n@include medium-narrow-up {\n    @include responsive-grid-aliased($responsive-grid-medium-narrow);\n    @include responsive-offset-aliased($responsive-offset-medium-narrow);\n}\n\n@include medium-up {\n    @include responsive-grid-aliased($responsive-grid-medium);\n    @include responsive-offset-aliased($responsive-offset-medium);\n}\n\n@include medium-wide-up {\n    @include responsive-grid-aliased($responsive-grid-medium-wide);\n    @include responsive-offset-aliased($responsive-offset-medium-wide);\n}\n\n@include large-narrow-up {\n    @include responsive-grid-aliased($responsive-grid-large-narrow);\n    @include responsive-offset-aliased($responsive-offset-large-narrow);\n}\n\n@include large-up {\n    @include responsive-grid-aliased($responsive-grid-large);\n    @include responsive-offset-aliased($responsive-offset-large);\n}\n\n@include large-wide-up {\n    @include responsive-grid-aliased($responsive-grid-large-wide);\n    @include responsive-offset-aliased($responsive-offset-large-wide);\n}\n","/* Used to add gutters and responsive padding classes responsively */\n@use 'sass:math';\n\n@mixin responsive-padding($padding-size) {\n    .eds-g-cell {\n        padding-left: $padding-size;\n        padding-right: $padding-size;\n    }\n\n    @for $i from 1 through 2 {\n        /* Used to provide appropriate sized gutters on off-grid elements */\n        .eds-l-gutter-left-#{$i} {\n            padding-left: $padding-size * $i;\n        }\n\n        .eds-l-gutter-right-#{$i} {\n            padding-right: $padding-size * $i;\n        }\n    }\n}\n\n/* Generate the grid for a responsive size */\n@mixin responsive-grid($responsive-size, $num-cols) {\n    @for $i from 1 through ($num-cols) {\n        $selector: #{$responsive-size}-#{$i}-#{$num-cols};\n        %eds-#{$selector} {\n            width: math.div(100% * $i, $num-cols);\n        }\n    }\n}\n\n/* Generate the grid offsets for a responsive size */\n@mixin responsive-offset($responsive-size, $num-cols) {\n    @for $i from 0 through ($num-cols - 1) {\n        $selector: #{$responsive-size}-#{$i}-#{$num-cols};\n        %eds-#{$selector} {\n            margin-left: math.div(100% * $i, $num-cols);\n        }\n    }\n}\n\n/* This mixin makes duplicate 12 column grids, so that we can say grid-1of2 instead of grid-6of12 */\n@mixin responsive-grid-aliased($responsive-size) {\n    @include responsive-grid($responsive-size, 12);\n    @include responsive-grid($responsive-size, 9);\n    @include responsive-grid($responsive-size, 8);\n    @include responsive-grid($responsive-size, 4);\n    @include responsive-grid($responsive-size, 3);\n    @include responsive-grid($responsive-size, 2);\n    @include responsive-grid($responsive-size, 1);\n}\n\n@mixin responsive-offset-aliased($responsive-size) {\n    @include responsive-offset($responsive-size, 12);\n    @include responsive-offset($responsive-size, 9);\n    @include responsive-offset($responsive-size, 8);\n    @include responsive-offset($responsive-size, 4);\n    @include responsive-offset($responsive-size, 3);\n    @include responsive-offset($responsive-size, 2);\n    @include responsive-offset($responsive-size, 1);\n}\n\n@mixin page-margin-manual {\n    padding-left: 0;\n    padding-right: 0;\n}\n","// NOTE: This file used to be in eds/styles/color but this caused a cyclic dependency\n// with eds/styles/settings which can prevent exporting both components to the remote\n// scope. So I moved it to settings until a better organization is devised.\n\n@import './settings.scss';\n\n// Color map loop\n@each $key, $value in $colors {\n    body {\n        %eds-text-color--#{$key} {\n            color: $value;\n\n            .eds-icon path {\n                fill: $value;\n            }\n        }\n\n        %eds-text-color-hover--#{$key}:hover {\n            color: $value;\n\n            .eds-icon path {\n                fill: $value;\n            }\n        }\n\n        %eds-text-color-active--#{$key}:focus {\n            color: $value;\n\n            .eds-icon path {\n                fill: $value;\n            }\n        }\n\n        %eds-bg-color--#{$key} {\n            background-color: $value;\n        }\n    }\n}\n","@import '../settings/settings.scss';\n@import './fxSettings.scss';\n\n@keyframes moveIn {\n    from {\n        transform: translateX(20px);\n    }\n    to {\n        transform: translateX(0);\n    }\n}\n\n%moveIn {\n    animation: moveIn $promptly $persistent;\n}\n\n@keyframes moveOut {\n    from {\n        transform: translateX(0);\n    }\n    to {\n        transform: translateX(20px);\n    }\n}\n\n%moveOut {\n    animation: moveOut $promptly $persistent;\n}\n\n@keyframes fadeOut {\n    from {\n        opacity: 1;\n    }\n    to {\n        opacity: 0;\n    }\n}\n\n%fadeOut {\n    animation-name: fadeOut;\n}\n\n@keyframes fadeOutDown {\n    0% {\n        opacity: 1;\n        transform: translateY(0);\n    }\n\n    100% {\n        opacity: 0;\n        transform: translateY(20px);\n    }\n}\n\n%fadeOutDown {\n    animation-name: fadeOutDown;\n}\n\n@keyframes fadeOutUp {\n    0% {\n        opacity: 1;\n        transform: translateY(0);\n    }\n\n    100% {\n        opacity: 0;\n        transform: translateY(-20px);\n    }\n}\n\n%fadeOutUp {\n    animation-name: fadeOutUp;\n}\n\n%fadeMoveOut {\n    animation:\n        fadeOut $linear $promptly,\n        moveOut $promptly $persistent;\n}\n\n%fadeMoveIn {\n    animation:\n        fadeIn $linear $promptly,\n        moveIn $promptly $persistent;\n}\n\n@keyframes fadeIn {\n    from {\n        opacity: 0;\n    }\n    to {\n        opacity: 1;\n    }\n}\n\n%fadeIn {\n    animation-name: fadeIn;\n}\n\n@keyframes fadeInDown {\n    0% {\n        opacity: 0;\n        transform: translateY(-20px);\n    }\n\n    65% {\n        opacity: 1;\n    }\n\n    100% {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n%fadeInDown {\n    animation-name: fadeInDown;\n}\n\n@keyframes fadeInLeft {\n    0% {\n        opacity: 0;\n        transform: translateX(-20px);\n    }\n\n    100% {\n        opacity: 1;\n        transform: translateX(0);\n    }\n}\n\n%fadeInLeft {\n    animation-name: fadeInLeft;\n}\n\n@keyframes fadeInRight {\n    0% {\n        opacity: 0;\n        transform: translateX(20px);\n    }\n\n    100% {\n        opacity: 1;\n        transform: translateX(0);\n    }\n}\n\n%fadeInRight {\n    animation-name: fadeInRight;\n}\n\n@keyframes fadeInUp {\n    0% {\n        opacity: 0;\n        transform: translateY(20px);\n    }\n\n    65% {\n        opacity: 1;\n    }\n\n    100% {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n%fadeInUp {\n    animation-name: fadeInUp;\n}\n\n@keyframes elevate {\n    to {\n        transform: perspective(200px) translateZ(30px);\n        box-shadow: $elevation-3;\n    }\n}\n\n%elevate {\n    animation-name: elevate;\n    animation-timing-function: $quickly, $promptly;\n}\n\n@keyframes shake {\n    20% {\n        transform: translate3d(-2px, 0, 0);\n    }\n    40% {\n        transform: translate3d(4px, 0, 0);\n    }\n    60% {\n        transform: translate3d(-4px, 0, 0);\n    }\n    80% {\n        transform: translate3d(2px, 0, 0);\n    }\n}\n\n%shake {\n    animation: shake $gently $persistent;\n}\n\n@keyframes grow {\n    from {\n        transform: scale(0.9, 0.9);\n    }\n    to {\n        transform: scale(1, 1);\n    }\n}\n\n%grow {\n    animation: grow $persistent $quickly;\n}\n\n@keyframes slideUp {\n    0% {\n        transform: translateY(180px);\n        border-height: 1px;\n    }\n\n    100% {\n        transform: translateY(0);\n        border-height: 0;\n    }\n}\n\n%slideUp {\n    animation: slideUp $linear 500ms;\n    animation-fill-mode: forwards;\n}\n\n@keyframes depress {\n    from {\n        transform: scale(1, 1);\n    }\n    to {\n        transform: scale(0.8, 0.8);\n    }\n}\n\n%depress {\n    animation: depress $persistent $promptly;\n}\n\n@keyframes shorten {\n    from {\n        transform: scale(1, 1);\n    }\n    to {\n        transform: scale(1.5, 0.5);\n    }\n}\n\n%shorten {\n    animation: shorten $persistent $promptly;\n}\n\n@keyframes pop {\n    20% {\n        transform: scale(0.9, 0.9);\n    }\n    50% {\n        transform: scale(1.2, 1.2);\n    }\n}\n\n%pop {\n    animation: pop $persistent $promptly;\n}\n\n@keyframes bounce {\n    20% {\n        transform: scale(0.75, 0.75);\n    }\n    50% {\n        transform: scale(1.2, 1.2);\n    }\n    70% {\n        transform: scale(0.85, 0.85);\n    }\n    85% {\n        transform: scale(1.08, 1.08);\n    }\n    90% {\n        transform: scale(0.95, 0.95);\n    }\n    95% {\n        transform: scale(1.05, 1.05);\n    }\n}\n\n%bounce {\n    animation: bounce 700ms $persistent;\n}\n\n@keyframes rotateX {\n    to {\n        transform: rotateX(180deg);\n    }\n}\n\n%rotateX {\n    animation-name: rotateX;\n}\n\n@keyframes rotateY {\n    to {\n        transform: rotateY(180deg);\n    }\n}\n\n%rotateY {\n    animation-name: rotateY;\n}\n\n%rotate {\n    animation: rotate 800ms linear;\n}\n\n@keyframes rotate {\n    to {\n        transform: rotate(360deg);\n    }\n}\n","@import './fxMixins.scss';\n@import './fx.scss';\n\n%eds-fx--hide {\n    opacity: 0;\n}\n\n%animation-fade {\n    @include animation-duration($promptly);\n    @include animation-timing-function(linear);\n    @include animation-iteration-count(1);\n    @include animation-fill-mode(forwards);\n\n    @extend %eds-fx--hide;\n}\n\n%eds-fx--animate {\n    @include animation-duration($quickly);\n    @include animation-timing-function(linear);\n    @include animation-iteration-count(1);\n    @include animation-fill-mode(forwards);\n}\n\n%eds-fx--fade-in {\n    @extend %animation-fade;\n\n    @extend %fadeIn;\n}\n\n%eds-fx--fade-in-down {\n    @extend %animation-fade;\n\n    @extend %fadeInDown;\n}\n\n%eds-fx--fade-in-up {\n    @extend %animation-fade;\n\n    @extend %fadeInUp;\n}\n\n%eds-fx--fade-in-left {\n    @extend %fadeInLeft;\n\n    @extend %animation-fade;\n}\n\n%eds-fx--fade-in-right {\n    @extend %animation-fade;\n\n    @extend %fadeInRight;\n}\n\n%eds-fx--fade-out {\n    @extend %animation-fade;\n\n    @extend %fadeOut;\n}\n\n%eds-fx--fade-out-down {\n    @extend %animation-fade;\n\n    @extend %fadeOutDown;\n}\n\n%eds-fx--fade-out-up {\n    @extend %animation-fade;\n\n    @extend %fadeOutUp;\n}\n\n%eds-fx--fade-move-out {\n    @extend %animation-fade;\n\n    @extend %fadeMoveOut;\n}\n\n%eds-fx--fade-move-in {\n    @extend %animation-fade;\n\n    @extend %fadeMoveIn;\n}\n\n%eds-fx--move-in {\n    @extend %eds-fx--animate;\n\n    @extend %moveIn;\n}\n\n%eds-fx--move-out {\n    @extend %eds-fx--animate;\n\n    @extend %moveOut;\n}\n\n%eds-fx--elevate {\n    @extend %eds-fx--animate;\n\n    @extend %elevate;\n}\n\n%eds-fx--shake {\n    @extend %eds-fx--animate;\n\n    @extend %shake;\n}\n\n%eds-fx--grow {\n    @extend %eds-fx--animate;\n\n    @extend %grow;\n}\n\n%eds-fx--slide-up {\n    @extend %slideUp;\n}\n\n%eds-fx--depress {\n    @extend %eds-fx--animate;\n\n    @extend %depress;\n}\n\n%eds-fx--shorten {\n    @extend %eds-fx--animate;\n\n    @extend %shorten;\n}\n\n%eds-fx--pop {\n    @extend %eds-fx--animate;\n\n    @extend %pop;\n}\n\n%eds-fx--bounce {\n    @extend %eds-fx--animate;\n\n    @extend %bounce;\n}\n\n%eds-fx--rotateX {\n    @extend %eds-fx--animate;\n\n    @extend %rotateX;\n}\n\n%eds-fx--rotateY {\n    @extend %eds-fx--animate;\n\n    @extend %rotateY;\n}\n\n%eds-fx--rotate {\n    @include animation-iteration-count(infinite);\n    @include animation-fill-mode(forwards);\n\n    @extend %rotate;\n}\n\n// Delaying an animation\n//\n// Animation delay classes can be used to add delays to your animations\n// You can use eds-fx--delay-1 to eds-fx--delay-30\n//\n// .eds-fx--delay-1 - 1 * our base unit\n// .eds-fx--delay-30 - 30 * our base unit\n//\n// Markup:\n// <div class=\"ImageContainer eds-fx--fade-in-down {{modifier_class}}\">\n//     <img src=\"https://s3.amazonaws.com/eventbrite-s3/marketing/emails/images/logos/eb-wordmarkx2.png\" />\n// </div>\n\n@for $i from 1 through 30 {\n    %eds-fx--delay-#{$i} {\n        @include animation-delay($i * $animation-increment);\n    }\n}\n\n// Custom animation duration\n//\n// Animation duration classes can be used to add diffrent durations to your animations\n// You can use eds-fx--duration_-9 to eds-fx--duration_10\n//\n// .eds-fx--duration_-9 - 1 second - 0.9s = 0.1s\n// .eds-fx--duration_9 - 1 second + 0.9s = 1.9s\n//\n// Markup:\n// <div class=\"ImageContainer eds-fx--fade-in {{modifier_class}}\">\n//     <img src=\"https://s3.amazonaws.com/eventbrite-s3/marketing/emails/images/logos/eb-wordmarkx2.png\" />\n// </div>\n\n@for $i from -10 through 10 {\n    %eds-fx--duration_#{$i} {\n        @include animation-duration($animation-increment + (($animation-increment * $i) * 0.1));\n    }\n}\n","@use 'sass:math';\n\n@import '../functions/functions.scss';\n\n@mixin truncate-text($value: on, $white-space: nowrap) {\n    @if $value == on {\n        text-overflow: ellipsis;\n        overflow: hidden;\n        white-space: $white-space;\n    } @else {\n        overflow: visible;\n        white-space: normal;\n    }\n}\n\n@mixin prefixer($property, $value, $prefixes) {\n    $prefix-for-webkit: true;\n    $prefix-for-mozilla: true;\n    $prefix-for-microsoft: true;\n    $prefix-for-opera: true;\n    $prefix-for-spec: true;\n\n    @each $prefix in $prefixes {\n        @if $prefix == webkit {\n            @if $prefix-for-webkit {\n                -webkit-#{$property}: $value;\n            }\n        } @else if $prefix == moz {\n            @if $prefix-for-mozilla {\n                -moz-#{$property}: $value;\n            }\n        } @else if $prefix == ms {\n            @if $prefix-for-microsoft {\n                -ms-#{$property}: $value;\n            }\n        } @else if $prefix == o {\n            @if $prefix-for-opera {\n                -o-#{$property}: $value;\n            }\n        } @else if $prefix == spec {\n            @if $prefix-for-spec {\n                #{$property}: $value;\n            }\n        } @else {\n            @warn \"Unrecognized prefix: #{$prefix}\";\n        }\n    }\n}\n\n$alignment-map: (\n    'left': flex-start,\n    'right': flex-end,\n    'center': center,\n    'space-around': space-around,\n    'space-between': space-between,\n);\n\n@mixin responsive-alignment($responsive-size) {\n    @each $alignment-abbr, $alignment in $alignment-map {\n        %eds-align--#{$responsive-size}-#{$alignment-abbr} {\n            display: flex;\n            justify-content: #{$alignment};\n        }\n    }\n}\n\n// takes the real width of an image and divides it by the resolution\n// to reduce fuzzy images on high pixel density screens\n@mixin calculateRwdWidth($width, $resolution: 2) {\n    $calculatedWidth: math.div($width, $resolution);\n\n    max-width: addUnits($calculatedWidth);\n}\n","@import '@eventbrite/legacy-eds.styles/media-queries/mediaQueries.scss';\n@import '@eventbrite/legacy-eds.styles/mixins/mixins.scss';\n@import '@eventbrite/legacy-eds.styles/motion/fxSettings.scss';\n@import '@eventbrite/legacy-eds.styles/motion/motion.scss';\n@import '@eventbrite/legacy-eds.styles/settings/settings.scss';\n@import '@eventbrite/legacy-eds.styles/spacing/spacing.scss';\n@import '@eventbrite/legacy-eds.styles/typography/typography.scss';\n@import '@eventbrite/legacy-eds.theming/themeSettings.scss';\n\n$border-radius: $grid-unit * 0.5;\n$input-line-height: $text-line-height;\n$input-line-height--sm: 23px;\n\n$input-separation: 12px;\n$input-border-sim-padding: 2px;\n$aside-height: 24px;\n$minimal-aside-separation: 4px;\n$minimal-aside-height: 40px;\n$underline-separation: 10px;\n$content-border-padding: 2px;\n\n$multiline-before-height: 22px;\n$resizable-max-height: $input-line-height * 10;\n$resizable-max-height--sm: $input-line-height--sm * 10;\n\n$input-basic-internal-input-pad: $input-separation 14px;\n$input-static-internal-input-pa