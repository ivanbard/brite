ss than the footer, but more than the modal close button when\n        // the pane is open so that the user doesn't mistake it for a way to close the pane.\n        //\n        // See $modal-index-close-button and $modal-index-footer in modal.scss and\n        // https://jira.evbhome.com/browse/EB-61329\n\n        z-index: $collapsible-pane-layout-index-open;\n\n        @include medium-narrow-up {\n            z-index: $collapsible-pane-layout-index-closed;\n        }\n\n        transform: translateY(0);\n\n        // Use momentum-based scrolling for iOS. This fixes an issue where modals don't scroll\n        // if a user's finger hits an input at the start of their scroll: EB-28583, EB-61201, EB-61426\n        -webkit-overflow-scrolling: touch;\n    }\n\n    &.edsCollapsiblePaneLayoutPaneAsModal {\n        display: flex;\n        background-color: adjust-color($ui-900, $alpha: -0.3);\n        flex-direction: column;\n        justify-content: flex-end;\n        opacity: 0;\n        z-index: $modal-index-collapsible-panel-as-modal;\n        transition:\n            opacity $gently,\n            transform 0s $gently,\n            visibility $gently;\n        visibility: hidden;\n\n        .edsCollapsiblePaneLayoutPaneContent {\n            background: $theme-ui-100;\n            transform: translateY(100%);\n            transition: transform $gently $outgoing;\n        }\n\n        &.edsCollapsiblePaneLayoutPaneOpen {\n            opacity: 1;\n            transition: opacity $gently $incoming;\n            visibility: visible;\n            z-index: $modal-index-collapsible-panel-as-modal-open;\n\n            .edsCollapsiblePaneLayoutPaneContent {\n                transition: transform $gently $incoming;\n                transform: translateY(0);\n            }\n        }\n    }\n\n    @include medium-narrow-up {\n        transition: none;\n        transform: translateY(0);\n        display: block;\n        position: relative;\n        width: $collapsible-pane-layout-size-medium;\n        border-left: 1px solid $theme-ui-200;\n\n        .edsCollapsiblePaneLayoutPaneContent {\n            height: 100%;\n        }\n\n        &.edsCollapsiblePaneLayoutPaneAsModal {\n            background-color: $theme-ui-100;\n            display: block;\n            opacity: 1;\n            visibility: visible;\n\n            .edsCollapsiblePaneLayoutPaneContent {\n                transform: translateY(0);\n            }\n        }\n    }\n\n    @include medium-up {\n        width: $collapsible-pane-layout-size-large;\n    }\n}\n","@import '../mixins/mixins.scss';\n\n// This helper should be removed if during the design sprints it is decided that we don't need it\n%eds-h-full-height-scrollable {\n    height: 100vh;\n    overflow: auto;\n}\n\n%eds-align--left {\n    display: flex;\n    justify-content: flex-start;\n}\n\n%eds-align--right {\n    display: flex;\n    justify-content: flex-end;\n}\n\n%eds-align--center {\n    display: flex;\n    justify-content: center;\n    align-content: center;\n    align-items: center;\n    margin: auto;\n}\n\n%eds-align--center-horizontal {\n    display: flex;\n    justify-content: center;\n}\n\n%eds-align--center-vertical {\n    display: flex;\n    justify-content: flex-start;\n    align-content: center;\n    align-items: center;\n}\n\n%eds-align--space-between {\n    display: flex;\n    justify-content: space-between;\n}\n\n%eds-align--space-around {\n    display: flex;\n    justify-content: space-around;\n}\n","@mixin spacing-classes($type-abbr, $type, $size-abbr, $size) {\n    %eds-l-#{$type-abbr}-all-#{$size-abbr} {\n        #{$type}: $size;\n    }\n\n    %eds-l-#{$type-abbr}-hor-#{$size-abbr} {\n        #{$type}-left: $size;\n        #{$type}-right: $size;\n    }\n\n    %eds-l-#{$type-abbr}-vert-#{$size-abbr} {\n        #{$type}-top: $size;\n        #{$type}-bottom: $size;\n    }\n\n    %eds-l-#{$type-abbr}-left-#{$size-abbr} {\n        #{$type}-left: $size;\n    }\n\n    %eds-l-#{$type-abbr}-right-#{$size-abbr} {\n        #{$type}-right: $size;\n    }\n\n    %eds-l-#{$type-abbr}-top-#{$size-abbr} {\n        #{$type}-top: $size;\n    }\n\n    %eds-l-#{$type-abbr}-bot-#{$size-abbr} {\n        #{$type}-bottom: $size;\n    }\n}\n\n@mixin spacing-mapper($key, $type-abbr, $type) {\n    $spacingKey: $key + '-' + $type-abbr;\n\n    @each $size-abbr, $size in $size-map {\n        @include spacing-classes($spacingKey, $type, $size-abbr, $size);\n    }\n}\n\n$shorthand-sizings: 'sn', 'sm', 'sw', 'mn', 'md', 'mw', 'ln', 'lg', 'lw';\n\n@function get-sizing-index($sizing) {\n    $index: index($shorthand-sizings, $sizing);\n\n    @if $index == null {\n        @warn \"#{$sizing} isn't a valid sizing. Must be one of #{$shorthand-sizings}\";\n    }\n\n    @return $index;\n}\n\n@mixin class-range($spacing, $start-size, $stop-size: null, $base: 'eds-l') {\n    $start-index: get-sizing-index($start-size);\n    $end-index: length($shorthand-sizings);\n\n    @if $stop-size != null {\n        $end-index: get-sizing-index($stop-size);\n    }\n\n    @if $end-index < $start-index {\n        $temp: $start-index;\n        $start-index: $end-index;\n        $end-index: $temp;\n    }\n\n    @for $i from $start-index through $end-index {\n        $size: nth($shorthand-sizings, $i);\n        @extend %#{$base}-#{$size}-#{$spacing};\n    }\n}\n","@import '../settings/settings.scss';\n\n// Settings for the sizes\n$spacing-0: 0;\n$spacing-1: $grid-unit; // 4px\n$spacing-2: $grid-unit * 2; // 8px\n$spacing-3: $grid-unit * 3; // 10px\n$spacing-4: $grid-unit * 4; // 16px\n$spacing-5: $grid-unit * 5; // 20px\n$spacing-6: $grid-unit * 6; // 24px\n$spacing-8: $grid-unit * 8; // 32px\n$spacing-10: $grid-unit * 10; // 40px\n$spacing-12: $grid-unit * 12; // 48px\n$spacing-14: $grid-unit * 14; // 56px\n$spacing-16: $grid-unit * 16; // 64px\n$spacing-18: $grid-unit * 18; // 72px\n$spacing-20: $grid-unit * 20; // 80px\n\n// Size map\n$size-map: (\n    '0': $spacing-0,\n    '1': $spacing-1,\n    '2': $spacing-2,\n    '3': $spacing-3,\n    '4': $spacing-4,\n    '5': $spacing-5,\n    '6': $spacing-6,\n    '8': $spacing-8,\n    '10': $spacing-10,\n    '12': $spacing-12,\n    '14': $spacing-14,\n    '16': $spacing-16,\n    '18': $spacing-18,\n    '20': $spacing-20,\n);\n","@import '../settings/settings.scss';\n@import '../media-queries/mediaQueries.scss';\n@import './typographyMixins.scss';\n\n// Please do not @extend any of these classes\n\n// TODO: these two non-class selectors break CSS Modules due to their global nature, so\n// they've been moved into a separate root.scss typography stylesheet that needs to be\n// imported at the app level. Should revisit approach after initial POC.\n//:root {\n//  font-size: $typography-font-size-base;\n//}\n//\n//body {\n//  font-family: $default-font-family;\n//  font-weight: $text-weight-regular;\n//  -moz-osx-font-smoothing: grayscale;\n//  -webkit-font-smoothing: antialiased;\n//  color: $theme-ui-800;\n//}\n\n%eds-text-hxl,\n%eds-text-hxl--fixed,\n%eds-text-hl,\n%eds-text-hl--fixed,\n%eds-text-hm,\n%eds-text-hm--fixed,\n%eds-text-hs,\n%eds-text-hs--fixed,\n%eds-text-bl,\n%eds-text-bl--fixed,\n%eds-text-bm,\n%eds-text-bm--fixed,\n%eds-text-bs,\n%eds-text-bs--fixed {\n    text-rendering: optimizeLegibility;\n}\n%eds-text-hxl,\n%eds-text-hxl--fixed,\n%eds-text-hl,\n%eds-text-hl--fixed,\n%eds-text-hm,\n%eds-text-hm--fixed,\n%eds-text-hs,\n%eds-text-hs--fixed {\n    color: $theme-ui-900;\n}\n\n%eds-text- {\n    &hxl,\n    &hxl--fixed {\n        @include rhythm($typography-font-size-heading-xl, $typography-line-height-quad);\n        @include letter-spacing($typography-letter-spacing-five-quarter);\n        font-weight: $text-weight-black;\n    }\n    &hl,\n    &hl--fixed {\n        @include rhythm($typography-font-size-heading-large, $typography-line-height-double-half);\n        @include letter-spacing($typography-letter-spacing-whole);\n        font-weight: $text-weight-black;\n    }\n    &hm,\n    &hm--fixed {\n        @include rhythm(\n            $typography-font-size-heading-medium,\n            $typography-line-height-double-quarter\n        );\n        @include letter-spacing($typography-letter-spacing-three-quarter);\n        font-weight: $text-weight-bold;\n    }\n    &hs,\n    &hs--fixed {\n        @include rhythm($typography-font-size-heading-small, $typography-line-height-double);\n        @include letter-spacing($typography-letter-spacing-quarter);\n        font-weight: $text-weight-bold;\n    }\n    &bl,\n    &bl--fixed {\n        @include rhythm(\n            $typography-font-size-body-large,\n            $typography-line-height-base-three-quarter\n        );\n        @include letter-spacing($typography-letter-spacing-quarter);\n        font-weight: $text-weight-text-semibold;\n\n        &%eds-text-height--open {\n            line-height: $typography-line-height-body-open;\n        }\n    }\n    &bm,\n    &bm--fixed {\n        @include rhythm($typography-font-size-base, $typography-line-height-base-half);\n        font-weight: $text-weight-regular;\n\n        &%eds-text-height--open {\n            line-height: $typography-line-height-body-open;\n        }\n    }\n    &bs,\n    &bs--fixed {\n        @include rhythm($typography-font-size-body-small, $typography-line-height-base-quarter);\n    }\n\n    @include medium-up {\n        &hxl,\n        &hxl--fixed {\n            @include rhythm(\n                $typography-font-size-heading-xl-desktop,\n                $typography-line-height-six-half\n            );\n        }\n\n        &hl,\n        &hl--fixed {\n            @include rhythm($typography-font-size-heading-xl, $typography-line-height-quad);\n        }\n\n        &hm,\n        &hm--fixed {\n            @include rhythm(\n                $typography-font-size-heading-medium-desktop,\n                $typography-line-height-double-half\n            );\n            @include letter-spacing($typography-letter-spacing-half);\n        }\n\n        &hs,\n        &hs--fixed {\n            @include rhythm($typography-font-size-heading-small, $typography-line-height-double);\n        }\n\n        &bl,\n        &bl--fixed {\n            @include rhythm(\n                $typography-font-size-body-large-desktop,\n                $typography-line-height-base-half\n            );\n        }\n\n        &bm,\n        &bm--fixed {\n            // Body Medium flexes to Body Small on Desktop hence the usage of $typography-font-size-body-small\n            @include rhythm($typography-font-size-body-small, $typography-line-height-base-quarter);\n        }\n\n        &bs,\n        &bs--fixed {\n            @include rhythm($typography-font-size-body-small-desktop, $typography-line-height-base);\n        }\n    }\n}\n\n%eds-text--underline {\n    border-bottom: 1px solid $grey-300;\n    margin: $grid-unit * 2 0 $grid-unit * 4;\n    padding: $grid-unit * 2 0;\n}\n\n%eds-text--strikethrough {\n    text-decoration: line-through;\n}\n\n%eds-text--uppercase {\n    text-transform: uppercase;\n}\n\n%eds-text--left {\n    text-align: left;\n}\n\n%eds-text--right {\n    text-align: right;\n}\n\n%eds-text--center {\n    text-align: center;\n}\n\n@each $key, $value in $text-weights {\n    %eds-text-weight--#{$key} {\n        font-weight: $value;\n    }\n}\n","@import '../functions/functions.scss';\n@import '../settings/settings.scss';\n\n/* ************ Typography Mixins ************ */\n\n//Adds font-size in rem\n@mixin font-size($sizeValue: 12px, $base: $typography-font-size-base) {\n    font-size: rem($sizeValue, $base);\n}\n\n//Adds line-height\n@mixin line-height($heightValue) {\n    line-height: $heightValue;\n}\n\n//Adds letter-spacing and accounts for center and right aligned text correction\n@mixin letter-spacing($spacing) {\n    letter-spacing: $spacing;\n    margin-right: -$spacing;\n}\n\n//Rhythm adds font-size and line-height in rem\n@mixin rhythm($sizeValue: 12px, $heightValue: 1rem) {\n    @include font-size($sizeValue);\n    @include line-height($heightValue);\n}\n","@import '@eventbrite/legacy-eds.button/buttonSettings.scss';\n\n/* ========== Base =========== */\n$icon-btn-border-radius: 40px;\n$icon-btn-height: 40px;\n$icon-btn-padding: 8px;\n$icon-btn-transition: $btn-transition;\n\n// Outline\n$icon-btn-outline-padding: 7px; // Adjust for border to keep btn 40px by 40px\n$icon-btn-outline-border-width: 1px;\n\n$icon-btn-control-border-width: 2px;\n$icon-btn-control-padding: 6px;\n\n/* ========== Colour =========== */\n$icon-btn-text-color: $theme-ui-700;\n$icon-btn-text-color--hover: $theme-ui-800;\n$icon-btn-background-color--hover: $theme-ui-100;\n$icon-btn-background-color--active: $theme-ui-200;\n\n// Active\n$icon-btn-active-background-color: $theme-ui-100;\n\n// Link\n$icon-btn-link-text-color: $theme-control;\n$icon-btn-link-text-color--hover: $theme-control--hover;\n$icon-btn-link-text-color--active: $theme-control--active;\n\n// Fill\n$icon-btn-fill-text-color: $theme-primary-brand;\n$icon-btn-fill-text-color--hover: $theme-primary-brand--hover;\n$icon-btn-fill-text-color--active: $theme-primary-brand--active;\n\n// Outline\n$icon-btn-outline-background-color: $theme-background;\n$icon-btn-outline-background-color--hover: $theme-background;\n$icon-btn-outline-background-color--active: $theme-ui-200;\n$icon-btn-outline-border-color: $theme-ui-300;\n$icon-btn-outline-border-color--hover: $theme-ui-500;\n$icon-btn-outline-border-color--active: $theme-ui-600;\n\n// Control\n$icon-btn-control-background-color: $theme-background;\n$icon-btn-control-background-color--hover: $theme-ui-200;\n$icon-btn-control-background-color--active: $theme-control;\n$icon-btn-control-border-color: $theme-control;\n$icon-btn-control-border-color--hover: $theme-control;\n$icon-btn-control-border-color--active: $theme-control;\n$icon-btn-control-color--active: $white;\n\n// Disabled\n$icon-btn-disabled-text-color: $theme-ui-500;\n$icon-btn-disabled-border-color: $theme-ui-200;\n$icon-btn-disabled-background-color--hover: transparent;\n\n// Inverse - Not theme compatible\n$icon-btn-inverse-background-color: transparent;\n$icon-btn-inverse-background-color--hover: $ui-700;\n$icon-btn-inverse-background-color--active: $ui-800;\n$icon-btn-inverse-text-color: $white;\n$icon-btn-inverse-text-color--disabled: $ui-500;\n\n// Over Image\n$icon-btn-oimage-background-color: rgba($ui-100, 0.5);\n$icon-btn-oimage-background-color--hover: rgba($ui-100, 0.9);\n\n%eds-icon-button-default {\n    color: $icon-btn-text-color;\n    fill: $icon-btn-text-color;\n\n    &:focus,\n    &:hover,\n    &:active {\n        color: $icon-btn-text-color--hover;\n        fill: $icon-btn-text-color--hover;\n    }\n\n    &:focus,\n    &:hover {\n        background-color: $icon-btn-background-color--hover;\n    }\n\n    &:active {\n        background-color: $icon-btn-background-color--active;\n    }\n}\n\n.root {\n    border: var(--eds-IconButton-border);\n    border-radius: var(--eds-IconButton-border-radius);\n    padding: var(--eds-IconButton-padding);\n    background-color: var(--eds-IconButton-background-color);\n    display: inline-block;\n\n    button {\n        @extend %eds-icon-button-default;\n        border-radius: $icon-btn-border-radius;\n        height: $icon-btn-height;\n        padding: $icon-btn-padding;\n        transition: $icon-btn-transition;\n        width: $icon-btn-height;\n    }\n}\n\n.active {\n    button {\n        &:hover {\n            background-color: $icon-btn-active-background-color;\n        }\n    }\n}\n\n.link {\n    button {\n        fill: $icon-btn-link-text-color;\n        color: $icon-btn-link-text-color;\n\n        &:focus,\n        &:hover {\n            fill: $icon-btn-link-text-color--hover;\n            color: $icon-btn-link-text-color--hover;\n        }\n\n        &:active {\n            fill: $icon-btn-link-text-color--active;\n            color: $icon-btn-link-text-color--active;\n        }\n    }\n}\n\n.neutral {\n    button {\n        @extend %eds-icon-button-default;\n    }\n}\n\n.none {\n    button {\n        &:focus,\n        &:hover {\n            background-color: transparent;\n        }\n    }\n}\n\n.brand {\n    button {\n        color: $icon-btn-fill-text-color;\n        fill: $icon-btn-fill-text-color;\n\n        &:focus,\n        &:hover {\n            color: $icon-btn-fill-text-color--hover;\n            fill: $icon-btn-fill-text-color--hover;\n        }\n\n        &:active {\n            color: $icon-btn-fill-text-color--active;\n            fill: $icon-btn-fill-text-color--active;\n        }\n    }\n}\n\n.inverse {\n    &.active button {\n        background-color: $icon-btn-inverse-background-color--active;\n\n        &:hover,\n        &:focus {\n            background-color: $icon-btn-inverse-background-color--hover;\n        }\n    }\n\n    button {\n        background-color: $icon-btn-inverse-background-color;\n        color: $icon-btn-inverse-text-color;\n        fill: $icon-btn-inverse-text-color;\n\n        &:hover,\n        &:focus,\n        &:active {\n            color: $icon-btn-inverse-text-color;\n            fill: $icon-btn-inverse-text-color;\n        }\n\n        &:hover,\n        &:focus {\n            background-color: $icon-btn-inverse-background-color--hover;\n        }\n\n        &:active {\n            background-color: $icon-btn-inverse-background-color--active;\n        }\n    }\n\n    &.disabled {\n        button {\n            color: $icon-btn-inverse-text-color--disabled;\n            fill: $icon-btn-inverse-text-color--disabled;\n\n            &:active,\n            &:focus,\n            &:hover {\n                background-color: transparent;\n                color: $icon-btn-inverse-text-color--disabled;\n                fill: $icon-btn-inverse-text-color--disabled;\n            }\n        }\n    }\n}\n\n.outline {\n    button {\n        background-color: $icon-btn-outline-background-color;\n        border: $icon-btn-outline-border-width solid $icon-btn-outline-border-color;\n        padding: $icon-btn