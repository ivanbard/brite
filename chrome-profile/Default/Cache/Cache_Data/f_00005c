etails && agendaInfo ? <Agenda tabs={agendaInfo?.tabs} /> : null;\n\n  const faqsComponent = showEndedEventDetails ? <EventFAQs faqs={structuredContent?.widgets?.faqs ?? []} /> : null;\n\n  const organizerCardComponent = showEndedEventDetails ? <OrganizerCard organizer={basicInfo.organizer} /> : null;\n\n  const reportThisEventButtonComponent = showEndedEventDetails ? (\n    <ReportThisEventButton\n      ref={reportButtonRef}\n      eventId={basicInfo.id}\n      eventName={basicInfo.name}\n      eventUrl={basicInfo.url}\n      country={basicInfo.venue?.address?.country ?? 'US'}\n      locale={locale}\n    />\n  ) : null;\n\n  const relatedEventsComponent = basicInfo?.id ? (\n    <RelatedEvents\n      eventId={basicInfo.id}\n      isBodyRendered={isBodyRendered}\n      eventBasicInfo={basicInfo}\n      sessionData={sessionData}\n    />\n  ) : null;\n\n  const moreOrganizerEventsComponent =\n    basicInfo?.id && basicInfo?.organizer?.id ? (\n      <MoreOrganizerEvents\n        eventId={basicInfo.id}\n        isBodyRendered={isBodyRendered}\n        eventBasicInfo={basicInfo}\n        sessionData={sessionData}\n      />\n    ) : null;\n\n  return (\n    <DisplayStatusProvider salesStatusData={salesStatus} eventStatus={basicInfo.status}>\n      <ToastProvider>\n        <div className={styles.bodyWrapper} data-testid=\"body\" id=\"listing-body\">\n          <OrganizerFollowStatusProvider organizer={basicInfo.organizer}>\n            <div className={styles.heroAndBannerSection}>\n              <NotificationBanner />\n              <EventHero\n                hasCroppedLogo={false}\n                mainBodyBackground={{ croppedLogoUrl50: gallery?.images?.[0]?.url }}\n                items={carouselItems}\n                featuredVideo={featuredVideo}\n                nativeVideo={nativeVideo}\n                eventName={basicInfo.name}\n              />\n            </div>\n            <EventSignalsBar />\n            <div className={styles.contentContainer}>\n              <div className={styles.layoutWrapper}>\n                <Layout>\n                  <Main className={styles.mainContent}>\n                    <EventDetails basicInfo={basicInfo} collections={collections} presenterInfo={presenterInfo} />\n                    {viewDetailsButton}\n                    <SectionWrapper name=\"overview\">{overviewComponent}</SectionWrapper>\n                    <SectionWrapper name=\"artistsInfo\">{artistInfoComponent}</SectionWrapper>\n                    <SectionWrapper name=\"goodToKnow\">{goodToKnowComponent}</SectionWrapper>\n                    <SectionWrapper name=\"location\">{locationComponent}</SectionWrapper>\n                    <SectionWrapper name=\"agenda\">{agendaComponent}</SectionWrapper>\n                    <SectionWrapper name=\"faqs\" noDivider>\n                      {faqsComponent}\n                    </SectionWrapper>\n                    <SectionWrapper name=\"organizerCard\" noDivider>\n                      {organizerCardComponent}\n                    </SectionWrapper>\n                    <SectionWrapper name=\"reportThisEvent\">{reportThisEventButtonComponent}</SectionWrapper>\n                  </Main>\n                  {moreOrganizerEventsComponent}\n                  {relatedEventsComponent}\n                  <EventTags tags={tags} />\n                </Layout>\n              </div>\n              <ConversionBarWrapper>\n                <ConversionBar />\n              </ConversionBarWrapper>\n            </div>\n            <Footer\n              refTargets={{\n                'report-this-event-button': () => reportButtonRef.current?.triggerModal(),\n              }}\n            />\n          </OrganizerFollowStatusProvider>\n        </div>\n      </ToastProvider>\n    </DisplayStatusProvider>\n  );\n};\n","export { Body } from './Body';\n","import type { Stage } from '@eventbrite/webapp-constants';\nimport { TagManager as TagManagerComponent } from '@eventbrite/webapp-data';\n\nconst PROD_ID = 'GTM-5P8FXJ';\nconst QA_ID = 'GTM-K38MFVK';\n\nconst PROD_QS = '';\nconst QA_QS = '&gtm_auth=EooEAfCZ9TFXW4xjZ1fXCA&gtm_preview=env-55&gtm_cookies_win=x';\nconst DEV_QS = '&gtm_auth=UbbN_A4eWDkvSIJ-0I6qZA&gtm_preview=env-6&gtm_cookies_win=x';\n\ninterface TagManagerProps {\n  publicUserId: string;\n  stage: Stage;\n}\n\nexport const TagManager: React.FC<TagManagerProps> = ({ publicUserId, stage }) => {\n  return (\n    <TagManagerComponent\n      publicUserId={publicUserId}\n      stage={stage}\n      environment={{\n        production: {\n          id: PROD_ID,\n          query: PROD_QS,\n        },\n        qa: {\n          id: QA_ID,\n          query: QA_QS,\n        },\n        development: {\n          query: DEV_QS,\n        },\n      }}\n    />\n  );\n};\n","import { createContext, useContext } from 'react';\n\nexport type ExperimentAssignment = {\n  groupName: string;\n  parameters: Record<string, unknown>;\n};\n\nexport type ExperimentsData = Record<string, ExperimentAssignment>;\n\nexport const ExperimentsContext = createContext<ExperimentsData | undefined>(undefined);\n\nexport const ExperimentsProvider = ({\n  children,\n  experiments,\n}: {\n  children: React.ReactNode;\n  experiments: ExperimentsData;\n}) => {\n  return <ExperimentsContext.Provider value={experiments}>{children}</ExperimentsContext.Provider>;\n};\n\nexport const useExperiments = () => {\n  const context = useContext(ExperimentsContext);\n  if (context === undefined) {\n    throw new Error('useExperiments must be used within an ExperimentsProvider');\n  }\n  return context;\n};\n\nexport const useExperiment = (experimentName: string) => {\n  const experiments = useExperiments();\n  return experiments[experimentName];\n};\n","import { getTreatment } from '@eventbrite/splitio-client';\n\n/**\n * Split.io feature flag names mapped to their application keys.\n *\n * To add a new flag:\n * 1. Add entry here: `myNewFlag: 'split_io_flag_name'`\n * 2. Add default in `DEFAULT_FEATURE_FLAGS`\n * 3. Add evaluation in `evaluateFeatureFlags`\n */\nconst FLAGS = {} as const;\n\nexport type FeatureFlags = {\n  [K in keyof typeof FLAGS]: boolean;\n};\n\nexport const DEFAULT_FEATURE_FLAGS: FeatureFlags = {};\n\n/**\n * Context passed to feature flag evaluation.\n * Contains all attributes that may be used for flag targeting in Split.io.\n */\nexport interface FeatureFlagContext {\n  eventId: string;\n  organizationId?: string;\n}\n\n/**\n * Evaluates all feature flags for the given context.\n *\n * Each flag specifies which attributes it needs from the context.\n * Flags are evaluated in parallel.\n *\n * @param ctx - Context containing attributes for flag targeting\n * @returns Promise resolving to all feature flag values\n */\nexport async function evaluateFeatureFlags(ctx: FeatureFlagContext): Promise<FeatureFlags> {\n  const flagEntries = await Promise.all(\n    (Object.entries(FLAGS) as [keyof FeatureFlags, string][]).map(async ([flagKey, flagName]) => {\n      const value = await evaluateFlag(flagName, ctx.eventId, {\n        eventId: ctx.eventId,\n        organization_id: ctx.organizationId,\n      });\n      return [flagKey, value] as const;\n    }),\n  );\n\n  return flagEntries.reduce((acc, [flagKey, value]) => ({ ...acc, [flagKey]: value }), DEFAULT_FEATURE_FLAGS);\n}\n\n/**\n * Evaluates a single feature flag.\n *\n * @param flagName - Split.io flag name\n * @param key - Split.io key (typically eventId)\n * @param attributes - Targeting attributes\n * @returns `true` if treatment is 'on', `false` otherwise or on error\n */\nasync function evaluateFlag(\n  flagName: string,\n  key: string,\n  attributes: Record<string, string | undefined>,\n): Promise<boolean> {\n  try {\n    const cleanAttributes: Record<string, string> = {};\n    for (const [attrKey, value] of Object.entries(attributes)) {\n      if (value !== undefined) cleanAttributes[attrKey] = value;\n    }\n    const treatment = await getTreatment(key, flagName, cleanAttributes);\n    return treatment === 'on';\n  } catch (error) {\n    console.warn(`Failed to evaluate feature flag: ${flagName}`, { error, key });\n    const flagKey = (Object.entries(FLAGS) as [keyof FeatureFlags, string][]).find(\n      ([, value]) => value === flagName,\n    )?.[0];\n    return (flagKey !== undefined ? DEFAULT_FEATURE_FLAGS[flagKey] : undefined) ?? false;\n  }\n}\n","import React, { createContext, useContext, useMemo } from 'react';\nimport { FeatureFlags, DEFAULT_FEATURE_FLAGS } from '@/utils/featureFlags';\n\nconst FeatureFlagsContext = createContext<FeatureFlags>(DEFAULT_FEATURE_FLAGS);\n\ninterface FeatureFlagsProviderProps {\n  flags: FeatureFlags;\n  children: React.ReactNode;\n}\n\nexport const FeatureFlagsProvider: React.FC<FeatureFlagsProviderProps> = ({ flags, children }) => {\n  const value = useMemo(() => flags, [flags]);\n\n  return <FeatureFlagsContext.Provider value={value}>{children}</FeatureFlagsContext.Provider>;\n};\n\nexport const useFeatureFlags = (): FeatureFlags => {\n  const context = useContext(FeatureFlagsContext);\n  if (context === undefined) {\n    throw new Error('useFeatureFlags must be used within a FeatureFlagsProvider');\n  }\n  return context;\n};\n","export { ExperimentsProvider, useExperiments, useExperiment, type ExperimentsData } from './ExperimentsContext';\nexport { FeatureFlagsProvider, useFeatureFlags } from './FeatureFlagsContext';\n","/**\n * Sends event view tracking data using Navigator.sendBeacon or fetch fallback\n * Only runs in browser environment (client-side)\n *\n * @returns Promise<boolean> - true if the request was successfully queued, false otherwise\n */\nexport const sendEventViewTracking = async (): Promise<boolean> => {\n  // Only run in browser environment\n  if (typeof window === 'undefined') {\n    return false;\n  }\n\n  try {\n    const payload = JSON.stringify({\n      path: window.location.pathname + window.location.search,\n      host: window.location.host,\n    });\n\n    // Use sendBeacon if available (preferred method)\n    if (navigator.sendBeacon) {\n      return navigator.sendBeacon('/e/api/eventview', payload);\n    } else {\n      // Fallback to fetch if sendBeacon is not available\n      await fetch('/e/api/eventview', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n        },\n        body: payload,\n        keepalive: true, // Similar behavior to sendBeacon\n      });\n      return true;\n    }\n    // eslint-disable-next-line @typescript-eslint/no-unused-vars\n  } catch (error) {\n    // Silently ignore errors for tracking\n    return false;\n  }\n};\n","import Head from 'next/head';\nimport { getImageProps } from 'next/image';\nimport { useEffect } from 'react';\nimport { useQuery } from '@tanstack/react-query';\nimport {\n  MetaTags,\n  AssetsPrefetchLinks,\n  FavIconLinks,\n  TwitterTags,\n  TwitterCard,\n  OpenGraphTags,\n} from '@eventbrite/webapp-public-content';\n\nimport {\n  extractFacebookClickIds,\n  useAttributionClickTracking,\n  useTranscendConsent,\n} from '@eventbrite/legacy-infra.clid-courier';\nimport { getExperimentAssignment } from '@eventbrite/legacy-infra.statsig';\n\nimport { Body } from '@components/Body';\nimport { Header } from '@components/Header';\nimport { getBaseDeepLinkAppUrl, JSONLDTags, SEOTags } from '@components/SEOTags';\nimport { TagManager } from '@/components/TagManager/TagManager';\nimport { GenericErrorPage } from '@/components/_shared/ErrorPages';\nimport { BasicInfoProvider } from '@/components/_shared/contexts/BasicInfoContext';\nimport { ExperimentsProvider } from '@/components/_shared/contexts/ExperimentsContext';\nimport { FeatureFlagsProvider } from '@/components/_shared/contexts';\nimport { DEFAULT_FEATURE_FLAGS } from '@/utils/featureFlags';\n\nimport { useEventDescription, useEventTitle } from '@/hooks';\nimport { addPagePropertiesFromRenderContext } from '@/utils/dataLayer';\nimport { sendEventViewTracking } from '@/utils/eventViewTracking';\n\nimport { onStatsigReady } from '../../../common/statsig';\nimport type { ListingPageProps } from '@/pages/listingPageTypes';\nimport { getUserDataQueryOptions } from '@/hooks/useUserData/useUserData';\n\nconst TWITTER_IOS_REFERRER = 'eiosurlxtcar';\nconst TWITTER_ANDROID_REFERRER = 'eandurlxtcar';\n\nexport type EventListingPageProps = ListingPageProps & {\n  /** When set, renders <link rel=\"canonical\" href={...} /> in Head (e.g. protected page points to gate URL). */\n  canonicalHref?: string | null;\n  /** OG/Twitter description. If not provided, uses basicInfo.isProtected ? '' : basicInfo.summary. */\n  ogDescription?: string;\n};\n\nexport function EventListingPage({\n  context,\n  locale,\n  error,\n  stage,\n  googleMapsApiKey,\n  ebHost,\n  query,\n  featureFlags = DEFAULT_FEATURE_FLAGS,\n  experiments = {},\n  globalHeaderProps,\n  canonicalHref,\n  ogDescription,\n}: EventListingPageProps): JSX.Element {\n  const { data: userData } = useQuery(\n    getUserDataQueryOptions(context?.basicInfo?.id, context?.basicInfo?.isOnline, !!context),\n  );\n\n  useEffect(() => {\n    if (context && userData !== undefined) {\n      const isAuthenticated = !!userData?.userId;\n      addPagePropertiesFromRenderContext(context, isAuthenticated);\n    }\n    if (context !== undefined && context != null) {\n      sendEventViewTracking();\n    }\n  }, [context, userData]);\n\n  useEffect(() => {\n    onStatsigReady(() => {\n      Object.entries(experiments).forEach(([experimentName, experimentData]) => {\n        const clientSideExperimentAssignment = getExperimentAssignment(experimentName);\n        if (clientSideExperimentAssignment?.getGroupName() !== experimentData.groupName) {\n          console.error('[Statsig Error] Experiment Assignment Mismatch!', {\n            experimentName,\n            serverSideGroupName: experimentData.groupName,\n            clientSideGroupName: clientSideExperimentAssignment?.getGroupName(),\n          });\n        }\n      });\n    });\n  }, [experiments