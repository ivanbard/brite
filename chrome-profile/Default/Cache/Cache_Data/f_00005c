 from './badgeInfo';\nimport { useIntl } from 'react-intl';\nimport styles from './UrgencySignalBadge.module.scss';\n\ninterface Props {\n  badge: BadgeInfo;\n}\n\nexport const UrgencySignalBadge: React.FC<Props> = ({ badge }) => {\n  const { formatMessage } = useIntl();\n  return (\n    <Badge variant={badge.style} bordered={true} className={styles.badge} icon={badge.icon as JSX.Element}>\n      {formatMessage(badge.text)}\n    </Badge>\n  );\n};\n","import { useEffect, useState } from 'react';\nimport { updateUrgencySignalsPageProperties } from '@/utils/dataLayer';\nimport type { BadgeInfo } from './badgeInfo';\nimport { badges } from './badges';\nimport type { Signal } from './signal';\nimport { UrgencySignalBadge } from './UrgencySignalBadge';\n\nconst MAX_VISIBLE_SIGNALS = 1;\n\ninterface Props {\n  eventId: string;\n}\n\nexport const UrgencySignals: React.FC<Props> = ({ eventId }) => {\n  const urgencySignals = useUrgencySignals(eventId);\n  const visibleBadges = getVisibleBadgesFrom(urgencySignals.slice(0, MAX_VISIBLE_SIGNALS));\n  return visibleBadges.map((badge) => <UrgencySignalBadge key={badge.signal} badge={badge} />);\n};\n\nfunction useUrgencySignals(eventId: string) {\n  const [urgencySignals, setUrgencySignals] = useState<Signal[]>([]);\n\n  useEffect(() => {\n    fetch(`/e/api/${eventId}/urgency-signals`)\n      .then(async (res) => {\n        if (!res.ok) {\n          setUrgencySignals([]);\n          updateUrgencySignalsPageProperties([]);\n          return;\n        }\n        const newSignals: string[] = await res.json();\n        setUrgencySignals(newSignals as Signal[]);\n        updateUrgencySignalsPageProperties(newSignals);\n      })\n      .catch(() => {\n        setUrgencySignals([]);\n        updateUrgencySignalsPageProperties([]);\n      });\n  }, [eventId]);\n\n  return urgencySignals;\n}\n\nfunction getVisibleBadgesFrom(urgencySignals: Signal[]): Array<BadgeInfo> {\n  const presentBadges = badges\n    .sort((a, b) => a.priority - b.priority)\n    .filter((badge) => urgencySignals.includes(badge.signal));\n\n  const messageBadge = presentBadges.filter((badge) => badge.type === 'message')[0];\n  const categoryBadges = presentBadges.filter((badge) => badge.type === 'category');\n\n  if (messageBadge) {\n    return [messageBadge, ...categoryBadges.slice(0, 1)];\n  }\n\n  return categoryBadges.slice(0, 2);\n}\n","import { useMediaQuery } from '../../../hooks/useMediaQuery';\n\nexport const useIsMobile = (): boolean => useMediaQuery('(max-width: 743px)');\n","import React, { useRef } from 'react';\nimport { ShareInline, ShareModal, type ShareEventProps } from '@eventbrite/legacy.social-share';\nimport { useIntl } from 'react-intl';\nimport { GenericLazyString } from '@eventbrite/legacy-infra.i18n';\nimport { useAppContext } from '@shared/Wrapper';\nimport { useIsMobile } from '@components/Agenda/_shared/useIsMobile';\nimport { AffiliateCodes, GACodes } from '@/components/_shared/constants';\nimport styles from './ShareButton.module.scss';\n\nconst LISTING_UTM_OPTIONS = {\n  'utm-campaign': 'social',\n  'utm-content': 'attendeeshare',\n  'utm-medium': 'discovery',\n  'utm-term': 'listing',\n};\n\nconst TWITTER_HANDLE = 'eventbritehelp';\n\nexport interface ShareButtonProps {\n  eventId: string;\n  eventName: string;\n  eventUrl: string;\n  isShareable?: boolean;\n}\n\nconst formatUrlWithUtm = (\n  url: string,\n  utmOptions: Record<string, string>,\n  additionalParams?: Record<string, string>,\n): string => {\n  try {\n    const urlObj = new URL(url);\n    const params = new URLSearchParams(urlObj.search);\n\n    // Add UTM parameters\n    Object.entries(utmOptions).forEach(([key, value]) => {\n      params.set(key, value);\n    });\n\n    if (additionalParams) {\n      Object.entries(additionalParams).forEach(([key, value]) => {\n        params.set(key, value);\n      });\n    }\n\n    urlObj.search = params.toString();\n    return urlObj.toString();\n  } catch {\n    // If URL parsing fails, return original URL\n    return url;\n  }\n};\n\nexport const ShareButton: React.FC<ShareButtonProps> = ({ eventId, eventName, eventUrl, isShareable = false }) => {\n  const {\n    data: { serverUrl, locale },\n  } = useAppContext();\n  const isMobile = useIsMobile();\n  const { formatMessage } = useIntl();\n  const modalContainer = useRef<HTMLDivElement>(null);\n\n  if (!isShareable) {\n    return null;\n  }\n\n  const facebookOptions = {\n    appId: '28218816837',\n    locale: locale.replace('-', '_'),\n    page: 'www.facebook.com/Eventbrite',\n    version: 'v12.0',\n    xfbml: true,\n  };\n\n  const shareEventProps: ShareEventProps = {\n    eventId,\n    eventName,\n    eventUrl,\n    facebookOptions,\n    serverUrl,\n    twitterHandle: TWITTER_HANDLE,\n    isMobile,\n    trackingCategory: GACodes.GA_CATEGORY_LISTING,\n    utmOptions: LISTING_UTM_OPTIONS,\n  };\n\n  const dataWebShareApi = {\n    text: eventName,\n    title: eventName,\n    url: formatUrlWithUtm(eventUrl, LISTING_UTM_OPTIONS, {\n      'utm-source': 'wsa',\n      aff: AffiliateCodes.AFF_SHARE_WEB_MOBILE,\n    }),\n  };\n\n  const shareUrl = formatUrlWithUtm(eventUrl, LISTING_UTM_OPTIONS, {\n    'utm-source': 'cp',\n    aff: AffiliateCodes.AFF_SHARE_COPY_URL,\n  });\n\n  const tooltipTitle = new GenericLazyString(() =>\n    formatMessage({ id: 'Share this event', defaultMessage: 'Share this event' }),\n  );\n  const tooltipText = new GenericLazyString(() => formatMessage({ id: 'Share Event', defaultMessage: 'Share Event' }));\n\n  return (\n    <div data-testid=\"share-button-container\">\n      <div ref={modalContainer} id=\"share-modal-wrapper\" />\n      <div className={styles.tooltipStackingContext}>\n        <ShareModal\n          dataWebShareApi={dataWebShareApi}\n          title={formatMessage({ id: 'Share with friends', defaultMessage: 'Share with friends' })}\n          inputLabel={formatMessage({ id: 'Event URL', defaultMessage: 'Event URL' })}\n          url={shareUrl}\n          tooltipTitle={tooltipTitle}\n          tooltipText={tooltipText}\n          trackingCategory={GACodes.GA_CATEGORY_LISTING}\n          isMobile={isMobile}\n          container={modalContainer}\n          useWebShareApi={true}\n          eventId={eventId}\n        >\n          <ShareInline {...shareEventProps} />\n        </ShareModal>\n      </div>\n    </div>\n  );\n};\n","export interface BookmarkEvent {\n  id: string;\n  name: {\n    text: string;\n    html: string;\n  };\n}\n\nexport interface BookmarksPagination {\n  object_count: number;\n  continuation: string | null;\n  page_count: number;\n  page_size: number;\n  has_more_items: boolean;\n  page_number: number;\n}\n\nexport interface BookmarksResponse {\n  pagination: BookmarksPagination;\n  events: BookmarkEvent[];\n}\n\nexport interface BookmarkStatus {\n  isLiked: boolean;\n  isAuthenticated: boolean;\n}\n\nexport const DEFAULT_BOOKMARK_STATUS: BookmarkStatus = {\n  isLiked: false,\n  isAuthenticated: false,\n};\n\nexport const LIKE_ACTION = 'save' as const;\nexport const UNLIKE_ACTION = 'unsave' as const;\n\nexport type BookmarkAction = typeof LIKE_ACTION | typeof UNLIKE_ACTION;\n","export interface SdkRequestError {\n  response?: {\n    status?: number;\n  };\n  parsedError?: {\n    error?: string;\n  };\n}\n\nexport const isUnauthorizedError = (error: unknown): boolean => {\n  const sdkError = error as SdkRequestError;\n\n  // Check HTTP status code (401 or 403)\n  const status = sdkError?.response?.status;\n  const isUnauthorizedStatus = status === 401 || status === 403;\n\n  // Check parsedError for NOT_AUTHORIZED or ACCESS_DENIED\n  const errorCode = sdkError?.parsedError?.error;\n  const isNotAuthorizedError = errorCode === 'NOT_AUTHORIZED' || errorCode === 'ACCESS_DENIED';\n\n  // Return true only if BOTH conditions are met\n  return isUnauthorizedStatus && isNotAuthorizedError;\n};\n","import React, { useState, useCallback } from 'react';\nimport { sdkRequest } from '@eventbrite/legacy-infra.http';\nimport { track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport { logEvent } from '@eventbrite/legacy-infra.statsig';\nimport { redirectToLoginWithCustomReferrer } from '@/utils/utils';\nimport { useStage } from '@/hooks/useStage';\nimport { stageFromString } from '@eventbrite/webapp-constants';\nimport { GACodes, LISTING_HEAP_IDS, STATSIG_EVENT_NAMES } from '@/components/_shared/constants';\nimport type { BookmarkAction } from '../types';\nimport { LIKE_ACTION, UNLIKE_ACTION } from '../types';\nimport { isUnauthorizedError } from './utils';\nimport { useToast } from '@/components/_shared/contexts/ToastContext';\nimport { EventLikedToast, ToastType } from '@/components/_shared/Toast';\n\nexport type BookmarkActionResponse = {\n  created?: boolean;\n  deleted?: boolean;\n};\n\nexport function trackBookmarkActionSuccess(response: BookmarkActionResponse, eventId: string): void {\n  if (response?.created === true) {\n    logEvent(STATSIG_EVENT_NAMES.LISTING_ALL_SUCCESS_LIKE_EVENT);\n    track({\n      eventName: LISTING_HEAP_IDS.LIKE_CLICK,\n      eventData: { eventId },\n    });\n  }\n  if (response?.deleted === true) {\n    track({\n      eventName: LISTING_HEAP_IDS.DISLIKE_EVENT_CLICK,\n      eventData: { eventId },\n    });\n  }\n}\n\nexport interface UseBookmarkActionsResult {\n  likeEvent: () => Promise<void>;\n  unlikeEvent: () => Promise<void>;\n  bookmarkActionLoading: boolean;\n}\n\nexport const useBookmarkActions = (\n  eventId: string,\n  setBookmarkStatus: React.Dispatch<React.SetStateAction<boolean>>,\n): UseBookmarkActionsResult => {\n  const [loading, setLoading] = useState(false);\n  const stage = useStage();\n  const { showToast } = useToast();\n\n  const redirectToLogin = useCallback(() => {\n    const stageValue = stageFromString(stage);\n    const referrerURL = new URL(window.location.href);\n    referrerURL.searchParams.set('bookmarkEvent', eventId);\n\n    const pathWithQuery = referrerURL.pathname + referrerURL.search;\n    redirectToLoginWithCustomReferrer(pathWithQuery, stageValue);\n  }, [eventId, stage]);\n\n  const updateBookmarkState = useCallback(\n    (isLiked: boolean) => {\n      setBookmarkStatus(isLiked);\n    },\n    [setBookmarkStatus],\n  );\n\n  const performBookmarkAction = useCallback(\n    async (action: BookmarkAction): Promise<void> => {\n      if (!eventId) {\n        console.error('useBookmarkActions: Event ID is required');\n        return;\n      }\n\n      const analyticsAction =\n        action === LIKE_ACTION ? GACodes.GA_ACTION_BOOKMARK_ADD : GACodes.GA_ACTION_BOOKMARK_REMOVE;\n      trackAnalyticsEvent({\n        action: analyticsAction,\n        category: GACodes.GA_CATEGORY_LISTING,\n      });\n\n      setLoading(true);\n\n      try {\n        const endpoint = `/api/v3/users/me/bookmarks/${action}/`;\n        const response = (await sdkRequest(\n          endpoint,\n          {\n            method: 'POST',\n            body: JSON.stringify({ event_id: eventId }),\n          },\n          process.env.NEXT_PUBLIC_PROXY_API_V3 ? '/e' : '',\n        )) as BookmarkActionResponse;\n\n        // Update the state based on the action\n        const newIsLiked = action === LIKE_ACTION;\n        updateBookmarkState(newIsLiked);\n\n        if (action === LIKE_ACTION && response?.created === true) {\n          showToast({\n            type: ToastType.INFO,\n            duration: 5000,\n            content: React.createElement(EventLikedToast),\n          });\n        }\n\n        trackBookmarkActionSuccess(response, eventId);\n      } catch (error) {\n        if (isUnauthorizedError(error)) {\n          // User is not authenticated, redirect to login\n          redirectToLogin();\n          return;\n        }\n\n        console.error(`useBookmarkActions: Error performing ${action} action`, error);\n      } finally {\n        setLoading(false);\n      }\n    },\n    [eventId, updateBookmarkState, redirectToLogin, showToast],\n  );\n\n  const likeEvent = useCallback(() => performBookmarkAction(LIKE_ACTION), [performBookmarkAction]);\n  const unlikeEvent = useCallback(() => performBookmarkAction(UNLIKE_ACTION), [performBookmarkAction]);\n\n  return {\n    likeEvent,\n    unlikeEvent,\n    bookmarkActionLoading: loading,\n  };\n};\n","export { useBookmarkActions } from './useBookmarkActions';\nexport type { UseBookmarkActionsResult } from './useBookmarkActions';\n","import { useEffect, useCallback, useState } from 'react';\nimport { HeartIcon, HeartFillIcon, IconButton } from '@eventbrite/marmalade';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { useIntl } from 'react-intl';\nimport { withTooltip } from '@eventbrite/legacy-eds.tooltip';\nimport { useUserData } from '@/hooks/useUserData';\nimport classNames from 'classnames';\nimport { useBookmarkActions } from './hooks';\nimport styles from './LikeEventButton.module.scss';\n\nconst IconButtonWithTooltip = withTooltip(IconButton);\n\nexport const LikeEventButton = () => {\n  const { id: eventId } = useBasicInfo();\n  const { formatMessage } = useIntl();\n  const { hasLikedEvent, isLoading: userDataLoading } = useUserData();\n  const [isLiked, setIsLiked] = useState(false);\n\n  useEffect(() => {\n    setIsLiked(hasLikedEvent);\n  }, [hasLikedEvent]);\n\n  const { likeEvent, unlikeEvent, bookmarkActionLoading } = useBookmarkActions(eventId, setIsLiked);\n  const isLoading = userDataLoading || bookmarkActionLoading;\n\n  // Handle post-login bookmark action\n  useEffect(() => {\n    const urlParams = new URLSearchParams(window?.location?.search);\n    const bookmarkEventId = urlParams.get('bookmarkEvent');\n\n    if (bookmarkEventId === eventId && !isLiked && !isLoading) {\n      // Remove the param from URL to prevent re-triggering\n      const newUrl = new URL(window.location.href);\n      newUrl.searchParams.delete('bookmarkEvent');\n      window.history.replaceState({}, '', newUrl