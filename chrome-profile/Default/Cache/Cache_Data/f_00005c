n text',\n});\n\nexport const DIRECT_AFF_CODE = 'oddtdtdirect';\n","import { BasicInfo } from '@/types';\nimport { createContext, useContext } from 'react';\n\nexport const BasicInfoContext = createContext<BasicInfo>({} as BasicInfo);\n\nexport const BasicInfoProvider = ({ children, basicInfo }: { children: React.ReactNode; basicInfo: BasicInfo }) => {\n  return <BasicInfoContext.Provider value={basicInfo}>{children}</BasicInfoContext.Provider>;\n};\n\nexport const useBasicInfo = () => {\n  return useContext(BasicInfoContext);\n};\n","import { getHighLevelStatus, HighLevelStatus } from '@/utils/highLevelStatus';\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\nimport React, { createContext, useContext, ReactNode } from 'react';\n\nexport type DisplayStatusContextType = {\n  salesStatusData?: WebappResponse['salesStatus'];\n  displayStatus: HighLevelStatus;\n};\n\nconst DisplayStatusContext = createContext<DisplayStatusContextType>({ displayStatus: HighLevelStatus.UNKNOWN });\n\ntype DisplayStatusProviderProps = {\n  children: ReactNode;\n  salesStatusData?: WebappResponse['salesStatus'];\n  eventStatus?: string;\n};\n\nexport const DisplayStatusProvider: React.FC<DisplayStatusProviderProps> = ({\n  children,\n  salesStatusData,\n  eventStatus,\n}) => {\n  return (\n    <DisplayStatusContext.Provider\n      value={{ salesStatusData, displayStatus: getHighLevelStatus(salesStatusData, eventStatus) }}\n    >\n      {children}\n    </DisplayStatusContext.Provider>\n  );\n};\n\nexport const useDisplayStatus = (): DisplayStatusContextType => {\n  const context = useContext(DisplayStatusContext);\n  if (context === undefined) {\n    throw new Error('useDisplayStatus must be used within a DisplayStatusProvider');\n  }\n  return context;\n};\n","import { sdkRequest } from '@eventbrite/legacy-infra.http';\nimport type { FollowStatus, FollowStatusApiResponse } from '@/components/OrganizerCard/types';\nimport {\n  DEFAULT_FOLLOW_STATUS_RESPONSE,\n  mapApiResponseToFollowStatus,\n} from '@/components/_shared/buttons/FollowButton/utils';\n\nexport const fetchOrganizerFollowStatusExpansion = async (organizerId: string | null): Promise<FollowStatus> => {\n  if (!organizerId) {\n    console.error('FollowButton: Organizer ID is missing');\n    return DEFAULT_FOLLOW_STATUS_RESPONSE;\n  }\n\n  const response: FollowStatusApiResponse = await sdkRequest(\n    `/organizers/${organizerId}/?expand.organizer=follow_status`,\n    undefined,\n    process.env.NEXT_PUBLIC_PROXY_API_V3 ? '/e' : '',\n  );\n\n  if (!response.follow_status) {\n    console.error('FollowButton: API response missing follow_status', {\n      organizerId,\n      response,\n    });\n    return DEFAULT_FOLLOW_STATUS_RESPONSE;\n  }\n\n  return mapApiResponseToFollowStatus(response.follow_status);\n};\n","import { Organizer } from '@/types';\nimport React, { createContext, useContext, useEffect, useState } from 'react';\nimport { fetchOrganizerFollowStatusExpansion } from './fetchers/fetchOrganizerFollowStatusExpansion';\n\nexport type FollowOrganizerContextType = {\n  isFollowing: boolean;\n  numFollowers: number;\n  loading: boolean;\n  updateFollowStatus: (isFollowing: boolean) => void;\n  updateNumFollowers: (numFollowers: number) => void;\n};\n\nexport const FollowOrganizerContext = createContext<FollowOrganizerContextType | null>(null);\n\nexport const OrganizerFollowStatusProvider: React.FC<{\n  children: React.ReactNode;\n  organizer: Organizer | null | undefined;\n}> = ({ children, organizer }) => {\n  const [isFollowing, setIsFollowing] = useState<boolean>(false);\n  const [numFollowers, setNumFollowers] = useState<number>(0);\n  const [loading, setLoading] = useState<boolean>(true);\n\n  useEffect(() => {\n    const fetchStatus = async () => {\n      if (!organizer?.id) {\n        setLoading(false);\n        return;\n      }\n\n      setLoading(true);\n      try {\n        const data = await fetchOrganizerFollowStatusExpansion(organizer.id);\n        setIsFollowing(data.followedByYou);\n        setNumFollowers(data.numFollowers);\n      } catch (error) {\n        console.error('Failed to fetch follow status:', error);\n      } finally {\n        setLoading(false);\n      }\n    };\n\n    fetchStatus();\n  }, [organizer?.id]);\n\n  const updateFollowStatus = (isFollowing: boolean) => {\n    setIsFollowing(isFollowing);\n  };\n\n  const updateNumFollowers = (numFollowers: number) => {\n    setNumFollowers(numFollowers);\n  };\n\n  const contextValue: FollowOrganizerContextType = {\n    isFollowing,\n    numFollowers,\n    loading,\n    updateFollowStatus,\n    updateNumFollowers,\n  };\n\n  return <FollowOrganizerContext.Provider value={contextValue}>{children}</FollowOrganizerContext.Provider>;\n};\n\nexport const useOrganizerFollowStatus = (): FollowOrganizerContextType => {\n  const context = useContext(FollowOrganizerContext);\n  if (!context) {\n    throw new Error('useOrganizerFollowStatus must be used within an OrganizerFollowStatusProvider');\n  }\n  return context;\n};\n","import { intlFormat } from 'date-fns';\nimport { useIntl } from 'react-intl';\n\nimport { BasicInfo } from '@/types';\n\nconst getLocation = (basicInfo: BasicInfo, venueName?: string): string | null => {\n  const city = basicInfo.venue?.address?.city;\n  const region = basicInfo.venue?.address?.region;\n  let location: string | null;\n\n  if (venueName && region) {\n    if (city) {\n      location = `${venueName}, ${city}, ${region}`;\n    } else {\n      location = `${venueName}, ${region}`;\n    }\n  } else if (venueName) {\n    location = `${venueName}`;\n  } else if (city && region) {\n    location = `${city}, ${region}`;\n  } else if (region) {\n    location = `${region}`;\n  } else {\n    location = null;\n  }\n  return location;\n};\n\nexport const useEventDescription = (basicInfo: BasicInfo | undefined, locale: string = 'en') => {\n  const { formatMessage } = useIntl();\n\n  if (!basicInfo) {\n    return formatMessage({ id: 'Eventbrite - Find event and ticket information.' });\n  }\n\n  const organizationName = basicInfo.organizer.name;\n  const venueName = basicInfo.isProtected ? '' : basicInfo.venue?.name;\n\n  const date = basicInfo.startDate.local\n    ? intlFormat(new Date(basicInfo.startDate.local), { dateStyle: 'full' }, { locale })\n    : '';\n\n  const location = getLocation(basicInfo, venueName);\n\n  let description: string;\n\n  // This function has a high cyclomatic complexity, but it cannot be easily refactored: to do so it should be split in many numerous hooks:\n  // formatMessage cannot be passed as a reference into lower level functions: otherwise the parser does not detect the translations.\n  // in and at must be translated and therefore must be in the main string.\n  // the reduced complexity does not warrant the refactoring into many smaller hooks, hence leaving it as is.\n  if (location && organizationName) {\n    if (!venueName) {\n      description = formatMessage(\n        {\n          id: 'Eventbrite - {organizationName} presents {eventName} - {date} in {location}. Find event and ticket information.',\n          defaultMessage:\n            'Eventbrite - {organizationName} presents {eventName} - {date} in {location}. Find event and ticket information.',\n          description:\n            \"Example string is 'Eventbrite - Tortuga Music Festival presents Tortuga Music Festival - Wednesday, December 25, 2013 in San Francisco, CA. Find event and registration information.\",\n        },\n        {\n          organizationName,\n          eventName: basicInfo.name,\n          date,\n          location,\n        },\n      );\n    } else {\n      description = formatMessage(\n        {\n          id: 'Eventbrite - {organizationName} presents {eventName} - {date} at {location}. Find event and ticket information.',\n          defaultMessage:\n            'Eventbrite - {organizationName} presents {eventName} - {date} at {location}. Find event and ticket information.',\n          description:\n            'Eventbrite - Tortuga Music Festival presents Tortuga Music Festival - Wednesday, December 25, 2013 at Venue, San Francisco, CA. Find event and registration information.',\n        },\n        {\n          organizationName,\n          eventName: basicInfo.name,\n          date,\n          location,\n        },\n      );\n    }\n  } else if (location) {\n    if (!venueName) {\n      description = formatMessage(\n        {\n          id: 'Eventbrite - {eventName} - {date} in {location}. Find event and ticket information.',\n          defaultMessage: 'Eventbrite - {eventName} - {date} in {location}. Find event and ticket information.',\n          description:\n            'Eventbrite - Tortuga Music Festival - Wednesday, December 25, 2013 in San Francisco, CA. Find event and registration information.',\n        },\n        {\n          eventName: basicInfo.name,\n          date,\n          location,\n        },\n      );\n    } else {\n      description = formatMessage(\n        {\n          id: 'Eventbrite - {eventName} - {date} at {location}. Find event and ticket information.',\n          defaultMessage: 'Eventbrite - {eventName} - {date} at {location}. Find event and ticket information.',\n          description:\n            'Eventbrite - Tortuga Music Festival - Wednesday, December 25, 2013 at Venue, San Francisco, CA. Find event and registration information.',\n        },\n        {\n          eventName: basicInfo.name,\n          date,\n          location,\n        },\n      );\n    }\n  } else if (organizationName) {\n    description = formatMessage(\n      {\n        id: 'Eventbrite - {organizationName} presents {eventName} - {date} - Find event and ticket information.',\n        defaultMessage:\n          'Eventbrite - {organizationName} presents {eventName} - {date} - Find event and ticket information.',\n        description:\n          \"Example string is 'Eventbrite - Tortuga Music Festival presents Tortuga Music Festival - Wednesday, December 25, 2013 - Find event and registration information.\",\n      },\n      {\n        organizationName,\n        eventName: basicInfo.name,\n        date,\n      },\n    );\n  } else {\n    description = formatMessage(\n      {\n        id: 'Eventbrite - {eventName} - {date} - Find event and ticket information.',\n        defaultMessage: 'Eventbrite - {eventName} - {date} - Find event and ticket information.',\n        description:\n          'Eventbrite - Tortuga Music Festival - Wednesday, December 25, 2013. Find event and registration information.',\n      },\n      {\n        eventName: basicInfo.name,\n        date,\n      },\n    );\n  }\n\n  return description;\n};\n","import { useIntl } from 'react-intl';\n\nimport { BasicInfo } from '@/types';\nimport { getAttendeeTimezone, getDisplayTimezone, getEventDateTimeDisplayString } from '@/utils/dateTime';\nimport { MULTIPLE_DATES } from '@/components/_shared/constants';\n\nexport const useEventTitle = (basicInfo: BasicInfo | undefined, locale: string = 'en') => {\n  const { formatMessage } = useIntl();\n\n  if (!basicInfo) {\n    return 'Eventbrite';\n  }\n  const { name, venue, startDate, endDate, hideStartDate, hideEndDate, isOnline, isSeries } = basicInfo;\n\n  const eventCity = venue?.address?.city ? `, ${venue.address.city}` : '';\n\n  let dateTimeCity = eventCity;\n  if (startDate?.utc) {\n    const attendeeTimezone = getAttendeeTimezone();\n    const timezone = getDisplayTimezone({\n      isOnlineEvent: isOnline ?? false,\n      eventTimezone: startDate.timezone,\n      attendeeTimezone,\n    });\n    const displayString = getEventDateTimeDisplayString({\n      startDate,\n      endDate: endDate ?? { utc: null, timezone: null },\n      hideStartDate: hideStartDate ?? false,\n      hideEndDate: hideEndDate ?? false,\n      locale,\n      timezone,\n      formatMessage,\n      isRecurringEvent: isSeries ?? false,\n      recurringEventLabel: isSeries ? formatMessage(MULTIPLE_DATES) : undefined,\n      showTimezone: isOnline ?? false,\n    });\n    if (displayString) {\n      dateTimeCity = `, ${displayString}`;\n    }\n  }\n\n  const ticketHeader = formatMessage({ id: 'Tickets' });\n\n  const title = `${name} ${ticketHeader}${dateTimeCity} | Eventbrite`;\n\n  return title;\n};\n","export { useEventTitle } from './useEventTitle';\n","import { intlFormat } from 'date-fns';\nimport { useIntl } from 'react-intl';\n\nexport const useFormattedDateTimeInLocale = (date?: string, locale: string = 'en'): string | null => {\n  const { formatMessage } = useIntl();\n  if (!date) {\n    return null;\n  }\n  const dateObj = new Date(date);\n  if (isNaN(dateObj.getTime())) {\n    return null;\n  }\n\n  const formattedDate = intlFormat(\n    dateObj,\n    {\n      month: 'short',\n      day: 'numeric',\n      year: 'numeric',\n      weekday: 'short',\n    },\n    { locale },\n  );\n  const formattedTime = intlFormat(dateObj, { timeStyle: 'short' }, { locale });\n\n  const formattedDateTime = formatMessage(\n    {\n      id: '{date} at {time}',\n      defaultMessage: '{date} at {time}',\n      description: 'Example string is Tue, Nov 18, 2025 at 8:00 PM',\n    },\n    {\n      date: formattedDate,\n      time: formattedTime,\n    },\n  );\n\n  return formattedDateTime;\n};\n","import { useRef, useEffect, useCallback } from 'react';\n\nconst DRAG_THRESHOLD = 5;\n\ninterface UseSimpleDragToCloseOptions {\n  onClose: () => void;\n}\n\nconst isValidDragTarget = (target: Element): boolean => {\n  const modal = target.closest('[class*=\"modalContainer\"]');\n  const headerElement = target.closest('header');\n  return !!(modal && headerElement);\n};\n\nexport const useSimpleDragToClose = ({ onClose }: UseSimpleDragToCloseOptions) => {\n  const startY = useRef(0);\n  const isDragging = useRef(false);\n\n  const handleTouchStart = useCallback((e: TouchEvent) => {\n    const target = e.target as Element;\n\n    if (!isValidDragTarget(target)) return;\n\n    startY.current = e.touches[0].clientY;\n    isDragging.current = true;\n  }, []);\n\n  const handleTouchMove = useCallback((e: TouchEvent) => {\n    if (!isDragging.current) return;\n\n    const currentY = e.touches[0].clientY;\n    const deltaY = currentY - startY.current;\n\n    if (deltaY >= DRAG_THRESHOLD) {\n      e.preventDefault();\n    }\n  }, []);\n\n  const handleTouchEnd = useCallback(\n    (e: TouchEvent) => {\n      if (!isDragging.current) return;\n\n      const endY = e.changedTouches[0].clientY;\n      const deltaY = endY - startY.current;\n\n      isDragging.current = false;\n\n      if (deltaY >= DRAG_THRESHOLD) {\n        onClose();\n      }\n    },\n    [onClose],\n  );\n\n  useEffect(() => {\n    document.addEventListener('touchstart', handleTouchStart, { passive: true });\n    document.addEventListener('touchmove', handleTouchMove, { passive: false });\n    document.addEventListener('touchend', handleTouchEnd, { passive: true });\n\n    return () => {\n      document.removeEventListener('touchstart', handleTouchStart);\n      document.removeEventListener('touchmove', handleTouchMove);\n      document.removeEventListener('touchend', handleTouchEnd);\n    };\n  }, [handleTouchStart, handleTouchMove, handleTouchEnd]);\n};\n","export { useSimpleDragToClose } from './useSimpleDragToClose';\n","export { useAttendeeTimezone } from './useAttendeeTimezone';\nexport { useComponentVisibility, useComponentVisibilityWithTracking } from './useComponentVisibility';\nexport type { ComponentTrackingConfig, ComponentVisibilityOptions } from './useComponentVisibility';\nexport { useEventDescription } from './useEventDescription';\nexport { useEventTitle } from './useEventTitle';\nexport { useFormattedDateTimeInLocale } from './useFormattedDateTimeInLocale';\nexport { useMediaQuery } from './useMediaQuery';\nexport { useSimpleDragToClose } from './useSimpleDragToClose';\nexport { useIsClient } from './useIsClient';\n","import { useState, useEffect } from 'react';\nimport { getAttendeeTimezone } from '@/utils/dateTime';\n\n/**\n * Hook to get the attendee's timezone from the browser.\n *\n * Uses useEffect to avoid hydration mismatches since\n * Intl.DateTimeFormat is a browser API that returns different\n * values on server vs client.\n *\n * @param enabled - Whether to resolve the timezone (typically true for online events)\n * @returns The attendee's IANA timezone string, or undefined if not yet resolved or disabled\n */\nexport const useAttendeeTimezone = (enabled: boolean): string | undefined => {\n  const [timezone, setTimezone] = useState<string | undefined>(undefined);\n\n  useEffect(() => {\n    if (!enabled) {\n      return;\n    }\n    setTimezone(getAttendeeTimezone());\n  }, [enabled]);\n\n  return timezone;\n};\n","export { useAttendeeTimezone } from './useAttendeeTimezone';\n","import { useEffect, useRef, useCallback, useState } from 'react';\nimport { ComponentTrackingConfig } from './types';\nimport { logEvent } from '@eventbrite/legacy-infra.statsig';\nimport { track } from '@eventbrite/legacy-infra.datalayer-library';\n\nexport const DEFAULT_INTERSECTION_OPTIONS: IntersectionObserverInit = {\n  root: null,\n  threshold: 0, // Trigger as soon as any part is visible for fastest response\n  rootMargin: '0px 0px -150px 0px', // 150px above the conversion bar\n};\n\n/**\n * Pure visibility hook - detects when a component becomes visible using Intersection Observer\n *\n * @param callback - Function to call when component becomes visible\n * @param options - Intersection Observer options\n * @returns Ref to attach to the DOM element\n */\nexport const useComponentVisibility = (\n  callback: () => void,\n  options: IntersectionObserverInit = DEFAULT_INTERSECTION_OPTIONS,\n) => {\n  const elementRef = useRef<HTMLDivElement>(null);\n  // hasBeenVisible is used to execute the callback only once\n  const [hasBeenVisible, setHasBeenVisible] = useState(false);\n\n  const memoizedCallback = useCallback(callback, [callback]);\n\n  useEffect(() => {\n    if (typeof IntersectionObserver === 'undefined') {\n      return;\n    }\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry.isIntersecting && !hasBeenVisible) {\n        memoizedCallback();\n        setHasBeenVisible(true);\n      }\n    }, options);\n\n    const element = elementRef.current;\n\n    if (element) {\n      observer.observe(element);\n    }\n\n    return () => {\n      if (element) {\n        observer.unobserve(element);\n      }\n    };\n  }, [memoizedCallback, hasBeenVisible, options]);\n\n  return elementRef;\n};\n\n/**\n * Enhanced visibility hook with tracking capabilities\n *\n * @param callback - Function to call when component becomes visible\n * @param trackingConfig - Optional tracking configuration for Heap/Statsig\n * @returns Ref to attach to the DOM element\n */\nexport const useComponentVisibilityWithTracking = (callback?: () => void, trackingConfig?: ComponentTrackingConfig) => {\n  const memoizedCallback = useCallback(() => {\n    callback?.();\n\n    if (trackingConfig) {\n      dispatchTrackingEvents(trackingConfig);\n    }\n  }, [callback, trackingConfig]);\n\n  const options = trackingConfig?.intersectionOptions || DEFAULT_INTERSECTION_OPTIONS;\n\n  return useComponentVisibility(memoizedCallback, options);\n};\n\nexport const dispatchTrackingEvents = (config: ComponentTrackingConfig) => {\n  if (config.heap) {\n    track({\n      eventName: config.heap.eventName,\n      eventData: {\n        eventBucketLabel: config.heap.eventBucketLabel,\n      },\n    });\n  }\n\n  if (config.statsig) {\n    logEvent(config.statsig.eventName, null, config.statsig.params || null);\n  }\n};\n","export { useComponentVisibility, useComponentVisibilityWithTracking } from './useComponentVisibility';\nexport type { ComponentTrackingConfig, ComponentVisibilityOptions } from './types';\n","import { useEffect, useState } from 'react';\n\n/**\n * Hook to check if the client is mounted\n * @returns boolean ind