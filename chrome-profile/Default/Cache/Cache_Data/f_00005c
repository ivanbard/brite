ferrer\"\n      aria-label={ariaLabel}\n      data-heap-id={heapId}\n      onClick={() => {\n        trackAnalyticsEvent({\n          category: GACodes.GA_CATEGORY_LISTING,\n          action: GACodes.GA_ACTION_DIRECTIONS,\n          label: label,\n        });\n      }}\n    >\n      {children}\n    </a>\n  );\n};\n","import React from 'react';\nimport { Auto, Biking, Bus, Walking } from './icons';\nimport { defineMessage, FormattedMessage, MessageDescriptor } from 'react-intl';\nimport { Typography } from '@eventbrite/marmalade';\nimport { GACodes } from '@/components/_shared/constants';\nimport { LISTING_HEAP_IDS } from '@/components/_shared/constants';\nimport { TravelModeLink } from './TravelModeLink';\nimport { useIntl } from 'react-intl';\nimport styles from './HowToGetThere.module.scss';\nimport { Icon } from '@eventbrite/marmalade';\n\ninterface Props {\n  location: { latitude: number; longitude: number };\n}\n\nexport const HowToGetThere: React.FC<Props> = ({ location }) => {\n  const { formatMessage } = useIntl();\n\n  return (\n    <div className={styles.directions}>\n      <div className={styles.title}>\n        <Typography as=\"h4\">\n          <FormattedMessage id=\"How do you want to get there?\" />\n        </Typography>\n      </div>\n      <ul className={styles.list}>\n        {TRAVEL_MODE_LINKS.map((link) => (\n          <li key={link.mode}>\n            <TravelModeLink\n              queryParams={link.queryParams}\n              label={link.label}\n              heapId={link.heapId}\n              location={location}\n              ariaLabel={formatMessage(link.ariaLabel)}\n            >\n              <Icon size=\"small\" className={styles.icon}>\n                {link.icon}\n              </Icon>\n              <Typography as=\"span\" className={styles.text}>\n                {formatMessage(link.text)}\n              </Typography>\n            </TravelModeLink>\n          </li>\n        ))}\n      </ul>\n    </div>\n  );\n};\n\nconst TRAVEL_MODE_LINKS: {\n  mode: string;\n  queryParams: Record<string, string>;\n  label: string;\n  heapId: string;\n  ariaLabel: MessageDescriptor;\n  icon: React.ReactElement;\n  text: MessageDescriptor;\n}[] = [\n  {\n    mode: 'driving',\n    queryParams: { mode: 'driving' },\n    label: GACodes.GA_LABEL_DRIVE,\n    heapId: LISTING_HEAP_IDS.MAP_DRIVE,\n    ariaLabel: defineMessage({ id: 'Driving directions', defaultMessage: 'Driving directions' }),\n    icon: <Auto />,\n    text: defineMessage({ id: 'Driving', defaultMessage: 'Driving' }),\n  },\n  {\n    mode: 'transit',\n    queryParams: { mode: 'transit', dirflg: 'r' },\n    label: GACodes.GA_LABEL_BUS,\n    heapId: LISTING_HEAP_IDS.MAP_BUS,\n    ariaLabel: defineMessage({ id: 'Transit directions', defaultMessage: 'Transit directions' }),\n    icon: <Bus />,\n    text: defineMessage({ id: 'Public transport', defaultMessage: 'Public transport' }),\n  },\n  {\n    mode: 'bicycling',\n    queryParams: { mode: 'bicycling', dirflg: 'b' },\n    label: GACodes.GA_LABEL_BIKE,\n    heapId: LISTING_HEAP_IDS.MAP_BIKE,\n    ariaLabel: defineMessage({ id: 'Cycling directions', defaultMessage: 'Cycling directions' }),\n    icon: <Biking />,\n    text: defineMessage({ id: 'Biking', defaultMessage: 'Biking' }),\n  },\n  {\n    mode: 'walking',\n    queryParams: { mode: 'walking', dirflg: 'w' },\n    label: GACodes.GA_LABEL_WALK,\n    heapId: LISTING_HEAP_IDS.MAP_WALK,\n    ariaLabel: defineMessage({ id: 'Walking directions', defaultMessage: 'Walking directions' }),\n    icon: <Walking />,\n    text: defineMessage({\n      id: 'Walking',\n      defaultMessage: 'Walking',\n      description: 'Transportation mode label for walking directions',\n    }),\n  },\n];\n","import React from 'react';\nimport { Typography } from '@eventbrite/marmalade';\nimport styles from './Address.module.scss';\n\ninterface Props {\n  venueMultilineAddress?: string[];\n  venueName?: string;\n}\n\nexport const Address: React.FC<Props> = ({ venueMultilineAddress, venueName }) => {\n  const [firstAddressLine, ...restAddressLines] = venueMultilineAddress || [];\n  const restOfAddress = restAddressLines?.join(' ');\n\n  return (\n    <address className={styles.address}>\n      {venueName && (\n        <Typography as=\"h3\" className={styles.name}>\n          {venueName}\n        </Typography>\n      )}\n      <div>\n        {firstAddressLine && (\n          <Typography as=\"p\" className={styles.description}>\n            {firstAddressLine}\n          </Typography>\n        )}\n        {restOfAddress && (\n          <Typography as=\"p\" className={styles.description}>\n            {restOfAddress}\n          </Typography>\n        )}\n      </div>\n    </address>\n  );\n};\n","import React from 'react';\nimport { Map } from './Map/Map';\nimport { HowToGetThere } from './HowToGetThere/HowToGetThere';\nimport styles from './InPersonLocation.module.scss';\nimport { Address } from './Address/Address';\nimport { Divider } from '@eventbrite/marmalade';\nimport { FormattedMessage } from 'react-intl';\n\ninterface Props {\n  venueMultilineAddress?: string[];\n  venueName?: string;\n  location: {\n    latitude: number;\n    longitude: number;\n  };\n  hasMap?: boolean;\n  gMapsApiKey: string;\n}\n\nexport const InPersonLocation: React.FC<Props> = (props) => {\n  return (\n    <div className={styles.inPersonEventLocation}>\n      <div className={styles.address}>\n        <Address venueMultilineAddress={props.venueMultilineAddress} venueName={props.venueName} />\n      </div>\n      <Divider className={styles.divider} placeholder={<FormattedMessage id=\"How do you want to get there?\" />} />\n      <div className={styles.howToGetThere}>\n        <HowToGetThere location={props.location} />\n      </div>\n      <div className={styles.map}>\n        {props.hasMap && <Map location={props.location} gMapsApiKey={props.gMapsApiKey} />}\n      </div>\n    </div>\n  );\n};\n","import { Typography } from '@eventbrite/marmalade';\nimport { FormattedMessage } from 'react-intl';\nimport styles from './OnlineLocation.module.scss';\nimport { LISTING_HEAP_IDS } from '@/components/_shared/constants';\nimport { OnlineLinkIcon } from '@/components/_shared/Icons';\n\ninterface Props {\n  onlineEventUrl?: string;\n}\n\nexport const OnlineLocation: React.FC<Props> = ({ onlineEventUrl }) => {\n  return (\n    <div className={styles.onlineLocation}>\n      <Typography as=\"h4\" className={styles.text}>\n        <FormattedMessage\n          id=\"Online event\"\n          defaultMessage=\"Online event\"\n          description=\"Label for online event location\"\n        />\n      </Typography>\n      {onlineEventUrl && (\n        <a\n          className={styles.link}\n          href={onlineEventUrl}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          data-heap-id={LISTING_HEAP_IDS.ONLINE_EVENT_ACCESS_BUTTON}\n        >\n          <OnlineLinkIcon className={styles.onlineLinkIcon} />\n          <FormattedMessage id=\"Access link\" />\n        </a>\n      )}\n    </div>\n  );\n};\n","import { Typography } from '@eventbrite/marmalade';\nimport { FormattedMessage } from 'react-intl';\nimport styles from './ToBeAnnouncedLocation.module.scss';\n\nexport const ToBeAnnouncedLocation: React.FC = () => {\n  return (\n    <div className={styles.toBeAnnouncedLocation}>\n      <Typography as=\"p\" className={styles.text}>\n        <FormattedMessage\n          id=\"To be announced\"\n          defaultMessage=\"To be announced\"\n          description=\"Location to be announced text\"\n        />\n      </Typography>\n    </div>\n  );\n};\n","import React from 'react';\nimport { InPersonLocation } from './InPersonLocation/InPersonLocation';\nimport { FormattedMessage } from 'react-intl';\nimport { Typography } from '@eventbrite/marmalade';\nimport styles from './Location.module.scss';\nimport { OnlineLocation } from './OnlineLocation/OnlineLocation';\nimport { ToBeAnnouncedLocation } from './ToBeAnnouncedLocation/ToBeAnnouncedLocation';\n\nexport interface Props {\n  location: {\n    hasAddress: boolean;\n    isOnlineEvent?: boolean;\n    venueMultilineAddress: string[];\n    venueName?: string;\n    onlineEventUrl?: string;\n  };\n  map: {\n    location: {\n      latitude: number;\n      longitude: number;\n    };\n    gMapsApiKey: string;\n    shouldDisplayMap: boolean;\n  };\n}\n\nexport const Location: React.FC<Props> = ({ location, map }) => {\n  if (location.isOnlineEvent) {\n    return (\n      <LocationLayout>\n        <OnlineLocation onlineEventUrl={location.onlineEventUrl} />\n      </LocationLayout>\n    );\n  }\n\n  if (!location.hasAddress) {\n    return (\n      <LocationLayout>\n        <ToBeAnnouncedLocation />\n      </LocationLayout>\n    );\n  }\n\n  return (\n    <LocationLayout>\n      <InPersonLocation\n        venueMultilineAddress={location.venueMultilineAddress}\n        venueName={location.venueName}\n        location={map.location}\n        hasMap={map.shouldDisplayMap}\n        gMapsApiKey={map.gMapsApiKey}\n      />\n    </LocationLayout>\n  );\n};\n\nconst LocationLayout: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  return (\n    <div className={styles.location} id=\"location\">\n      <Typography as=\"h3\" variant=\"heading-sm\" className={styles.title}>\n        <FormattedMessage id=\"Location\" />\n      </Typography>\n      {children}\n    </div>\n  );\n};\n","import { BasicInfo } from '@/types';\n\nexport function getLocationInfoFrom(basicInfo: BasicInfo, apiKey: string) {\n  const latitude = Number(basicInfo.venue?.address?.latitude);\n  const longitude = Number(basicInfo.venue?.address?.longitude);\n\n  return {\n    location: {\n      venueMultilineAddress: basicInfo.venue?.address?.localizedMultiLineAddressDisplay || [],\n      hasAddress: basicInfo.venue?.address !== undefined && basicInfo.venue?.address !== null,\n      venueName: basicInfo.venue?.name,\n      isOnlineEvent: basicInfo.isOnline || false,\n      onlineEventUrl: undefined, // TODO: Add online event url\n    },\n    map: {\n      location: {\n        latitude,\n        longitude,\n      },\n      gMapsApiKey: apiKey,\n      shouldDisplayMap: hasValidCoordinates(basicInfo),\n    },\n  };\n}\n\nfunction hasValidCoordinates(basicInfo: BasicInfo) {\n  const latitude = Number(basicInfo.venue?.address?.latitude);\n  const longitude = Number(basicInfo.venue?.address?.longitude);\n\n  const hasCoordinates = !!basicInfo.venue?.address?.longitude && !!basicInfo.venue?.address?.latitude;\n  if (!hasCoordinates) {\n    return false;\n  }\n\n  const areFiniteNumbers = Number.isFinite(latitude) && Number.isFinite(longitude);\n  const hasValidLatitude = latitude >= -90 && latitude <= 90;\n  const hasValidLongitude = longitude >= -180 && longitude <= 180;\n\n  return areFiniteNumbers && hasValidLatitude && hasValidLongitude;\n}\n","import { GACodes, LISTING_HEAP_IDS } from '@/components/_shared/constants';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { useMemo } from 'react';\nimport { FormattedMessage } from 'react-intl';\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport styles from './CreatorBanner.module.scss';\n\nconst getEditEventUrl = (id: string, isParentEvent: boolean, isSeries?: boolean, seriesId?: string) => {\n  // For series child events, link to the parent event's manage page\n  const eventId = isSeries && !isParentEvent && seriesId ? seriesId : id;\n  return `/manage/events/${eventId}/details`;\n};\n\nexport const CreatorBanner = () => {\n  const { id, isSeries, isParentEvent, seriesId } = useBasicInfo();\n\n  const editEventUrl = useMemo(\n    () => getEditEventUrl(id, isParentEvent, isSeries, seriesId),\n    [id, isParentEvent, isSeries, seriesId],\n  );\n\n  const handleEditClick = () => {\n    trackAnalyticsEvent({\n      category: GACodes.GA_CATEGORY_LISTING,\n      action: GACodes.GA_ACTION_EDIT_EVENT,\n    });\n  };\n\n  return (\n    <>\n      <p className={styles.prompt}>\n        <FormattedMessage\n          id=\"Need to make some updates?\"\n          defaultMessage=\"Need to make some updates?\"\n          description=\"Creator banner prompt text shown to event organizers\"\n        />\n      </p>\n      <a\n        href={editEventUrl}\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        onClick={handleEditClick}\n        data-heap-id={LISTING_HEAP_IDS.CREATOR_TOP_BANNER_EDIT}\n        className={styles.editLink}\n      >\n        <FormattedMessage\n          id=\"Edit event\"\n          defaultMessage=\"Edit event\"\n          description=\"Creator banner link text to edit the event\"\n        />\n      </a>\n    </>\n  );\n};\n","import { FormattedMessage } from 'react-intl';\nimport { IconButton } from '@eventbrite/marmalade';\nimport { Cross as CrossIcon } from '@/components/_shared/Icons';\n\ninterface WaitingRoomBannerProps {\n  onCloseClick: () => void;\n}\n\nexport const WaitingRoomBanner = ({ onCloseClick }: WaitingRoomBannerProps) => {\n  return (\n    <>\n      <p>\n        <FormattedMessage\n          id=\"Tickets are in high demand. You might be placed in a queue\"\n          defaultMessage=\"Tickets are in high demand. You might be placed in a queue\"\n          description=\"Waiting room banner prompt text shown when waiting room is activated\"\n        />\n      </p>\n      <IconButton icon={<CrossIcon viewBox=\"0 0 25 25\" />} aria-label=\"Close\" onClick={onCloseClick} />\n    </>\n  );\n};\n","export { CreatorBanner } from './CreatorBanner/CreatorBanner';\nexport { WaitingRoomBanner } from './WaitingRoomBanner/WaitingRoomBanner';\n","import { useEffect, useMemo, useState } from 'react';\nimport { getPrivateOrganizationId } from '@/utils/utils';\n\n// Note: The response has more fields, but we only need the activated field.\n// Source: https://github.com/eventbrite/core/blob/master/django/src/www/eventbrite/ebapps/queue/client.py#L225\nexport interface WaitingRoomStatusResponse {\n  activated: boolean;\n}\n\ninterface UseWaitingRoomStatusProps {\n  organizationId: string;\n}\n\ninterface UseWaitingRoomStatusReturn {\n  waitingRoomStatus: WaitingRoomStatusResponse | null;\n  isLoading: boolean;\n}\n\nfunction isWaitingRoomStatusResponse(value: unknown): value is WaitingRoomStatusResponse {\n  return (\n    typeof value === 'object' &&\n    value !== null &&\n    'activated' in value &&\n    typeof (value as WaitingRoomStatusResponse).activated === 'boolean'\n  );\n}\n\n/**\n * Fetches waiting room status for an organization.\n * Returns null on any failure: network error, non-ok response, invalid JSON, or invalid shape.\n * Low priority: callers should treat null as \"feature unavailable\" and never block the UI.\n * @internal Exported for testing.\n */\nexport const getWaitingRoomStatus = async (\n  privateOrganizationId: string,\n  signal?: AbortSignal,\n): Promise<WaitingRoomStatusResponse | null> => {\n  try {\n    const response = await fetch(`/queue_rpc/status/${privateOrganizationId}`, { signal });\n    if (!response.ok) {\n      return null;\n    }\n    const body: unknown = await response.json();\n    if (!isWaitingRoomStatusResponse(body)) {\n      return null;\n    }\n    return body;\n  } catch {\n    return null;\n  }\n};\n\n/**\n * Gets the waiting room status for an organization.\n * @param organizationId - The ID of the organization to get the waiting room status for.\n * @returns The waiting room status for the organization and a boolean indicating if the status call is loading.\n */\nexport const useWaitingRoomStatus = ({ organizationId }: UseWaitingRoomStatusProps): UseWaitingRoomStatusReturn => {\n  const [waitingRoomStatus, setWaitingRoomStatus] = useState<WaitingRoomStatusResponse | null>(null);\n  const [isLoading, setIsLoading] = useState(false);\n\n  const privateOrganizationId = useMemo(() => getPrivateOrganizationId(organizationId), [organizationId]);\n\n  useEffect(() => {\n    if (!organizationId || !privateOrganizationId) {\n      setWaitingRoomStatus(null);\n      setIsLoading(false);\n      return;\n    }\n\n    setIsLoading(true);\n    const controller = new AbortController();\n\n    getWaitingRoomStatus(privateOrganizationId, controller.signal)\n      .then((status) => {\n        if (status !== null) {\n          setWaitingRoomStatus(status);\n        }\n      })\n      .catch((error: Error) => {\n        if (error.name !== 'AbortError') {\n          setWaitingRoomStatus(null);\n        }\n      })\n      .finally(() => {\n        setIsLoading(false);\n      });\n\n    return () => {\n      controller.abort();\n    };\n  }, [organizationId, privateOrganizationId]);\n\n  return { waitingRoomStatus, isLoading };\n};\n","export { useWaitingRoomStatus } from './useWaitingRoomStatus';\n","import styles from './NotificationBanner.module.scss';\nimport { useBasicInfo } from '../_shared/contexts/BasicInfoContext';\nimport { useUserData } from '@/hooks/useUserData';\nimport { WaitingRoomBanner, CreatorBanner } from './notificationBannerUseCases';\nimport { useWaitingRoomStatus } from '@/hooks/useWaitingRoomStatus';\nimport { useState } from 'react';\n\nexport const NotificationBanner: React.FC = () => {\n  const [isBannerVisible, setIsBannerVisible] = useState(true);\n  const { organizationId } = useBasicInfo();\n  const { canManageEvent, isLoading: isUserDataLoading } = useUserData();\n  const { waitingRoomStatus, isLoading: isWaitingRoomStatusLoading } = useWaitingRoomStatus({\n    organizationId: organizationId ?? '',\n  });\n  const isLoading = isUserDataLoading || isWaitingRoomStatusLoading;\n\n  const closeBanner = () => {\n    setIsBannerVisible(false);\n  };\n\n  const eligibleBanners = [\n    canManageEvent && <CreatorBanner />,\n    waitingRoomStatus?.activated && <WaitingRoomBanner onCloseClick={closeBanner} />,\n  ].filter(Boolean);\n\n  if (isLoading || eligibleBanners.length === 0 || !isBannerVisible) return null;\n\n  return (\n    <div className={styles.wrapper} role=\"status\">\n      <div className={styles.banner} data-name=\"notification-banner\">\n        <div className={styles.content}>{eligibleBanners.length > 0 ? eligibleBanners[0] : null}</div>\n      </div>\n    </div>\n  );\n};\n","export { NotificationBanner } from './NotificationBanner';\n","import { useToast } from '@/components/_shared/contexts/ToastContext';\nimport { Toast } from '@/components/_shared/Toast/Toast';\nimport styles from './ConverstionBarWrapper.module.scss';\n\ninterface ConversionBarWrapperProps {\n  children: React.ReactNode;\n}\n\nexport const ConversionBarWrapper: React.FC<ConversionBarWrapperProps> = ({ children }) => {\n  const { shouldShowToast } = useToast();\n\n  return (\n    <div className={styles.conversionBarWrapper}>\n      {children}\n      {shouldShowToast && <Toast position=\"belowConversionBar\" />}\n    </div>\n  );\n};\n","import React, { useRef } from 'react';\n\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\n\nimport { ArtistsInfo, type ArtistInfo } from '@components/ArtistsInfo/ArtistsInfo';\nimport { GoodToKnow } from '@/components/GoodToKnow/GoodToKnow';\nimport { ConversionBar } from '@components/ConversionBar';\nimport { EventDetails } from '@/components/EventDetails';\nimport { EventFAQs } from '@components/EventFAQs';\nimport { EventHero } from '@components/EventHero';\nimport { EventTags } from '@components/EventTags';\nimport { Footer } from '@components/Footer';\nimport { OrganizerCard } from '@components/OrganizerCard';\nimport { Overview } from '@/components/Overview';\nimport { RelatedEvents } from '@components/RelatedEvents';\nimport { MoreOrganizerEvents } from '@components/MoreOrganizerEvents';\nimport { ReportThisEventButton, type ReportThisEventButtonRef } from '@components/ReportThisEventButton';\nimport { EventSignalsBar } from '@/components/EventSignalsBar/EventSignalsBar';\nimport { Agenda } from '@/components/Agenda/Agenda';\nimport { Tab } from '@/components/Agenda/Content/Tab';\n\nimport { ViewDetailsButton } from '@shared/buttons/ViewDetailsButton/ViewDetailsButton';\nimport { Layout, Main } from '@shared/Layout/Layout';\nimport { SectionWrapper } from '@shared/SectionWrapper';\nimport { useAppContext } from '@shared/Wrapper';\n\nimport type { BasicInfo, Gallery, Tags, StructuredContent } from '@/types';\n\nimport { useBodyRendering, useEndedEventDetailsVisibility, useTrackingPixels } from './hooks';\nimport { isEventEnded, getCarouselItems, getEventSlugFromBasicInfo } from './utils/bodyUtils';\n\nimport styles from './Body.module.scss';\n\nimport { Location } from '@/components/Location/Location';\nimport { useUserData } from '@/hooks/useUserData';\nimport { getLocationInfoFrom } from './utils/getLocationInfoFrom';\nimport { DisplayStatusProvider } from '@/components/_shared/contexts/DisplayStatusContext';\nimport { Stage } from '@eventbrite/webapp-constants';\nimport { NotificationBanner } from '../NotificationBanner';\nimport { OrganizerFollowStatusProvider } from '../_shared/contexts/FollowOrganizerContext';\nimport { ToastProvider } from '@/components/_shared/contexts/ToastContext';\nimport { ConversionBarWrapper } from '../ConversionBar/ConversionBarWrapper/ConversionBarWrapper';\n\ninterface BodyProps {\n  basicInfo: BasicInfo;\n  gallery: Gallery;\n  collections: WebappResponse['collections'];\n  tags?: Tags;\n  structuredContent?: StructuredContent;\n  artistInfo?: ArtistInfo;\n  agendaInfo?: { tabs?: Tab[] };\n  googleMapsApiKey: string;\n  presenterInfo: WebappResponse['presenterInfo'];\n  salesStatus?: WebappResponse['salesStatus'];\n  stage: Stage;\n  goodToKnow: WebappResponse['goodToKnow'];\n}\n\nexport const Body: React.FC<BodyProps> = ({\n  basicInfo,\n  collections,\n  gallery,\n  tags,\n  structuredContent,\n  agendaInfo,\n  artistInfo,\n  googleMapsApiKey,\n  presenterInfo,\n  salesStatus,\n  goodToKnow,\n  stage,\n}) => {\n  const reportButtonRef = useRef<ReportThisEvent