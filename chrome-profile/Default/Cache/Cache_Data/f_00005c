w URL(formattedData.url);\n      parsedUrl.searchParams.set('aff', affiliateCode);\n      window.open(parsedUrl.toString(), '_blank');\n    } else {\n      window.open(formattedData.url, '_blank');\n    }\n  }, [formattedData?.url, affiliateCode, relatedEvent?.id, relatedEvent?.name]);\n\n  // Early returns ONLY after all hooks have been called\n  if (!relatedEvent || !components || !formattedData) {\n    return null;\n  }\n\n  // Extract components - safe to do after early returns since components is checked above\n  const {\n    VerticalEventCard,\n    EventCardPrice,\n    EventCardLocation,\n    EventCardDate,\n    EventCardTitle,\n    EventCardImage,\n    EventCardPromoted,\n    EventCardTracking,\n  } = components;\n\n  const {\n    props: { src },\n  } = getImageProps({\n    alt: '',\n    width: 148,\n    height: 74,\n    src: formattedData.imageUrl || '',\n  });\n\n  const imageElement = EventCardImage ? (\n    <EventCardImage src={src} alt={formattedData.name || formatMessage({ id: 'Event image' })} />\n  ) : null;\n\n  // Create event data for tracking\n  const eventForTracking = transformRelatedEventToTrackingEvent(relatedEvent);\n\n  const cardContent = (\n    <div\n      className={styles.grid}\n      onClick={handleCardClick}\n      role=\"button\"\n      tabIndex={0}\n      aria-label={`${formatMessage({ id: 'Open event' })}: ${formattedData.name || formatMessage({ id: 'Unnamed event' })}`}\n      style={{ cursor: 'pointer' }}\n    >\n      {formattedData.urgencySignalStatus && (\n        <div className={styles.signalBadgeWrapper}>\n          <SignalBadge />\n        </div>\n      )}\n\n      {EventCardTitle && formattedData.name && (\n        <div className={styles.titleWrapper}>\n          <EventCardTitle title={formattedData.name} className={titleClass} />\n        </div>\n      )}\n\n      {EventCardDate && formattedData.formattedEventDateTimeString && (\n        <div className={styles.dateWrapper}>\n          <EventCardDate formattedDateString={formattedData.formattedEventDateTimeString} className={styles.date} />\n        </div>\n      )}\n\n      {EventCardLocation && (\n        <div className={styles.locationWrapper}>\n          <EventCardLocation\n            formattedLocationString={formattedData.locationString}\n            isOnlineEvent={formattedData.isOnlineEvent}\n            className={styles.location}\n          />\n        </div>\n      )}\n\n      {EventCardPrice && (\n        <div className={styles.priceWrapper}>\n          <EventCardPrice\n            isFree={formattedData.isFree}\n            formattedPriceString={formattedData.priceString}\n            className={styles.price}\n          />\n        </div>\n      )}\n\n      {formattedData.isPromoted && EventCardPromoted && (\n        <div className={styles.promotedWrapper} data-testid=\"promoted-event-card\">\n          <EventCardPromoted isPromoted={formattedData.isPromoted} className={styles.promoted} />\n        </div>\n      )}\n\n      <div className={styles.imageWrapper}>{imageElement}</div>\n    </div>\n  );\n\n  return (\n    <div data-testid=\"related-event-card\" className={styles.wrapper}>\n      <VerticalEventCard isRaised={false}>\n        {EventCardTracking ? (\n          <EventCardTracking event={eventForTracking}>{cardContent}</EventCardTracking>\n        ) : (\n          cardContent\n        )}\n      </VerticalEventCard>\n    </div>\n  );\n};\n","export { RelatedEventCard } from './RelatedEventCard';\nexport type { RelatedEventCardProps } from './RelatedEventCard';\nexport { useEventCardComponents } from './hooks/useEventCardComponents';\n","import styles from './Divider.module.scss';\n\nexport const Divider: React.FC = () => {\n  return <div className={styles.divider} />;\n};\n","export { Divider } from './Divider';\n","import { useState, useCallback, useEffect } from 'react';\nimport { useComponentVisibility } from '@/hooks/useComponentVisibility';\nimport type { RelatedEventsData, PromotedEvent } from '../types';\nimport type { BasicInfo } from '@/types';\nimport { sdkRequest } from '@eventbrite/legacy-infra.http';\nimport { getLastRecentSearchTerms, getLastRecentViewsList } from '@/utils/utils';\nimport { ORGANIZERIDS_EXCLUDE } from '../../../../common/constants';\nimport { Stage } from '@eventbrite/webapp-constants';\n\nconst isElementVisible = (element: HTMLElement): boolean => {\n  const rect = element.getBoundingClientRect();\n  const windowHeight = window.innerHeight || document.documentElement.clientHeight;\n  const windowWidth = window.innerWidth || document.documentElement.clientWidth;\n\n  return rect.top < windowHeight && rect.bottom > 0 && rect.left < windowWidth && rect.right > 0;\n};\n\nexport const useRelatedAndPromotedEventsLazy = (\n  eventBasicInfo: BasicInfo,\n  stage: Stage,\n  eventId?: string,\n  isBodyRendered?: boolean,\n) => {\n  const [relatedEvents, setRelatedEvents] = useState<RelatedEventsData | null>(null);\n  const [promotedEvents, setPromotedEvents] = useState<PromotedEvent[] | null>(null);\n  const [isLoadingRelatedEvents, setIsLoadingRelatedEvents] = useState(false);\n  const [isLoadingPromotedEvents, setIsLoadingPromotedEvents] = useState(false);\n\n  const fetchRelatedEvents = useCallback(async () => {\n    setIsLoadingRelatedEvents(true);\n    try {\n      if (eventBasicInfo.organizer?.id && ORGANIZERIDS_EXCLUDE[stage].includes(eventBasicInfo.organizer?.id)) {\n        setRelatedEvents(null);\n        setIsLoadingRelatedEvents(false);\n        return;\n      }\n      // Always use relative URL - the local endpoint will proxy to QA server when needed\n      const fetchUrl = `/e/api/${eventId}/related-events?eventOrganizerId=${eventBasicInfo.organizer?.id}`;\n\n      const relatedEventsResponse = await fetch(fetchUrl);\n\n      if (relatedEventsResponse.ok) {\n        const data = await relatedEventsResponse.json();\n        setRelatedEvents(data);\n      } else {\n        console.error('Failed to fetch related events: Response not ok');\n      }\n    } catch (err) {\n      console.error('Failed to fetch related events:', err);\n    } finally {\n      setIsLoadingRelatedEvents(false);\n    }\n  }, [eventId, eventBasicInfo.organizer?.id, stage]);\n\n  const fetchPromotedEvents = useCallback(async () => {\n    setIsLoadingPromotedEvents(true);\n    try {\n      if (eventBasicInfo.organizer?.id && ORGANIZERIDS_EXCLUDE[stage].includes(eventBasicInfo.organizer?.id)) {\n        setPromotedEvents(null);\n        setIsLoadingPromotedEvents(false);\n        return;\n      }\n      const options = getPromotedEventsOptions(eventBasicInfo);\n      const promotedEventsResponse = await sdkRequest(\n        `/promoted/events`,\n        options,\n        process.env.NEXT_PUBLIC_PROXY_API_V3 ? '/e' : '',\n      );\n\n      if (promotedEventsResponse) {\n        setPromotedEvents(promotedEventsResponse);\n      } else {\n        setPromotedEvents(null);\n        console.error('Failed to fetch promoted events');\n      }\n    } catch (err) {\n      setPromotedEvents(null);\n      console.error('Failed to fetch promoted events:', err);\n    } finally {\n      setIsLoadingPromotedEvents(false);\n    }\n  }, [eventBasicInfo, stage]);\n\n  const fetchAllEvents = useCallback(async () => {\n    if (!eventId || !isBodyRendered) {\n      return;\n    }\n\n    await Promise.all([fetchRelatedEvents(), fetchPromotedEvents()]);\n  }, [eventId, isBodyRendered, fetchRelatedEvents, fetchPromotedEvents]);\n\n  const elementRef = useComponentVisibility(fetchAllEvents, {\n    rootMargin: '50px', // Pre-load when 50px away from viewport\n  });\n\n  useEffect(() => {\n    if (!isBodyRendered) {\n      return;\n    }\n\n    const element = elementRef.current;\n    if (!element) {\n      return;\n    }\n\n    if (isElementVisible(element)) {\n      fetchAllEvents();\n    }\n  }, [isBodyRendered, fetchAllEvents, elementRef]);\n\n  return {\n    relatedEvents,\n    promotedEvents,\n    isLoading: isLoadingRelatedEvents || isLoadingPromotedEvents,\n    elementRef,\n  };\n};\n\n/**\n * Creates the payload for promoted events API call\n *\n * @param eventBasicInfo - Basic info about the event\n * @returns Request options for the API call\n */\nconst getPromotedEventsOptions = (eventBasicInfo: BasicInfo): RequestInit => {\n  const geoPoint =\n    eventBasicInfo?.isOnline || !eventBasicInfo?.venue?.address?.latitude || !eventBasicInfo?.venue?.address?.longitude\n      ? undefined\n      : {\n          lat: eventBasicInfo?.venue?.address?.latitude,\n          lon: eventBasicInfo?.venue?.address?.longitude,\n          radius: 50,\n        };\n\n  return {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n    },\n    body: JSON.stringify({\n      slots: 2,\n      page: 1,\n      interface: 'related_events',\n      app: 'web',\n      personalized_options: {\n        recent_searches: getLastRecentSearchTerms(10),\n        recent_views: getLastRecentViewsList(10),\n      },\n      search: {\n        dates: ['current_future'],\n        related_event: {\n          id: parseInt(eventBasicInfo?.id),\n          name: eventBasicInfo?.name,\n          summary: eventBasicInfo?.summary,\n        },\n        place: {\n          is_online: eventBasicInfo?.isOnline,\n          geo_point: geoPoint,\n          place_id: eventBasicInfo?.venue?.id,\n        },\n        client_timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,\n      },\n    }),\n  };\n};\n","export { useRelatedAndPromotedEventsLazy } from './useRelatedAndPromotedEventsLazy';\n","/**\n * Interleaves two arrays, alternating elements from each array.\n * Starts with the first array, then the second, and so on.\n *\n * @param firstArray - The first array to interleave\n * @param secondArray - The second array to interleave\n * @returns A new array with interleaved elements\n *\n * @example\n * interleaveArrays([1, 3, 5], [2, 4, 6]) // [1, 2, 3, 4, 5, 6]\n * interleaveArrays([1, 3], [2, 4, 6, 8]) // [1, 2, 3, 4, 6, 8]\n */\nexport function interleaveArrays<T>(firstArray: T[], secondArray: T[]): T[] {\n  const result: T[] = [];\n  const maxLength = Math.max(firstArray.length, secondArray.length);\n\n  for (let i = 0; i < maxLength; i++) {\n    if (i < firstArray.length) {\n      result.push(firstArray[i]);\n    }\n    if (i < secondArray.length) {\n      result.push(secondArray[i]);\n    }\n  }\n\n  return result;\n}\n","import { interleaveArrays } from '@/utils/arrayUtils';\nimport { type PromotedEvent, type RelatedEventsData, type RelatedEvent, type UrgencySignals } from './types';\nimport { transformPromotedEventsToRelatedEvents } from '@/utils/mappers';\nimport type { EventInteraction, EventInteractionWithContext } from '@/tracking/types';\n\n/**\n * Merges related events and promoted events into a single RelatedEventsData object\n * with interleaved ordering\n *\n * @param relatedEvents - Related events data\n * @param promotedEvents - Array of promoted events\n * @returns Merged RelatedEventsData object or null if both are null/empty\n */\nexport function mergeRelatedAndPromotedEvents(\n  relatedEvents: RelatedEventsData | null,\n  promotedEvents: PromotedEvent[] | null,\n): RelatedEventsData | null {\n  if ((!relatedEvents && !promotedEvents) || (relatedEvents?.events?.length === 0 && promotedEvents?.length === 0)) {\n    return null;\n  }\n\n  const relatedEventsList = relatedEvents?.events || [];\n  const promotedEventsList = transformPromotedEventsToRelatedEvents(promotedEvents);\n  const interleavedEvents = interleaveArrays(promotedEventsList, relatedEventsList);\n\n  return {\n    events: interleavedEvents,\n    unrecoverableEventIds: relatedEvents?.unrecoverableEventIds || [],\n  };\n}\n\n/**\n * Computes event ranks for tracking purposes\n *\n * Due to historical reasons, we compute both relative and absolute ranks:\n * - rank: Position within the same related event type (promoted vs organic)\n * - absoluteRank: Position within the entire list\n *\n * @param events - Array of all events\n * @param eventId - ID of the event to find\n * @param isPromoted - Whether the event is promoted\n * @returns Object with rank and absoluteRank\n */\nexport function computeEventRanks(\n  events: RelatedEvent[],\n  eventId: string,\n  isPromoted: boolean | undefined,\n): { rank: number; absoluteRank: number } {\n  if (!eventId || typeof isPromoted === 'undefined') {\n    return {\n      rank: 0,\n      absoluteRank: 0,\n    };\n  }\n\n  const eventsGroup = events.filter((e) => isPromoted === e.isPromoted);\n\n  return {\n    rank: eventsGroup.findIndex((e) => e.id === eventId) + 1,\n    absoluteRank: events.findIndex((e) => e.id === eventId) + 1,\n  };\n}\n\n/**\n * Converts urgency signals to tracking format\n *\n * @param urgencySignals - Urgency signals from event data\n * @returns Array of urgency signal strings for tracking\n */\nexport function getUrgencySignalsForTracking(urgencySignals?: UrgencySignals): string[] {\n  if (!urgencySignals) {\n    return [];\n  }\n\n  const signals: string[] = [];\n\n  if (urgencySignals.new) signals.push('new');\n  if (urgencySignals.salesEndSoon) signals.push('salesEndSoon');\n  if (urgencySignals.fewTickets) signals.push('fewTickets');\n  if (urgencySignals.popular) signals.push('popular');\n  if (urgencySignals.goingFast) signals.push('goingFast');\n\n  return signals;\n}\n\n/**\n * Creates tracking context for related events interactions\n * This function generates the tracking context that gets added to each interaction.\n *\n * @param mainEvent - The main event\n * @param allEvents - Array of all related events for rank calculation\n * @param locale - The locale of the user\n * @returns Function that transforms event interactions into tracking context\n */\nexport const createTrackingInformationGetter = (\n  mainEvent: {\n    id?: string;\n    isOnline?: boolean;\n    isEnded?: boolean;\n  },\n  allEvents: RelatedEvent[] = [],\n  locale: string,\n  sessionInfo: {\n    userId?: string | null;\n    sessionId?: string | null;\n    guestId?: string | null;\n  },\n) => {\n  return (eventInteraction: EventInteraction): EventInteractionWithContext => {\n    // Find the specific event from the events array for rank calculation\n    const eventToTrack = allEvents.find(\n      (e) => e.id === eventInteraction.id && e.isPromoted === eventInteraction.event.isPromoted,\n    );\n\n    if (!eventToTrack) {\n      console.error(`Event with id ${eventInteraction.id} not found in related events list`);\n      return {} as EventInteractionWithContext;\n    }\n\n    // Calculate ranks\n    const { rank, absoluteRank } = computeEventRanks(allEvents, eventInteraction.id, eventToTrack.isPromoted);\n\n    const hasOpenPromotion = eventToTrack.hasOpenDiscount ?? false;\n    const hasBOGOLabel = eventToTrack.specialDiscounts?.hasBogoTickets ?? false;\n    const urgencySignals = getUrgencySignalsForTracking(eventToTrack.urgencySignals);\n\n    return {\n      id: eventInteraction.id,\n      action: eventInteraction.action,\n      event: eventInteraction.event,\n      user: {\n        id: sessionInfo.userId ?? undefined,\n        locale,\n        guestId: sessionInfo.guestId ?? undefined,\n        sessionId: sessionInfo.sessionId ?? undefined,\n      },\n      adId: eventToTrack.promotedListingMetadata?.adId,\n      place: {\n        name: 'related_events',\n        // Since we don't have pagination, page.number is always 0\n        position: rank, // For page 0, use rank (like EB-UI)\n        absoluteRank,\n        page: 1, // We don't have carousel pagination, so always page 1\n        context: {\n          related_event_id: mainEvent.id,\n          is_online: mainEvent.isOnline,\n        },\n        tabKey: '',\n        subInterface: {\n          name: mainEvent.isEnded ? 'event_expired_page' : 'events_carousel',\n          position: '',\n        },\n        placementId: eventToTrack.promotedListingMetadata?.placementId,\n      },\n      displayContext: {\n        hasOpenPromotion,\n        hasBOGOLabel,\n        urgencySignals,\n      },\n      venueId: eventToTrack.venue?.id,\n    };\n  };\n};\n","import { sdkRequest } from '@eventbrite/legacy-infra.http';\nimport { type EventInteractionWithContext, EventInteractions } from '../types';\nimport { BaseInteractionsLogger } from './BaseInteractionsLogger';\n\n/**\n * Data structure expected by the /api/v3/log_engagement/ endpoint\n */\ntype InteractionEngagementLoggerData = {\n  identity: {\n    user_id?: string | number;\n    locale?: string;\n    tracking_code: null;\n    device_latitude: null;\n    device_longitude: null;\n  };\n  interface_context: {\n    app: string;\n    interface: string;\n    placement_id?: string;\n    rank: number;\n    absolute_rank?: number;\n    event_id?: string;\n    ad_id?: string;\n    action?: string;\n    tab_key?: string;\n    campaign_id: null;\n    page: number;\n    sub_interface: string;\n    position: string;\n  };\n  retrieval_context?: Record<string, unknown>;\n  display_context?: {\n    has_open_promotion: boolean;\n    has_bogo_label: boolean;\n    urgency_signals: string[];\n  };\n  venue_context?: {\n    venue_id: string | null;\n  };\n  feedback_context?: {\n    email?: string;\n    report_reason?: string;\n    report_description?: string;\n  };\n};\n\nexport class InteractionsEngagementLogger extends BaseInteractionsLogger<InteractionEngagementLoggerData> {\n  protected excludedEvents: EventInteractions[] = [EventInteractions.Mounted];\n\n  /**\n   * Logs the transformed interactions to the engagement API\n   *\n   * @param transformedInteractions - Array of interactions in API format\n   */\n  protected log(transformedInteractions: InteractionEngagementLoggerData[]) {\n    this.logToEngagementAPI(transformedInteractions);\n  }\n\n  /**\n   * Sends the transformed interactions to the /api/v3/log_engagement/ API\n   *\n   * @param interactions - Array of interactions in the API format\n   */\n  private logToEngagementAPI(interactions: InteractionEngagementLoggerData[]) {\n    sdkRequest(\n      '/log_engagement/',\n      {\n        method: 'POST',\n        body: JSON.stringify(interactions),\n        headers: { 'EB-version': 'custom-events-next-version' },\n      },\n      process.env.NEXT_PUBLIC_PROXY_API_V3 ? '/e' : '',\n    );\n  }\n\n  /**\n   * Transforms an event interaction into the format expected by the API\n   *\n   * @param interaction - The event interaction to transform\n   * @returns The interaction in API format\n   */\n  protected transformInteraction(interaction: EventInteractionWithContext): InteractionEngagementLoggerData {\n    return {\n      identity: {\n        user_id: interaction.user.id ?? 0,\n        locale: interaction.user.locale,\n        tracking_code: null,\n        device_latitude: null,\n        device_longitude: null,\n      },\n      interface_context: {\n        app: 'web',\n        interface: interaction.place.name,\n        placement_id: interaction.place.placementId,\n        rank: interaction.place.position,\n        absolute_rank: interaction.place.absoluteRank,\n        event_id: interaction.id,\n        ad_id: interaction.adId,\n        action: interaction.action,\n        tab_key: interaction.place.tabKey,\n        campaign_id: null,\n        page: interaction.place.page,\n        // log_engagement endpoint breaks if sub_interface / position are not sent\n        sub_interface: interaction.place.subInterface?.name ?? '',\n        position: interaction.place.subInterface?.position ?? '',\n      },\n      retrieval_context: interaction.place.context,\n      display_context: {\n        has_open_promotion: Boolean(interaction.displayContext?.hasOpenPromotion),\n        has_bogo_label: Boolean(interaction.displayContext?.hasBOGOLabel),\n        urgency_signals: interaction.displayContext?.urgencySignals || [],\n      },\n      venue_context: {\n        venue_id: interaction.venueId ?? null,\n      },\n    };\n  }\n}\n","import { logEvent } from '@eventbrite/legacy-infra.statsig';\nimport { type EventInteractionWithContext, EventInteractions } from '../types';\nimport { BaseInteractionsLogger } from './BaseInteractionsLogger';\n\n/**\n * Data structure for Statsig logging\n */\ntype InteractionStatsigLoggerData = {\n  name: string;\n  metadata: {\n    app: string;\n    rank: string;\n    isOnline: string;\n    page: string;\n    isPromoted: string;\n    hasUrgencySignals: string;\n    isFree: string;\n  };\n};\n\nexport class InteractionsStatsigLogger extends BaseInteractionsLogger<InteractionStatsigLoggerData> {\n  protected allowedEvents: EventInteractions[] = [EventInteractions.Impression, EventInteractions.Click];\n\n  /**\n   * Filters out non-promoted events\n   *\n   * @param interaction - The interaction to check\n   */\n  protected filterEventsBy(interaction: EventInteractionWithContext): boolean {\n    return Boolean(interaction.event.isPromoted);\n  }\n\n  /**\n   * Transforms an interaction for Statsig logging\n   *\n   * @param interaction - The interaction to transform\n   * @returns Statsig-specific data format\n   */\n  protected transformInteraction(interaction: EventInteractionWithContext): InteractionStatsigLoggerData {\n    const urgencySignals = interaction.displayContext?.urgencySignals || [];\n    const hasUrgencySignals = urgencySignals.length > 0;\n\n    return {\n      name: this.getStatsigEventName(interaction),\n      metadata: {\n        app: 'web',\n        rank: `${interaction.place.position}`,\n        isOnline: `${interaction.event.isOnlineEvent}`,\n        page: `${interaction.place.page}`,\n        isPromoted: `${interaction.event.isPromoted}`,\n        hasUrgencySignals: `${hasUrgencySignals}`,\n        isFree: `${interaction.event.isFree}`,\n      },\n    };\n  }\n\n  /**\n   * Logs interactions to Statsig\n   *\n   * @param transformedInteractions - Array of transformed interactions\n   */\n  protected log(transformedInteractions: InteractionStatsigLoggerData[]): void {\n    transformedInteractions.forEach((event) => logEvent(event.name, undefined, event.metadata));\n  }\n\n  private getStatsigEventName(interaction: EventInteractionWithContext): string {\n    const dataPoints = [\n      interaction.place.name,\n      interaction.place.subInterface?.name,\n      interaction.action,\n      'Promoted',\n      'Event(s)',\n    ].filter((str) => !!str) as string[];\n\n    return dataPoints.map(snakeToTitle).join(' - ');\n  }\n}\n\n/**\n * Converts snake_case text to Title Case\n *\n * @param snakeCaseText - Text in snake_case format\n * @returns Text in Title Case format\n */\nfunction snakeToTitle(snakeCaseText: string): string {\n  const words = snakeCaseText.split('_');\n  const capitalizedWords = words.map((word) => word.charAt(0).toUpperCase() + word.slice(1));\n  return capitalizedWords.join(' ');\n}\n","import { InteractionsEngagementLogger } from './loggers/InteractionsEngagementLogger';\nimport { InteractionsDatadogLogger } from './loggers/InteractionsDatadogLogger';\nimport { InteractionsStatsigLogger } from './loggers/InteractionsStatsigLogger';\nimport { BaseInteractionsLogger } from './loggers/BaseInteractionsLogger';\nimport { EventInteractionWithContext, EventInteractions, PLACE_EVENT_INTERACTION, TrackableElement } from './types';\n\n/**\n * Manages batching and periodic logging of event card interactions\n *\n * This tracker:\n * - Listens for PLACE_EVENT_INTERACTION events\n * - Batches interactions to reduce API calls\n * - Sends batched data every 1.25 seconds\n * - Deduplicates certain events (impressions, mounted)\n *\n */\nexport class EventsInteractionsTracker {\n  private readonly LOG_PERIODICITY_MILLISECONS = 1250;\n\n  /** DOM element to listen for events on */\n  private readonly element: TrackableElement;\n\n  private readonly interactionsLoggers: BaseInteractionsLogger<unknown>[];\n  private interactions: EventInteractionWithContext[] = [];\n  private readonly interactions_history: Set<string> = new Set();\n\n  /**\n   * Creates a new EventsInteractionsTracker\n   *\n   * @param element - DOM element to listen for events on\n   * @param interactionsLoggers - Array of loggers to process interactions\n   */\n  constructor(\n    element: TrackableElement,\n    interactionsLoggers: BaseInteractionsLogger<unknown>[] = [\n      new InteractionsEngagementLogger(),\n      new InteractionsDatadogLogger(),\n      new InteractionsStatsigLogger(),\n    ],\n  ) {\n    this.element = element;\n    this.interactionsLoggers = interactionsLoggers;\n  }\n\n  /**\n   * Starts listening for PLACE_EVENT_INTERACTION events\n   *\n   * This method should be called once when the tracker is initialized.\n   * It sets up the event listener that captures interactions.\n   */\n  listen() {\n    this.element.addEventListener(PLACE_EVENT_INTERACTION, (event: CustomEvent<EventInteractionWithContext>) => {\n      const detail = event.detail;\n      const interactionUniqueId = `${detail.id}-${detail.place.placementId}-${detail.action}`;\n\n      if (uniqueInteractions.includes(detail.action) && this.interactions_history.has(interactionUniqueId)) {\n        return;\n      }\n\n      this.interactions_history.add(interactionUniqueId);\n      this.interactions.push(detail);\n    });\n  }\n\n  /**\n   * Starts the periodic batching and logging process\n   *\n   * This method:\n   * - Sets up a timer to send batched interactions\n   * - Sets up a beforeunload handler to send any remaining interactions\n   *\n   * Should be called after listen() to start the tracking process.\n   */\n  track() {\n    setInterval(() => {\n      this.logStoredInteractions();\n    }, this.LOG_PERIODICITY_MILLISECONS);\n\n    this.element.addEventListener('beforeunload', () => this.logStoredInteractions());\n  }\n\n  /**\n   * Processes and sends all stored interactions to the loggers\n   *\n   * This method:\n   * - Sends interactions in batches of 10\n   * - Clears the interactions buffer after sending\n   */\n  private logStoredInteractions() {\n    const logsLimit = 10;\n    for (let i = 0; i < this.interactions.length; i += logsLimit) {\n      const logsBlock = this.interactions.slice(i, i + logsLimit);\n\n      this.interactionsLoggers.forEach((logger) => {\n        logger.run(logsBlock);\n      });\n    }\n    this.interactions = [];\n  }\n}\n\n// This interactions should be only logged once\nconst uniqueInteractions = [EventInteractions.Impression, EventInteractions.Mounted];\n","import { EVENT_INTERACTION } from '@eventbrite/consumer-search.event-renderer';\nimport { useCallback, useEffect, useMemo, useRef } from 'react';\nimport { EventsInteractionsTracker } from './eventInteractionsTracker';\nimport { InteractionsEngagementLogger } from './loggers/InteractionsEngagementLogger';\nimport { InteractionsDatadogLogger } from './loggers/InteractionsDatadogLogger';\nimport { InteractionsStatsigLogger } from './loggers/InteractionsStatsigLogger';\nimport {\n  EventInteraction,\n  EventInteractionWithContext,\n  InteractionCustomEvent,\n  PLACE_EVENT_INTERACTION,\n  TrackableElement,\n} from './types';\n\nlet eventInteractionTracker: EventsInteractionsTracker;\nlet datadogLogger: InteractionsDatadogLogger;\n\n/**\n * Initializes the global event tracking system\n *\n * This function:\n * - Creates a single EventsInteractionsTracker instance for the page\n * - Sets up event listeners and batching\n */\nfunction startEventTracking() {\n  const IS_SSR = typeof document === 'undefined';\n\n  if (IS_SSR || eventInteractionTracker) {\n    return;\n  }\n\n  datadogLogger = new InteractionsDatadogLogger();\n  eventInteractionTracker = new EventsInteractionsTracker(document, [\n    new InteractionsEngagementLogger(),\n    datadogLogger,\n    new InteractionsStatsigLogger(),\n  ]);\n\n  eventInteractionTracker.listen();\n  eventInteractionTracker.track();\n}\n\n/**\n * React hook for tracking event interactions\n *\n * This hook:\n * - Initializes the global tracking system (singleton)\n * - Listens for EVENT_INTERACTION events\n * - Transforms them into PLACE_EVENT_INTERACTION events with context\n * - Returns a ref to attach to the DOM element containing event interactions\n *\n * @param getTrackingInformation - Function that adds context to interactions\n * @returns Object with ref to attach to the container element\n *\n * @example\n * ```tsx\n * const { ref } = useTracking(() => ({\n *   place: { name: 'related-events', position: 0 },\n *   user: { locale: 'en' }\n * }));\n *\n * return <div ref={ref}>...</div>;\n * ```\n */\nexport function useTracking<T extends TrackableElement>(\n  getTrackingInformation: (eventInteraction: EventInteraction) => EventInteractionWithContext,\n) {\n  useMemo(() => startEventTracking(), []);\n  const logInteractions = useCallback(\n    (e: InteractionCustomEvent) => {\n      e.preventDefault();\n\n      const detail: EventInteractionWithContext = {\n        ...e.detail,\n        ...getTrackingInformation(e.detail),\n      };\n\n      // Dispatch the enhanced event for EventsInteractionsTracker to pick up\n      const placeEventInteractionEvent = new CustomEvent(PLACE_EVENT_INTERACTION, { detail, bubbles: true });\n      e.currentTarget?.dispatchEvent(placeEventInteractionEvent);\n\n      // Datadog integration for promoted events\n      if (detail.event?.isPromoted && datadogLogger) {\n        datadogLogger.trackEventCardInteraction(detail);\n      }\n    },\n    [getTrackingInformation],\n  );\n\n  const ref = useRef<T>(null);\n\n  useEffect(() => {\n    const container = ref.current;\n    container?.addEventListener(EVENT_INTERACTION, logInteractions);\n    return () => container?.removeEventListener(EVENT_INTERACTION, logInteractions);\n  }, [ref, logInteractions]);\n\n  return { ref };\n}\n","export { useTracking } from './useTracking';\nexport type { EventInteraction, EventInteractionWithContext } from './types';\n","import React, { useMemo, useEffect, useRef } from 'react';\nimport { useIntl } from 'react-intl';\nimport { RelatedEventCard } from './RelatedEventCard';\nimport styles from './RelatedEvents.module.scss';\nimport { Divider } from '../_shared/Divider';\nimport { useRelatedAndPromotedEventsLazy } from './hooks';\nimport { LoadingSkeleton } from '@eventbrite/legacy-infra.loading-skeleton';\nimport { RelatedEvent, RelatedEventsData } from './types';\nimport { BasicInfo } from '@/types';\nimport { mergeRelatedAndPromotedEvents, createTrackingInformationGetter } from './utils';\nimport { assignRefsToNode } from '@/utils/utils';\nimport { AffiliateCodes, DOM_IDS } from '../_shared/constants';\nimport { useTracking, EventInteraction } from '@/tracking';\nimport { useAppContext } from '../_shared/context/AppContext';\nimport { isEventEnded, isEventLive } from '../Body/utils/bodyUtils';\nimport { LISTING_HEAP_IDS } from '@/components/_shared/constants';\nimport { useComponentVisibilityWithTracking } from '@/hooks/useComponentVisibility';\nimport { useStage } from '@/hooks/useStage';\n\nexport const DEFAULT_MAX_EVENTS = 4;\n\nexport interface SessionData {\n  userId: string | null;\n  sessionId: string | null;\n  guestId: string | null;\n}\n\nexport interface RelatedEventsProps {\n  eventId: string;\n  isBodyRendered?: boolean;\n  eventBasicInfo: BasicInfo;\n  sessionData?: SessionData;\n}\n\n// Helper functions\nconst getEventsToShow = (relatedEvents: RelatedEventsData | null): RelatedEvent[] => {\n  if (!relatedEvents?.events?.length) {\n    return [];\n  }\n  return relatedEvents.events.slice(0, DEFAULT_MAX_EVENTS);\n};\n\nconst buildRelatedEventList = (eventsToShow: RelatedEvent[], affiliateCode?: AffiliateCodes) => {\n  return eventsToShow.map((event, index) => {\n    const isLastItem = index === eventsToShow.length - 1;\n    const eventKey = event.id || `event-${index}`;\n\n    return (\n      <React.Fragment key={eventKey}>\n        <RelatedEventCard relatedEvent={event} affiliateCode={affiliateCode} />\n        {!isLastItem && <Divider />}\n      </React.Fragment>\n    );\n  });\n};\n\nconst buildContent = (\n  shouldShowSkeleton: boolean,\n  shouldShowEvents: boolean,\n  title: string,\n  relatedEventList: React.ReactNode,\n) => {\n  if (shouldShowSkeleton) {\n    return <LoadingSkeleton height={550} />;\n  }\n\n  if (shouldShowEvents) {\n    return (\n      <>\n        <div className={styles.title}>{title}</div>\n        <section className={styles.relatedEventsContainer}>\n          {relatedEventList}\n          <div className={styles.dividerContainer}>\n            <Divider />\n          </div>\n        </section>\n      </>\n    );\n  }\n\n  return null;\n};\n\nexport const RelatedEvents: React.FC<RelatedEventsProps> = ({\n  eventId,\n  isBodyRendered,\n  eventBasicInfo,\n  sessionData,\n}) => {\n  const { formatMessage } = useIntl();\n  const {\n    data: { locale },\n  } = useAppContext();\n  const stage = useStage();\n\n  const { relatedEvents, promotedEvents, isLoading, elementRef } = useRelatedAndPromotedEventsLazy(\n    eventBasicInfo,\n    stage,\n    eventId,\n    isBodyRendered,\n  );\n\n  const relatedAndPromotedEvents = useMemo(\n    () => mergeRelatedAndPromotedEvents(relatedEvents, promotedEvents),\n    [relatedEvents, promotedEvents],\n  );\n\n  const eventsToShow = useMemo(() => getEventsToShow(relatedAndPromotedEvents), [relatedAndPromotedEvents]);\n\n  const getTrackingInformation = useMemo(() => {\n    if (!sessionData) {\n      return (eventInteraction: EventInteraction) => ({\n        ...eventInteraction,\n        user: { locale },\n        place: { name: 'loading', position: 0, page: 1, context: {} },\n      });\n    }\n\n    return createTrackingInformationGetter(\n      {\n        id: eventBasicInfo.id,\n        isOnline: eventBasicInfo.isOnline,\n        isEnded: isEventEnded(eventBasicInfo.status),\n      },\n      relatedAndPromotedEvents?.events || [],\n      locale,\n      sessionData,\n    );\n  }, [eventBasicInfo, relatedAndPromotedEvents?.events, locale, sessionData]);\n\n  const { ref: trackingRef } = useTracking<HTMLDivElement>