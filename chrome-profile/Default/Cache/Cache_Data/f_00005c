_E/./src/components/Overview/AboutThisEvent/StructuredModuleRenderer/components/LazyVideo.module.scss","webpack://_N_E/./src/components/Overview/Overview.module.scss","webpack://_N_E/./src/components/RelatedEvents/RelatedEventCard/RelatedEventCard.module.scss","webpack://_N_E/./src/components/RelatedEvents/RelatedEvents.module.scss","webpack://_N_E/./src/components/ReportThisEventButton/ReportThisEventButton.module.scss","webpack://_N_E/./src/components/UrgencySignals/UrgencySignalBadge.module.scss","webpack://_N_E/./src/components/_shared/Divider/Divider.module.scss","webpack://_N_E/./src/components/_shared/Layout/Layout.module.scss","webpack://_N_E/./src/components/_shared/ScrollableDrawer/ScrollableDrawer.module.scss","webpack://_N_E/./src/components/_shared/SectionWrapper/SectionWrapper.module.scss","webpack://_N_E/./src/components/_shared/SignalBadge/SignalBadge.module.scss","webpack://_N_E/./src/components/_shared/Toast/Toast.module.scss","webpack://_N_E/./src/components/_shared/Toast/toastUseCases/EventLikedToast/EventLikedToast.module.scss","webpack://_N_E/./src/components/_shared/buttons/ContactButton/ContactButton.module.scss","webpack://_N_E/./src/components/_shared/buttons/FollowButton/FollowButton.module.scss","webpack://_N_E/./src/components/_shared/buttons/ShareButton/ShareButton.module.scss","webpack://_N_E/./src/components/_shared/buttons/ViewDetailsButton/ViewDetailsButton.module.scss"],"sourcesContent":["import { DateSalesWithTz } from '@eventbrite/event-listing-service-client';\nimport styles from '../EventDetails.module.scss';\nimport { useIntl } from 'react-intl';\nimport { useMemo } from 'react';\nimport { getDisplayTimezone, getEventDateTimeDisplayString } from '@/utils/dateTime';\nimport { useAttendeeTimezone } from '@/hooks/useAttendeeTimezone';\nimport { MULTIPLE_DATES } from '@/components/_shared/constants';\nimport { CalendarIcon } from '@/components/_shared/Icons/CalendarIcon';\n\ntype EventDateTimeProps = {\n  startDate: DateSalesWithTz;\n  endDate: DateSalesWithTz;\n  locale: string;\n  isOnlineEvent: boolean;\n  isRecurringEvent: boolean;\n  hideStartDate?: boolean;\n  hideEndDate?: boolean;\n};\n\nexport const EventDateTime = ({\n  startDate,\n  endDate,\n  locale,\n  isOnlineEvent,\n  isRecurringEvent,\n  hideStartDate = false,\n  hideEndDate = false,\n}: EventDateTimeProps) => {\n  const { formatMessage } = useIntl();\n  const attendeeTimezone = useAttendeeTimezone(isOnlineEvent && !isRecurringEvent && !!startDate.utc);\n\n  const displayText = useMemo(() => {\n    if (!startDate.utc) {\n      return null;\n    }\n\n    const timezone = getDisplayTimezone({\n      isOnlineEvent,\n      eventTimezone: startDate.timezone,\n      attendeeTimezone,\n    });\n\n    return getEventDateTimeDisplayString({\n      startDate,\n      endDate,\n      hideStartDate,\n      hideEndDate,\n      locale,\n      timezone,\n      formatMessage,\n      isRecurringEvent,\n      recurringEventLabel: isRecurringEvent ? formatMessage(MULTIPLE_DATES) : undefined,\n      showTimezone: isOnlineEvent,\n    });\n  }, [\n    isRecurringEvent,\n    startDate,\n    endDate,\n    isOnlineEvent,\n    locale,\n    formatMessage,\n    hideStartDate,\n    hideEndDate,\n    attendeeTimezone,\n  ]);\n\n  if (!displayText) {\n    return null;\n  }\n\n  return (\n    <div className={styles.secondaryText} data-testid=\"event-datetime\">\n      <CalendarIcon className={styles.calendarIcon} />\n      <span>{displayText}</span>\n    </div>\n  );\n};\n","import React from 'react';\nimport { useIntl } from 'react-intl';\nimport type { Organizer } from '@/types';\nimport { OrganizerAvatar } from '@/components/OrganizerCard/OrganizerData/OrganizerAvatar/OrganizerAvatar';\nimport { FollowButton, FollowButtonVariant } from '@/components/_shared/buttons/FollowButton/FollowButton';\nimport styles from './OrganizerInfo.module.scss';\nimport { LISTING_HEAP_PAGE_AREA_IDS } from '@/components/_shared/constants';\n\ntype OrganizerInfoProps = {\n  organizer?: Organizer;\n  /** When false, the follow button is hidden (e.g. on password gate). Default true. */\n  showFollowButton?: boolean;\n  /** When set, used as the organizer name link href instead of \"#organizer-card\". */\n  organizerLinkHref?: string;\n  /** When true, avoids falling back to \"#organizer-card\" when no organizerLinkHref is provided. */\n  suppressDefaultLinkFallback?: boolean;\n};\n\nexport const OrganizerInfo: React.FC<OrganizerInfoProps> = ({\n  organizer,\n  showFollowButton = true,\n  organizerLinkHref,\n  suppressDefaultLinkFallback = false,\n}) => {\n  const { formatMessage } = useIntl();\n\n  if (!organizer || !organizer.name) {\n    return;\n  }\n\n  const linkHref = organizerLinkHref ?? (suppressDefaultLinkFallback ? undefined : '#organizer-card');\n\n  return (\n    <div className={styles.wrapper} data-testid=\"organizer-info\">\n      <div className={styles.organizerInfoContent}>\n        <div className={styles.organizerAvatarWrapper}>\n          <OrganizerAvatar organizer={organizer} size=\"small\" />\n        </div>\n        <span className={styles.byTag}>\n          {formatMessage({ id: 'By', defaultMessage: 'By', description: 'By tag for organizer info' })}\n        </span>\n        {linkHref ? (\n          <a className={styles.organizerName} href={linkHref}>\n            {organizer.name}\n          </a>\n        ) : (\n          <span className={styles.organizerName}>{organizer.name}</span>\n        )}\n      </div>\n      {showFollowButton && (\n        <div className={styles.followButtonWrapper}>\n          <FollowButton\n            organizer={organizer}\n            variant={FollowButtonVariant.Organizer}\n            pageArea={LISTING_HEAP_PAGE_AREA_IDS.SIMPLIFIED_ORGANIZER}\n          />\n        </div>\n      )}\n    </div>\n  );\n};\n","import React, { useEffect } from 'react';\nimport { useInView } from 'react-intersection-observer';\nimport { ArtistWidget } from '@eventbrite/artist-widget';\nimport { track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { defineMessage, MessageDescriptor } from 'react-intl';\nimport { LISTING_HEAP_IDS, VIEW_ALL_MESSAGE } from '@/components/_shared/constants';\nimport { useIntl } from 'react-intl';\nimport { getImageProps } from 'next/image';\n\ninterface Props {\n  info: ArtistInfo;\n}\n\nexport const ArtistsInfo: React.FC<Props> = ({ info }) => {\n  const { artistType, artists } = info;\n\n  const artistsWithOptimizedImages = artists.map((artist) => ({\n    ...artist,\n    imageUrl: artist.imageUrl\n      ? getImageProps({ alt: '', width: 56, height: 56, src: artist.imageUrl }).props.src\n      : undefined,\n    fullSizeImageUrl: artist.fullSizeImageUrl\n      ? getImageProps({ alt: '', width: 430, height: 430, src: artist.fullSizeImageUrl }).props.src\n      : undefined,\n  }));\n\n  const { formatMessage } = useIntl();\n  const { ref, inView } = useInView({ triggerOnce: true });\n\n  useEffect(() => {\n    if (inView) {\n      track({ eventName: LISTING_HEAP_IDS.ARTIST_WIDGET_VIEW, eventData: { artistType } });\n    }\n  }, [inView, artistType]);\n\n  return (\n    <div ref={ref}>\n      <ArtistWidget\n        artistData={{\n          artistType: formatMessage(config[artistType].label),\n          artistRole: formatMessage(config[artistType].role),\n          artistList: artistsWithOptimizedImages,\n        }}\n        translatedTexts={{\n          VIEW_LESS: formatMessage(defineMessage({ id: 'View less', defaultMessage: 'View less' })),\n          VIEW_ALL: formatMessage(VIEW_ALL_MESSAGE),\n        }}\n      />\n    </div>\n  );\n};\n\nconst config: { [key: string]: { label: MessageDescriptor; role: MessageDescriptor } } = {\n  lineup: {\n    label: defineMessage({ id: 'Lineup', defaultMessage: 'Lineup' }),\n    role: defineMessage({ id: 'Headliner', defaultMessage: 'Headliner' }),\n  },\n  artists: {\n    label: defineMessage({ id: 'Artists', defaultMessage: 'Artists' }),\n    role: defineMessage({ id: 'Featured', defaultMessage: 'Featured' }),\n  },\n  speakers: {\n    label: defineMessage({ id: 'Speakers', defaultMessage: 'Speakers' }),\n    role: defineMessage({ id: 'Keynote', defaultMessage: 'Keynote' }),\n  },\n  performers: {\n    label: defineMessage({ id: 'Performers', defaultMessage: 'Performers' }),\n    role: defineMessage({ id: 'Headliner', defaultMessage: 'Headliner' }),\n  },\n};\n\nexport interface ArtistInfo {\n  artistType: 'lineup' | 'artists' | 'speakers' | 'performers';\n  artists: Artist[];\n}\n\ninterface Artist {\n  id: string;\n  name: string;\n  tagline?: string;\n  imageUrl?: string;\n  fullSizeImageUrl?: string;\n  role?: string;\n  socialMedia?: SocialMedia[];\n  bio?: string;\n}\n\ninterface SocialMedia {\n  linkType: string;\n  url: string;\n}\n","import { createIntl, createIntlCache, defineMessage, type MessageFormatElement } from 'react-intl';\nimport { TranslationKeys } from '@eventbrite/good-to-know';\nimport type { LocationProps } from '@/types';\nimport { READ_MORE_MESSAGE, VIEW_ALL_MESSAGE } from '../_shared/constants';\n\ntype Messages = Record<string, string> | Record<string, MessageFormatElement[]>;\n\nconst intlCache = createIntlCache();\n\nconst GOOD_TO_KNOW_MESSAGE = defineMessage({\n  id: 'Good to know',\n  defaultMessage: 'Good to know',\n  description: 'Good to know section title',\n});\n\nconst REFUND_POLICY_MESSAGE = defineMessage({\n  id: 'Refund Policy',\n  defaultMessage: 'Refund Policy',\n  description: 'Refund policy section title',\n});\n\nconst HIGHLIGHTS_MESSAGE = defineMessage({\n  id: 'Highlights',\n  defaultMessage: 'Highlights',\n  description: 'Highlights section title',\n});\n\nconst TO_BE_ANNOUNCED_MESSAGE = defineMessage({\n  id: 'To be announced',\n  defaultMessage: 'To be announced',\n  description: 'Location to be announced text',\n});\n\nconst AGE_RESTRICTION_ALL_AGES_MESSAGE = defineMessage({\n  id: 'All ages',\n  defaultMessage: 'All ages',\n  description: 'All ages label',\n});\n\nconst AGE_RESTRICTION_MIN_TWENTY_ONE_MESSAGE = defineMessage({\n  id: 'Ages 21+',\n  defaultMessage: 'Ages 21+',\n  description: 'Ages 21+ label',\n});\n\nconst AGE_RESTRICTION_MIN_NINETEEN_MESSAGE = defineMessage({\n  id: 'Ages 19+',\n  defaultMessage: 'Ages 19+',\n  description: 'Ages 19+ label',\n});\n\nconst AGE_RESTRICTION_MIN_EIGHTEEN_MESSAGE = defineMessage({\n  id: 'Ages 18+',\n  defaultMessage: 'Ages 18+',\n  description: 'Ages 18+ label',\n});\n\nconst AGE_RESTRICTION_MIN_SEVENTEEN_MESSAGE = defineMessage({\n  id: 'Ages 17+',\n  defaultMessage: 'Ages 17+',\n  description: 'Ages 17+ label',\n});\n\nconst AGE_RESTRICTION_MIN_SIXTEEN_MESSAGE = defineMessage({\n  id: 'Ages 16+',\n  defaultMessage: 'Ages 16+',\n  description: 'Ages 16+ label',\n});\n\nconst AGE_RESTRICTION_MIN_FIFTEEN_MESSAGE = defineMessage({\n  id: 'Ages 15+',\n  defaultMessage: 'Ages 15+',\n  description: 'Ages 15+ label',\n});\n\nconst AGE_RESTRICTION_MIN_FOURTEEN_MESSAGE = defineMessage({\n  id: 'Ages 14+',\n  defaultMessage: 'Ages 14+',\n  description: 'Ages 14+ label',\n});\n\nconst AGE_RESTRICTION_MIN_THIRTEEN_MESSAGE = defineMessage({\n  id: 'Ages 13+',\n  defaultMessage: 'Ages 13+',\n  description: 'Ages 13+ label',\n});\n\nconst AGE_RESTRICTION_MIN_TWELVE_MESSAGE = defineMessage({\n  id: 'Ages 12+',\n  defaultMessage: 'Ages 12+',\n  description: 'Ages 12+ label',\n});\n\nconst AGE_RESTRICTION_UNDER_TWENTY_ONE_WITH_GUARDIAN_MESSAGE = defineMessage({\n  id: 'Under 21 with parent or legal guardian',\n  defaultMessage: 'Under 21 with parent or legal guardian',\n  description: 'Under 21 with parent or legal guardian label',\n});\n\nconst AGE_RESTRICTION_UNDER_EIGHTEEN_WITH_GUARDIAN_MESSAGE = defineMessage({\n  id: 'Under 18 with parent or legal guardian',\n  defaultMessage: 'Under 18 with parent or legal guardian',\n  description: 'Under 18 with parent or legal guardian label',\n});\n\nconst AGE_RESTRICTION_UNDER_SIXTEEN_WITH_GUARDIAN_MESSAGE = defineMessage({\n  id: 'Under 16 with parent or legal guardian',\n  defaultMessage: 'Under 16 with parent or legal guardian',\n  description: 'Under 16 with parent or legal guardian label',\n});\n\nconst AGE_RESTRICTION_UNDER_FOURTEEN_WITH_GUARDIAN_MESSAGE = defineMessage({\n  id: 'Under 14 with parent or legal guardian',\n  defaultMessage: 'Under 14 with parent or legal guardian',\n  description: 'Under 14 with parent or legal guardian label',\n});\n\nconst IN_PERSON_MESSAGE = defineMessage({\n  id: 'In person',\n  defaultMessage: 'In person',\n  description: 'In person event label',\n});\n\nconst ONLINE_MESSAGE = defineMessage({\n  id: 'Online',\n  defaultMessage: 'Online',\n  description: 'Online event label',\n});\n\nconst SCROLL_CAROUSEL_LEFT_MESSAGE = defineMessage({\n  id: 'Scroll carousel left',\n  defaultMessage: 'Scroll carousel left',\n  description: 'Scroll carousel left aria label',\n});\n\nconst SCROLL_CAROUSEL_RIGHT_MESSAGE = defineMessage({\n  id: 'Scroll carousel right',\n  defaultMessage: 'Scroll carousel right',\n  description: 'Scroll carousel right aria label',\n});\n\nconst FREE_PARKING_MESSAGE = defineMessage({\n  id: 'Free parking',\n  defaultMessage: 'Free parking',\n  description: 'Free parking label',\n});\n\nconst PAID_PARKING_MESSAGE = defineMessage({\n  id: 'Paid parking',\n  defaultMessage: 'Paid parking',\n  description: 'Paid parking label',\n});\n\nconst getIntl = (locale = 'en', messages: Messages = {}) => {\n  return createIntl({ locale, messages, defaultLocale: 'en' }, intlCache);\n};\n\n// Extended type to include age restrictions that may not be in all versions\ninterface TranslationKeysWithAgeRestriction extends TranslationKeys {\n  all_ages: string;\n  ageMinTwentyOne: string;\n  ageMinNineteen: string;\n  ageMinEighteen: string;\n  ageMinSeventeen: string;\n  ageMinSixteen: string;\n  ageMinFifteen: string;\n  ageMinFourteen: string;\n  ageMinThirteen: string;\n  ageMinTwelve: string;\n  ageUnderTwentyOneWithGuardian: string;\n  ageUnderEighteenWithGuardian: string;\n  ageUnderSixteenWithGuardian: string;\n  ageUnderFourteenWithGuardian: string;\n}\n\nexport const getTranslations = (\n  location?: LocationProps,\n  locale = 'en',\n  messages: Messages = {},\n): TranslationKeysWithAgeRestriction => {\n  const intl = getIntl(locale, messages);\n  const isTBDLocation = location && !location.isOnlineEvent && !location.hasAddress;\n\n  return {\n    goodToKnow: intl.formatMessage(GOOD_TO_KNOW_MESSAGE),\n    refundPolicy: intl.formatMessage(REFUND_POLICY_MESSAGE),\n    viewAll: intl.formatMessage(VIEW_ALL_MESSAGE),\n    highlights: intl.formatMessage(HIGHLIGHTS_MESSAGE),\n    all_ages: intl.formatMessage(AGE_RESTRICTION_ALL_AGES_MESSAGE),\n    ageMinTwentyOne: intl.formatMessage(AGE_RESTRICTION_MIN_TWENTY_ONE_MESSAGE),\n    ageMinNineteen: intl.formatMessage(AGE_RESTRICTION_MIN_NINETEEN_MESSAGE),\n    ageMinEighteen: intl.formatMessage(AGE_RESTRICTION_MIN_EIGHTEEN_MESSAGE),\n    ageMinSeventeen: intl.formatMessage(AGE_RESTRICTION_MIN_SEVENTEEN_MESSAGE),\n    ageMinSixteen: intl.formatMessage(AGE_RESTRICTION_MIN_SIXTEEN_MESSAGE),\n    ageMinFifteen: intl.formatMessage(AGE_RESTRICTION_MIN_FIFTEEN_MESSAGE),\n    ageMinFourteen: intl.formatMessage(AGE_RESTRICTION_MIN_FOURTEEN_MESSAGE),\n    ageMinThirteen: intl.formatMessage(AGE_RESTRICTION_MIN_THIRTEEN_MESSAGE),\n    ageMinTwelve: intl.formatMessage(AGE_RESTRICTION_MIN_TWELVE_MESSAGE),\n    ageUnderTwentyOneWithGuardian: intl.formatMessage(AGE_RESTRICTION_UNDER_TWENTY_ONE_WITH_GUARDIAN_MESSAGE),\n    ageUnderEighteenWithGuardian: intl.formatMessage(AGE_RESTRICTION_UNDER_EIGHTEEN_WITH_GUARDIAN_MESSAGE),\n    ageUnderSixteenWithGuardian: intl.formatMessage(AGE_RESTRICTION_UNDER_SIXTEEN_WITH_GUARDIAN_MESSAGE),\n    ageUnderFourteenWithGuardian: intl.formatMessage(AGE_RESTRICTION_UNDER_FOURTEEN_WITH_GUARDIAN_MESSAGE),\n    inPerson: isTBDLocation ? intl.formatMessage(TO_BE_ANNOUNCED_MESSAGE) : intl.formatMessage(IN_PERSON_MESSAGE),\n    online: intl.formatMessage(ONLINE_MESSAGE),\n    scrollLeft: intl.formatMessage(SCROLL_CAROUSEL_LEFT_MESSAGE),\n    scrollRight: intl.formatMessage(SCROLL_CAROUSEL_RIGHT_MESSAGE),\n    freeParking: intl.formatMessage(FREE_PARKING_MESSAGE),\n    paidParking: intl.formatMessage(PAID_PARKING_MESSAGE),\n    readMore: intl.formatMessage(READ_MORE_MESSAGE),\n  };\n};\n\nexport const ageRestrictionsMapTranslations = {\n  all_ages: AGE_RESTRICTION_ALL_AGES_MESSAGE,\n  '21+': AGE_RESTRICTION_MIN_TWENTY_ONE_MESSAGE,\n  '19+': AGE_RESTRICTION_MIN_NINETEEN_MESSAGE,\n  '18+': AGE_RESTRICTION_MIN_EIGHTEEN_MESSAGE,\n  '17+': AGE_RESTRICTION_MIN_SEVENTEEN_MESSAGE,\n  '16+': AGE_RESTRICTION_MIN_SIXTEEN_MESSAGE,\n  '15+': AGE_RESTRICTION_MIN_FIFTEEN_MESSAGE,\n  '14+': AGE_RESTRICTION_MIN_FOURTEEN_MESSAGE,\n  '13+': AGE_RESTRICTION_MIN_THIRTEEN_MESSAGE,\n  '12+': AGE_RESTRICTION_MIN_TWELVE_MESSAGE,\n  under_21_with_guardian: AGE_RESTRICTION_UNDER_TWENTY_ONE_WITH_GUARDIAN_MESSAGE,\n  under_18_with_guardian: AGE_RESTRICTION_UNDER_EIGHTEEN_WITH_GUARDIAN_MESSAGE,\n  under_16_with_guardian: AGE_RESTRICTION_UNDER_SIXTEEN_WITH_GUARDIAN_MESSAGE,\n  under_14_with_guardian: AGE_RESTRICTION_UNDER_FOURTEEN_WITH_GUARDIAN_MESSAGE,\n};\n","import { createIntl, createIntlCache, defineMessage, MessageFormatElement } from 'react-intl';\nimport { parseISO, isValid } from 'date-fns';\nimport type { Duration, RefundPolicyProps } from '@/types';\n\ntype Messages = Record<string, string> | Record<string, MessageFormatElement[]>;\n\nconst intlCache = createIntlCache();\n\nconst DURATION_DAYS_MESSAGE = defineMessage({\n  id: '{days, plural, =1 {# day} other {# days}}',\n  defaultMessage: '{days, plural, =1 {# day} other {# days}}',\n  description: 'Duration in days with plural support',\n});\n\nconst DURATION_HOURS_MESSAGE = defineMessage({\n  id: '{hours, plural, =1 {# hour} other {# hours}}',\n  defaultMessage: '{hours, plural, =1 {# hour} other {# hours}}',\n  description: 'Duration in hours with plural support',\n});\n\nconst DURATION_MINUTES_MESSAGE = defineMessage({\n  id: '{minutes, plural, =1 {# minute} other {# minutes}}',\n  defaultMessage: '{minutes, plural, =1 {# minute} other {# minutes}}',\n  description: 'Duration in minutes with plural support',\n});\n\nconst REFUND_VALID_DAYS_MESSAGE = defineMessage({\n  id: 'Refunds up to {days, plural, =1 {# day} other {# days}} before event',\n  defaultMessage: 'Refunds up to {days, plural, =1 {# day} other {# days}} before event',\n  description: 'Refund policy message with days count and plural support',\n});\n\nconst NO_REFUNDS_MESSAGE = defineMessage({\n  id: 'No refunds',\n  defaultMessage: 'No refunds',\n  description: 'Message to display in highlights when no refunds are allowed',\n});\n\nconst DOOR_TIME_MESSAGE = defineMessage({\n  id: 'Doors at {doorTime}',\n  defaultMessage: 'Doors at {doorTime}',\n  description: 'Message to display in highlights when doors open at a specific time',\n});\n\nconst getIntl = (locale = 'en', messages: Messages = {}) => {\n  return createIntl({ locale, messages, defaultLocale: 'en' }, intlCache);\n};\n\nexport const formatDuration = (duration: Duration, locale = 'en', messages: Messages = {}): string => {\n  const intl = getIntl(locale, messages);\n\n  const daysText = intl.formatMessage(DURATION_DAYS_MESSAGE, { days: duration.days });\n  const hoursText = intl.formatMessage(DURATION_HOURS_MESSAGE, { hours: duration.hours });\n  const minutesText = intl.formatMessage(DURATION_MINUTES_MESSAGE, { minutes: duration.minutes });\n\n  if (duration.days > 0) {\n    if (duration.hours > 0) {\n      return `${daysText} ${hoursText}`;\n    }\n    return daysText;\n  }\n\n  if (duration.hours > 0) {\n    if (duration.minutes > 0) {\n      return `${hoursText} ${minutesText}`;\n    }\n    return hoursText;\n  }\n\n  return minutesText;\n};\n\nconst getValidDaysText = (validDays: number, locale = 'en', messages: Messages = {}): string => {\n  const intl = getIntl(locale, messages);\n  return intl.formatMessage(REFUND_VALID_DAYS_MESSAGE, { days: validDays });\n};\n\nexport const getTranslatedRefundPolicy = (\n  refundPolicy: RefundPolicyProps,\n  isRepeating = false,\n  locale = 'en',\n  messages: Messages = {},\n): string | null => {\n  const { isPaidEvent, validDays, isRefundRequestAllowed, refundPolicyDescription } = refundPolicy;\n\n  if (!isPaidEvent) {\n    return null;\n  }\n\n  if (isRepeating && validDays) {\n    return getValidDaysText(validDays, locale, messages);\n  }\n\n  if (!isRefundRequestAllowed) {\n    const intl = getIntl(locale, messages);\n    return intl.formatMessage(NO_REFUNDS_MESSAGE);\n  }\n\n  if (!validDays) {\n    return refundPolicyDescription || null;\n  }\n\n  return getValidDaysText(validDays, locale, messages);\n};\n\nexport const getDurationObject = (durationInMinutes: number): Duration => {\n  return {\n    totalSeconds: durationInMinutes * 60,\n    days: Math.floor(durationInMinutes / 1440),\n    hours: Math.floor(durationInMinutes / 60) % 24,\n    minutes: durationInMinutes % 60,\n  };\n};\n\nexport const formatDoorTime = (doorTime: string, timezone: string, locale = 'en', messages: Messages = {}): string => {\n  const intl = getIntl(locale, messages);\n\n  if (!doorTime || typeof doorTime !== 'string' || doorTime.trim() === '') {\n    return '';\n  }\n\n  let dateObj: Date;\n  try {\n    dateObj = parseISO(doorTime.trim());\n\n    if (!isValid(dateObj)) {\n      return '';\n    }\n  } catch {\n    return '';\n  }\n\n  const partsFormatter = new Intl.DateTimeFormat(locale, {\n    hour: 'numeric',\n    minute: '2-digit',\n    hour12: true,\n    timeZone: timezone,\n  });\n\n  const parts = partsFormatter.formatToParts(dateObj);\n  const hour = parts.find((part) => part.type === 'hour')?.value;\n  const minute = parts.find((part) => part.type === 'minute')?.value;\n  const dayPeriod = parts.find((part) => part.type === 'dayPeriod')?.value;\n\n  if (!hour || !minute || !dayPeriod) {\n    const fallbackFormatter = new Intl.DateTimeFormat(locale, {\n      hour: 'numeric',\n      minute: '2-digit',\n      hour12: true,\n      timeZone: timezone,\n    });\n    const formattedTime = fallbackFormatter.format(dateObj);\n    return intl.formatMessage(DOOR_TIME_MESSAGE, { doorTime: formattedTime });\n  }\n\n  const formattedTime = minute === '00' ? `${hour}${dayPeriod}` : `${hour}:${minute} ${dayPeriod}`;\n\n  return intl.formatMessage(DOOR_TIME_MESSAGE, { doorTime: formattedTime });\n};\n\nexport const isNotValidDuration = (durationInMinutes: number): boolean => {\n  return durationInMinutes <= 0 || isNaN(durationInMinutes);\n};\n","import { useMemo } from 'react';\nimport { useIntl } from 'react-intl';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport type { LocationProps, RefundPolicyProps } from '@/types';\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\nimport { GoodToKnow as G2K } from '@eventbrite/good-to-know';\nimport { formatDuration, getDurationObject, formatDoorTime } from '@/components/GoodToKnow/utils';\nimport { getTranslatedRefundPolicy, isNotValidDuration } from '@/components/GoodToKnow/utils';\nimport { ageRestrictionsMapTranslations } from '@/components/GoodToKnow/translations';\n\ntype G2KHighlights = React.ComponentProps<typeof G2K>['highlights'];\n\nexport const useGoodToKnowData = (\n  highlights: NonNullable<WebappResponse['goodToKnow']>['highlights'],\n  refundPolicy: NonNullable<WebappResponse['goodToKnow']>['refundPolicy'],\n) => {\n  const { locale, messages, formatMessage } = useIntl();\n  const { isSeries, isOnline, venue, isFree, startDate, hideEndDate, hideStartDate } = useBasicInfo();\n\n  const hideStartOrEndDate = hideEndDate || hideStartDate;\n\n  const location: LocationProps = useMemo(\n    () =>\n      ({\n        hasAddress: !!venue,\n        isOnlineEvent: isOnline,\n      }) as LocationProps,\n    [venue, isOnline],\n  );\n\n  const parsedRefundPolicy: RefundPolicyProps = useMemo(\n    () =>\n      ({\n        ...refundPolicy,\n        isPaidEvent: !isFree,\n        isRefundRequestAllowed: refundPolicy?.isRefundAllowed,\n        refundPolicyOrganizer: refundPolicy?.refundRequestOrganizer,\n      }) as RefundPolicyProps,\n    [isFree, refundPolicy],\n  );\n\n  const dHighlights: G2KHighlights | undefined = useMemo(() => {\n    if (!highlights) return undefined;\n\n    const timezone = startDate?.timezone || 'UTC';\n    const formattedDoorTime = highlights.doorTime\n      ? formatDoorTime(highlights.doorTime, timezone, locale, messages)\n      : undefined;\n\n    const getTranslatedAgeRestriction = (ageRestriction: string | undefined) => {\n      if (!ageRestriction) return undefined;\n\n      const messageObject =\n        ageRestrictionsMapTranslations[ageRestriction as keyof typeof ageRestrictionsMapTranslations];\n      return messageObject ? formatMessage(messageObject) : ageRestriction;\n    };\n\n    const translatedAgeRestriction = getTranslatedAgeRestriction(highlights.ageRestriction);\n\n    return {\n      ...highlights,\n      isOnline,\n      doorTime: formattedDoorTime,\n      age_restriction: translatedAgeRestriction,\n      durationString:\n        !highlights.durationInMinutes || isNotValidDuration(highlights.durationInMinutes) || hideStartOrEndDate\n          ? undefined\n          : formatDuration(getDurationObject(highlights.durationInMinutes), locale, messages),\n      parking: highlights.parking === 'free' || highlights.parking === 'paid',\n    };\n  }, [highlights, isOnline, locale, messages, startDate, hideStartOrEndDate, formatMessage]);\n\n  const translatedRefundPolicy = getTranslatedRefundPolicy(parsedRefundPolicy, isSeries, locale, messages);\n\n  return {\n    dHighlights,\n    translatedRefundPolicy,\n    location,\n  };\n};\n","import { GoodToKnow as G2K, CardSize, TranslationProvider, TrackingProvider } from '@eventbrite/good-to-know';\nimport { useRef } from 'react';\nimport { useIntl } from 'react-intl';\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\nimport { getTranslations } from './translations';\nimport { useGoodToKnowData } from '@/components/GoodToKnow/useGoodToKnowData';\nimport { track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { LISTING_HEAP_IDS, STATSIG_EVENT_NAMES } from '@/components/_shared/constants';\nimport { logEvent } from '@eventbrite/legacy-infra.statsig';\nimport styles from './GoodToKnow.module.scss';\n\n// TODO: Move this props into their own context provider\nexport const GoodToKnow: React.FC<NonNullable<WebappResponse['goodToKnow']>> = ({ highlights, refundPolicy }) => {\n  const { locale, messages } = useIntl();\n\n  const { dHighlights, translatedRefundPolicy, location } = useGoodToKnowData(highlights, refundPolicy);\n\n  const g2kRef = useRef<HTMLDivElement>(null);\n\n  return (\n    <TrackingProvider\n      data-testid=\"g2k-container\"\n      onSectionVisible={(sectionKey: string) => {\n        track({\n          eventName: LISTING_HEAP_IDS.G2K_VIEW_CARD,\n          eventData: {\n            card_key: sectionKey,\n          },\n        });\n        logEvent(STATSIG_EVENT_NAMES.G2K_VIEW_CARD, null, {\n          card_key: sectionKey,\n        });\n      }}\n      onReadMoreClick={(sectionKey: string) => {\n        track({\n          eventName: LISTING_HEAP_IDS.G2K_READ_MORE_CLICK,\n          eventData: {\n            card_key: sectionKey,\n          },\n        });\n        logEvent(STATSIG_EVENT_NAMES.G2K_READ_MORE_CLICK, null, {\n          card_key: sectionKey,\n        });\n      }}\n    >\n      <TranslationProvider translations={getTranslations(location, locale, messages)}>\n        <div className={styles.g2k}>\n          <G2K\n            highlights={dHighlights}\n            refundPolicy={translatedRefundPolicy || ''}\n            cardSize={refundPolicy ? CardSize.STRETCHED : CardSize.CONTAINED}\n            showViewAll={false}\n          />\n          <div ref={g2kRef} />\n        </div>\n      </TranslationProvider>\n    </TrackingProvider>\n  );\n};\n","import { HighLevelStatus } from '@/utils/highLevelStatus';\nimport { defineMessage, type MessageDescriptor } from 'react-intl';\n\nexport const CONVERSION_BAR_MESSAGES: Partial<Record<HighLevelStatus, MessageDescriptor>> = {\n  [HighLevelStatus.EVENT_ENDED]: defineMessage({\n    id: 'Sales ended',\n    defaultMessage: 'Sales ended',\n    description: 'Sales ended message for ended/completed events in conversion bar',\n  }),\n  [HighLevelStatus.SALES_ENDED]: defineMessage({\n    id: 'Sales ended',\n    defaultMessage: 'Sales ended',\n    description: 'Sales ended event message in conversion bar',\n  }),\n  [HighLevelStatus.SOLD_OUT]: defineMessage({\n    id: 'Sold out',\n    defaultMessage: 'Sold out',\n    description: 'Event status indicating tickets are sold out',\n  }),\n  [HighLevelStatus.UNAVAILABLE]: defineMessage({\n    id: 'Unavailable',\n    defaultMessage: 'Unavailable',\n    description: 'Unavailable event message in conversion bar',\n  }),\n  [HighLevelStatus.POSTPONED]: defineMessage({\n    id: 'Postponed',\n    defaultMessage: 'Postponed',\n    description: 'Event status indicating the event has been postponed',\n  }),\n  [HighLevelStatus.CANCELLED]: defineMessage({\n    id: 'Cancelled',\n    defaultMessage: 'Cancelled',\n    description: 'Event status indicating the event has been cancelled',\n  }),\n  [HighLevelStatus.SALES_START_SOON]: defineMessage({\n    id: 'On sale {date}',\n    defaultMessage: 'On sale {date}',\n    description: 'Sales start soon event message in conversion bar',\n  }),\n};\n\n// Check this list as it was generated with an AI tool from CORE codebase\nexport const SUPPORTED_CURRENCIES = [\n  'USD',\n  'CAD',\n  'EUR',\n  'GBP',\n  'JPY',\n  'AUD',\n  'NZD',\n  'CHF',\n  'HKD',\n  'SGD',\n  'SEK',\n  'DKK',\n  'PLN',\n  'NOK',\n  'HUF',\n  'CZK',\n  'MXN',\n  'ILS',\n  'ARS',\n  'BRL',\n  'CLP',\n  'MYR',\n  'PHP',\n  'TWD',\n  'THB',\n  'TRY',\n];\n","import { type BasicInfo, EVENT_STATUS, type Gallery } from '@/types';\n\nexport const isEventEnded = (status: string): boolean => {\n  return status === EVENT_STATUS.ENDED || status === EVENT_STATUS.COMPLETED;\n};\n\nexport const isEventLive = (status: string): boolean => {\n  return status === EVENT_STATUS.LIVE || status === EVENT_STATUS.STARTED;\n};\n\nexport const isEventCancelled = (status: string): boolean => {\n  return status === EVENT_STATUS.CANCELLED;\n};\n\nexport const isEventPostponed = (status: string): boolean => {\n  return status === EVENT_STATUS.POSTPONED;\n};\n\nexport const isEventSalesEnded = (status: string): boolean => {\n  return status === EVENT_STATUS.DELETED;\n};\n\n/** Path segment after /e/ in the event URL, falling back to basicInfo.id. */\nexport const getEventSlugFromBasicInfo = (basicInfo: BasicInfo): string => {\n  try {\n    const match = new URL(basicInfo.url).pathname.match(/^\\/e\\/([^/]+)/);\n    if (match) return match[1];\n  } catch {\n    // invalid or missing URL – fall through\n  }\n  return basicInfo.id ?? '';\n};\n\nexport const getViewDetailsUrl = (basicInfo: BasicInfo | null): string | null => {\n  if (!basicInfo || !isEventEnded(basicInfo.status) || !basicInfo.url) {\n    return null;\n  }\n  return `${basicInfo.url}?viewDetails=true`;\n};\n\nexport const getCarouselItems = (gallery?: Gallery) => {\n  return (\n    gallery?.images?.map(({ croppedLogoUrl480, croppedLogoUrl600, croppedLogoUrl940 }) => ({\n      croppedLogoUrl480,\n      croppedLogoUrl600,\n      croppedLogoUrl940,\n    })) ?? []\n  );\n};\n","import currency from 'currency.js';\nimport { SUPPORTED_CURRENCIES } from './constants';\nimport { getFormattedDateTime } from '@eventbrite/legacy-infra.datetime-fns';\nimport { TicketInformationResponse } from '@/pages/api/[eventId]/ticket-information.page';\nimport { isEventCancelled, isEventEnded, isEventPostponed } from '@/components/Body/utils/bodyUtils';\nimport { IntlShape } from 'react-intl';\nimport { getDisplayTimezone } from '@/utils/dateTime';\nimport { HighLevelStatus } from '@/utils/highLevelStatus';\nimport { EVENT_STATUS } from '@/types';\n\n// This value is kept from CORE implementation for keeping the same behavior\nconst MAX_PRICE_RANGE_LENGTH = 13;\n\nconst DEFAULT_CURRENCY_EXPONENT = 2;\n\nconst CURRENCY_EXPONENTS: Record<string, number> = {\n  JPY: 0,\n  KRW: 0,\n  VND: 0,\n  BHD: 3,\n  JOD: 3,\n  KWD: 3,\n  OMR: 3,\n  TND: 3,\n};\n\nexport const formatV3Price = (\n  price: number,\n  currencyCode: string,\n  locale: string,\n  roundUp: boolean = false,\n  removeTrailingZeros: boolean = false,\n): string => {\n  if (!currencyCode || !isValidCurrency(currencyCode)) {\n    return '';\n  }\n\n  const normalizedCurrency = currencyCode.toUpperCase();\n  const exponent = CURRENCY_EXPONENTS[normalizedCurrency] ?? DEFAULT_CURRENCY_EXPONENT;\n\n  let amount = currency(price, { precision: exponent });\n\n  // Convert to major units\n  const divisor = Math.pow(10, exponent);\n  amount = amount.divide(divisor);\n\n  // Handle round up\n  if (roundUp) {\n    amount = currency(amount.add(0.99).intValue, { precision: exponent });\n  }\n\n  // Use Intl.NumberFormat for locale-specific formatting\n  const formatter = new Intl.NumberFormat(locale, {\n    style: 'currency',\n    currency: normalizedCurrency,\n    minimumFractionDigits: roundUp ? 0 : exponent,\n    maximumFractionDigits: exponent,\n  });\n\n  let formatted = formatter.format(amount.value);\n\n  // Remove trailing zeros if requested and not rounding up\n  if (removeTrailingZeros && !roundUp) {\n    formatted = formatted.replace(/\\.0+$/, '');\n  }\n\n  return formatted;\n};\n\nexport const isValidCurrency = (currency: string): boolean => {\n  return SUPPORTED_CURRENCIES.includes(currency.toUpperCase());\n};\n\n/** Shape used for conversion bar price display (ticket-information and external ticketing). Value in minor units. */\nexport type PanelPriceInfo = {\n  minimumTicketPrice?: { value?: number; currency?: string };\n  maximumTicketPrice?: { value?: number; currency?: string };\n  isFree?: boolean;\n};\n\n/**\n * Formats price for the conversion bar.\n * Supports optional min/max and isFree so it can be used for both ticket-information and external ticketing.\n */\nexport const getPanelDisplayPriceFromPriceInfo = (\n  priceInfo: PanelPriceInfo,\n  locale: string,\n  formatMessage: IntlShape['formatMessage'],\n): string => {\n  const minValue = priceInfo.minimumTicketPrice?.value;\n  const maxValue = priceInfo.maximumTicketPrice?.value;\n  const currency = priceInfo.minimumTicketPrice?.currency ?? priceInfo.maximumTicketPrice?.currency;\n\n  const bothZero = minValue === 0 && maxValue === 0;\n  if (priceInfo.isFree || bothZero) {\n    return formatMessage({ id: 'Free', defaultMessage: 'Free', description: 'Free event price in conversion bar' });\n  }\n\n  const hasMin = minValue !== undefined && minValue != null && currency;\n  const hasMax = maxValue !== undefined && maxValue != null && currency;\n\n  if (!hasMin && !hasMax) return '';\n\n  if (hasMin && hasMax) {\n    const minPrice = formatV3Price(minValue!, currency!, locale, false, true);\n    const maxPrice = formatV3Price(maxValue!, currency!, locale, false, true);\n    if (!minPrice || !maxPrice) return '';\n    if (minPrice === maxPrice) return minPrice;\n    const priceRange = `${minPrice} - ${maxPrice}`;\n    return priceRange.length > MAX_PRICE_RANGE_LENGTH\n      ? formatMessage({\n          id: 'From',\n          defaultMessage: 'From',\n          description: 'Used for price range in conversion bar for stating only the minimum price',\n        }) + ` ${minPrice}`\n      : priceRange;\n  }\n\n  if (hasMin) {\n    return formatV3Price(minValue!, currency!, locale, false, true);\n  }\n  return formatV3Price(maxValue!, currency!, locale, false, true);\n};\n\nexport const getPanelDisplayPrice = (\n  ticketAvailabilityData: TicketInformationResponse,\n  locale: string,\n  formatMessage: IntlShape['formatMessage'],\n): string => {\n  const priceInfo: PanelPriceInfo = {\n    minimumTicketPrice: ticketAvailabilityData?.minimumTicketPrice,\n    maximumTicketPrice: ticketAvailabilityData?.maximumTicketPrice,\n    isFree:\n      ticketAvailabilityData?.minimumTicketPrice?.value === 0 &&\n      ticketAvailabilityData?.maximumTicketPrice?.value === 0,\n  };\n  return getPanelDisplayPriceFromPriceInfo(priceInfo, locale, formatMessage);\n};\n\nexport const getStartDate = (\n  date: TicketInformationResponse['startSalesDate'],\n  locale: string,\n  isOnlineEvent: boolean = false,\n  attendeeTimezone?: string,\n) => {\n  if (!date) return '';\n\n  const timezone = getDisplayTimezone({\n    isOnlineEvent,\n    eventTimezone: date.timezone,\n    attendeeTimezone,\n  });\n  const formatted = getFormattedDateTime(date.utc, true, timezone, locale, `MMM d · p`);\n  return formatted.replace(/(AM|PM)/g, (match) => match.toLowerCase());\n};\n\nexport const shouldShowExploreEventsButton = (status: string): boolean => {\n  return isEventEnded(status) || isEventCancelled(status) || isEventPostponed(status);\n};\n\nexport const shouldShowDiscountSignal = (ticketInfo?: TicketInformationResponse | null): boolean => {\n  return !!(\n    ticketInfo?.availability?.hasBogoTickets ||\n    ticketInfo?.availability?.hasEarlyBirdTickets ||\n    (ticketInfo?.discounts && ticketInfo?.discounts?.length > 0)\n  );\n};\n\nexport const shouldDisplayRsvp = (\n  mipaParam: string | null,\n  status: string,\n  highLevelStatus?: HighLevelStatus,\n  ticketInfo?: TicketInformationResponse | null,\n): boolean => !!mipaParam && shouldShowCheckoutButton(status, highLevelStatus, ticketInfo);\n\nexport const shouldShowCheckoutButton = (\n  status: string,\n  highLevelStatus?: HighLevelStatus,\n  ticketInfo?: TicketInformationResponse | null,\n): boolean => {\n  if (\n    [\n      EVENT_STATUS.UNSAVED,\n      EVENT_STATUS.DRAFT,\n      EVENT_STATUS.CANCELLED,\n      EVENT_STATUS.DELETED,\n      EVENT_STATUS.POSTPONED,\n      EVENT_STATUS.COMPLETED,\n      EVENT_STATUS.ENDED,\n    ].includes(status)\n  ) {\n    return false;\n  }\n\n  if (\n    highLevelStatus &&\n    [\n      HighLevelStatus.SALES_ENDED,\n      HighLevelStatus.UNAVAILABLE,\n      HighLevelStatus.POSTPONED,\n      HighLevelStatus.CANCELLED,\n      HighLevelStatus.SALES_START_SOON,\n      HighLevelStatus.EVENT_ENDED,\n      HighLevelStatus.COMPLETED,\n    ].includes(highLevelStatus)\n  ) {\n    return false;\n  }\n\n  if (\n    ticketInfo?.isSoldOut === true &&\n    !ticketInfo?.availability?.waitlistAvailable &&\n    !ticketInfo?.availability?.waitlistEnabled\n  ) {\n    return false;\n  }\n\n  if (highLevelStatus === HighLevelStatus.SOLD_OUT && ticketInfo?.isSoldOut === undefined) {\n    return false;\n  }\n\n  return true;\n};\n\nexport const shouldShowSoldOutText = (\n  highLevelStatus: HighLevelStatus,\n  ticketInfo?: TicketInformationResponse | null,\n): boolean => {\n  return highLevelStatus === HighLevelStatus.SOLD_OUT || ticketInfo?.isSoldOut === true;\n};\n\nexport const generateRandomHast = () => (Math.random() + 1).toString(36).substring(7);\n","import { updatePageProps, track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { LISTING_HEAP_IDS } from '@/components/_shared/constants';\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\nimport { getRefundPolicy } from './utils';\nimport type { TicketInformationResponse } from '@/pages/api/[eventId]/ticket-information.page';\nimport { getHighLevelStatus, HighLevelStatus } from './highLevelStatus';\nexport interface CorePageProperties {\n  listingSource: string;\n  timedEntry: boolean;\n\n  eventId: string;\n  eventStartDate: string;\n  eventEndDate: string;\n  eventIsEnded: boolean;\n  eventOrganizerId: string;\n  eventIsOnlineEvent: boolean;\n  eventOwnerId: string;\n  eventCountry?: string;\n  eventRegion?: string;\n  eventStatus: string;\n  eventStatusSales: string | undefined;\n  eventIsCanceled?: boolean;\n  eventIsPostponed?: boolean;\n  eventIsSalesEnded?: boolean;\n  eventIsSoldOut?: boolean;\n\n  isLive: boolean;\n  isOnline: boolean;\n  isPrivate: boolean;\n  isRepeatingEvent: boolean;\n\n  multiticket: boolean;\n  hasHeroImages: boolean;\n  hasImages: boolean;\n\n  childEventId?: string;\n\n  isFree: boolean;\n  isPaid: boolean;\n  isSeriesParent: boolean;\n  isListed: boolean;\n  locale: string;\n\n  eventCurrency: string;\n  eventSource: string;\n  eventIsExpired: boolean;\n\n  // Event taxonomies\n  category: string;\n  subcategory: string;\n  format: string;\n  eventCategory: string;\n  eventSubcategory: string;\n  eventFormat: string;\n\n  // Lineup\n  hasArtistWidget: boolean;\n\n  // Related to \"Good to know\"\n  goodToKnowAge: boolean;\n  goodToKnowCheckin: boolean;\n  goodToKnowParking?: string;\n  goodToKnowFAQNumber: number;\n  eventRefund: string;\n  eventAgeRestriction: string;\n  eventDurationSeconds?: number;\n\n  // RSVP\n  hasRSVP: boolean;\n\n  // External tickets\n  hasExternalTickets: boolean;\n\n  // Waitlist (set client-side when ticket info is available)\n  hasWaitlistEnabled?: boolean;\n\n  // Authentication (set client-side when user info is available)\n  isAuthenticated: boolean;\n\n  // Referrer source (true when traffic comes from an Eventbrite domain)\n  EBSource: boolean;\n\n  // Ticket information\n  eventHasReservedSeating?: boolean;\n  eventHasMoreThanOneTicket?: boolean;\n  eventHasDiscounts?: boolean;\n  eventHasDonations?: boolean;\n  eventHasAddons?: boolean;\n\n  // FAQs / content (context-derived)\n  faqsNumber?: number;\n  hasFaqs?: boolean;\n  hasAgenda?: boolean;\n  hasDescriptionImages?: boolean;\n\n  // Hero / video (context-derived)\n  hasVideo?: boolean;\n  heroVideo?: boolean;\n  videoSource?: 'service' | 'url' | null; // \"service\" if it is a native video, \"url\" if it is a featured video\n\n  // Discounts / tickets (client-side after fetch)\n  has2x1?: boolean;\n  hasEarlyBirdDiscount?: boolean;\n  hasOpenDiscount?: boolean;\n  hasPrivateDiscount?: boolean;\n\n  // Urgency signals (client-side after fetch)\n  hasUrgencySignals?: boolean;\n  hasFewTicketsLeftUrgencySignal?: boolean;\n  hasGoingFastUrgencySignal?: boolean;\n  hasNewUrgencySignal?: boolean;\n  hasPopularUrgencySignal?: boolean;\n  hasSalesEndSoonUrgencySignal?: boolean;\n}\n\n/**\n *  Ongoing work to add all page properties. This interface should eventually be removed as we\n *  complete adding all the needed properties.\n *\n *  For reference, the legacy page properties are defined in:\n *  - https://github.com/eventbrite/eb-ui/blob/main/packages/attendee/listings/src/tracking/dataLayerMiddleware.ts\n *  - https://github.com/eventbrite/analytics-instrumentation/blob/main/google-tag-manager/tag_generators/heap_page_props/src/reducers/event-listing.ts\n */\ninterface NotYetAvailablePageProperties {\n  hasAutogeneratedContent: boolean; // TODO: Add this prop to the context within structured content block\n\n  // Unclassified\n  isSeriesInfiniteCalendar: boolean; // Deprecated?\n  shouldShowExpressCheckout: boolean; // Deprecated?\n  eventShouldShowCompactCheckout: boolean; // Deprecated?\n}\n\ntype PageProperties = CorePageProperties & Partial<NotYetAvailablePageProperties>;\n\nexport function addPagePropertiesFromRenderContext(context: WebappResponse, isAuthenticated: boolean) {\n  const isEventEnded = ['ended', 'completed', 'deleted'].includes(context.basicInfo.status);\n  const isFree = context.basicInfo.isFree || false;\n  const hasFeaturedVideo = !!context.gallery?.featuredVideo?.url;\n  const hasNativeVideo = !!context.gallery?.nativeVideo?.url;\n  const hasVideoInDescription = !!context.structuredContent?.modules?.some(\n    (m: { type?: string }) => m.type === 'video',\n  );\n\n  const hasVideo = hasVideoInDescription || hasFeaturedVideo || hasNativeVideo;\n\n  const page: CorePageProperties = {\n    listingSource: 'web:valkyrie',\n    timedEntry: context.basicInfo.isTimedEntry ?? false,\n    eventEndDate: context.basicInfo.endDate.utc || '',\n    eventId:\n      context.basicInfo.isSeries && context.basicInfo.seriesId ? context.basicInfo.seriesId : context.basicInfo.id,\n    eventStartDate: context.basicInfo.startDate.utc || '',\n    hasHeroImages: Array.isArray(context.gallery?.images) && context.gallery.images.length > 0,\n    hasImages: Array.isArray(context.gallery?.images) && context.gallery.images.length > 0,\n    isLive: context.basicInfo.status === 'live',\n    isOnline: context.basicInfo.isOnline || false,\n    isPrivate: context.basicInfo.isProtected || false,\n    isRepeatingEvent: context.basicInfo.isSeries || false,\n    multiticket: false,\n    eventCountry: context.basicInfo.venue?.address?.country,\n    eventIsEnded: isEventEnded,\n    eventIsExpired: isEventEnded,\n    eventIsOnlineEvent: context.basicInfo.isOnline || false,\n    eventOwnerId: context.basicInfo.organizationId,\n    eventRegion: context.basicInfo.venue?.address?.region,\n    eventOrganizerId: context.basicInfo.organizer.id,\n    childEventId: context.basicInfo.isSeries ? context.basicInfo.id : undefined,\n    isFree,\n    isPaid: !isFree,\n    isSeriesParent: context.basicInfo.isParentEvent,\n    isListed: context.basicInfo.isListed,\n    locale: context.basicInfo.locale,\n    eventStatus: context.basicInfo.status,\n    eventStatusSales: context.salesStatus?.salesStatus,\n    ...getSalesStateFlags(context.salesStatus),\n    eventCurrency: context.basicInfo.currency,\n    eventSource: context.basicInfo.ticketsBy,\n    category: normalizeValue(context.taxonomies?.category),\n    subcategory: normalizeValue(context.taxonomies?.subcategory),\n    format: normalizeValue(context.taxonomies?.format),\n    eventCategory: normalizeValue(context.taxonomies?.category),\n    eventSubcategory: normalizeValue(context.taxonomies?.subcategory),\n    eventFormat: normalizeValue(context.taxonomies?.format),\n    hasArtistWidget: typeof context.artistInfo?.artistType !== 'undefined' || false,\n    goodToKnowAge: !!context.goodToKnow?.highlights?.ageRestriction,\n    goodToKnowParking: context.goodToKnow?.highlights?.parking,\n    goodToKnowCheckin: !!context.goodToKnow?.highlights?.doorTime,\n    goodToKnowFAQNumber: context.structuredContent?.widgets?.faqs?.length || 0,\n    eventRefund: getRefundPolicy(context.goodToKnow?.refundPolicy),\n    eventAgeRestriction: context.goodToKnow?.highlights?.ageRestriction || '',\n    hasRSVP: false,\n    hasExternalTickets: context.basicInfo.hasExternalTickets ?? false,\n    isAuthenticated: isAuthenticated,\n    eventHasReservedSeating: context.basicInfo.eventHasReservedSeating ?? false,\n    eventDurationSeconds: context.basicInfo.eventDurationSeconds,\n\n    hasVideo,\n    heroVideo: hasFeaturedVideo || hasNativeVideo,\n    videoSource: getVideoSource(hasFeaturedVideo, hasNativeVideo),\n\n    hasAgenda: !!context.structuredContent?.widgets?.agenda,\n    hasFaqs: !!context.structuredContent?.widgets?.faqs?.length,\n    faqsNumber: context.structuredContent?.widgets?.faqs?.length || 0,\n\n    hasDescriptionImages: !!context.structuredContent?.modules?.some((m: { type?: string }) => m.type === 'image'),\n\n    EBSource: getEBSource(),\n  };\n\n  updatePageProperties(page);\n}\n\nfunction updatePageProperties(page: PageProperties) {\n  updatePageProps({ page });\n}\n\n// ------------------------------------------------------------\n// Render Context Helpers\n// ------------------------------------------------------------\n\nfunction normalizeValue(value: string | undefined): string {\n  return value?.toLocaleLowerCase().replace(/\\s/g, '_') || '';\n}\n\nfunction getSalesStateFlags(salesStatusData?: WebappResponse['salesStatus']) {\n  const status = getHighLevelStatus(salesStatusData);\n  return {\n    eventIsCanceled: status === HighLevelStatus.CANCELLED,\n    eventIsPostponed: status === HighLevelStatus.POSTPONED,\n    eventIsSalesEnded: status === HighLevelStatus.SALES_ENDED,\n    eventIsSoldOut: status === HighLevelStatus.SOLD_OUT,\n  };\n}\n\nfunction getVideoSource(hasFeaturedVideo: boolean, hasNativeVideo: boolean): 'service' | 'url' | null {\n  if (hasNativeVideo) return 'service';\n  if (hasFeaturedVideo) return 'url';\n  return null;\n}\n\nfunction getEBSource(): boolean {\n  if (typeof document === 'undefined' || document.referrer === '') return false;\n  try {\n    const referrer = new URL(document.referrer);\n    return referrer.hostname.includes('eventbrite');\n  } catch {\n    return false;\n  }\n}\n\n// ------------------------------------------------------------\n// Client-side Helpers\n// ------------------------------------------------------------\n\nexport function updateWaitlistPageProperty(hasWaitlistEnabled: boolean) {\n  updatePageProps({ page: { hasWaitlistEnabled } });\n}\n\nexport function updateRsvpPageProperty(hasRSVP: boolean) {\n  updatePageProps({ page: { hasRSVP } });\n}\n\nexport function updateTicketInformationPageProperties(ticketInformation: TicketInformationResponse) {\n  function hasDiscountType(discountType: 'coded' | 'access' | 'public' | 'hold' | 'open') {\n    return ticketInformation?.discounts?.some((d) => d.discount_type === discountType);\n  }\n\n  const has2x1 = ticketInformation?.availability?.hasBogoTickets ?? false;\n  const hasEarlyBirdDiscount = ticketInformation?.availability?.hasEarlyBirdTickets ?? false;\n  const hasOpenDiscount = hasDiscountType('open');\n  const hasPrivateDiscount = hasDiscountType('coded');\n\n  updatePageProps({\n    page: {\n      eventHasMoreThanOneTicket: (ticketInformation?.numTicketClasses ?? 0) > 1 || false,\n      eventHasAddons: ticketInformation?.eventHasAddons ?? false,\n      eventHasDonations: ticketInformation?.eventHasDonations ?? false,\n      eventTotalTicketsCount: ticketInformation?.numTicketClasses ?? 0,\n      has2x1,\n      hasEarlyBirdDiscount,\n      hasOpenDiscount,\n      hasPrivateDiscount,\n      eventHasDiscounts: has2x1 || hasEarlyBirdDiscount || hasOpenDiscount || hasPrivateDiscount,\n    },\n  });\n}\n\nexport function updateUrgencySignalsPageProperties(signals: string[]) {\n  updatePageProps({ page: urgencySignalsToPageProperties(signals) });\n}\n\n/**\n * Maps urgency-signals API response (array of signal names) to HEAP page properties.\n */\nexport function urgencySignalsToPageProperties(signals: string[]) {\n  const set = new Set(signals);\n  return {\n    hasUrgencySignals: signals.length > 0,\n    hasEarlyBirdDiscount: set.has('earlyBird'),\n    hasFewTicketsLeftUrgencySignal: set.has('fewTickets'),\n    hasGoingFastUrgencySignal: set.has('goingFast'),\n    hasNewUrgencySignal: set.has('new'),\n    hasPopularUrgencySignal: set.has('popular'),\n    hasSalesEndSoonUrgencySignal: set.has('salesEndSoon'),\n  };\n}\n\n/**\n * Fires a custom event after all lazy-loaded page properties (e.g. hasWaitlistEnabled)\n * have been pushed to the dataLayer. GTM picks up this event and can re-send the\n * now-complete page properties to Heap, ensuring they are available for analytics\n * even though they were not present at initial page load.\n */\nexport function trackConversionBarHydration() {\n  track({ eventName: LISTING_HEAP_IDS.CONVERSION_BAR_HYDRATE, eventData: {} });\n}\n","import type { TicketInformationResponse } from '@/pages/api/[eventId]/ticket-information.page';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport {\n  updateWaitlistPageProperty,\n  trackConversionBarHydration,\n  updateTicketInformationPageProperties,\n} from '@/utils/dataLayer';\nimport { useQuery } from '@tanstack/react-query';\nimport { useEffect } from 'react';\n\nexport const TICKET_INFORMATION_TIMEOUT_MS = 10000;\n\n/**\n * Module-level flag to ensure dataLayer page properties and the hydration event\n * are only pushed once per page load, regardless of how many components call\n * useTicketInformation.\n */\nlet hasTrackedPageProperties = false;\n\n/** @internal Exposed for testing only */\nexport function _resetTracking() {\n  hasTrackedPageProperties = false;\n}\n\n/**\n * Fetches ticket information for a given event from the API.\n *\n * This function implements a timeout mechanism to prevent long-running requests.\n * If the request exceeds the timeout duration or the API call fails, it returns null.\n *\n * @param eventId\n * @param organizationId\n * @param isSeries - Whether the event is part of a series\n * @param isParentEvent - Whether the event is a parent event in a series\n * @param isOnline - Whether the event is online (affects caching and client IP forwarding)\n * @returns A Promise that resolves to:\n *   - `TicketInformationResponse` if the API call succeeds within the timeout\n *   - `null` if the request times out or the API call fails\n */\nexport const getTicketInformation = async (\n  eventId: string,\n  organizationId: string,\n  isSeries: boolean,\n  isParentEvent: boolean,\n  isOnline: boolean,\n  requestedPromoCode?: string,\n  eventTimezone?: string,\n): Promise<TicketInformationResponse | null> => {\n  const controller = new AbortController();\n  const timeoutId = setTimeout(() => {\n    controller.abort();\n  }, TICKET_INFORMATION_TIMEOUT_MS);\n\n  const isChild = isSeries && !isParentEvent;\n  const params = new URLSearchParams({\n    organizationId,\n    isChild: String(isChild),\n    isOnline: String(isOnline),\n  });\n  if (requestedPromoCode) {\n    params.set('discountCode', requestedPromoCode);\n  }\n  if (eventTimezone) {\n    params.set('eventTimezone', eventTimezone);\n  }\n\n  try {\n    const response = await fetch(`/e/api/${eventId}/ticket-information?${params.toString()}`, {\n      signal: controller.signal,\n    });\n    if (!response.ok) {\n      return null;\n    }\n    return response.json();\n  } catch (error) {\n    if (error instanceof Error && error.name === 'AbortError') {\n      console.error('Ticket information request timed out and was aborted.');\n      return null;\n    }\n    return null;\n  } finally {\n    clearTimeout(timeoutId);\n  }\n};\n\nexport const useTicketInformation = (): [TicketInformationResponse | null, boolean] => {\n  const { id: eventId, organizationId, isSeries, isParentEvent, isOnline, startDate } = useBasicInfo();\n  const searchParams = new URLSearchParams(typeof window !== 'undefined' ? window.location.search : '');\n  const requestedPromoCode = searchParams.get('discount') || searchParams.get('access') || undefined;\n  const eventTimezone = startDate?.timezone;\n  const { data, isLoading } = useQuery({\n    queryKey: [\n      'ticketInformation',\n      eventId,\n      organizationId,\n      isSeries,\n      isParentEvent,\n      isOnline,\n      eventTimezone,\n      requestedPromoCode,\n    ],\n    queryFn: () =>\n      getTicketInformation(\n        eventId,\n        organizationId,\n        isSeries ?? false,\n        isParentEvent,\n        isOnline ?? false,\n        requestedPromoCode,\n        eventTimezone,\n      ),\n  });\n\n  useEffect(() => {\n    if (data?.availability && !hasTrackedPageProperties) {\n      hasTrackedPageProperties = true;\n      const hasWaitlistEnabled = !!data.availability.waitlistAvailable || !!data.availability.waitlistEnabled;\n      updateWaitlistPageProperty(hasWaitlistEnabled);\n      updateTicketInformationPageProperties(data);\n      trackConversionBarHydration();\n    }\n  }, [data]);\n\n  return [data ?? null, isLoading];\n};\n","import { useCallback } from 'react';\nimport { logEvent } from '@eventbrite/legacy-infra.statsig';\nimport { GACodes, STATSIG_EVENT_NAMES } from '@/components/_shared/constants';\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\n\nexport const useTrackCheckoutButtonClick = () => {\n  const trackCheckoutButtonClick = useCallback((trackingLabel?: string) => {\n    logEvent(STATSIG_EVENT_NAMES.LISTING_CONVERSION_BAR_CTA_CLICK);\n    trackAnalyticsEvent({\n      action: GACodes.GA_ACTION_CHECKOUT,\n      category: GACodes.GA_CATEGORY_LISTING,\n      label: trackingLabel ?? 'Get Tickets',\n    });\n  }, []);\n\n  return trackCheckoutButtonClick;\n};\n","import { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { useTicketInformation } from '@/hooks/useTicketInformation/useTicketInformation';\nimport { useTrackCheckoutButtonClick } from './useGoToCheckoutAction';\n\nexport const useLiveEventData = () => {\n  const { id: eventId, startDate, isSeries, vertical, isOnline, hideStartDate, seriesId } = useBasicInfo();\n  const [ticketInfo, loading] = useTicketInformation();\n  const handleGetTicketsClick = useTrackCheckoutButtonClick();\n\n  const hasError = !loading && !ticketInfo && !!startDate;\n\n  return {\n    eventId,\n    startDate,\n    isSeries,\n    seriesId,\n    isOnline,\n    ticketInfo,\n    vertical,\n    hideStartDate,\n    loading,\n    hasError,\n    handleGetTicketsClick,\n  };\n};\n","/**\n * Utility functions for recording custom metrics to Datadog RUM\n */\n\nimport { isDatadogInitialized } from './datadogrum';\n\n/**\n * Records a custom timing metric to Datadog RUM\n * @param metricName - Name of the metric to record\n * @param durationMs - Duration in milliseconds\n */\nexport const recordDatadogRumTiming = async (metricName: string, durationMs: number) => {\n  try {\n    if (isDatadogInitialized) {\n      const { datadogRum } = await import('@datadog/browser-rum-slim');\n\n      datadogRum.addTiming(metricName, durationMs);\n\n      datadogRum.addAction(metricName, {\n        duration: durationMs,\n        timestamp: Date.now(),\n      });\n    }\n  } catch (error) {\n    console.error('Error recording Datadog RUM timing:', error);\n  }\n};\n\n/**\n * Records a component render timing to Datadog RUM\n * Also creates a performance mark/measure for Chrome DevTools\n * @param componentName - Name of the component being tracked\n * @param startTime - Performance timing start (defaults to navigation start)\n */\nexport const recordComponentRenderTime = (componentName: string, startTime: number = 0) => {\n  const renderTime = performance.now();\n  const timeElapsed = startTime > 0 ? renderTime - startTime : renderTime;\n\n  const metricName = `component.render.${componentName}`;\n\n  recordDatadogRumTiming(metricName, timeElapsed);\n\n  try {\n    performance.mark(metricName);\n\n    performance.measure(\n      `${metricName}-measure`,\n      undefined, // Uses navigation start as default\n      metricName,\n    );\n  } catch (error) {\n    if (process.env.NODE_ENV !== 'production') {\n      console.warn('User Timing API not available:', error);\n    }\n  }\n\n  if (process.env.NODE_ENV !== 'production') {\n    console.log(`[RUM Metric] ${metricName}: ${timeElapsed.toFixed(2)}ms`);\n  }\n\n  return timeElapsed;\n};\n","import { Stage } from '@eventbrite/webapp-constants';\n\n/**\n * Gets the stableId from cookies.\n * This is used to pass the stableId to the checkout widget as a query parameter,\n * bypassing CloudFront's cookie filtering which strips the stableId cookie.\n */\nexport const getStableIdFromCookie = (): string | undefined => {\n  if (typeof document === 'undefined') return undefined;\n  const cookies = document.cookie.split(';');\n  for (const cookie of cookies) {\n    const [name, ...rest] = cookie.trim().split('=');\n    if (name === 'stableId') {\n      return rest.join('=');\n    }\n  }\n  return undefined;\n};\n\nexport const getEBWidgetsScriptUrl = (stage: Stage, serverUrl: string): string => {\n  const EB_WIDGETS_SCRIPT_URL = {\n    [Stage.LOCAL]: `https://www.evbqa.com/static/widgets/eb_widgets.js`,\n    [Stage.DEV]: `https://www.evbqa.com/static/widgets/eb_widgets.js`,\n    [Stage.TEST]: `${serverUrl}/static/widgets/eb_widgets.js`,\n    [Stage.PROD]: `${serverUrl}/static/widgets/eb_widgets.js`,\n  };\n  return EB_WIDGETS_SCRIPT_URL[stage] || EB_WIDGETS_SCRIPT_URL[Stage.TEST];\n};\n","'use client';\n\nimport { useEffect } from 'react';\nimport { Stage, stageFromString } from '@eventbrite/webapp-constants';\nimport { getEBWidgetsScriptUrl } from '@/utils/widgetUtils';\nimport { getWindowObject } from '@eventbrite/legacy-infra.feature-detection';\n\ninterface EBWidgetsScriptProps {\n  hostname?: string;\n  onScriptLoad?: () => void;\n  stage?: string;\n}\n\nexport const EBWidgetsScript: React.FC<EBWidgetsScriptProps> = ({ hostname, onScriptLoad, stage = Stage.TEST }) => {\n  useEffect(() => {\n    const scriptId = 'eb-widgets-script';\n\n    const existingScript = document.getElementById(scriptId);\n    if (existingScript) {\n      if (onScriptLoad && typeof window !== 'undefined' && getWindowObject('EBWidgets')) {\n        onScriptLoad();\n      }\n      return;\n    }\n\n    const resolvedHostname = hostname || (typeof window !== 'undefined' ? window.location.hostname : '');\n    const scriptUrl = getEBWidgetsScriptUrl(stageFromString(stage), resolvedHostname);\n\n    const script = document.createElement('script');\n    script.id = scriptId;\n    script.src = scriptUrl;\n    script.async = false;\n\n    script.onload = () => {\n      if (onScriptLoad) {\n        onScriptLoad();\n      }\n    };\n\n    script.onerror = () => {\n      console.error('Failed to load EB Widgets script');\n    };\n\n    document.body.appendChild(script);\n  }, [hostname, onScriptLoad, stage]);\n\n  return null;\n};\n","import { useEffect, useLayoutEffect, useState } from 'react';\nimport { useLiveEventData } from '../hooks/useLiveEventData';\nimport { getWindowObject } from '@eventbrite/feature-detection';\nimport { generateRandomHast } from '../utils';\nimport { defineMessage, MessageDescriptor, FormattedMessage } from 'react-intl';\nimport { LoadingButton } from '@eventbrite/marmalade';\nimport { VERTICAL } from '@/types';\nimport styles from './CheckoutButton.module.scss';\nimport { TicketInformationResponse } from '@/pages/api/[eventId]/ticket-information.page';\nimport { recordComponentRenderTime } from '../../../../common/monitoring/rum-metrics';\nimport { GACodes, LISTING_HEAP_IDS, DIRECT_AFF_CODE } from '@/components/_shared/constants';\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport { useAppContext } from '@/components/_shared/context/AppContext';\nimport { QUERY_PARAMS } from '../../../../common/constants';\nimport { EBWidgetsScript } from '@/components/_shared/EBWidgetsScript/EBWidgetsScript';\nimport { getStableIdFromCookie } from '@/utils/widgetUtils';\nimport escape from 'lodash/escape';\n\nconst MESSAGES: Record<string, MessageDescriptor> = {\n  RESERVE_SPOT: defineMessage({\n    id: 'Reserve a spot',\n    defaultMessage: 'Reserve a spot',\n    description: 'Free Checkout button CTA',\n  }),\n  GET_TICKETS: defineMessage({\n    id: 'Get tickets',\n    defaultMessage: 'Get tickets',\n    description: 'Checkout button CTA',\n  }),\n  REMIND_ME: defineMessage({\n    id: 'Details',\n    defaultMessage: 'Details',\n    description: 'Remind me button CTA',\n  }),\n  SERIES: defineMessage({\n    id: 'Check availability',\n    defaultMessage: 'Check availability',\n    description: 'Series button CTA',\n  }),\n  JOIN_WAITLIST: defineMessage({\n    id: 'Join Waitlist',\n    defaultMessage: 'Join Waitlist',\n    description: 'Waitlist button CTA',\n  }),\n  RSVP_CONFIRM: defineMessage({\n    id: 'Yes',\n    defaultMessage: 'Yes',\n    description: 'RSVP Yes button CTA',\n  }),\n};\n\nexport const GET_TICKETS_MESSAGE = MESSAGES.GET_TICKETS;\n\nconst getCheckoutButtonLabel = (\n  isRemindMe?: boolean,\n  isSeries?: boolean,\n  ticketInfo?: TicketInformationResponse | null,\n  vertical?: string,\n  isRSVP?: boolean,\n) => {\n  if (isRemindMe) {\n    return MESSAGES.REMIND_ME;\n  }\n  if (isRSVP) {\n    return MESSAGES.RSVP_CONFIRM;\n  }\n  if (isSeries) {\n    return MESSAGES.SERIES;\n  }\n  if (ticketInfo?.availability?.waitlistAvailable || ticketInfo?.availability?.waitlistEnabled) {\n    return MESSAGES.JOIN_WAITLIST;\n  }\n  return ticketInfo?.isFree || vertical === VERTICAL.REGISTRATION ? MESSAGES.RESERVE_SPOT : MESSAGES.GET_TICKETS;\n};\n\nexport const CheckoutButton: React.FC<{ isRemindMe?: boolean; isRSVP?: boolean }> = ({\n  isRemindMe = false,\n  isRSVP = false,\n}) => {\n  const {\n    data: { serverUrl, stage },\n  } = useAppContext();\n  const { ticketInfo, loading, eventId, handleGetTicketsClick, isSeries, vertical, seriesId } = useLiveEventData();\n\n  const [modalTriggerElementId, setModalTriggerElementId] = useState<string | null>(null);\n  const [isScriptLoaded, setIsScriptLoaded] = useState(false);\n\n  useEffect(() => {\n    setModalTriggerElementId(`eventbrite-widget-modal-trigger-${eventId}-${generateRandomHast()}`);\n  }, [eventId]);\n\n  useLayoutEffect(() => {\n    if (!modalTriggerElementId || !isScriptLoaded || loading) return;\n\n    requestAnimationFrame(() => {\n      const buttonElement = document.getElementById(modalTriggerElementId);\n      const ebWidgets = getWindowObject('EBWidgets');\n\n      if (!buttonElement || !ebWidgets) {\n        return;\n      }\n\n      const searchParams = new URLSearchParams(getWindowObject('location')?.search ?? '');\n      const affiliateCode = searchParams.get(QUERY_PARAMS.AFFILIATE_CODE) ?? DIRECT_AFF_CODE;\n      const waitlistToken = searchParams.get(QUERY_PARAMS.WAITLIST_TOKEN);\n      const rsvpToken = searchParams.get(QUERY_PARAMS.MIPA);\n      const stableId = getStableIdFromCookie();\n      const promoCode = ticketInfo?.appliedPromoCode || ticketInfo?.discounts?.[0]?.code;\n\n      ebWidgets.createWidget({\n        widgetType: 'checkout',\n        eventId: waitlistToken ? eventId : isSeries ? seriesId : eventId,\n        modal: true,\n        modalTriggerElementId,\n        affiliateCode,\n        ...(promoCode ? { promoCode: escape(promoCode) } : {}),\n        ...(waitlistToken ? { waitlistToken } : {}),\n        ...(stableId ? { extraParams: [{ name: 'stableID', value: stableId }] } : {}),\n        ...(rsvpToken ? { rsvpToken } : {}),\n      });\n\n      // Auto-open checkout modal when #tickets hash or waitlist token is present\n      const hasTicketsHash = getWindowObject('location')?.hash === '#tickets';\n      if (hasTicketsHash || waitlistToken) {\n        buttonElement.click();\n      }\n    });\n  }, [eventId, modalTriggerElementId, isScriptLoaded, loading, ticketInfo, seriesId, isSeries]);\n\n  // Track button render time for monitoring\n  useEffect(() => {\n    if (modalTriggerElementId && !loading) {\n      // Button is fully rendered and ready - record the timing\n      recordComponentRenderTime('CheckoutButton');\n    }\n  }, [modalTriggerElementId, loading]);\n\n  const buttonLabel = getCheckoutButtonLabel(isRemindMe, isSeries ?? false, ticketInfo, vertical, isRSVP);\n\n  const handleButtonClick = () => {\n    if (isRSVP) {\n      trackAnalyticsEvent({\n        category: GACodes.GA_CATEGORY_LISTING,\n        action: GACodes.GA_ACTION_RSVP_YES_INTENT,\n      });\n    }\n    handleGetTicketsClick(buttonLabel.id);\n  };\n\n  if (!modalTriggerElementId) {\n    return null;\n  }\n\n  return (\n    <>\n      <EBWidgetsScript hostname={serverUrl} onScriptLoad={() => setIsScriptLoaded(true)} stage={stage} />\n      <LoadingButton\n        isLoading={loading}\n        id={modalTriggerElementId}\n        role=\"button\"\n        variant={isRemindMe ? 'secondary' : 'primary'}\n        className={styles.button}\n        data-testid=\"conversion-bar-checkout-button\"\n        data-heap-id={LISTING_HEAP_IDS.CHECKOUT_BUTTON}\n        onClick={handleButtonClick}\n      >\n        <FormattedMessage {...buttonLabel} />\n      </LoadingButton>\n    </>\n  );\n};\n","import React from 'react';\nimport { useIntl } from 'react-intl';\nimport { Button } from '@eventbrite/marmalade';\nimport { DOM_IDS, LISTING_HEAP_IDS, STATSIG_EVENT_NAMES } from '../../_shared/constants';\nimport styles from './ExploreSimilarEventsButton.module.scss';\nimport { logEvent } from '@eventbrite/legacy-infra.statsig';\n\nexport const ExploreSimilarEventsButton: React.FC = () => {\n  const { formatMessage } = useIntl();\n\n  const label = formatMessage({ id: 'Explore similar events' });\n\n  const handleScrollToRelatedEvents = () => {\n    logEvent(STATSIG_EVENT_NAMES.LISTING_CONVERSION_BAR_CTA_CLICK);\n    const relatedEventsElement = document.getElementById(DOM_IDS.RELATED_EVENTS);\n\n    if (!relatedEventsElement) {\n      console.warn('Related events section not found - element may not be loaded yet');\n      return;\n    }\n\n    try {\n      relatedEventsElement.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start',\n      });\n    } catch (error) {\n      console.error('Error scrolling to related events:', error);\n      // Fallback to simple scroll\n      try {\n        relatedEventsElement.scrollIntoView();\n      } catch (fallbackError) {\n        console.error('Fallback scroll also failed:', fallbackError);\n      }\n    }\n  };\n\n  return (\n    <Button\n      className={styles.exploreSimilarEventsButton}\n      variant=\"primary\"\n      onClick={handleScrollToRelatedEvents}\n      data-heap-id={LISTING_HEAP_IDS.EXPLORE_SIMILAR_EVENTS}\n      data-testid=\"explore-similar-events-button\"\n    >\n      {label}\n    </Button>\n  );\n};\n","export { ExploreSimilarEventsButton } from './ExploreSimilarEventsButton';\n","'use client';\nimport { useEffect } from 'react';\nimport { useIntl } from 'react-intl';\nimport styles from './LiveEventPanelInfo.module.scss';\nimport { LoadingButton } from '@eventbrite/marmalade';\nimport {\n  getPanelDisplayPrice,\n  shouldShowDiscountSignal,\n  shouldShowCheckoutButton,\n  shouldShowSoldOutText,\n} from '../utils';\nimport { getDisplayTimezone, getSingleDateDisplayString } from '@/utils/dateTime';\nimport { FormattedMessage } from 'react-intl';\nimport { LoadingSkeleton } from '@eventbrite/legacy-infra.loading-skeleton';\nimport { useLiveEventData } from '../hooks/useLiveEventData';\nimport { CheckoutButton } from '../CheckoutButton/CheckoutButton';\nimport { MULTIPLE_DATES, DONATION_TEXT } from '@/components/_shared/constants';\nimport { useAttendeeTimezone } from '@/hooks/useAttendeeTimezone';\nimport { ExploreSimilarEventsButton } from '../ExploreSimilarEventsButton';\nimport { CONVERSION_BAR_MESSAGES } from '../constants';\nimport { HighLevelStatus } from '@/utils/highLevelStatus';\nimport { useDisplayStatus } from '@/components/_shared/contexts/DisplayStatusContext';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\n\nconst DetailsLoadingSkeleton: React.FC = () => {\n  return (\n    <div className={styles.detailsLoadingSkeleton}>\n      <LoadingSkeleton height={15} width={150} />\n      <LoadingSkeleton height={15} width={150} />\n    </div>\n  );\n};\n\nconst ContentArea: React.FC = () => {\n  const { loading } = useLiveEventData();\n\n  if (loading) {\n    return <DetailsLoadingSkeleton />;\n  }\n  return <SalesInformation />;\n};\n\nconst SalesInformation: React.FC = () => {\n  const { formatMessage, locale } = useIntl();\n  const { ticketInfo, startDate, isSeries, isOnline, hideStartDate } = useLiveEventData();\n  const { endDate, hideEndDate } = useBasicInfo();\n\n  const attendeeTimezone = useAttendeeTimezone(isOnline ?? false);\n  const { displayStatus } = useDisplayStatus();\n\n  if (!ticketInfo || !startDate) {\n    return null;\n  }\n\n  let displayText;\n  if (ticketInfo.hasOnlyDonationTicketsAvailable) {\n    displayText = formatMessage(DONATION_TEXT);\n  } else if (shouldShowSoldOutText(displayStatus, ticketInfo)) {\n    displayText = CONVERSION_BAR_MESSAGES[HighLevelStatus.SOLD_OUT]\n      ? formatMessage(CONVERSION_BAR_MESSAGES[HighLevelStatus.SOLD_OUT])\n      : '';\n  } else {\n    displayText = getPanelDisplayPrice(ticketInfo, locale, formatMessage);\n  }\n\n  const showEndTimeOnly = hideStartDate && !hideEndDate && endDate?.utc;\n  const timezone = getDisplayTimezone({\n    isOnlineEvent: isOnline ?? false,\n    eventTimezone: startDate.timezone,\n    attendeeTimezone,\n  });\n  const dateString = isSeries\n    ? formatMessage(MULTIPLE_DATES)\n    : getSingleDateDisplayString(\n        startDate,\n        !hideStartDate,\n        locale,\n        timezone,\n        formatMessage,\n        false,\n        !showEndTimeOnly ? ' • ' : undefined,\n        true,\n        isOnline ?? false,\n      );\n\n  return (\n    <>\n      <div data-testid=\"conversion-bar-headline\" className={styles.headline}>\n        <span>{displayText}</span>\n      </div>\n      <div data-testid=\"conversion-bar-date\" className={styles.date}>\n        {dateString}\n      </div>\n    </>\n  );\n};\n\nexport const LiveEventPanelInfo: React.FC<{ showDiscountSignal?: (show: boolean) => void }> = ({\n  showDiscountSignal = () => void {},\n}) => {\n  const { status } = useBasicInfo();\n  const { ticketInfo, loading } = useLiveEventData();\n  useEffect(() => {\n    if (shouldShowDiscountSignal(ticketInfo) && !ticketInfo?.hasOnlyDonationTicketsAvailable) {\n      showDiscountSignal(true);\n    }\n  }, [ticketInfo, showDiscountSignal, ticketInfo?.hasOnlyDonationTicketsAvailable]);\n\n  const { displayStatus } = useDisplayStatus();\n  const showCheckoutButton = shouldShowCheckoutButton(status, displayStatus, ticketInfo);\n\n  return (\n    <div className={styles.container}>\n      <div className={styles.content}>\n        <ContentArea />\n      </div>\n      <div data-testid=\"cb-cta-area\" className={styles.ctaButtonWrapper}>\n        {loading ? (\n          <LoadingButton\n            isLoading={loading}\n            id=\"conversion-bar-checkout-button\"\n            data-testid=\"conversion-bar-checkout-button\"\n            role=\"button\"\n            variant=\"primary\"\n            className={styles.button}\n          >\n            <FormattedMessage id=\"Get tickets\" defaultMessage=\"Get tickets\" description=\"Checkout button CTA\" />\n          </LoadingButton>\n        ) : showCheckoutButton ? (\n          <CheckoutButton isRemindMe={false} />\n        ) : (\n          <ExploreSimilarEventsButton />\n        )}\n      </div>\n    </div>\n  );\n};\n","export { OrganizerInfo } from './OrganizerInfo';\n","import { sdkRequest } from '@eventbrite/legacy-infra.http';\n\nconst unremind = (eventId: string) => {\n  return sdkRequest(`/destination/events/${eventId}/unremind/`, { method: 'POST' });\n};\n\ntype TrackablePromise<T> = Promise<T> & {\n  completed: boolean;\n};\n\nfunction trackPromise<T>(p: Promise<T>): TrackablePromise<T> {\n  const promise = p as TrackablePromise<T>;\n  promise.completed = false;\n  promise.finally(() => {\n    promise.completed = true;\n  });\n  return promise;\n}\n\nlet singletonRequest: TrackablePromise<{\n  action_performed: boolean;\n}> | null = null;\n\nconst remind = (eventId: string) => {\n  if (singletonRequest && !singletonRequest.completed) return singletonRequest;\n  singletonRequest = trackPromise(sdkRequest(`/destination/events/${eventId}/remind/`, { method: 'POST' }));\n  return singletonRequest;\n};\n\ntype GetReminderStatusResponse = {\n  reminder_events: unknown[];\n};\n\nconst getReminderStatus = async (userId: string, eventId: string): Promise<boolean> => {\n  const response = (await sdkRequest(`/destination/users/${userId}/reminders/?event_id=${eventId}`, {\n    method: 'GET',\n  })) as GetReminderStatusResponse;\n  const reminderEvents = response?.reminder_events;\n  return reminderEvents != null && Array.isArray(reminderEvents) && reminderEvents.length > 0;\n};\n\nexport { unremind, remind, getReminderStatus };\n","export const RemindMeIcon = () => {\n  return (\n    <svg viewBox=\"0 0 24 24\">\n      <g>\n        <path d=\"M5 10h2L6 20H4zm3 0l7-5.95A2.53 2.53 0 0117.5 8l-1.43 2h2.69a1 1 0 011 1 1.23 1.23 0 010 .19l-1.26 6.37A3 3 0 0115.56 20H9.25a2 2 0 01-2-2 1.34 1.34 0 010-.2l.69-6.8zm2 1l-.7 7h6.31a1 1 0 001-.81l1-5.16h-5.44l3.7-5.16a.49.49 0 00.13-.41.53.53 0 00-.24-.37z\"></path>\n      </g>\n    </svg>\n  );\n};\n","export { useUserData } from './useUserData';\nexport type { UserDataResponse } from './useUserData';\n","import { useEffect, useState } from 'react';\nimport { FormattedMessage, useIntl } from 'react-intl';\nimport { Typography, Icon, LoadingButton } from '@eventbrite/marmalade';\nimport { Modal } from '@/components/_shared/Modal/Modal';\nimport { redirectToSignIn } from '@/utils/utils';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { OrganizerInfo } from '@/components/EventDetails/OrganizerInfo';\nimport styles from './RemindMe.module.scss';\nimport { unremind, remind, getReminderStatus } from './remindMeClient';\nimport { RemindMeIcon } from './RemindMeIcon';\nimport { useUserData } from '@/hooks/useUserData';\n\nexport const RemindMe: React.FC = () => {\n  const [isReminded, setIsReminded] = useState(false);\n  const [showModal, setShowModal] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n  const { formatMessage } = useIntl();\n  const { organizer, id } = useBasicInfo();\n  const { userId } = useUserData();\n  const isAuthenticated = !!userId;\n\n  useEffect(() => {\n    let cancelled = false;\n    const urlParams = new URLSearchParams(window?.location?.search);\n    const remindMeActionRequested = urlParams.get('remindMe') === 'true';\n    if (isAuthenticated && !isReminded && remindMeActionRequested) {\n      setIsLoading(true);\n      remind(id)\n        .then(() => {\n          if (!cancelled) {\n            setIsReminded(true);\n            setShowModal(true);\n          }\n        })\n        .finally(() => {\n          if (!cancelled) {\n            setIsLoading(false);\n          }\n        });\n    }\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  useEffect(() => {\n    const urlParams = new URLSearchParams(window?.location?.search);\n    const remindMeActionRequested = urlParams.get('remindMe') === 'true';\n    if (!isAuthenticated || !userId || !id || remindMeActionRequested) {\n      return;\n    }\n    let cancelled = false;\n    setIsLoading(true);\n    getReminderStatus(userId, id)\n      .then((hasReminder) => {\n        if (!cancelled) {\n          setIsReminded(hasReminder);\n        }\n      })\n      .finally(() => {\n        if (!cancelled) {\n          setIsLoading(false);\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [isAuthenticated, userId, id]);\n\n  const toggleRemind = () => {\n    setIsLoading(true);\n    if (!isAuthenticated) {\n      const url = new URL(window.location.href);\n      url.searchParams.set('remindMe', 'true');\n      url.searchParams.delete('overrideListingsOrigin');\n      history.pushState(null, '', url.toString());\n      redirectToSignIn();\n      return;\n    }\n\n    if (isReminded) {\n      unremind(id)\n        .then(() => {\n          setIsReminded(false);\n        })\n        .finally(() => {\n          setIsLoading(false);\n        });\n      return;\n    }\n\n    remind(id)\n      .then(() => {\n        setIsReminded(true);\n        setShowModal(true);\n      })\n      .finally(() => {\n        setIsLoading(false);\n      });\n  };\n\n  return (\n    <div>\n      <LoadingButton isLoading={isLoading} variant={isReminded ? 'secondary' : 'primary'} onClick={toggleRemind}>\n        {isReminded ? (\n          <FormattedMessage id=\"Remove reminder\" defaultMessage=\"Remove reminder\" />\n        ) : (\n          <FormattedMessage id=\"Remind me\" defaultMessage=\"Remind me\" />\n        )}\n      </LoadingButton>\n      <Modal visible={showModal} onClose={() => setShowModal(false)} type=\"simple\">\n        <div className={styles.remindMeModalContent}>\n          <Icon size=\"medium\" className={styles.remindMeIcon}>\n            <RemindMeIcon />\n          </Icon>\n          <Typography as=\"h2\" variant=\"heading-md\" className={styles.reminderSetTitle}>\n            <FormattedMessage id=\"Reminder set!\" defaultMessage=\"Reminder set!\" />\n          </Typography>\n          <Typography as=\"p\" variant=\"body-md\" className={styles.reminderSetDescription}>\n            <FormattedMessage\n              id=\"We'll email you an hour before tickets go on sale. Manage your reminder on the event page.\"\n              defaultMessage=\"We'll email you an hour before tickets go on sale. Manage your reminder on the event page.\"\n            />\n          </Typography>\n          <section\n            className={styles.organizerInfoSection}\n            aria-label={formatMessage({ id: 'Organizer profile', defaultMessage: 'Organizer profile' })}\n          >\n            <OrganizerInfo organizer={organizer} />\n          </section>\n        </div>\n      </Modal>\n    </div>\n  );\n};\n","import { differenceInHours, parseISO } from 'date-fns';\n\nconst REMIND_ME_MIN_HOURS_AHEAD = 2;\n\nexport type ShouldShowRemindMeParams = {\n  isListed: boolean;\n  isProtected: boolean;\n  startSalesDateUtc?: string;\n};\n\nexport function shouldShowRemindMe(params: ShouldShowRemindMeParams): boolean {\n  const { isListed, isProtected, startSalesDateUtc } = params;\n\n  if (!isListed || isProtected) return false;\n  if (!startSalesDateUtc) return false;\n\n  try {\n    const salesStart = parseISO(startSalesDateUtc);\n    const hoursUntilStart = differenceInHours(salesStart, new Date());\n    return hoursUntilStart > REMIND_ME_MIN_HOURS_AHEAD;\n  } catch {\n    return false;\n  }\n}\n","import { useTicketInformation } from '@/hooks/useTicketInformation/useTicketInformation';\nimport { FormattedMessage, useIntl } from 'react-intl';\nimport { getFormattedDateTime } from '@eventbrite/legacy-infra.datetime-fns';\nimport { CONVERSION_BAR_MESSAGES } from '../../constants';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { getDisplayTimezone } from '@/utils/dateTime';\nimport { useAttendeeTimezone } from '@/hooks/useAttendeeTimezone';\n\nimport { CheckoutButton } from '../../CheckoutButton/CheckoutButton';\nimport styles from './SalesStartSoonPanel.module.scss';\nimport { RemindMe } from './RemindMe/RemindMe';\nimport { LoadingSkeleton } from '@eventbrite/legacy-infra.loading-skeleton';\nimport { shouldShowRemindMe } from './shouldShowRemindMe';\n\nexport const SalesStartSoonPanel: React.FC = () => {\n  const { locale } = useIntl();\n  const { isOnline, isListed, isProtected } = useBasicInfo();\n  const attendeeTimezone = useAttendeeTimezone(isOnline ?? false);\n  const [data, loading] = useTicketInformation();\n\n  if (loading) {\n    return (\n      <div className={styles.detailsLoadingSkeleton}>\n        <LoadingSkeleton height={30} width=\"100%\" />\n        <LoadingSkeleton height={30} width=\"100%\" />\n      </div>\n    );\n  }\n\n  if (!data) {\n    return null;\n  }\n\n  const timezone = getDisplayTimezone({\n    isOnlineEvent: isOnline ?? false,\n    eventTimezone: data.startSalesDate?.timezone,\n    attendeeTimezone,\n  });\n  const startDate = getFormattedDateTime(data.startSalesDate?.utc, false, timezone, locale, 'PPp');\n  const showRemindMe = shouldShowRemindMe({\n    isListed: isListed ?? false,\n    isProtected: isProtected ?? false,\n    startSalesDateUtc: data.startSalesDate?.utc,\n  });\n\n  return (\n    <div className={styles.container} data-testid=\"sales-start-soon-panel\">\n      <div className={styles.content}>\n        <div className={styles.label} data-testid=\"sales-start-soon-panel-label\">\n          <FormattedMessage {...CONVERSION_BAR_MESSAGES.SALES_START_SOON} values={{ date: startDate }} />\n        </div>\n      </div>\n      <div data-testid=\"cb-cta-area\" className={styles.ctaButtonWrapper}>\n        {showRemindMe && <RemindMe />}\n        <CheckoutButton isRemindMe />\n      </div>\n    </div>\n  );\n};\n","import React from 'react';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { useIntl } from 'react-intl';\nimport styles from './GeneralEventPanelInfo.module.scss';\nimport { getDisplayTimezone, getSingleDateDisplayString } from '@/utils/dateTime';\nimport { ExploreSimilarEventsButton } from '../ExploreSimilarEventsButton';\nimport { useDisplayStatus } from '@/components/_shared/contexts/DisplayStatusContext';\nimport { CONVERSION_BAR_MESSAGES } from '../constants';\nimport { SalesStartSoonPanel } from './SalesStartSoonPanel/SalesStartSoonPanel';\nimport { CheckoutButton } from '../CheckoutButton/CheckoutButton';\nimport { HighLevelStatus } from '@/utils/highLevelStatus';\nimport { useAttendeeTimezone } from '@/hooks/useAttendeeTimezone';\n\ntype GeneralEventPanelInfoProps = {\n  showSalesEndedDonationPanel?: boolean;\n};\n\nexport const GeneralEventPanelInfo: React.FC<GeneralEventPanelInfoProps> = ({\n  showSalesEndedDonationPanel = false,\n}) => {\n  const { formatMessage, locale } = useIntl();\n  const { hideStartDate, hideEndDate, startDate, endDate, isOnline } = useBasicInfo();\n  const { displayStatus } = useDisplayStatus();\n  const attendeeTimezone = useAttendeeTimezone(isOnline ?? false);\n\n  const label = CONVERSION_BAR_MESSAGES[displayStatus] ?? null;\n\n  if (displayStatus === HighLevelStatus.SALES_START_SOON) {\n    return <SalesStartSoonPanel />;\n  }\n\n  const showEndTimeOnly = !showSalesEndedDonationPanel && hideStartDate && !hideEndDate && endDate?.utc;\n  const dateToShow = showSalesEndedDonationPanel ? endDate : startDate;\n  const showTime = showSalesEndedDonationPanel ? !hideEndDate : !hideStartDate;\n  const timezone = getDisplayTimezone({\n    isOnlineEvent: isOnline ?? false,\n    eventTimezone: dateToShow?.timezone,\n    attendeeTimezone,\n  });\n  const useBulletSeparator = !showEndTimeOnly && showTime;\n  const dateString = dateToShow\n    ? getSingleDateDisplayString(\n        dateToShow,\n        showTime,\n        locale,\n        timezone,\n        formatMessage,\n        false,\n        useBulletSeparator ? ' • ' : undefined,\n        true,\n        isOnline ?? false,\n      )\n    : undefined;\n\n  return (\n    <div className={styles.container} data-testid=\"general-event-panel-info\">\n      <div className={styles.content}>\n        <div className={styles.label}>{label ? formatMessage({ id: label.id }) : ''}</div>\n        <div data-testid=\"conversion-bar-date\" className={styles.date}>\n          {dateString}\n        </div>\n      </div>\n      <div data-testid=\"cb-cta-area\" className={styles.ctaButtonWrapper}>\n        {showSalesEndedDonationPanel ? <CheckoutButton isRemindMe /> : <ExploreSimilarEventsButton />}\n      </div>\n    </div>\n  );\n};\n","import React from 'react';\n\nexport const DiscountSignalIcon: React.FC = () => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n    <path\n      fillRule=\"evenodd\"\n      clipRule=\"evenodd\"\n      d=\"M7.33464 13.3335L2.66797 8.66683L8.0013 3.3335H12.0013C12.3695 3.3335 12.668 3.63197 12.668 4.00016V8.00016L7.33464 13.3335ZM10.6678 6.16683C11.128 6.16683 11.5011 5.79373 11.5011 5.3335C11.5011 4.87326 11.128 4.50016 10.6678 4.50016C10.2076 4.50016 9.83447 4.87326 9.83447 5.3335C9.83447 5.79373 10.2076 6.16683 10.6678 6.16683Z\"\n      fill=\"#261B36\"\n    />\n  </svg>\n);\n","import styles from './DiscountSignal.module.scss';\nimport { useLiveEventData } from '../hooks/useLiveEventData';\nimport { DiscountSignalIcon } from './DiscountSignalIcon';\nimport { useIntl } from 'react-intl';\n\nexport const DiscountSignal = () => {\n  let discountText: string | undefined;\n  const { formatMessage } = useIntl();\n  const { ticketInfo } = useLiveEventData();\n\n  const discountsAppliedText = formatMessage({ id: 'DISCOUNTS APPLIED', defaultMessage: 'DISCOUNTS APPLIED' });\n\n  const hasBogo = ticketInfo?.availability?.hasBogoTickets;\n  const hasEarlyBird = ticketInfo?.availability?.hasEarlyBirdTickets;\n  const hasDiscounts = ticketInfo?.discounts && ticketInfo?.discounts?.length > 0;\n\n  const discountCount = [hasBogo, hasEarlyBird, hasDiscounts].filter(Boolean).length;\n\n  if (discountCount > 1 || hasDiscounts) {\n    discountText = discountsAppliedText;\n  } else if (hasBogo) {\n    discountText = formatMessage({ id: '2 FOR 1 DEAL', defaultMessage: '2 FOR 1 DEAL' });\n  } else if (hasEarlyBird) {\n    discountText = formatMessage({\n      id: 'EARLY BIRD DISCOUNT APPLIED',\n      defaultMessage: 'EARLY BIRD DISCOUNT APPLIED',\n    });\n  }\n\n  if (!discountText) {\n    return null;\n  }\n\n  return (\n    <span className={styles.discountSignal}>\n      <DiscountSignalIcon />\n      {discountText}\n    </span>\n  );\n};\n","import { RSVPResponseType } from './types';\n\nexport interface SubmitRsvpCampaignParams {\n  eventId: string;\n  campaignToken: string;\n  response: RSVPResponseType;\n  message?: string;\n}\n\nexport async function submitRsvpCampaignResponse({\n  eventId,\n  campaignToken,\n  response,\n  message,\n}: SubmitRsvpCampaignParams): Promise<void> {\n  try {\n    await fetch(`/e/api/${eventId}/rsvp`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        campaignToken,\n        response,\n        ...(message !== undefined && message.trim() !== '' && { message: message.trim() }),\n      }),\n    });\n  } catch (error) {\n    throw new Error(`RSVP request failed: ${error}`);\n  }\n}\n\nexport async function isCampaignTokenValid(eventId: string, campaignToken: string): Promise<boolean> {\n  try {\n    const response = await fetch(`/e/api/${eventId}/validate-campaign-token`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ campaignToken }),\n    });\n\n    if (!response.ok) {\n      console.error(`MIPA token validation failed.`);\n      return false;\n    }\n\n    const data = await response.json();\n    return data.isValid;\n  } catch (error) {\n    console.error(`MIPA token validation failed: ${error}`);\n    return false;\n  }\n}\n","import { useEffect, useState } from 'react';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { useDisplayStatus } from '@/components/_shared/contexts/DisplayStatusContext';\nimport { useTicketInformation } from '@/hooks/useTicketInformation/useTicketInformation';\nimport { updateRsvpPageProperty } from '@/utils/dataLayer';\nimport { QUERY_PARAMS } from '../../../../common/constants';\nimport { shouldDisplayRsvp as computeShouldDisplayRsvp } from '../utils';\nimport { HAS_WINDOW } from '@eventbrite/feature-detection';\nimport { isCampaignTokenValid } from '../RSVP/rsvpApiClient';\n\nexport interface RsvpParamsState {\n  mipaToken: string | null;\n}\n\nexport const useShouldDisplayRsvp = () => {\n  const [rsvpParams, setUrlParams] = useState<RsvpParamsState>({\n    mipaToken: null,\n  });\n\n  const { id: eventId, status } = useBasicInfo();\n  const { displayStatus } = useDisplayStatus();\n  const [ticketInfo] = useTicketInformation();\n\n  useEffect(() => {\n    const verifyMipaToken = async () => {\n      if (!HAS_WINDOW) return;\n      const params = new URLSearchParams(window.location.search);\n      const mipaToken = params.get(QUERY_PARAMS.MIPA);\n\n      if (!mipaToken) {\n        return;\n      }\n\n      const isMipaTokenValid = await isCampaignTokenValid(eventId, mipaToken);\n      updateRsvpPageProperty(isMipaTokenValid);\n      if (isMipaTokenValid) {\n        setUrlParams({\n          mipaToken: mipaToken,\n        });\n      }\n    };\n    verifyMipaToken();\n  }, [eventId]);\n\n  const shouldDisplayRsvp = computeShouldDisplayRsvp(rsvpParams.mipaToken, status, displayStatus, ticketInfo);\n\n  return {\n    shouldDisplayRsvp,\n    mipaToken: rsvpParams.mipaToken,\n  };\n};\n","'use client';\n\nimport React, { useState } from 'react';\nimport { FormattedMessage, useIntl } from 'react-intl';\nimport { Button, LoadingButton, Typography } from '@eventbrite/marmalade';\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport { Modal } from '@/components/_shared/Modal/Modal';\nimport { GACodes } from '@/components/_shared/constants';\nimport { submitRsvpCampaignResponse } from './rsvpApiClient';\nimport styles from './RSVPModal.module.scss';\nimport { RSVPResponseType } from './types';\n\nexport interface RSVPModalProps {\n  visible: boolean;\n  onClose: () => void;\n  responseType: RSVPResponseType;\n  eventId: string;\n  mipaToken: string | null;\n}\n\nexport const RSVPModal: React.FC<RSVPModalProps> = ({ visible, onClose, responseType, eventId, mipaToken }) => {\n  const { formatMessage } = useIntl();\n  const [note, setNote] = useState('');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const handleSend = async () => {\n    setError(null);\n    setIsSubmitting(true);\n    try {\n      if (!mipaToken) {\n        throw new Error('Campaign token is required for this response');\n      }\n      await submitRsvpCampaignResponse({\n        eventId,\n        campaignToken: mipaToken,\n        response: responseType,\n        message: note.trim() || undefined,\n      });\n      if (responseType === 'maybe') {\n        trackAnalyticsEvent({\n          category: GACodes.GA_CATEGORY_LISTING,\n          action: GACodes.GA_ACTION_RSVP_MAYBE,\n          label: GACodes.GA_LABEL_RSVP_MAYBE_MSG_SENT,\n        });\n      } else {\n        trackAnalyticsEvent({\n          category: GACodes.GA_CATEGORY_LISTING,\n          action: GACodes.GA_ACTION_RSVP_NO,\n          label: GACodes.GA_LABEL_RSVP_NO_MSG_SENT,\n        });\n      }\n      onClose();\n    } catch (e) {\n      console.error('Error submitting RSVP response', e);\n      setError('Something went wrong');\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const attendanceOptionTitle =\n    responseType === 'maybe'\n      ? formatMessage({\n          id: 'Maybe attending',\n          defaultMessage: 'Maybe attending',\n          description: 'RSVP Maybe attending modal title',\n        })\n      : formatMessage({\n          id: 'Not attending',\n          defaultMessage: 'Not attending',\n          description: 'RSVP Not attending modal title',\n        });\n\n  return (\n    <Modal visible={visible} onClose={onClose} type=\"simple\">\n      <div className={styles.content}>\n        <Typography\n          variant=\"body-lg-bold\"\n          as=\"h2\"\n          align=\"center\"\n          className={styles.attendanceOptionTitle}\n          color=\"neutral-800\"\n        >\n          {attendanceOptionTitle}\n        </Typography>\n        <Typography variant=\"body-md\" as=\"h3\" align=\"center\">\n          <FormattedMessage\n            id=\"Let the organizer know more about your plans\"\n            defaultMessage=\"Let the organizer know more about your plans\"\n            description=\"RSVP modal note label\"\n          />\n        </Typography>\n        <textarea\n          id=\"rsvp-note\"\n          className={styles.noteField}\n          value={note}\n          onChange={(e) => setNote(e.target.value)}\n          placeholder={formatMessage({\n            id: 'Send an optional note to the event organizer',\n            defaultMessage: 'Send an optional note to the event organizer',\n          })}\n          aria-label=\"Optional note\"\n          disabled={isSubmitting}\n        />\n        {error && <Typography variant=\"body-md-bold\">{error}</Typography>}\n        <div className={styles.actions}>\n          <LoadingButton variant=\"primary\" onClick={handleSend} isLoading={isSubmitting}>\n            <FormattedMessage id=\"Send\" defaultMessage=\"Send\" description=\"RSVP modal send\" />\n          </LoadingButton>\n          <Button variant=\"secondary\" onClick={onClose} disabled={isSubmitting} className={styles.cancelButton}>\n            <FormattedMessage id=\"Cancel\" defaultMessage=\"Cancel\" description=\"RSVP modal cancel\" />\n          </Button>\n        </div>\n      </div>\n    </Modal>\n  );\n};\n","'use client';\n\nimport React, { useCallback, useState } from 'react';\nimport { FormattedMessage } from 'react-intl';\nimport { Button } from '@eventbrite/marmalade';\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport { CheckoutButton } from '../CheckoutButton/CheckoutButton';\nimport { RSVPModal } from './RSVPModal';\nimport { RSVPResponseType } from './types';\nimport { useLiveEventData } from '../hooks/useLiveEventData';\nimport { useComponentVisibility } from '@/hooks/useComponentVisibility';\nimport { GACodes, LISTING_HEAP_IDS } from '@/components/_shared/constants';\nimport styles from './RSVPPanel.module.scss';\n\nexport interface RSVPPanelProps {\n  mipaToken: string | null;\n}\n\ninterface RsvpModalState {\n  open: boolean;\n  responseType: RSVPResponseType | null;\n}\n\nexport const RSVPPanel: React.FC<RSVPPanelProps> = ({ mipaToken }) => {\n  const { eventId } = useLiveEventData();\n  const [modalState, setModalState] = useState<RsvpModalState>({\n    open: false,\n    responseType: null,\n  });\n\n  const onRsvpSectionVisible = useCallback(() => {\n    trackAnalyticsEvent({\n      category: GACodes.GA_CATEGORY_LISTING,\n      action: GACodes.GA_ACTION_RSVP_LOADED,\n    });\n  }, []);\n  const rsvpSectionRef = useComponentVisibility(onRsvpSectionVisible);\n\n  const openModal = (responseType: RSVPResponseType) => setModalState({ open: true, responseType });\n  const closeModal = () => setModalState({ open: false, responseType: null });\n\n  return (\n    <div ref={rsvpSectionRef} className={styles.container} data-testid=\"rsvp-panel\">\n      <div className={styles.content}>\n        <div className={styles.label} data-testid=\"rsvp-label\">\n          <FormattedMessage\n            id=\"Are you going to this event?\"\n            defaultMessage=\"Are you going to this event?\"\n            description=\"RSVP label in conversion bar\"\n          />\n        </div>\n      </div>\n      <div data-testid=\"cb-cta-area\" className={styles.ctaButtonWrapper}>\n        <CheckoutButton isRemindMe={false} isRSVP={true} />\n        <Button\n          variant=\"secondary\"\n          onClick={() => openModal('maybe')}\n          data-heap-id={LISTING_HEAP_IDS.CTA_RSVP_MAYBE}\n          data-testid=\"rsvp-maybe-button\"\n          className={styles.secondaryRSVPButton}\n        >\n          <FormattedMessage id=\"Maybe\" defaultMessage=\"Maybe\" description=\"RSVP Maybe button\" />\n        </Button>\n        <Button\n          variant=\"secondary\"\n          onClick={() => openModal('no')}\n          data-heap-id={LISTING_HEAP_IDS.CTA_RSVP_NO}\n          data-testid=\"rsvp-no-button\"\n          className={styles.secondaryRSVPButton}\n        >\n          <FormattedMessage id=\"No\" defaultMessage=\"No\" description=\"RSVP No button\" />\n        </Button>\n      </div>\n      {modalState.responseType && (\n        <RSVPModal\n          visible={modalState.open}\n          onClose={closeModal}\n          responseType={modalState.responseType}\n          eventId={eventId ?? ''}\n          mipaToken={mipaToken}\n        />\n      )}\n    </div>\n  );\n};\n","import React from 'react';\nimport { Button } from '@eventbrite/marmalade';\nimport { defineMessage, FormattedMessage, useIntl } from 'react-intl';\nimport { useBasicInfo } from '@/components/_shared/contexts/BasicInfoContext';\nimport { GET_TICKETS_MESSAGE } from '../CheckoutButton/CheckoutButton';\nimport styles from './ExternalTicketsPanel.module.scss';\nimport { getPanelDisplayPriceFromPriceInfo } from '../utils';\nimport { getDisplayTimezone, getSingleDateDisplayString } from '@/utils/dateTime';\nimport { useAttendeeTimezone } from '@/hooks/useAttendeeTimezone';\nimport { MULTIPLE_DATES } from '@/components/_shared/constants';\n\nexport const ON_PROVIDER_MESSAGE = defineMessage({\n  id: 'On {provider}',\n  defaultMessage: 'On {provider}',\n  description: 'External ticketing provider label in the conversion bar',\n});\n\nexport const ExternalTicketsPanel: React.FC = () => {\n  const { formatMessage, locale } = useIntl();\n  const { externalTicketing, endDate, hideEndDate, startDate, hideStartDate, isSeries, isOnline } = useBasicInfo();\n  const attendeeTimezone = useAttendeeTimezone(isOnline ?? false);\n  const externalTicketsUrl = externalTicketing?.externalTicketsUrl ?? '';\n  const externalTicketingProviderName = externalTicketing?.externalTicketingProviderName ?? '';\n  const externalTicketsAreAvailable = externalTicketing?.externalTicketsAreAvailable ?? false;\n\n  if (!externalTicketsAreAvailable || !externalTicketsUrl) {\n    return null;\n  }\n\n  const providerText = externalTicketingProviderName\n    ? formatMessage(ON_PROVIDER_MESSAGE, { provider: externalTicketingProviderName })\n    : '';\n\n  const priceText = getPanelDisplayPriceFromPriceInfo(\n    {\n      minimumTicketPrice: externalTicketing?.minimumTicketPrice,\n      maximumTicketPrice: externalTicketing?.maximumTicketPrice,\n      isFree: externalTicketing?.isFree,\n    },\n    locale,\n    formatMessage,\n  );\n\n  const headlineText = [priceText, providerText].filter(Boolean).join(' · ');\n\n  const showEndTimeOnly = hideStartDate && !hideEndDate && endDate?.utc;\n\n  const timezone = getDisplayTimezone({\n    isOnlineEvent: isOnline ?? false,\n    eventTimezone: startDate?.timezone,\n    attendeeTimezone,\n  });\n\n  const dateString = isSeries\n    ? formatMessage(MULTIPLE_DATES)\n    : startDate\n      ? getSingleDateDisplayString(\n          startDate,\n          !hideStartDate,\n          locale,\n          timezone,\n          formatMessage,\n          false,\n          !showEndTimeOnly ? ' • ' : undefined,\n          true,\n          isOnline ?? false,\n        )\n      : undefined;\n\n  return (\n    <div className={styles.container} data-testid=\"external-tickets-panel\">\n      <div className={styles.content}>\n        {headlineText && (\n          <div data-testid=\"conversion-bar-headline\" className={styles.headline}>\n            <span>{headlineText}</span>\n          </div>\n        )}\n        {dateString && (\n          <div data-testid=\"conversion-bar-date\" className={styles.date}>\n            {dateString}\n          </div>\n        )}\n      </div>\n      <div className={styles.ctaButtonWrapper}>\n        <Button\n          variant=\"primary\"\n          onClick={() => window.open(externalTicketsUrl, '_blank', 'noreferrer noopener')}\n          data-testid=\"external-tickets-link\"\n        >\n          <FormattedMessage {...GET_TICKETS_MESSAGE} />\n        </Button>\n      </div>\n    </div>\n  );\n};\n","import React, { useMemo, useState } from 'react';\nimport classNames from 'classnames';\n\nimport styles from './ConversionBar.module.scss';\nimport { getHighLevelStatus, HighLevelStatus, shouldTreatAsLiveEvent } from '@/utils/highLevelStatus';\nimport { useDisplayStatus } from '../_shared/contexts/DisplayStatusContext';\nimport { useMediaQuery } from '@/hooks';\nimport { MEDIA_QUERIES } from '@/components/_shared/constants';\nimport { LiveEventPanelInfo } from './LiveEvent/LiveEventPanelInfo';\nimport { GeneralEventPanelInfo } from './GeneralEventPanelInfo/GeneralEventPanelInfo';\nimport { DiscountSignal } from './DiscountSignal/DiscountSignal';\nimport { useBasicInfo } from '../_shared/contexts/BasicInfoContext';\nimport { useShouldDisplayRsvp } from './hooks/useShouldDisplayRsvp';\nimport { RSVPPanel } from './RSVP/RSVPPanel';\nimport { ExternalTicketsPanel } from './ExternalTicketsPanel/ExternalTicketsPanel';\n\ntype ConversionBarProps = {\n  isPositionCalculated?: boolean;\n};\n\nexport const ConversionBar: React.FC<ConversionBarProps> = ({ isPositionCalculated = true }) => {\n  const isDesktop = useMediaQuery(`(min-width: ${MEDIA_QUERIES.LARGE_UP_BREAKPOINT}px)`);\n\n  const wrapperClasses = classNames(styles.wrapper, {\n    [styles['relative']]: isDesktop,\n    [styles['hidden']]: !isPositionCalculated,\n  });\n  const [isDiscountSignalVisible, setIsDiscountSignalVisible] = useState(false);\n\n  const { shouldDisplayRsvp, mipaToken } = useShouldDisplayRsvp();\n  const { displayStatus, salesStatusData } = useDisplayStatus();\n\n  const { endDate, hasDonationTicketsAvailable = false, externalTicketing } = useBasicInfo();\n  const externalTicketsAreAvailable = externalTicketing?.externalTicketsAreAvailable ?? false;\n  const isLiveEvent = shouldTreatAsLiveEvent(displayStatus, endDate?.utc, hasDonationTicketsAvailable);\n\n  // Keep this behavior sales-driven: donations grace panel should depend on sales status,\n  // even when lifecycle status (ended/completed) wins displayStatus precedence.\n  const salesDerivedStatus = getHighLevelStatus(salesStatusData);\n  const isSalesEndedWithDonations = salesDerivedStatus === HighLevelStatus.SALES_ENDED && hasDonationTicketsAvailable;\n\n  const infoPanel = useMemo(() => {\n    if (shouldDisplayRsvp) {\n      return <RSVPPanel mipaToken={mipaToken} />;\n    }\n    if (externalTicketsAreAvailable) {\n      return <ExternalTicketsPanel />;\n    }\n    return isLiveEvent && !isSalesEndedWithDonations ? (\n      <LiveEventPanelInfo showDiscountSignal={setIsDiscountSignalVisible} />\n    ) : (\n      <GeneralEventPanelInfo showSalesEndedDonationPanel={isSalesEndedWithDonations && isLiveEvent} />\n    );\n  }, [shouldDisplayRsvp, mipaToken, externalTicketsAreAvailable, isLiveEvent, isSalesEndedWithDonations]);\n\n  return (\n    <div className={wrapperClasses} data-testid=\"conversion-bar\">\n      {isDiscountSignalVisible && <DiscountSignal />}\n      <div className={styles.content}>\n        <div className={styles.infoPanelWrapper} data-testid=\"conversion-bar-panel-info\">\n          {infoPanel}\n        </div>\n      </div>\n    </div>\n  );\n};\n","export { ConversionBar } from './ConversionBar';\n","import React from 'react';\nimport styles from './EventTitle.module.scss';\n\ntype EventTitleProps = {\n  title: string;\n};\n\nexport const EventTitle: React.FC<EventTitleProps> = ({ title }) => {\n  if (!title) {\n    return;\n  }\n  return (\n    <h1 className={styles.wrapper} data-testid=\"event-title\">\n      {title}\n    </h1>\n  );\n};\n","export { EventTitle } from './EventTitle';\n","import { BulletSeparator } from '@/components/_shared/BulletSeparator';\nimport styles from '../EventDetails.module.scss';\nimport type { Venue } from '@/types';\nimport { FormattedMessage } from 'react-intl';\nimport { LocationIcon } from '@/components/_shared/Icons/LocationIcon';\nimport type { ReactNode } from 'react';\n\ntype EventVenueProps = {\n  venue?: Venue;\n  isOnline?: boolean;\n};\n\ntype VenueLinkProps = {\n  children: ReactNode;\n};\n\nconst VenueLink = ({ children }: VenueLinkProps) => {\n  return (\n    <a className={styles.secondaryText} data-testid=\"event-venue\" href=\"#location\">\n      <LocationIcon aria-label=\"Location\" className={styles.locationIcon} />\n      {children}\n    </a>\n  );\n};\n\nexport const EventVenue = ({ venue, isOnline }: EventVenueProps) => {\n  if (isOnline) {\n    return (\n      <VenueLink>\n        <FormattedMessage\n          id=\"Online event\"\n          defaultMessage=\"Online event\"\n          description=\"Label for online event location\"\n        />\n      </VenueLink>\n    );\n  }\n\n  if (!venue && !isOnline) {\n    return (\n      <VenueLink>\n        <FormattedMessage\n          id=\"Location TBD\"\n          defaultMessage=\"Location TBD\"\n          description=\"To display in event venue section when location is TBD\"\n        />\n      </VenueLink>\n    );\n  }\n\n  if (!venue || !venue.name) {\n    return null;\n  }\n\n  const addressParts = [venue.address?.city, venue.address?.region].filter(Boolean);\n  const addressText = addressParts.join(', ');\n  const addressWithSeparator = addressText ? (\n    <>\n      <BulletSeparator />\n      {addressText}\n    </>\n  ) : null;\n\n  return (\n    <VenueLink>\n      {venue.name}\n      {addressWithSeparator}\n    </VenueLink>\n  );\n};\n","export const MANY_COLLECTIONS_LIMIT = 9;\n","import { useEffect } from 'react';\nimport { FormattedMessage, useIntl } from 'react-intl';\n\nimport { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\n\nimport { GACodes, LISTING_HEAP_IDS, LISTING_HEAP_SOURCE } from '@/components/_shared/constants';\n\nimport { MANY_COLLECTIONS_LIMIT } from './constants';\n\nimport styles from './CreatorCollectionsLink.module.scss';\n\nexport interface CreatorCollectionsLinkProps {\n  collections: WebappResponse['collections'];\n  viewMoreCollections?: (isOpen: boolean) => void;\n}\n\nexport const CreatorCollectionsLink: React.FC<CreatorCollectionsLinkProps> = ({ collections = [] }) => {\n  const { formatMessage } = useIntl();\n  const count = collections.length;\n  const singleCollection = collections[0];\n\n  useEffect(() => {\n    const link = document.getElementById('link-to-creator-collections');\n    const _handleSingleCollectionClick = () => {\n      _trackCollectionLink(GACodes.GA_ACTION_COLLECTION_PAGE_LINK_CLICK);\n    };\n\n    link?.addEventListener('click', _handleSingleCollectionClick);\n\n    return () => {\n      link?.removeEventListener('click', _handleSingleCollectionClick);\n    };\n  }, [singleCollection]);\n\n  if (count === 0) {\n    return <></>;\n  }\n\n  let message = null;\n\n  const _trackCollectionLink = (action: string) => {\n    trackAnalyticsEvent({\n      category: GACodes.GA_CATEGORY_CREATOR_COLLECTIONS_LISTING,\n      action,\n      label: GACodes.GA_LABEL_EVENT_DETAILS,\n      dimensions: {\n        source: LISTING_HEAP_SOURCE,\n      },\n    });\n  };\n\n  const _handleMultipleCollectionClick = () => {\n    // TODO EB-312460: handle multiple collections\n    _trackCollectionLink(GACodes.GA_ACTION_COLLECTION_PAGE_LINK_CLICK);\n    // until we support multiple collections, we'll open the first one. 1 collections only represents 90% of the collections\n    window.open(singleCollection.collectionUrl, '_blank');\n  };\n\n  if (count === 1) {\n    const { name, collectionUrl } = collections[0];\n    message = (\n      <FormattedMessage\n        id=\"Part of the <link>{name}</link> collection\"\n        defaultMessage=\"Part of the <link>{name}</link> collection\"\n        values={{\n          name,\n          link: (chunks) => (\n            <a\n              id=\"link-to-creator-collections\"\n              data-heap-id=\"Hero Content - Part of /Featured in Collection/s button\"\n              href={collectionUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n            >\n              {chunks}\n            </a>\n          ),\n        }}\n      />\n    );\n  } else {\n    const countToShow =\n      count > MANY_COLLECTIONS_LIMIT\n        ? formatMessage(\n            { id: '{maxCount}+', defaultMessage: '{maxCount}+', description: 'Truncated count when too many, ex: 9+' },\n            { maxCount: MANY_COLLECTIONS_LIMIT },\n          )\n        : `${count}`;\n    message = (\n      <FormattedMessage\n        id=\"Featured in <button>{count} collections</button>\"\n        defaultMessage=\"Featured in <button>{count} collections</button>\"\n        values={{\n          count: countToShow,\n          button: (chunks) => (\n            <button\n              className=\"creator-collections-link__button\"\n              onClick={_handleMultipleCollectionClick}\n              data-heap-id={LISTING_HEAP_IDS.PART_OF_A_COLLECTION}\n            >\n              {chunks}\n            </button>\n          ),\n        }}\n      />\n    );\n  }\n\n  return (\n    <div data-testid=\"link-to-creator-collections\" className={styles.root}>\n      {message}\n    </div>\n  );\n};\n","import type { WebappResponse } from '@eventbrite/event-listing-service-client';\nimport { CreatorCollectionsLink } from './CreatorCollectionsLink';\n\nexport const CreatorCollections = ({ collections }: { collections: WebappResponse['collections'] }) => {\n  return <CreatorCollectionsLink collections={collections} />;\n};\n","export { CreatorCollections } from './CreatorCollections';\n","import type { WebappResponse } from '@eventbrite/event-listing-service-client';\n\nimport styles from './PresenterInfo.module.scss';\n\ninterface PresenterInfoProps {\n  presenterInfo: NonNullable<WebappResponse['presenterInfo']>;\n}\n\nexport const PresenterInfo: React.FC<PresenterInfoProps> = ({ presenterInfo }) => {\n  if (!presenterInfo?.presenter) {\n    return null;\n  }\n\n  return <div className={styles.wrapper}>{presenterInfo.presenter}</div>;\n};\n","export { PresenterInfo } from './PresenterInfo';\n","import React from 'react';\n\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\n\nimport { useAppContext } from '@shared/context/AppContext';\nimport type { BasicInfo } from '@/types';\n\nimport { EventTitle } from './EventTitle';\nimport { OrganizerInfo } from './OrganizerInfo';\nimport { EventDateTime } from './EventDateTime/EventDateTime';\nimport { EventVenue } from './EventVenue/EventVenue';\nimport { CreatorCollections } from './CreatorCollections';\nimport { PresenterInfo } from './PresenterInfo';\n\nimport styles from './EventDetails.module.scss';\n\ninterface EventDetailsProps {\n  basicInfo: BasicInfo;\n  collections: WebappResponse['collections'];\n  presenterInfo: WebappResponse['presenterInfo'];\n}\n\nexport const EventDetails: React.FC<EventDetailsProps> = ({ basicInfo, collections, presenterInfo }) => {\n  const { data } = useAppContext();\n\n  const shouldShowDateTime = !!basicInfo.startDate?.utc;\n\n  const eventDateTimeComponent = shouldShowDateTime ? (\n    <EventDateTime\n      startDate={basicInfo.startDate}\n      endDate={basicInfo.endDate ?? { utc: null, timezone: undefined }}\n      locale={data.locale}\n      isOnlineEvent={basicInfo.isOnline || false}\n      isRecurringEvent={basicInfo.isSeries || false}\n      hideStartDate={basicInfo.hideStartDate}\n      hideEndDate={basicInfo.hideEndDate}\n    />\n  ) : null;\n\n  return (\n    <div className={styles.wrapper} data-testid=\"event-details\">\n      <EventTitle title={basicInfo.name} />\n      <div className={styles.organizerInfoWrapper}>\n        <OrganizerInfo organizer={basicInfo.organizer} />\n      </div>\n      <CreatorCollections collections={collections} />\n      <div className={styles.venueAndDateTimeWrapper}>\n        <EventVenue venue={basicInfo.venue} isOnline={basicInfo.isOnline} />\n        {eventDateTimeComponent}\n      </div>\n      {presenterInfo?.presenter && (\n        <div className={styles.presenterInfoWrapper}>\n          <PresenterInfo presenterInfo={presenterInfo} />\n        </div>\n      )}\n    </div>\n  );\n};\n","export { EventDetails } from './EventDetails';\n","import React from 'react';\nimport { ExpansionPanel, ExpansionPanelContent, ExpansionPanelTrigger } from '@eventbrite/marmalade';\nimport type { FAQ } from '../../types';\nimport styles from './FAQItem.module.scss';\n\ninterface FAQItemProps {\n  faq: FAQ;\n}\n\nexport const FAQItem: React.FC<FAQItemProps> = ({ faq }) => {\n  if (!faq.question?.trim() || !faq.answer?.trim()) {\n    return null;\n  }\n\n  return (\n    // @ts-expect-error: TS2739\n    <ExpansionPanel className={styles.faqItem}>\n      {/* @ts-expect-error: TS2739 */}\n      <ExpansionPanelTrigger className={styles.question}>{faq.question}</ExpansionPanelTrigger>\n      {/* @ts-expect-error: TS2739 */}\n      <ExpansionPanelContent>\n        <div className={styles.answer}>{faq.answer}</div>\n      </ExpansionPanelContent>\n    </ExpansionPanel>\n  );\n};\n","export { FAQItem } from './FAQItem';\n","import React from 'react';\nimport styles from './EventFAQs.module.scss';\nimport { useIntl } from 'react-intl';\nimport type { FAQ } from './types';\nimport { FAQItem } from './components/FAQItem';\nimport { useComponentVisibilityWithTracking } from '@/hooks/useComponentVisibility';\nimport { LISTING_HEAP_IDS, STATSIG_EVENT_NAMES } from '../_shared/constants';\n\nexport const FAQ_TRACKING_CONFIG = {\n  heap: {\n    eventName: LISTING_HEAP_IDS.FAQ_VIEW,\n  },\n  statsig: {\n    eventName: STATSIG_EVENT_NAMES.FAQ_VIEW,\n  },\n  heapId: LISTING_HEAP_IDS.FAQS_DROPDOWN,\n} as const;\n\ninterface EventFAQsProps {\n  faqs: FAQ[];\n}\n\nexport const EventFAQs: React.FC<EventFAQsProps> = ({ faqs }) => {\n  const { formatMessage } = useIntl();\n\n  const ref = useComponentVisibilityWithTracking(undefined, FAQ_TRACKING_CONFIG);\n\n  if (!faqs || faqs.length === 0) {\n    return null;\n  }\n\n  return (\n    <div ref={ref} data-testid=\"event-faqs\" data-heap-id={FAQ_TRACKING_CONFIG.heapId}>\n      <div className={styles.content}>\n        <div className={styles.title}>{formatMessage({ id: 'Frequently asked questions' })}</div>\n        {faqs.map((faq) => (\n          <FAQItem key={`${faq.question}-${faq.answer}`} faq={faq} />\n        ))}\n      </div>\n    </div>\n  );\n};\n","export { EventFAQs } from './EventFAQs';\nexport type { FAQ } from './types';\n","export const getFocalPoint = (imageUrl: string): { x: number; y: number } | null => {\n  if (!imageUrl) {\n    return null;\n  }\n\n  let imageUrlObject;\n  try {\n    imageUrlObject = new URL(imageUrl);\n  } catch (e) {\n    console.error('Error parsing image URL', e);\n    return null;\n  }\n\n  if (!imageUrlObject.searchParams.has('fp-x')) {\n    return null;\n  }\n\n  return {\n    x: parseFloat(imageUrlObject.searchParams.get('fp-x') || '0.5'),\n    y: parseFloat(imageUrlObject.searchParams.get('fp-y') || '0.5'),\n  };\n};\n","/* eslint-disable @next/next/no-img-element */\nimport React from 'react';\nimport classNames from 'classnames';\nimport { getFocalPoint } from '../../../utils/images';\nimport { CarouselItems } from '../HeroCarousel';\nimport styles from './HeroImage.module.scss';\nimport NextImage, { getImageProps } from 'next/image';\n\nexport type HeroImageProps = {\n  alt?: string;\n  fetchPriority?: FetchPriorityType;\n  loading?: LoadingType;\n  className?: string;\n} & Pick<CarouselItems, 'croppedLogoUrl480' | 'croppedLogoUrl600' | 'croppedLogoUrl940'>;\n\nexport type LoadingType = 'eager' | 'lazy';\n\nexport enum FetchPriorityType {\n  high = 'high',\n  low = 'low',\n}\n\nexport const HeroImage = ({\n  className,\n  alt,\n  croppedLogoUrl480,\n  croppedLogoUrl600,\n  croppedLogoUrl940,\n  fetchPriority,\n  loading,\n}: HeroImageProps) => {\n  const focalPoint = getFocalPoint(croppedLogoUrl480 || croppedLogoUrl600 || croppedLogoUrl940 || '');\n  const primaryImageUrl = croppedLogoUrl940 || croppedLogoUrl600 || croppedLogoUrl480 || '';\n  const fallbackImageUrl = croppedLogoUrl600 || croppedLogoUrl940 || croppedLogoUrl480 || '';\n  const imageClasses = classNames(styles.image, className);\n\n  const {\n    props: { srcSet, sizes },\n  } = getImageProps({\n    alt: '',\n    sizes: '(max-width:480px) 480px, (max-width:600px) 600px, 940px',\n    width: 940,\n    height: 560,\n    src: primaryImageUrl,\n  });\n\n  return (\n    <picture data-testid=\"hero-image\">\n      <source srcSet={srcSet} sizes={sizes} />\n      {focalPoint ? (\n        <Image\n          className={imageClasses}\n          alt={alt || ''}\n          src={fallbackImageUrl}\n          loading={loading}\n          fetchPriority={fetchPriority}\n          x={focalPoint.x}\n          y={focalPoint.y}\n          data-testid=\"hero-img\"\n        />\n      ) : (\n        <NextImage\n          className={imageClasses}\n          width={600}\n          height={300}\n          alt={alt || 'Hero image'}\n          src={fallbackImageUrl}\n          loading={loading || (fetchPriority === 'high' ? 'eager' : 'lazy')}\n          fetchPriority={fetchPriority}\n          data-testid=\"hero-img\"\n        />\n      )}\n    </picture>\n  );\n};\n\ninterface ImageProps {\n  x: number;\n  y: number;\n  className?: string;\n  alt: string;\n  src?: string;\n  loading?: LoadingType;\n  fetchPriority?: FetchPriorityType;\n  'data-testid'?: string;\n}\n\nconst Image: React.FC<ImageProps> = ({ x, y, className, src, fetchPriority, loading, alt, ...props }) => {\n  const imageStyle = {\n    objectPosition: `${x * 100}% ${y * 100}%`,\n  };\n\n  if (!src) {\n    return null;\n  }\n\n  return (\n    <NextImage\n      className={className}\n      style={imageStyle}\n      src={src}\n      width={600}\n      height={300}\n      loading={loading || (fetchPriority === 'high' ? 'eager' : 'lazy')}\n      fetchPriority={fetchPriority}\n      {...props}\n      alt={alt || ''}\n    />\n  );\n};\n","export * from './HeroImage';\n","import React, { useState } from 'react';\nimport { LISTING_HEAP_IDS } from '../../_shared/constants';\nimport { Modal as LegacyEDSModal } from '@eventbrite/legacy-eds.modal';\n\nimport { Play, Cross } from '../../_shared/Icons';\n\nimport styles from './FeaturedHeroVideo.module.scss';\n\ninterface FeaturedHeroVideoProps {\n  alt?: string;\n  embedUrl: string;\n  children?: React.ReactNode;\n}\n\nexport const FeaturedHeroVideo: React.FC<FeaturedHeroVideoProps> = ({ alt, embedUrl, children }) => {\n  const [shouldShowVideo, setShouldShowVideo] = useState(false);\n  return (\n    <>\n      <div className={styles.root}>\n        <div className={styles.overlay}>\n          <button\n            data-heap-id={LISTING_HEAP_IDS.HERO_VIDEO}\n            className={styles.playButton}\n            aria-label={'Play'}\n            onClick={() => setShouldShowVideo(true)}\n          >\n            <div className={styles.playButtonIcon}>\n              <Play />\n            </div>\n          </button>\n        </div>\n        {children}\n      </div>\n      {shouldShowVideo && (\n        <LegacyEDSModal\n          isShown={true}\n          onClose={() => setShouldShowVideo(false)}\n          noMinHeight={false}\n          type=\"fullscreen\"\n          noPadding={true}\n          closeButtonCustomIcon={(() => <Cross />) as unknown as React.ReactNode}\n          closeButtonClassName={styles.closeButton}\n          isClosable={true}\n          isPortal={true}\n          modalHostNodeSelector=\"body\"\n          dangerouslySetContainerClassName={{ __className: styles.modalContainer as string }}\n          __containerClassName={styles.modal}\n        >\n          <div className={styles.modalVideoWrapper}>\n            <iframe\n              src={`${embedUrl.split('?')[0]}?autoplay=1&mute=1`}\n              frameBorder=\"0\"\n              allowFullScreen\n              allow=\"autoplay\"\n              title={alt || 'Video content'}\n              loading=\"lazy\"\n            />\n          </div>\n        </LegacyEDSModal>\n      )}\n    </>\n  );\n};\n","export * from './FeaturedHeroVideo';\n","export enum DatadogAdsEvents {\n  Impression = 'ads-impressions',\n  Mounted = 'ads-renders',\n  RequestedImpression = 'ads-requested-log-impressions',\n}\n\nexport enum DatadogVideoEvents {\n  PlaybackStart = 'listings-webapp.event_video_playback_start',\n  PlaybackFailed = 'listings-webapp.event_video_playback_failed',\n  PlaybackEnd = 'listings-webapp.event_video_playback_end',\n}\n","import { FormattedEvent } from '@eventbrite/consumer-search.event-renderer';\n\n/**\n * Event interaction types that can be tracked\n */\nexport enum EventInteractions {\n  Impression = 'impression',\n  Click = 'click',\n  Hover = 'hover',\n  HideAd = 'hide-ad',\n  ReportAd = 'report-ad',\n  Mounted = 'mounted',\n  Follow = 'follow',\n  Unfollow = 'unfollow',\n}\n\n/**\n * Event name for the custom event that gets dispatched\n */\nexport const PLACE_EVENT_INTERACTION = 'PlaceEventInteraction';\n\n/**\n * Raw event interaction from EventCardTracking\n */\nexport interface EventInteraction {\n  id: string;\n  action: EventInteractions;\n  event: FormattedEvent;\n}\n\n/**\n * Event interaction with tracking context added\n */\nexport interface EventInteractionWithContext extends EventInteraction {\n  user: {\n    id?: string;\n    locale?: string;\n    guestId?: string;\n    sessionId?: string;\n  };\n  adId?: string;\n  place: {\n    name: string;\n    position: number;\n    page: number;\n    context: Record<string, unknown>;\n    tabKey?: string;\n    placementId?: string;\n    absoluteRank?: number;\n    subInterface?: {\n      name?: string;\n      position?: string;\n    };\n  };\n  displayContext?: {\n    hasOpenPromotion: boolean;\n    hasBOGOLabel: boolean;\n    urgencySignals?: string[];\n  };\n  venueId?: string;\n}\n\n/**\n * Custom event type for event interactions\n */\nexport type InteractionCustomEvent = CustomEvent<EventInteraction>;\n\n/**\n * Element that can listen to events (simplified from HTMLElement)\n */\nexport interface TrackableElement {\n  addEventListener(type: string, listener: (event: CustomEvent) => void): void;\n  removeEventListener(type: string, listener: (event: CustomEvent) => void): void;\n  dispatchEvent(event: CustomEvent): void;\n}\n","import { type EventInteractionWithContext, EventInteractions } from '../types';\n\n/**\n * Base class for all interaction loggers\n *\n * Provides common functionality for filtering and processing interactions\n * while allowing each logger to implement its own transformation and logging logic\n */\nexport abstract class BaseInteractionsLogger<T> {\n  protected allowedEvents: EventInteractions[] = Object.values(EventInteractions);\n  protected excludedEvents: EventInteractions[] = [];\n\n  /**\n   * Transforms an interaction into the format expected by this logger\n   *\n   * @param interaction - The interaction to transform\n   * @returns The transformed interaction in logger-specific format\n   */\n  protected abstract transformInteraction(interaction: EventInteractionWithContext): T;\n\n  /**\n   * Logs the transformed interactions to the destination\n   *\n   * @param transformedInteractions - Array of transformed interactions\n   */\n  protected abstract log(transformedInteractions: T[]): void;\n\n  /**\n   * Processes a batch of interactions\n   *\n   * This method:\n   * 1. Filters interactions based on allowed/excluded events\n   * 2. Transforms each interaction using the logger-specific logic\n   * 3. Logs the transformed interactions\n   *\n   * @param interactions - Array of interactions to process\n   */\n  public run(interactions: EventInteractionWithContext[]) {\n    const filtered = this.filterInteractions(interactions);\n\n    if (filtered.length === 0) {\n      return;\n    }\n\n    const transformed = filtered.map((interaction) => this.transformInteraction(interaction));\n    this.log(transformed);\n  }\n\n  /**\n   * Filter with custom logic the interactions.\n   * @param interaction - The interaction to filter.\n   * @returns If the interaction should be logged or not\n   */\n  // eslint-disable-next-line @typescript-eslint/no-unused-vars\n  protected filterEventsBy(_: EventInteractionWithContext): boolean {\n    return true;\n  }\n\n  /**\n   * Filters interactions based on allowed and excluded events\n   *\n   * @param interactions - Array of interactions to filter\n   * @returns Filtered array of interactions\n   */\n  protected filterInteractions(interactions: EventInteractionWithContext[]): EventInteractionWithContext[] {\n    return interactions\n      .filter(({ action }) => this.allowedEvents.includes(action) && !this.excludedEvents.includes(action))\n      .filter(this.filterEventsBy);\n  }\n}\n","import { type EventInteractionWithContext, EventInteractions } from '../types';\nimport { BaseInteractionsLogger } from './BaseInteractionsLogger';\nimport { DatadogAdsEvents } from './DatadogRUMEvents';\n\n// Type declaration for Datadog RUM\ndeclare global {\n  interface Window {\n    DD_RUM?: {\n      addAction: (name: string, data: unknown) => void;\n      onReady: (callback: () => void) => void;\n      addError?: (error: unknown, context?: object) => void;\n    };\n  }\n}\n\n/**\n * Adds a custom RUM event to Datadog\n *\n * @param name - Event name\n * @param data - Event payload\n * @returns True if event was queued, false otherwise\n */\nexport function addCustomRUMEvent<EventName = string, Payload = Record<string, unknown>>(\n  name: EventName,\n  data: Payload,\n): boolean {\n  if (typeof window === 'undefined') return false;\n\n  if (!window?.DD_RUM?.addAction || !window?.DD_RUM?.onReady) {\n    console.warn('Datadog RUM not initialized. Call initializeDatadog() first.');\n    return false;\n  }\n\n  try {\n    window.DD_RUM.onReady(() => {\n      window.DD_RUM?.addAction(String(name), data);\n    });\n    return true;\n  } catch (error) {\n    console.error('Failed to send Datadog event:', error);\n    return false;\n  }\n}\n\ntype InteractionDatadogLoggerData = {\n  action: EventInteractions;\n  place: string;\n  placementId: string;\n};\n\nexport class InteractionsDatadogLogger extends BaseInteractionsLogger<InteractionDatadogLoggerData> {\n  protected allowedEvents: EventInteractions[] = [EventInteractions.Impression, EventInteractions.Mounted];\n\n  private readonly interactions_history: Set<string> = new Set();\n\n  /**\n   * Tracks event card interactions for immediate Datadog logging\n   * @param interaction - The interaction to track\n   */\n  public trackEventCardInteraction({\n    id,\n    place,\n    action,\n  }: Pick<EventInteractionWithContext, 'id' | 'place' | 'action'>) {\n    const interactionUniqueId = `${id}-${place?.placementId}-${action}`;\n    if (!this.allowedEvents.includes(action) || this.interactions_history.has(interactionUniqueId)) return;\n\n    this.interactions_history.add(interactionUniqueId);\n    const datadogEvent = this.getDatadogEvent(action);\n    if (datadogEvent) {\n      this.sendInteractionEvent(place.name, datadogEvent);\n    }\n  }\n\n  /**\n   * Transforms an interaction for Datadog logging\n   *\n   * @param interaction - The interaction to transform\n   * @returns Datadog-specific data format\n   */\n  protected transformInteraction(interaction: EventInteractionWithContext): InteractionDatadogLoggerData {\n    return {\n      action: interaction.action,\n      place: interaction.place.name,\n      placementId: interaction.place.placementId ?? '',\n    };\n  }\n\n  /**\n   * Logs interactions to Datadog RUM\n   * - Only logs impressions with placement_id\n   * - Only sends RequestedImpression events\n   *\n   * @param transformedInteractions - Array of transformed interactions\n   */\n  protected log(transformedInteractions: InteractionDatadogLoggerData[]): void {\n    this.sendRequestedImpressionMetrics(transformedInteractions);\n  }\n\n  /**\n   * Maps interaction actions to Datadog event names\n   *\n   * @param action - The interaction action\n   * @returns Datadog event name or undefined\n   */\n  private getDatadogEvent(action: EventInteractions): DatadogAdsEvents | undefined {\n    const datadogEventsMap: Partial<Record<EventInteractions, DatadogAdsEvents>> = {\n      [EventInteractions.Impression]: DatadogAdsEvents.Impression,\n      [EventInteractions.Mounted]: DatadogAdsEvents.Mounted,\n    };\n    return datadogEventsMap[action];\n  }\n\n  /**\n   * Sends an interaction event to Datadog RUM\n   *\n   * @param interfaceName - The interface name (e.g., 'related_events')\n   * @param action - The Datadog event action\n   * @param count - Number of events (default: 1)\n   */\n  private sendInteractionEvent(interfaceName: string, action: DatadogAdsEvents, count = 1): void {\n    addCustomRUMEvent(action, {\n      value: count,\n      app: 'web',\n      is_mobile: false, // TODO: use CF header to determine if mobile\n      interface: interfaceName,\n    });\n  }\n\n  /**\n   * Sends Datadog metrics for impressions with placement_id\n   *\n   * - Filters for impressions with placement_id\n   * - Sends RequestedImpression events only\n   *\n   * @param transformedInteractions - Array of transformed interactions\n   */\n  private sendRequestedImpressionMetrics(transformedInteractions: InteractionDatadogLoggerData[]): void {\n    const impressions = transformedInteractions.filter(\n      (interaction) => interaction.action === EventInteractions.Impression && !!interaction.placementId,\n    );\n\n    impressions.forEach((interaction) => {\n      this.sendInteractionEvent(interaction.place, DatadogAdsEvents.RequestedImpression);\n    });\n  }\n}\n","import type { VideoStateMetric } from './VideoStateMetric';\n\nexport type Handlers = {\n  onBuffering?: () => void;\n  onError?: (error?: MediaError) => void;\n  onLoadedMetadata?: (duration: number) => void;\n  onPlay?: () => void;\n  onTimeUpdate?: (currentTime: number, duration: number) => void;\n  onEnded?: (metrics: VideoMetrics, metadata: VideoMetaData) => void;\n};\n\nexport type EventToSubscribe = {\n  event: string;\n  handler: (event?: Event) => void;\n};\n\nexport type MediaErrorEvent = Event & {\n  target?: Event['target'] & { error?: MediaError };\n};\n\nexport enum VIDEO_STATES {\n  UNINITIALIZED = 'uninitialized', // load hasn't started\n  LOADING = 'loading', // video initial load\n  READY = 'ready', // video is ready to play but hasn't started yet\n  PLAYING = 'playing',\n  PAUSED = 'paused',\n  ENDED = 'ended',\n  SEEKING = 'seeking', // user started seeking by clicking somewhere in the progress bar\n  STALLED = 'stalled', // video is stopped by other reason than user interaction (buffering or stalled)\n  ERROR = 'error',\n}\n\nexport type VideoMetaData = {\n  duration: number;\n};\n\nexport type VideoMetrics = Record<VIDEO_STATES, VideoStateMetric>;\n\nexport const DEFAULT_ELAPSED_TIME = 0.01;\n","import {\n  VIDEO_STATES,\n  type VideoMetaData,\n  type VideoMetrics,\n  DEFAULT_ELAPSED_TIME,\n} from '../../../_shared/Video/types';\n\nexport const getStalledRatioOverPlaybackTime = (metrics: VideoMetrics): number => {\n  return (\n    metrics[VIDEO_STATES.STALLED].elapsedTime / (metrics[VIDEO_STATES.PLAYING].elapsedTime || DEFAULT_ELAPSED_TIME)\n  );\n};\n\nexport const getStalledRatioOverDuration = (metrics: VideoMetrics, metadata: VideoMetaData): number => {\n  return metrics[VIDEO_STATES.STALLED].elapsedTime / metadata.duration;\n};\n\nexport const getTotalStalledTime = (metrics: VideoMetrics): number => {\n  return metrics[VIDEO_STATES.STALLED].elapsedTime;\n};\n\nexport const getTimesStalled = (metrics: VideoMetrics): number => {\n  return metrics[VIDEO_STATES.STALLED].count;\n};\n\nexport const getPlaybackTime = (metrics: VideoMetrics): number => {\n  return metrics[VIDEO_STATES.PLAYING].elapsedTime;\n};\n","import { VIDEO_STATES, type VideoMetrics } from './types';\n\nexport class VideoStateMetric {\n  elapsedTime: number;\n  count: number;\n\n  constructor(elapsedTime = 0, count = 0) {\n    this.elapsedTime = elapsedTime;\n    this.count = count;\n  }\n\n  incrementCount() {\n    this.count++;\n    return this;\n  }\n\n  incrementTime(time: number) {\n    this.elapsedTime += time;\n    return this;\n  }\n}\n\nexport const getInitialStateMetrics = (): VideoMetrics => ({\n  [VIDEO_STATES.UNINITIALIZED]: new VideoStateMetric(),\n  [VIDEO_STATES.LOADING]: new VideoStateMetric(),\n  [VIDEO_STATES.READY]: new VideoStateMetric(),\n  [VIDEO_STATES.PLAYING]: new VideoStateMetric(),\n  [VIDEO_STATES.PAUSED]: new VideoStateMetric(),\n  [VIDEO_STATES.ENDED]: new VideoStateMetric(),\n  [VIDEO_STATES.SEEKING]: new VideoStateMetric(),\n  [VIDEO_STATES.STALLED]: new VideoStateMetric(),\n  [VIDEO_STATES.ERROR]: new VideoStateMetric(),\n});\n","import { useEffect, useRef, useState } from 'react';\nimport { useUnmount } from 'react-use';\nimport { EventToSubscribe, Handlers, MediaErrorEvent, VIDEO_STATES, type VideoMetrics } from './types';\nimport { getInitialStateMetrics } from './VideoStateMetric';\n\nexport const useVideoEventHandlers = ({\n  onError,\n  onLoadedMetadata,\n  onBuffering,\n  onTimeUpdate,\n  onPlay,\n  onEnded,\n}: Handlers) => {\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const [videoState, setVideoState] = useState<VIDEO_STATES>(VIDEO_STATES.UNINITIALIZED);\n  const [videoStateMetrics, setVideoStateMetrics] = useState<VideoMetrics>(getInitialStateMetrics());\n\n  const currentStateTimeRef = useRef<number>(Date.now());\n  const videoStateRef = useRef<VIDEO_STATES>(VIDEO_STATES.UNINITIALIZED);\n  const metricsCollectionEnabled = useRef<boolean>(true);\n\n  const transitionToState = (newState: VIDEO_STATES) => {\n    if (newState === videoStateRef.current) {\n      return;\n    }\n    if (!metricsCollectionEnabled.current) {\n      videoStateRef.current = newState;\n      setVideoState(newState);\n      return;\n    }\n    const now = Date.now();\n    const elapsedTime = now - currentStateTimeRef.current;\n    setVideoStateMetrics((prevMetrics) => ({\n      ...prevMetrics,\n      [videoStateRef.current]: prevMetrics[videoStateRef.current].incrementTime(elapsedTime),\n      [newState]: prevMetrics[newState].incrementCount(),\n    }));\n    currentStateTimeRef.current = now;\n    videoStateRef.current = newState;\n    setVideoState(newState);\n  };\n\n  const onLoadedMetadataHandler = () => {\n    const videoElement = videoRef.current;\n    if (videoElement && onLoadedMetadata) {\n      onLoadedMetadata(videoElement.duration);\n    }\n    transitionToState(VIDEO_STATES.LOADING);\n  };\n\n  const onLoopHandler = () => {\n    if (!metricsCollectionEnabled.current) {\n      return;\n    }\n    videoStateMetrics[videoStateRef.current] = videoStateMetrics[videoStateRef.current].incrementTime(\n      Date.now() - currentStateTimeRef.current,\n    );\n    if (onEnded) {\n      onEnded(videoStateMetrics, {\n        duration: videoRef.current?.duration || 0.01,\n      });\n    }\n    metricsCollectionEnabled.current = false;\n  };\n\n  const onTimeUpdateHandler = () => {\n    const videoElement = videoRef.current;\n    if (videoElement && onTimeUpdate) {\n      onTimeUpdate(videoElement.currentTime, videoElement.duration);\n    }\n\n    // Check if the video has reached the end and is looping\n    if (videoElement && videoElement.loop && videoElement.currentTime === videoElement.duration) {\n      onLoopHandler();\n    }\n  };\n\n  const onBufferingHandler = () => {\n    const videoElement = videoRef.current;\n    if (videoElement && onBuffering) {\n      const statesToIgnore = [\n        VIDEO_STATES.ENDED,\n        VIDEO_STATES.LOADING,\n        VIDEO_STATES.READY,\n        VIDEO_STATES.SEEKING,\n        VIDEO_STATES.STALLED,\n      ];\n\n      if (statesToIgnore.includes(videoStateRef.current) || videoElement.seeking) {\n        return;\n      }\n\n      onBuffering();\n    }\n    transitionToState(VIDEO_STATES.STALLED);\n  };\n\n  const onErrorHandler = (event?: Event) => {\n    if (onError) {\n      onError((event as MediaErrorEvent)?.target?.error);\n    }\n    transitionToState(VIDEO_STATES.ERROR);\n  };\n\n  const onPlayHandler = () => {\n    if (onPlay) {\n      onPlay();\n    }\n    transitionToState(VIDEO_STATES.PLAYING);\n  };\n\n  const moveToPaused = () => {\n    transitionToState(VIDEO_STATES.PAUSED);\n  };\n  const moveToEnded = () => {\n    transitionToState(VIDEO_STATES.ENDED);\n  };\n  const moveToSeeking = () => {\n    transitionToState(VIDEO_STATES.SEEKING);\n  };\n  const moveToLoading = () => {\n    transitionToState(VIDEO_STATES.LOADING);\n  };\n  const moveToReady = () => {\n    transitionToState(VIDEO_STATES.READY);\n  };\n  const moveToPlaying = () => {\n    transitionToState(VIDEO_STATES.PLAYING);\n  };\n\n  const eventsToSubscribe: EventToSubscribe[] = [\n    { event: 'loadstart', handler: moveToLoading },\n    { event: 'loadedmetadata', handler: onLoadedMetadataHandler },\n    { event: 'play', handler: onPlayHandler },\n    { event: 'pause', handler: moveToPaused },\n    { event: 'ended', handler: moveToEnded },\n    { event: 'seeking', handler: moveToSeeking },\n    { event: 'seeked', handler: moveToPlaying },\n    { event: 'playing', handler: moveToPlaying },\n    { event: 'canplay', handler: moveToReady },\n    { event: 'waiting', handler: onBufferingHandler },\n    { event: 'stalled', handler: onBufferingHandler },\n    { event: 'timeupdate', handler: onTimeUpdateHandler },\n    { event: 'error', handler: onErrorHandler },\n  ];\n\n  useEffect(() => {\n    const videoElement = videoRef.current;\n    if (videoElement) {\n      eventsToSubscribe.forEach(({ event, handler }: EventToSubscribe) => {\n        videoElement.addEventListener(event, handler);\n      });\n    }\n    return () => {\n      if (videoElement) {\n        eventsToSubscribe.forEach(({ event, handler }: EventToSubscribe) => {\n          videoElement.removeEventListener(event, handler);\n        });\n      }\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [videoStateMetrics]);\n\n  useUnmount(() => {\n    onLoopHandler();\n  });\n\n  return {\n    ref: videoRef,\n    videoState,\n    getMetrics: () => videoStateMetrics,\n  };\n};\n","import React, { useEffect } from 'react';\nimport type { VideoMetaData, VideoMetrics } from './types';\nimport { useVideoEventHandlers } from './useVideoEventHandlers';\n\ntype VideoProps = {\n  alt?: string;\n  url: string;\n  className?: string;\n  onLoadedMetadata?: (duration: number) => void;\n  onTimeUpdate?: (currentTime: number, duration: number) => void;\n  onError?: (error?: MediaError) => void;\n  onBuffering?: () => void;\n  onEnded?: (metrics: VideoMetrics, metadata: VideoMetaData) => void;\n};\n\nexport const Video: React.FC<VideoProps> = React.memo(\n  ({ alt, url, className, onLoadedMetadata, onTimeUpdate, onError, onBuffering, onEnded }) => {\n    const { ref: videoRef } = useVideoEventHandlers({\n      onTimeUpdate,\n      onLoadedMetadata,\n      onError,\n      onBuffering,\n      onEnded,\n    });\n\n    useEffect(() => {\n      const videoElement = videoRef.current;\n\n      const playVideo = () => {\n        if (videoElement && videoElement.paused) {\n          videoElement.load();\n          videoElement.play().catch(() => {\n            console.error('Error automatically playing video');\n          });\n        }\n      };\n\n      if (videoElement) {\n        playVideo();\n      }\n\n      return () => {\n        if (videoElement) {\n          videoElement.pause();\n          videoElement.currentTime = 0;\n          videoElement.load(); // this resets the video element\n        }\n      };\n    }, [videoRef]);\n\n    return (\n      <video\n        ref={videoRef}\n        className={className}\n        title={alt || 'Native video content'}\n        src={url}\n        controls\n        autoPlay={true}\n        loop\n        playsInline\n        onClick={(e) => e.stopPropagation()}\n        controlsList=\"nodownload nofullscreen\"\n      />\n    );\n  },\n);\n\nVideo.displayName = 'Video';\n","/* eslint-disable @next/next/no-img-element */\nimport React, { useState } from 'react';\nimport styles from './NativeVideo.module.scss';\nimport { Cross, Play } from '../../_shared/Icons';\nimport { Modal as LegacyEDSModal } from '@eventbrite/legacy-eds.modal';\nimport { track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { LISTING_HEAP_IDS } from '../../_shared/constants';\nimport { DatadogVideoEvents } from '../../../tracking/loggers/DatadogRUMEvents';\nimport { addCustomRUMEvent } from '../../../tracking/loggers/InteractionsDatadogLogger';\nimport {\n  getPlaybackTime,\n  getStalledRatioOverDuration,\n  getStalledRatioOverPlaybackTime,\n  getTotalStalledTime,\n} from './tracking/videoMetrics';\nimport type { VideoMetaData, VideoMetrics } from '../../_shared/Video/types';\nimport { Video } from '../../_shared/Video/Video';\n\ninterface NativeVideoProps {\n  url: string;\n  children?: React.ReactNode;\n}\n\nexport const NativeVideo: React.FC<NativeVideoProps> = ({ url, children }) => {\n  const [shouldShowVideo, setShouldShowVideo] = useState(false);\n\n  const handleLoadedMetadata = (duration: number) => {\n    addCustomRUMEvent(DatadogVideoEvents.PlaybackStart, {\n      location: 'fullscreen',\n      value: 1,\n    });\n\n    if (!duration) {\n      return;\n    }\n    track({\n      eventName: LISTING_HEAP_IDS.VIDEO_DURATION,\n      eventData: {\n        eventBucketLabel: `Video duration: ${duration} seconds`,\n      },\n    });\n  };\n\n  const handleTimeUpdate = (currentTime: number, duration: number) => {\n    if (!duration) {\n      return;\n    }\n    const percentageOfVideoPlayed = Math.floor((currentTime / duration) * 100);\n    if ([25, 50, 75, 100].includes(percentageOfVideoPlayed)) {\n      track({\n        eventName: LISTING_HEAP_IDS.VIDEO_PLAYED,\n        eventData: {\n          percentageOfVideoPlayed,\n        },\n      });\n    }\n  };\n\n  const handleError = (error?: MediaError) => {\n    addCustomRUMEvent(DatadogVideoEvents.PlaybackFailed, {\n      error,\n      location: 'fullscreen',\n      value: 1,\n    });\n  };\n\n  const handleEnded = (metrics: VideoMetrics, metadata: VideoMetaData) => {\n    const playbackTime = getPlaybackTime(metrics);\n    const stalledTime = getTotalStalledTime(metrics);\n    const stalledRatioOverPlaybackTime = getStalledRatioOverPlaybackTime(metrics);\n    const stalledRatioOverDuration = getStalledRatioOverDuration(metrics, metadata);\n    addCustomRUMEvent(DatadogVideoEvents.PlaybackEnd, {\n      playback_time: playbackTime,\n      stalled_time: stalledTime,\n      stalled_over_playback_time: stalledRatioOverPlaybackTime,\n      stalled_over_video_duration: stalledRatioOverDuration,\n      location: 'fullscreen',\n      value: 1,\n    });\n  };\n\n  return (\n    <>\n      <div className={styles.root}>\n        <div className={styles.overlay}>\n          <button\n            className={styles.playButton}\n            aria-label={'Play'}\n            onClick={() => setShouldShowVideo(true)}\n            data-heap-id={LISTING_HEAP_IDS.HERO_VIDEO}\n          >\n            <div className={styles.playButtonIcon}>\n              <Play />\n            </div>\n          </button>\n        </div>\n        {children}\n      </div>\n      {shouldShowVideo && (\n        <LegacyEDSModal\n          isShown={true}\n          onClose={() => setShouldShowVideo(false)}\n          noMinHeight={false}\n          type=\"simple\"\n          noPadding={true}\n          closeButtonCustomIcon={(() => <Cross />) as unknown as React.ReactNode}\n          closeButtonClassName={styles.closeButton}\n          isClosable={true}\n          isPortal={true}\n          modalHostNodeSelector=\"body\"\n          dangerouslySetContainerClassName={{ __className: styles.modalContainer as string }}\n          __containerClassName={styles.modal}\n        >\n          <div\n            onClick={() => setShouldShowVideo(false)}\n            className={styles.modalVideoWrapper}\n            data-testid=\"native-video-wrapper\"\n          >\n            <Video\n              url={url}\n              onLoadedMetadata={handleLoadedMetadata}\n              onTimeUpdate={handleTimeUpdate}\n              onError={handleError}\n              onEnded={handleEnded}\n            />\n          </div>\n        </LegacyEDSModal>\n      )}\n    </>\n  );\n};\n","export { NativeVideo } from './NativeVideo';\n","import React from 'react';\nimport type { FeaturedVideoProps, NativeVideoProps } from '../types';\nimport { FeaturedHeroVideo } from '../FeaturedHeroVideo';\nimport type { CarouselItems } from '../HeroCarousel';\nimport { FetchPriorityType } from '../HeroImage';\nimport { HeroImage } from '../HeroImage';\nimport { NativeVideo } from '../NativeVideo';\n\ntype HeroVideoProps = {\n  nativeVideo?: NativeVideoProps;\n  featuredVideo?: FeaturedVideoProps;\n  overrideThumbnail?: CarouselItems;\n};\n\nexport const HeroVideo = ({ nativeVideo, featuredVideo, overrideThumbnail }: HeroVideoProps) => {\n  if (nativeVideo?.url) {\n    return (\n      <NativeVideo url={nativeVideo.url}>\n        <HeroImage\n          croppedLogoUrl480={overrideThumbnail?.croppedLogoUrl480 || ''}\n          croppedLogoUrl600={overrideThumbnail?.croppedLogoUrl600 || ''}\n          croppedLogoUrl940={overrideThumbnail?.croppedLogoUrl940 || ''}\n          alt={''}\n          fetchPriority={FetchPriorityType.high}\n        />\n      </NativeVideo>\n    );\n  }\n\n  if (!featuredVideo?.embedUrl) {\n    return null;\n  }\n  return (\n    <FeaturedHeroVideo embedUrl={featuredVideo.embedUrl}>\n      <HeroImage\n        croppedLogoUrl480={overrideThumbnail?.croppedLogoUrl480 || featuredVideo.thumbnail?.small?.url || ''}\n        croppedLogoUrl600={overrideThumbnail?.croppedLogoUrl600 || featuredVideo.thumbnail?.medium?.url || ''}\n        croppedLogoUrl940={overrideThumbnail?.croppedLogoUrl940 || featuredVideo.thumbnail?.large?.url || ''}\n        alt={''}\n        fetchPriority={FetchPriorityType.high}\n      />\n    </FeaturedHeroVideo>\n  );\n};\n","export { HeroVideo } from './HeroVideo';\n","import { useEffect, useRef } from 'react';\n\ninterface KeyPressSettings {\n  isCarouselFocused: boolean;\n  onLeftKeyPressed: () => void;\n  onRightKeyPressed: () => void;\n}\n\nconst ArrowKeysCode = {\n  ArrowLeft: 'ArrowLeft',\n  ArrowRight: 'ArrowRight',\n} as const;\n\nexport const useKeyPress = ({ isCarouselFocused, onLeftKeyPressed, onRightKeyPressed }: KeyPressSettings) => {\n  const isCarouselFocusedRef = useRef(isCarouselFocused);\n\n  useEffect(() => {\n    isCarouselFocusedRef.current = isCarouselFocused;\n  }, [isCarouselFocused]);\n\n  useEffect(() => {\n    const handleKeyDown = (event: KeyboardEvent) => {\n      const { key } = event;\n\n      if (!isCarouselFocusedRef.current) {\n        return;\n      }\n\n      if (key === ArrowKeysCode.ArrowLeft) {\n        onLeftKeyPressed();\n      } else if (key === ArrowKeysCode.ArrowRight) {\n        onRightKeyPressed();\n      }\n    };\n\n    document.addEventListener('keydown', handleKeyDown);\n\n    return () => {\n      document.removeEventListener('keydown', handleKeyDown);\n    };\n  }, [onLeftKeyPressed, onRightKeyPressed]);\n};\n","import { useEffect, useState } from 'react';\n\ninterface SwipeSettings {\n  ref: React.RefObject<HTMLElement>;\n  onSwipeLeft: () => void;\n  onSwipeRight: () => void;\n}\n\nexport const useSwipe = ({ ref, onSwipeLeft, onSwipeRight }: SwipeSettings) => {\n  const [touchStart, setTouchStart] = useState(0);\n  const [touchEnd, setTouchEnd] = useState(0);\n  const minSwipeDistance = 50;\n\n  useEffect(() => {\n    const element = ref.current as HTMLElement;\n\n    const handleTouchStart = (event: TouchEvent) => {\n      setTouchEnd(0);\n      setTouchStart(event.targetTouches[0].clientX);\n    };\n\n    const handleTouchMove = (event: TouchEvent) => {\n      setTouchEnd(event.targetTouches[0].clientX);\n    };\n\n    const handleTouchEnd = () => {\n      if (!touchStart || !touchEnd) return;\n      const distance = touchStart - touchEnd;\n      const isSwipeLeft = distance > minSwipeDistance;\n      const isSwipeRight = distance < -minSwipeDistance;\n      if (isSwipeLeft) {\n        onSwipeLeft();\n      }\n      if (isSwipeRight) {\n        onSwipeRight();\n      }\n    };\n\n    element.addEventListener('touchstart', handleTouchStart);\n    element.addEventListener('touchmove', handleTouchMove);\n    element.addEventListener('touchend', handleTouchEnd);\n\n    return () => {\n      element.removeEventListener('touchstart', handleTouchStart);\n      element.removeEventListener('touchmove', handleTouchMove);\n      element.removeEventListener('touchend', handleTouchEnd);\n    };\n  });\n};\n","import { Icon } from '@eventbrite/valkyrie-eds-icon';\nimport { ArrowLeftChunky, ArrowRightChunky } from '@eventbrite/valkyrie-eds-iconography';\nimport React, { useCallback, useRef, useState } from 'react';\nimport { LISTING_HEAP_IDS } from '../../_shared/constants';\nimport { FetchPriorityType, HeroImage } from '../HeroImage';\nimport { HeroVideo } from '../HeroVideo';\nimport styles from './HeroCarousel.module.scss';\nimport type { CarouselItems } from './index';\nimport { useKeyPress } from './useKeyPress';\nimport { useSwipe } from './useSwipe';\n\ninterface HeroCarousel {\n  eventName: string;\n  items: Array<CarouselItems>;\n  initialSlide?: number;\n  enableAutoSlide?: boolean;\n  featuredVideo?: FeaturedVideoProps | undefined;\n  nativeVideo?: NativeVideoProps;\n}\n\nexport type FeaturedVideoProps = {\n  url?: string;\n  embedUrl: string;\n  thumbnail?: {\n    large?: {\n      url: string;\n    };\n    medium?: {\n      url: string;\n    };\n    small?: {\n      url: string;\n    };\n  };\n  provider?: string;\n};\n\nexport type NativeVideoProps = {\n  url: string;\n  thumbnail: string;\n};\n\nconst TRANSLATION_UNIT_INIT = '0';\n\nconst getSlidesTranslationValue = (slidePosition: number) => {\n  return slidePosition === 0 ? TRANSLATION_UNIT_INIT : `-${slidePosition}00`;\n};\n\nexport const HeroCarousel: React.FC<HeroCarousel> = ({\n  eventName,\n  items,\n  initialSlide = 0,\n  featuredVideo,\n  nativeVideo,\n}) => {\n  const shouldShowCarouselControls = items.length > 1;\n  const firstSlide = 0;\n  const lastSlide = items.length - 1;\n  const [currentSlide, setCurrentSlide] = useState(initialSlide);\n  const [translationUnit, setTranslationUnit] = useState(getSlidesTranslationValue(initialSlide));\n  const [isCarouselFocused, setIsCarouselFocused] = useState(false);\n  const carousel = useRef(null);\n\n  const goToSlide = useCallback((slideNumber: number) => {\n    setCurrentSlide(slideNumber);\n    setTranslationUnit(getSlidesTranslationValue(slideNumber));\n  }, []);\n\n  const nextSlide = useCallback(() => {\n    const nextSlide = currentSlide === lastSlide ? firstSlide : currentSlide + 1;\n    goToSlide(nextSlide);\n  }, [currentSlide, lastSlide, goToSlide]);\n\n  const prevSlide = useCallback(() => {\n    const prevSlide = currentSlide === firstSlide ? lastSlide : currentSlide - 1;\n    goToSlide(prevSlide);\n  }, [currentSlide, lastSlide, goToSlide]);\n\n  const handleOnFocus = () => {\n    if (!isCarouselFocused) {\n      setIsCarouselFocused(true);\n    }\n  };\n  const handleOnBlur = (event: React.FocusEvent<HTMLDivElement>) => {\n    const isCarouselBlurred = !event.currentTarget.contains(event.relatedTarget as Node);\n    if (isCarouselBlurred) {\n      setIsCarouselFocused(false);\n    }\n  };\n\n  useKeyPress({\n    isCarouselFocused,\n    onLeftKeyPressed: () => prevSlide(),\n    onRightKeyPressed: () => nextSlide(),\n  });\n\n  useSwipe({\n    ref: carousel,\n    onSwipeLeft: () => nextSlide(),\n    onSwipeRight: () => prevSlide(),\n  });\n\n  return (\n    <div\n      ref={carousel}\n      tabIndex={shouldShowCarouselControls ? 0 : -1}\n      onFocus={handleOnFocus}\n      onBlur={handleOnBlur}\n      data-testid=\"hero-carousel\"\n      className={styles.carouselWrapper}\n    >\n      {shouldShowCarouselControls && (\n        <>\n          <ul>\n            <li>\n              <button\n                onClick={prevSlide}\n                className={`${styles.controlButton} ${styles.prev}`}\n                data-heap-id={LISTING_HEAP_IDS.LEFT_ARROW_HERO_CAROUSEL}\n              >\n                <Icon type={<ArrowLeftChunky />} />\n                {/* translate */}\n                <span className={styles.accessibleText}>{'Previous slide'}</span>\n              </button>\n            </li>\n            <li>\n              <button\n                onClick={nextSlide}\n                className={`${styles.controlButton} ${styles.next}`}\n                data-heap-id={LISTING_HEAP_IDS.RIGHT_ARROW_HERO_CAROUSEL}\n              >\n                <Icon type={<ArrowRightChunky />} />\n                {/* translate */}\n                <span className={styles.accessibleText}>{'Next slide'}</span>\n              </button>\n            </li>\n          </ul>\n          <div className={styles.sliderBar}>\n            <ul className={styles.sliderBarList}>\n              {items.map((_, index: number) => {\n                const slideNumber = index + 1;\n\n                return (\n                  <li key={index} data-testid=\"slider-bar\">\n                    <button\n                      onClick={() => {\n                        goToSlide(index);\n                      }}\n                      className={`${styles.sliderBarButton} ${index === currentSlide ? styles.active : ''}`}\n                      aria-current={index === currentSlide}\n                    >\n                      {/* translate */}\n                      <span className={styles.accessibleText}>{`Go to slide ${slideNumber}`}</span>\n                    </button>\n                  </li>\n                );\n              })}\n            </ul>\n          </div>\n        </>\n      )}\n      {items.length > 0 ? (\n        <div className={styles.carouselViewport}>\n          <div\n            className={styles.imageList}\n            style={{ transform: `translateX(${translationUnit}%)` }}\n            data-testid=\"slide-list\"\n          >\n            {items.map((item, index: number) => {\n              const shouldShowHeroVideo = index === 0 && (nativeVideo?.url || featuredVideo?.embedUrl);\n\n              return (\n                <div\n                  className={styles.imageListItem}\n                  data-testid=\"slide\"\n                  aria-hidden={!(index === currentSlide)}\n                  key={`slide-${index}`}\n                >\n                  {shouldShowHeroVideo ? (\n                    <HeroVideo featuredVideo={featuredVideo} nativeVideo={nativeVideo} overrideThumbnail={item} />\n                  ) : (\n                    <HeroImage\n                      croppedLogoUrl480={item.croppedLogoUrl480}\n                      croppedLogoUrl600={item.croppedLogoUrl600}\n                      croppedLogoUrl940={item.croppedLogoUrl940}\n                      alt={index === 0 ? eventName : ''}\n                      loading={index !== 0 ? 'lazy' : undefined}\n                      fetchPriority={index === 0 ? FetchPriorityType.high : FetchPriorityType.low}\n                    />\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      ) : (\n        <HeroVideo nativeVideo={nativeVideo} featuredVideo={featuredVideo} />\n      )}\n    </div>\n  );\n};\n","export * from './HeroCarousel';\nexport * from './types';\n","import React, { createContext, useContext, useState, useCallback, useEffect, useRef } from 'react';\nimport type { ToastProps } from '../Toast/types';\n\ninterface ToastContextType {\n  toastProps: ToastProps | null;\n  shouldShowToast: boolean;\n  showToast: (props: ToastProps) => void;\n  hideToast: () => void;\n}\n\nconst ToastContext = createContext<ToastContextType | undefined>(undefined);\n\nexport const ToastProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [toastProps, setToastProps] = useState<ToastProps | null>(null);\n  const [shouldShowToast, setShouldShowToast] = useState(false);\n  const toastTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n\n  const clearToastTimeout = useCallback(() => {\n    if (toastTimeoutRef.current) {\n      clearTimeout(toastTimeoutRef.current);\n      toastTimeoutRef.current = null;\n    }\n  }, []);\n\n  const hideToast = useCallback(() => {\n    clearToastTimeout();\n    setShouldShowToast(false);\n  }, [clearToastTimeout]);\n\n  const showToast = useCallback(\n    (props: ToastProps) => {\n      if (props?.content && props?.type) {\n        clearToastTimeout();\n        setToastProps(props);\n        setShouldShowToast(true);\n\n        toastTimeoutRef.current = setTimeout(() => {\n          setShouldShowToast(false);\n        }, props?.duration ?? 4000);\n      }\n    },\n    [clearToastTimeout],\n  );\n\n  useEffect(() => () => clearToastTimeout(), [clearToastTimeout]);\n\n  return (\n    <ToastContext.Provider\n      value={{\n        toastProps,\n        shouldShowToast,\n        showToast,\n        hideToast,\n      }}\n    >\n      {children}\n    </ToastContext.Provider>\n  );\n};\n\nexport const useToast = () => {\n  const context = useContext(ToastContext);\n  if (!context) throw new Error('useToast must be used within a ToastProvider');\n  return context;\n};\n","import React from 'react';\nimport { useToast } from '../contexts/ToastContext';\nimport styles from './Toast.module.scss';\n\ninterface ToastComponentProps {\n  position: 'heroCarousel' | 'belowConversionBar';\n}\n\nexport const Toast: React.FC<ToastComponentProps> = ({ position }) => {\n  const { toastProps, shouldShowToast } = useToast();\n\n  if (!shouldShowToast || !toastProps) {\n    return null;\n  }\n\n  const toastClassName = [styles.toast, styles[position], styles[toastProps.type]].join(' ');\n\n  return (\n    <div className={toastClassName} role=\"status\">\n      <div className={styles.content}>{toastProps.content}</div>\n    </div>\n  );\n};\n","import React from 'react';\nimport styles from './EventLikedToast.module.scss';\nimport { useUserData } from '@/hooks/useUserData';\nimport { useAppContext } from '@/components/_shared/context/AppContext';\nimport { FormattedMessage } from 'react-intl';\n\nexport const EventLikedToast: React.FC = () => {\n  const { userId } = useUserData();\n  const {\n    data: { serverUrl },\n  } = useAppContext();\n  const likesUrl = userId ? `${serverUrl}/u/${userId}/favorites/events` : null;\n\n  return (\n    <div className={styles.container}>\n      <span className={styles.message}>\n        <FormattedMessage\n          id=\"Event saved\"\n          defaultMessage=\"Event saved\"\n          description=\"Event saved message in toast after user likes an event\"\n        />\n      </span>\n      {likesUrl && (\n        <a className={styles.link} href={likesUrl} target=\"_blank\" rel=\"noopener noreferrer\">\n          <FormattedMessage\n            id=\"Go to likes\"\n            defaultMessage=\"Go to likes\"\n            description=\"Go to likes link in toast after user likes an event\"\n          />\n        </a>\n      )}\n    </div>\n  );\n};\n","import type { ReactNode } from 'react';\n\nexport const ToastType = {\n  SUCCESS: 'success',\n  ERROR: 'error',\n  WARNING: 'warning',\n  INFO: 'info',\n} as const;\n\nexport interface ToastProps {\n  content: ReactNode;\n  type: (typeof ToastType)[keyof typeof ToastType];\n  duration?: number;\n}\n","export { Toast } from './Toast';\nexport { EventLikedToast } from './toastUseCases/EventLikedToast/EventLikedToast';\nexport { ToastType } from './types';\n","import React from 'react';\nimport type { Event, EventHeroScopedProps } from './types';\nimport styles from './EventHero.module.scss';\nimport { HeroCarousel } from './HeroCarousel';\nimport { getImageProps } from 'next/image';\nimport { Toast } from '../_shared/Toast';\nimport { useToast } from '../_shared/contexts/ToastContext';\n\nexport type EventHeroProps = {\n  eventName: Event['name'];\n} & EventHeroScopedProps &\n  Pick<Event, 'hasCroppedLogo'>;\n\nexport const EventHero = ({\n  mainBodyBackground: { croppedLogoUrl50 },\n  items = [],\n  eventName,\n  featuredVideo,\n  nativeVideo,\n}: EventHeroProps) => {\n  const shouldShowEventHero = items.length > 0 || featuredVideo || nativeVideo;\n  const backgroundImage = croppedLogoUrl50 || nativeVideo?.thumbnail || featuredVideo?.thumbnail?.small?.url;\n  const {\n    props: { src },\n  } = getImageProps({\n    alt: '',\n    width: 50,\n    height: 25,\n    src: backgroundImage || '',\n  });\n\n  const { shouldShowToast } = useToast();\n\n  if (!shouldShowEventHero) {\n    return null;\n  }\n\n  return (\n    <div className={styles.root} data-testid=\"event-hero\">\n      <div className={styles.hero}>\n        <div className={styles.background} style={{ backgroundImage: `url(\"${src}\")` }}></div>\n        <HeroCarousel eventName={eventName} items={items} featuredVideo={featuredVideo} nativeVideo={nativeVideo} />\n        {shouldShowToast && <Toast position=\"heroCarousel\" />}\n      </div>\n    </div>\n  );\n};\n","export * from './EventHero';\n","import { FormattedMessage, useIntl } from 'react-intl';\nimport { preparePlaceholders } from '../../utils/localizedTagsUtils';\n\nexport interface LocalizedTextProps {\n  /**\n   * The localized text, or the translation token\n   */\n  text: string;\n  /**\n   * If true, the text is localized, otherwise it's a translation token\n   */\n  isLocalized: boolean;\n  /**\n   * A map of placeholder keys to their values. These placeholders can be used in the translation token for dynamic content.\n   */\n  placeholders?: {\n    [k: string]: string;\n  };\n}\n\n/**\n * LocalizedText is a React component that renders either a localized string using react-intl's FormattedMessage,\n * or a plain text string, depending on the `isLocalized` prop.\n *\n * It is used to render the text of the event tags in the event details page.\n *\n * - If `isLocalized` is true, it treats `text` as a translation key and uses `FormattedMessage` to render the localized string.\n *   - If `placeholders` are provided, they are passed as values to the translation.\n *   - Special handling is applied for `category_string` and `format_string` placeholders: if present and non-empty,\n *     their values are also localized using `formatMessage` before being passed to FormattedMessage.\n * - If `isLocalized` is false, it renders the `text` prop as plain text inside a <span>.\n *\n * @component\n * @param {Object} props\n * @param {LocalizedTextProps} props.text - The text configuration object, including the translation key, localization flag, and optional placeholders.\n * @returns {JSX.Element} The rendered localized or plain text.\n */\n\nexport const LocalizedText: React.FC<{ text: LocalizedTextProps }> = ({ text }) => {\n  const intl = useIntl();\n\n  if (text.isLocalized) {\n    const placeHolders = preparePlaceholders(text.placeholders, intl);\n    return <FormattedMessage id={text.text} values={placeHolders} />;\n  }\n  return <span>{text.text}</span>;\n};\n","import { Tag } from '@/types';\nimport { LocalizedText } from '../LocalizedText/LocalizedText';\nimport styles from './EventTag.module.scss';\n\nexport interface EventTagProps {\n  tag: Tag;\n}\n\nexport const EventTag = ({ tag }: EventTagProps) => {\n  return (\n    <li className={styles.tag}>\n      <a href={tag.link}>\n        <LocalizedText text={tag.text} />\n      </a>\n    </li>\n  );\n};\n","import { useIntl } from 'react-intl';\nimport { Tag, Tags } from '@/types';\nimport { EventTag } from './components/EventTag/EventTag';\nimport styles from './EventTags.module.scss';\n\nexport interface EventTagsProps {\n  tags?: Tags;\n}\n\nexport const EventTags = ({ tags }: EventTagsProps) => {\n  const { formatMessage } = useIntl();\n\n  if (!tags || tags.length === 0) {\n    return null;\n  }\n\n  const validTags = tags.filter((tag: Tag) => !!tag?.link);\n\n  if (validTags.length === 0) {\n    return null;\n  }\n\n  return (\n    <div className={styles.wrapper} data-testid=\"event-tags\">\n      <div className={styles.title}>{formatMessage({ id: 'Related' })}</div>\n      <ul className={styles.tagsContainer}>\n        {validTags.map((tag: Tag, index) => (\n          <EventTag key={index} tag={tag} />\n        ))}\n      </ul>\n    </div>\n  );\n};\n","export { EventTags } from './EventTags';\n","import React from 'react';\nimport { useIntl } from 'react-intl';\nimport classNames from 'classnames';\nimport styles from './OrganizerStats.module.scss';\nimport type { OrganizerWithFollowStatus } from '@/components/OrganizerCard/types';\n\nconst Stat = ({ label, data, divider }: { label: string; data: string | number; divider: boolean }) => {\n  const statUnitClasses = classNames(styles.stat, { [styles.statWithDivider]: divider });\n\n  return (\n    <div className={statUnitClasses}>\n      <span className={styles.label}>{label}</span>\n      <span className={styles.data}>{data}</span>\n    </div>\n  );\n};\n\ninterface OrganizerStatsProps {\n  organizer: OrganizerWithFollowStatus;\n}\n\nexport const OrganizerStats: React.FC<OrganizerStatsProps> = ({ organizer }) => {\n  const { formatMessage } = useIntl();\n\n  const NO_AVAILABLE_DATA = '--';\n\n  const numberOfFollowers = organizer.followStatus?.numFollowers || NO_AVAILABLE_DATA;\n  const numberOfEvents = organizer.numEvents || NO_AVAILABLE_DATA;\n  const hostingSinceText =\n    organizer.hostingSince !== undefined && organizer.hostingSince > 0\n      ? `${organizer.hostingSince} ${formatMessage({ id: 'years' })}`\n      : NO_AVAILABLE_DATA;\n\n  return (\n    <div className={styles.wrapper} data-testid=\"organizer-stats\">\n      <Stat label={formatMessage({ id: 'Followers' })} data={numberOfFollowers} divider={false} />\n      <Stat label={formatMessage({ id: 'Events' })} data={numberOfEvents} divider={true} />\n      <Stat label={formatMessage({ id: 'Hosting' })} data={hostingSinceText} divider={true} />\n    </div>\n  );\n};\n","export { OrganizerStats } from './OrganizerStats';\n","import React from 'react';\nimport type { OrganizerWithFollowStatus } from '@/components/OrganizerCard/types';\nimport { OrganizerStats } from './OrganizerStats';\nimport styles from './OrganizerData.module.scss';\nimport { OrganizerAvatar } from './OrganizerAvatar/OrganizerAvatar';\nimport { useAppContext } from '@/components/_shared/context/AppContext';\n\ninterface OrganizerDataProps {\n  organizer: OrganizerWithFollowStatus;\n}\n\nexport const OrganizerData: React.FC<OrganizerDataProps> = ({ organizer }) => {\n  const { data: appContextData } = useAppContext();\n  const domainUrl = appContextData.serverUrl;\n\n  return (\n    <div className={styles.wrapper} data-testid=\"organizer-data\">\n      <div className={styles.avatarContainer}>\n        <OrganizerAvatar organizer={organizer} />\n      </div>\n      <div className={styles.contentContainer}>\n        <a\n          href={`${domainUrl}/o/${organizer.id}`}\n          className={styles.organizerName}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n        >\n          {organizer.name}\n        </a>\n        <OrganizerStats organizer={organizer} />\n      </div>\n    </div>\n  );\n};\n","export { OrganizerData } from './OrganizerData';\n","import { Button } from '@eventbrite/marmalade';\nimport styles from './ContactButton.module.scss';\nimport { FormattedMessage } from 'react-intl';\nimport { useAppContext } from '../../context/AppContext';\n\nexport type ContactButtonProps = {\n  organizerId: string;\n  organizerName?: string;\n};\n\nexport const ContactButton = ({ organizerId, organizerName }: ContactButtonProps) => {\n  const { data: appContextData } = useAppContext();\n  const domainUrl = appContextData.serverUrl;\n\n  if (!organizerId) {\n    return null;\n  }\n\n  const handleClick = () => {\n    window.location.href = `${domainUrl}/o/${organizerId}?contact_organizer=true`;\n  };\n\n  return (\n    <Button variant=\"secondary\" className={styles.contactButton} onClick={handleClick} data-testid=\"contact-button\">\n      {organizerName ? <FormattedMessage id=\"Contact\" /> : <FormattedMessage id=\"Contact organizer\" />}\n    </Button>\n  );\n};\n","import styles from './ActionBar.module.scss';\nimport { ContactButton } from '@/components/_shared/buttons/ContactButton/ContactButton';\nimport { FollowButton } from '@/components/_shared/buttons/FollowButton/FollowButton';\nimport type { OrganizerWithFollowStatus } from '@/components/OrganizerCard/types';\n\nexport type ActionBarProps = {\n  organizer: OrganizerWithFollowStatus;\n  pageArea?: string;\n};\n\nexport const ActionBar = ({ organizer, pageArea }: ActionBarProps) => {\n  return (\n    <div className={styles.actionBar}>\n      <ContactButton organizerId={organizer.id} organizerName={organizer.name} />\n      <FollowButton organizer={organizer} pageArea={pageArea} />\n    </div>\n  );\n};\n","export { ActionBar } from './ActionBar';\n","import React from 'react';\nimport { useIntl } from 'react-intl';\nimport { OrganizerData } from './OrganizerData';\nimport styles from './OrganizerCard.module.scss';\nimport type { Organizer } from '@/types';\nimport { ActionBar } from './ActionBar';\nimport { LISTING_HEAP_PAGE_AREA_IDS } from '@/components/_shared/constants';\nimport type { OrganizerWithFollowStatus } from '@/components/OrganizerCard/types';\nimport { OrganizerAvatar } from './OrganizerData/OrganizerAvatar/OrganizerAvatar';\nimport { ContactButton } from '../_shared/buttons/ContactButton/ContactButton';\nimport { DEFAULT_FOLLOW_STATUS_RESPONSE } from '../_shared/buttons/FollowButton/utils';\nimport { useOrganizerFollowStatus } from '../_shared/contexts/FollowOrganizerContext';\n\nexport const OrganizerCard: React.FC<{ organizer: Organizer | null | undefined }> = ({ organizer }) => {\n  const { formatMessage } = useIntl();\n  const { isFollowing, numFollowers, loading } = useOrganizerFollowStatus();\n  if (!organizer || !organizer.id) {\n    return null;\n  }\n\n  if (!organizer.name) {\n    return <UnnamedOrganizerCard organizer={organizer} />;\n  }\n\n  const organizerWithFollowStatus: OrganizerWithFollowStatus = {\n    ...organizer,\n    followStatus: {\n      numFollowers: numFollowers ?? DEFAULT_FOLLOW_STATUS_RESPONSE.numFollowers,\n      followedByYou: isFollowing ?? DEFAULT_FOLLOW_STATUS_RESPONSE.followedByYou,\n    },\n    followStatusLoading: loading,\n  };\n\n  return (\n    <div data-testid=\"organizer-card\" id=\"organizer-card\">\n      <div className={styles.title}>{formatMessage({ id: 'Organized by' })}</div>\n      <div className={styles.content}>\n        <OrganizerData organizer={organizerWithFollowStatus} />\n        <ActionBar organizer={organizerWithFollowStatus} pageArea={LISTING_HEAP_PAGE_AREA_IDS.NEW_ORGANIZER_PANEL} />\n      </div>\n    </div>\n  );\n};\n\nconst UnnamedOrganizerCard: React.FC<{ organizer: Organizer }> = ({ organizer }) => {\n  const { formatMessage } = useIntl();\n\n  return (\n    <div data-testid=\"organizer-card\">\n      <div className={styles.title}>{formatMessage({ id: 'Organized by' })}</div>\n      <div className={styles.unnamedContent}>\n        <div className={styles.avatarContainer}>\n          <OrganizerAvatar organizer={organizer} />\n        </div>\n        <div className={styles.actionBar}>\n          <ContactButton organizerId={organizer.id} />\n        </div>\n      </div>\n    </div>\n  );\n};\n","export { OrganizerCard } from './OrganizerCard';\n","import React from 'react';\nimport { useIntl } from 'react-intl';\nimport { Modal } from '../../../_shared/Modal/Modal';\nimport { useSimpleDragToClose } from '@/hooks';\nimport styles from './AboutThisEventModal.module.scss';\n\nexport type AboutThisEventModalProps = {\n  visible: boolean;\n  onClose: () => void;\n  children: React.ReactNode;\n};\n\nexport const AboutThisEventModal: React.FC<AboutThisEventModalProps> = React.memo(({ visible, onClose, children }) => {\n  const { formatMessage } = useIntl();\n\n  useSimpleDragToClose({\n    onClose,\n  });\n\n  return (\n    <Modal\n      visible={visible}\n      onClose={onClose}\n      __containerClassName={styles.modalContainer}\n      title={formatMessage({ id: 'Overview' })}\n    >\n      <div className={styles.modulesWrapper}>{children}</div>\n    </Modal>\n  );\n});\n\nAboutThisEventModal.displayName = 'AboutThisEventModal';\n","export { AboutThisEventModal, type AboutThisEventModalProps } from './AboutThisEventModal';\n","import React from 'react';\nimport styles from './AboutThisEventEmbedded.module.scss';\nimport classNames from 'classnames';\n\nexport type AboutThisEventEmbeddedProps = {\n  visible?: boolean;\n  children: React.ReactNode;\n};\n\nexport const AboutThisEventEmbedded: React.FC<AboutThisEventEmbeddedProps> = React.memo(({ visible, children }) => {\n  const containerClassName = classNames(styles.container, {\n    [styles.hidden]: !visible,\n  });\n\n  return <div className={containerClassName}>{children}</div>;\n});\n\nAboutThisEventEmbedded.displayName = 'AboutThisEventEmbedded';\n","export { AboutThisEventEmbedded } from './AboutThisEventEmbedded';\n","export const transformYouTubeWatchUrl = (videoUrl: string): string | null => {\n  if (!videoUrl.includes('youtube.com/watch')) return null;\n\n  const videoId = videoUrl.split('v=')[1]?.split('&')[0];\n  return videoId ? `https://www.youtube.com/embed/${videoId}` : null;\n};\n\nexport const transformYouTubeShortUrl = (videoUrl: string): string | null => {\n  if (!videoUrl.includes('youtu.be/')) return null;\n\n  const videoId = videoUrl.split('youtu.be/')[1]?.split('?')[0];\n  return videoId ? `https://www.youtube.com/embed/${videoId}` : null;\n};\n\nexport const transformYouTubeShortsUrl = (videoUrl: string): string | null => {\n  if (!videoUrl.includes('youtube.com/shorts/')) return null;\n\n  const videoId = videoUrl.split('/shorts/')[1]?.split('?')[0]?.split('/')[0];\n  return videoId ? `https://www.youtube.com/embed/${videoId}` : null;\n};\n\nexport const transformYouTubeLiveUrl = (videoUrl: string): string | null => {\n  if (!videoUrl.includes('youtube.com/live/')) return null;\n\n  const videoId = videoUrl.split('/live/')[1]?.split('?')[0]?.split('/')[0];\n  return videoId ? `https://www.youtube.com/embed/${videoId}` : null;\n};\n\nexport const isYouTubeEmbedUrl = (videoUrl: string): boolean => {\n  return videoUrl.includes('youtube.com/embed/');\n};\n\nexport const transformVimeoUrl = (videoUrl: string): string | null => {\n  if (!videoUrl.includes('vimeo.com/') || videoUrl.includes('/player.js') || videoUrl.includes('/embed/')) {\n    return null;\n  }\n\n  const videoId = videoUrl.split('vimeo.com/')[1]?.split('?')[0];\n  return videoId && !isNaN(Number(videoId)) ? `https://player.vimeo.com/video/${videoId}` : null;\n};\n\nconst YOUTUBE_TRANSFORMS = [\n  transformYouTubeWatchUrl,\n  transformYouTubeShortUrl,\n  transformYouTubeShortsUrl,\n  transformYouTubeLiveUrl,\n];\n\nexport const getEmbedUrl = (videoUrl: string): string => {\n  if (isYouTubeEmbedUrl(videoUrl)) return videoUrl;\n\n  for (const transform of YOUTUBE_TRANSFORMS) {\n    const result = transform(videoUrl);\n    if (result) return result;\n  }\n\n  const vimeo = transformVimeoUrl(videoUrl);\n  if (vimeo) return vimeo;\n\n  return videoUrl;\n};\n","import React, { useState, useCallback } from 'react';\nimport Image from 'next/image';\nimport { useComponentVisibility } from '../../../../../hooks/useComponentVisibility';\nimport { LoadingSkeleton } from '@eventbrite/legacy-infra.loading-skeleton';\n\nexport interface LazyImageProps {\n  src: string;\n  alt: string;\n  width?: number;\n  height?: number;\n  fill?: boolean;\n  className?: string;\n  style?: React.CSSProperties;\n  objectFit?: 'contain' | 'cover' | 'fill' | 'none' | 'scale-down';\n  objectPosition?: string;\n  placeholder?: 'blur' | 'empty';\n  priority?: boolean;\n}\n\nexport const LazyImage: React.FC<LazyImageProps> = ({\n  src,\n  alt,\n  width,\n  height,\n  fill = false,\n  className,\n  style,\n  objectFit = 'contain',\n  objectPosition,\n  placeholder = 'empty',\n  priority = false,\n}) => {\n  const [shouldLoad, setShouldLoad] = useState(priority);\n\n  const handleVisible = useCallback(() => {\n    setShouldLoad(true);\n  }, []);\n\n  const ref = useComponentVisibility(handleVisible, {\n    threshold: 0.1,\n    rootMargin: '50px',\n  });\n\n  const shouldLoadImage = priority || shouldLoad;\n\n  return (\n    <div ref={ref} className={className} style={style}>\n      {shouldLoadImage ? (\n        fill ? (\n          <Image\n            key={`lazy-fill-${src}`}\n            src={src}\n            alt={alt}\n            fill\n            loading={priority ? 'eager' : 'lazy'}\n            style={{ objectFit, objectPosition }}\n            placeholder={placeholder}\n          />\n        ) : (\n          <Image\n            key={`lazy-sized-${src}-${width}x${height}`}\n            src={src}\n            alt={alt}\n            width={width}\n            height={height}\n            loading={priority ? 'eager' : 'lazy'}\n            style={{ maxWidth: '100%', height: 'auto', display: 'block' }}\n            placeholder={placeholder}\n          />\n        )\n      ) : (\n        <LoadingSkeleton height={fill ? 400 : height || 200} />\n      )}\n    </div>\n  );\n};\n","import React, { useState, useCallback } from 'react';\nimport { useIntl } from 'react-intl';\nimport { useComponentVisibility } from '../../../../../hooks/useComponentVisibility';\nimport { LoadingSkeleton } from '@eventbrite/legacy-infra.loading-skeleton';\nimport { getEmbedUrl } from '../utils/videoUtils';\nimport styles from './LazyVideo.module.scss';\n\nexport interface LazyVideoProps {\n  src: string;\n  altText?: string;\n  className?: string;\n  style?: React.CSSProperties;\n  priority?: boolean;\n}\n\nexport const LazyVideo: React.FC<LazyVideoProps> = ({ src, altText, className, style, priority = false }) => {\n  const { formatMessage } = useIntl();\n  const [shouldLoad, setShouldLoad] = useState(priority);\n\n  const handleVisible = useCallback(() => {\n    setShouldLoad(true);\n  }, []);\n\n  const ref = useComponentVisibility(handleVisible, {\n    threshold: 0.1,\n    rootMargin: '50px',\n  });\n\n  const shouldLoadVideo = priority || shouldLoad;\n  const embedUrl = getEmbedUrl(src);\n\n  return (\n    <div ref={ref} className={className} style={style}>\n      {shouldLoadVideo ? (\n        <div className={styles.videoContainer}>\n          <iframe\n            src={embedUrl}\n            allowFullScreen\n            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n            title={formatMessage({ id: 'Video content' })}\n            style={{ border: 'none' }}\n          >\n            {altText}\n          </iframe>\n        </div>\n      ) : (\n        <LoadingSkeleton height={315} />\n      )}\n    </div>\n  );\n};\n","export enum LoadingStrategy {\n  EAGER = 'eager',\n  LAZY = 'lazy',\n}\n\nexport type LoadingStrategyType = `${LoadingStrategy}`;\n","export { LoadingStrategy, type LoadingStrategyType } from './LoadingStrategy';\n","import React from 'react';\nimport { useIntl } from 'react-intl';\nimport Image from 'next/image';\nimport styles from './StructuredModuleRenderer.module.scss';\nimport type { WebappStructuredContentModule } from '@eventbrite/event-listing-service-client';\nimport classNames from 'classnames';\nimport { getEmbedUrl } from './utils/videoUtils';\nimport { LazyImage } from './components/LazyImage';\nimport { LazyVideo } from './components/LazyVideo';\nimport { LoadingStrategy, type LoadingStrategyType } from './types';\n\n// Extract the literal types directly from WebappStructuredContentModule\ntype ModuleType = WebappStructuredContentModule['type']; // \"text\" | \"image\" | \"video\"\n\n// Create constants using the extracted types\nexport const MODULE_TYPES: Record<Uppercase<ModuleType>, ModuleType> = {\n  TEXT: 'text',\n  IMAGE: 'image',\n  VIDEO: 'video',\n} as const;\n\nexport const TEXT_ALIGNMENTS = {\n  LEFT: 'left',\n  CENTER: 'center',\n  RIGHT: 'right',\n} as const;\n\ntype TextContentProps = {\n  text: string;\n  alignment: (typeof TEXT_ALIGNMENTS)[keyof typeof TEXT_ALIGNMENTS];\n};\n\ntype ImageContentProps = {\n  url: string;\n  altText?: string;\n  captionText?: string;\n  width?: number;\n  height?: number;\n  loadingStrategy?: LoadingStrategyType;\n};\n\ntype VideoContentProps = {\n  url: string;\n  altText?: string;\n  loadingStrategy?: LoadingStrategyType;\n};\n\nconst getTextAlignment = (alignment: (typeof TEXT_ALIGNMENTS)[keyof typeof TEXT_ALIGNMENTS]) => {\n  switch (alignment) {\n    case TEXT_ALIGNMENTS.LEFT:\n      return styles.textLeft;\n    case TEXT_ALIGNMENTS.CENTER:\n      return styles.textCenter;\n    case TEXT_ALIGNMENTS.RIGHT:\n      return styles.textRight;\n  }\n};\n\nconst TextContent = ({ text, alignment }: TextContentProps) => (\n  <div\n    className={getTextAlignment(alignment)}\n    // eslint-disable-next-line react/no-danger\n    dangerouslySetInnerHTML={{ __html: text }}\n  />\n);\n\nconst VideoContent = ({ url, altText, loadingStrategy = LoadingStrategy.LAZY }: VideoContentProps) => {\n  const { formatMessage } = useIntl();\n  const shouldUseLazyLoading = loadingStrategy === LoadingStrategy.LAZY;\n\n  return (\n    <div className={styles.video}>\n      {shouldUseLazyLoading ? (\n        <LazyVideo src={url} altText={altText} />\n      ) : (\n        <iframe\n          src={getEmbedUrl(url)}\n          allowFullScreen\n          allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n          title={formatMessage({ id: 'Video content' })}\n          style={{ border: 'none' }}\n        >\n          {altText}\n        </iframe>\n      )}\n    </div>\n  );\n};\n\nconst ImageContent = ({\n  url,\n  altText,\n  captionText,\n  width = 0,\n  height = 0,\n  loadingStrategy = LoadingStrategy.LAZY,\n}: ImageContentProps) => {\n  const shouldUseLazyLoading = loadingStrategy === LoadingStrategy.LAZY;\n\n  return (\n    <div className={styles.imageContent}>\n      {shouldUseLazyLoading ? (\n        width > 0 && height > 0 ? (\n          <LazyImage\n            src={url}\n            alt={altText || ''}\n            width={width}\n            height={height}\n            style={{ maxWidth: '100%', height: 'auto', display: 'block' }}\n          />\n        ) : (\n          <LazyImage\n            src={url}\n            alt={altText || ''}\n            fill\n            style={{ position: 'relative', height: 'auto', width: '100%' }}\n            objectFit=\"contain\"\n          />\n        )\n      ) : width > 0 && height > 0 ? (\n        <Image\n          key={`eager-sized-${url}-${width}x${height}`}\n          src={url}\n          alt={altText || ''}\n          width={width}\n          height={height}\n          loading=\"eager\"\n          priority={true}\n          sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\"\n          style={{ maxWidth: '100%', height: 'auto', display: 'block' }}\n        />\n      ) : (\n        <div>\n          <Image\n            key={`eager-fill-${url}`}\n            src={url}\n            alt={altText || ''}\n            fill\n            loading=\"eager\"\n            priority={true}\n            sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\"\n            style={{ objectFit: 'contain' }}\n          />\n        </div>\n      )}\n      {captionText && <span className={styles.caption}>{captionText}</span>}\n    </div>\n  );\n};\n\nexport type StructuredModuleRendererProps = {\n  module: WebappStructuredContentModule;\n  isModal?: boolean;\n};\n\nexport const StructuredModuleRenderer = ({ module, isModal = false }: StructuredModuleRendererProps) => {\n  const className = classNames(styles.structuredContent, styles[module.type]);\n  const loadingStrategy = isModal ? LoadingStrategy.EAGER : LoadingStrategy.LAZY;\n\n  switch (module.type) {\n    case MODULE_TYPES.TEXT:\n      const textContent = module as TextContentProps;\n      return (\n        <div className={className} data-testid=\"text-content\">\n          <TextContent text={textContent.text} alignment={textContent.alignment} />\n        </div>\n      );\n\n    case MODULE_TYPES.IMAGE:\n      const imageContent = module as ImageContentProps;\n      return (\n        <div className={className} data-testid=\"image-content\">\n          <ImageContent\n            url={imageContent.url}\n            altText={imageContent.altText}\n            captionText={imageContent.captionText}\n            width={imageContent.width}\n            height={imageContent.height}\n            loadingStrategy={loadingStrategy}\n          />\n        </div>\n      );\n    case MODULE_TYPES.VIDEO:\n      const videoContent = module as VideoContentProps;\n      return (\n        <div className={className} data-testid=\"video-content\">\n          <VideoContent url={videoContent.url} altText={videoContent.altText} loadingStrategy={loadingStrategy} />\n        </div>\n      );\n    default:\n      return <></>;\n  }\n};\n","export { StructuredModuleRenderer } from './StructuredModuleRenderer';\n","import React, { useMemo, useCallback } from 'react';\n\nimport { AboutThisEventModal } from './AboutThisEventModal';\nimport type { StructuredContent } from '@/types';\nimport { AboutThisEventEmbedded } from './AboutThisEventEmbedded';\nimport { StructuredModuleRenderer } from './StructuredModuleRenderer';\nimport { MEDIA_QUERIES } from '@/components/_shared/constants';\nimport { useMediaQuery } from '@/hooks';\n\nexport type AboutThisEventProps = {\n  showFullEventOverview: boolean;\n  structuredContent?: StructuredContent;\n  handleCloseModal: () => void;\n};\n\nexport const AboutThisEvent: React.FC<AboutThisEventProps> = React.memo(\n  ({ showFullEventOverview, structuredContent, handleCloseModal }) => {\n    const isNarrowScreen = useMediaQuery(`(max-width: ${MEDIA_QUERIES.MEDIUM_BREAKPOINT}px)`);\n\n    const memoizedStructuredContent = useMemo(() => structuredContent, [structuredContent]);\n\n    const renderModules = useCallback(\n      (isModal: boolean, keyPrefix: string) =>\n        memoizedStructuredContent?.modules?.map((module, index) => (\n          <StructuredModuleRenderer key={`${keyPrefix}-${index}`} module={module} isModal={isModal} />\n        )) ?? null,\n      [memoizedStructuredContent?.modules],\n    );\n\n    const modalChildren = useMemo(() => renderModules(true, 'modal'), [renderModules]);\n\n    const embeddedChildren = useMemo(() => renderModules(false, 'embedded'), [renderModules]);\n\n    const aboutThisEventModal =\n      isNarrowScreen && showFullEventOverview ? (\n        <AboutThisEventModal visible={showFullEventOverview} onClose={handleCloseModal}>\n          {modalChildren}\n        </AboutThisEventModal>\n      ) : null;\n\n    return (\n      <>\n        {aboutThisEventModal}\n        <AboutThisEventEmbedded visible={showFullEventOverview}>{embeddedChildren}</AboutThisEventEmbedded>\n      </>\n    );\n  },\n);\n\nAboutThisEvent.displayName = 'AboutThisEvent';\n","export * from './AboutThisEvent';\nexport * from './AboutThisEventModal';\n","import React, { useMemo, useState, useCallback, useRef, useEffect } from 'react';\nimport { useIntl } from 'react-intl';\nimport { AboutThisEvent } from './AboutThisEvent';\nimport type { StructuredContent } from '@/types';\n\nimport { MODULE_TYPES, TEXT_ALIGNMENTS } from './AboutThisEvent/StructuredModuleRenderer/StructuredModuleRenderer';\nimport styles from './Overview.module.scss';\nimport { LISTING_HEAP_IDS, READ_MORE_MESSAGE } from '@/components/_shared/constants';\nimport classNames from 'classnames';\n\n// Threshold for determining if content is \"long\" enough to show \"Read more\" button\nexport const LONG_CONTENT_THRESHOLD = 280;\n\nexport const getVisibleText = (html: string): string => {\n  return html\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n};\n\nconst isValidTextModule = (module: unknown): module is { type: string; text: string } => {\n  if (module === null || typeof module !== 'object') {\n    return false;\n  }\n\n  const moduleObj = module as Record<string, unknown>;\n\n  const hasRequiredProperties = 'type' in moduleObj && 'text' in moduleObj;\n  if (!hasRequiredProperties) {\n    return false;\n  }\n\n  const isTextType = moduleObj.type === MODULE_TYPES.TEXT;\n  const hasValidText = typeof moduleObj.text === 'string' && moduleObj.text.length > 0;\n\n  return isTextType && hasValidText;\n};\n\nconst findFirstTextModule = (modules: unknown[]) => {\n  return modules.find(isValidTextModule);\n};\n\nexport type OverviewProps = {\n  summary?: string;\n  structuredContent?: StructuredContent;\n};\n\nexport const Overview: React.FC<OverviewProps> = React.memo(({ summary, structuredContent }) => {\n  const { formatMessage } = useIntl();\n  const summaryRef = useRef<HTMLDivElement>(null);\n\n  const [showFullEventOverview, setShowFullEventOverview] = useState(false);\n  const [hasContentOverflow, setHasContentOverflow] = useState(false);\n\n  const handleShowFullEventOverview = useCallback(() => {\n    setShowFullEventOverview(true);\n  }, []);\n\n  const handleHideFullEventOverview = useCallback(() => {\n    setShowFullEventOverview(false);\n  }, []);\n\n  // Helper function to safely truncate HTML content\n  const sanitizeHtmlForTruncation = (htmlContent: string): string => {\n    if (!htmlContent) return '';\n\n    // Remove any incomplete tags at the end (tags that start with < but don't end with >)\n    let sanitized = htmlContent.replace(/<[^>]*$/g, '');\n\n    // Also remove any incomplete closing tags\n    sanitized = sanitized.replace(/<\\/[^>]*$/g, '');\n\n    // Remove any attributes that might be cut off (ending with incomplete quotes)\n    sanitized = sanitized.replace(/\\s+[a-zA-Z-]+=(\"[^\"]*|'[^']*)$/g, '');\n\n    return sanitized;\n  };\n\n  const sanitizedSummary = useMemo(() => {\n    return sanitizeHtmlForTruncation(summary || '');\n  }, [summary]);\n\n  useEffect(() => {\n    if (showFullEventOverview) return;\n\n    const el = summaryRef.current;\n    if (!el) return;\n\n    const checkOverflow = () => {\n      setHasContentOverflow(el.scrollHeight > el.clientHeight);\n    };\n\n    checkOverflow();\n\n    if (typeof ResizeObserver !== 'undefined') {\n      const resizeObserver = new ResizeObserver(checkOverflow);\n      resizeObserver.observe(el);\n      return () => resizeObserver.disconnect();\n    }\n\n    return undefined;\n  }, [sanitizedSummary, structuredContent, showFullEventOverview]);\n\n  const hasMoreContentToShow = useMemo(() => {\n    const originalModules = structuredContent?.modules || [];\n    const hasSummary = Boolean(sanitizedSummary);\n    const firstModule = originalModules[0];\n\n    const hasLongSummary = hasSummary && getVisibleText(sanitizedSummary).length > LONG_CONTENT_THRESHOLD;\n\n    const hasLongTextModule = originalModules.some(\n      (module) => isValidTextModule(module) && getVisibleText(module.text).length > LONG_CONTENT_THRESHOLD,\n    );\n\n    const hasMultipleModules = originalModules.length > 1;\n\n    const isFirstModuleMedia =\n      firstModule && (firstModule.type === MODULE_TYPES.IMAGE || firstModule.type === MODULE_TYPES.VIDEO);\n\n    const hasHiddenModules = hasSummary && isFirstModuleMedia && originalModules.length > 0;\n\n    return hasLongSummary || hasLongTextModule || hasMultipleModules || hasHiddenModules || hasContentOverflow;\n  }, [sanitizedSummary, structuredContent, hasContentOverflow]);\n\n  const structuredContentWithSummary: StructuredContent = useMemo(\n    () => ({\n      ...structuredContent,\n      modules: [\n        {\n          type: MODULE_TYPES.TEXT,\n          text: `<p>${sanitizedSummary}</p>`,\n          alignment: TEXT_ALIGNMENTS.LEFT,\n        },\n        ...(structuredContent?.modules ?? []),\n      ],\n    }),\n    [structuredContent, sanitizedSummary],\n  );\n\n  const readMoreButton = useMemo(() => {\n    return hasMoreContentToShow && !showFullEventOverview ? (\n      <button\n        className={styles.readMore}\n        onClick={handleShowFullEventOverview}\n        type=\"button\"\n        data-heap-id={LISTING_HEAP_IDS.ABOUT_THIS_EVENT_READ_MORE}\n        aria-label={formatMessage({ id: 'Read more about this event' })}\n      >\n        {formatMessage(READ_MORE_MESSAGE)}\n      </button>\n    ) : null;\n  }, [handleShowFullEventOverview, formatMessage, hasMoreContentToShow, showFullEventOverview]);\n\n  const readLessButton = useMemo(() => {\n    return hasMoreContentToShow && showFullEventOverview ? (\n      <div className={styles.readMoreWrapper}>\n        <button\n          className={styles.readMore}\n          onClick={handleHideFullEventOverview}\n          type=\"button\"\n          data-heap-id={LISTING_HEAP_IDS.ABOUT_THIS_EVENT_READ_LESS}\n          aria-label={formatMessage({ id: 'Read less about this event' })}\n        >\n          {formatMessage({ id: 'Read less' })}\n        </button>\n      </div>\n    ) : null;\n  }, [handleHideFullEventOverview, formatMessage, hasMoreContentToShow, showFullEventOverview]);\n\n  const displaySummary = useMemo(() => {\n    const hasSummary = Boolean(sanitizedSummary);\n    const originalModules = structuredContent?.modules || [];\n    const firstModule = originalModules[0];\n\n    if (hasSummary) {\n      if (isValidTextModule(firstModule)) {\n        return (\n          <>\n            <p dangerouslySetInnerHTML={{ __html: sanitizedSummary }} />\n            <div dangerouslySetInnerHTML={{ __html: firstModule.text }} />\n          </>\n        );\n      }\n      return <p dangerouslySetInnerHTML={{ __html: sanitizedSummary }} />;\n    } else {\n      if (isValidTextModule(firstModule)) {\n        return <div dangerouslySetInnerHTML={{ __html: firstModule.text }} />;\n      } else {\n        const firstTextModule = findFirstTextModule(originalModules);\n\n        if (!firstTextModule?.text) {\n          return null;\n        }\n\n        return <div dangerouslySetInnerHTML={{ __html: firstTextModule.text }} />;\n      }\n    }\n  }, [sanitizedSummary, structuredContent]);\n\n  if (!displaySummary) {\n    return null;\n  }\n\n  const summaryClasses = classNames(styles.summary, {\n    [styles.hidden]: showFullEventOverview,\n  });\n\n  const fadeOutEffect = hasMoreContentToShow && !showFullEventOverview ? <div className={styles.fadeOut}></div> : null;\n\n  return (\n    <>\n      <div className={styles.title}>{formatMessage({ id: 'Overview' })}</div>\n\n      <div className={styles.summaryWrapper}>\n        <div ref={summaryRef} className={summaryClasses}>\n          {displaySummary}\n        </div>\n        {fadeOutEffect}\n      </div>\n      {readMoreButton}\n\n      <AboutThisEvent\n        showFullEventOverview={showFullEventOverview}\n        handleCloseModal={handleHideFullEventOverview}\n        structuredContent={structuredContentWithSummary}\n      />\n      {readLessButton}\n    </>\n  );\n});\n\nOverview.displayName = 'Overview';\n","export { Overview } from './Overview';\n","/* eslint-disable @typescript-eslint/no-explicit-any */\nimport { useState, useEffect } from 'react';\n\nexport interface EventCardComponents {\n  VerticalEventCard: React.ComponentType<any>;\n  EventCardPrice: React.ComponentType<any>;\n  EventCardLocation: React.ComponentType<any>;\n  EventCardDate: React.ComponentType<any>;\n  EventCardTitle: React.ComponentType<any>;\n  EventCardImage: React.ComponentType<any>;\n  EventCardPromoted: React.ComponentType<any>;\n  EventCardTracking: React.ComponentType<any>;\n}\n\nexport const useEventCardComponents = (): EventCardComponents | null => {\n  const [components, setComponents] = useState<EventCardComponents | null>(null);\n\n  useEffect(() => {\n    const loadComponents = async () => {\n      try {\n        const eventRendererModule = await import('@eventbrite/consumer-search.event-renderer');\n\n        setComponents({\n          VerticalEventCard: eventRendererModule.VerticalEventCard,\n          EventCardPrice: eventRendererModule.EventCardPrice,\n          EventCardLocation: eventRendererModule.EventCardLocation,\n          EventCardDate: eventRendererModule.EventCardDate,\n          EventCardTitle: eventRendererModule.EventCardTitle,\n          EventCardImage: eventRendererModule.EventCardImage,\n          EventCardPromoted: eventRendererModule.EventCardPromoted,\n          EventCardTracking: eventRendererModule.EventCardTracking,\n        });\n      } catch (error) {\n        console.error('Could not load components from consumer-search.event-renderer:', error);\n      }\n    };\n\n    loadComponents();\n  }, []);\n\n  return components;\n};\n","import { useMemo } from 'react';\nimport { useIntl } from 'react-intl';\nimport { useFormattedLocationString } from '@eventbrite/consumer-search.event-renderer';\n\nimport { SignalBadgeStatus } from '@/components/_shared/SignalBadge';\nimport { getDisplayTimezone } from '@/utils/dateTime';\nimport { useAttendeeTimezone } from '@/hooks/useAttendeeTimezone';\nimport type { RelatedEvent, UrgencySignals, Venue } from '../../types';\n\n// Type assertion helper for external library compatibility\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\ntype ExternalVenue = any;\n\nexport interface FormattedEventData {\n  id?: string;\n  isFree: boolean;\n  imageUrl: string;\n  isOnlineEvent: boolean;\n  isPromoted: boolean;\n  locationString: string;\n  formattedPriceString: string;\n  name?: string;\n  urgencySignals: UrgencySignals;\n  url: string;\n  venue: Venue | undefined;\n  formattedEventDateTimeString: string;\n  urgencySignalStatus: SignalBadgeStatus | null;\n  priceString?: string;\n}\n\n// Helper functions to reduce complexity\nconst formatOnlineEventLocation = (\n  formatMessage: (descriptor: { id: string; defaultMessage?: string; description?: string }) => string,\n): string => {\n  return formatMessage({\n    id: 'Online event',\n    defaultMessage: 'Online event',\n    description: 'Label for online event location',\n  });\n};\n\nconst formatInPersonEventLocation = (locationStringFromHook: string): string => {\n  return locationStringFromHook;\n};\n\nconst formatDateTimeString = (\n  startDate: string | undefined,\n  startTime: string | undefined,\n  timezone: string,\n  locale: string,\n  isOnlineEvent: boolean,\n  attendeeTimezone?: string,\n): string => {\n  if (!startDate) return '';\n\n  // Construct UTC date string from startDate and startTime\n  const timeString = startTime ?? '00:00:00';\n  const utcDateString = `${startDate}T${timeString}Z`;\n  const dateObj = new Date(utcDateString);\n\n  const targetTimezone = getDisplayTimezone({\n    isOnlineEvent,\n    eventTimezone: timezone,\n    attendeeTimezone,\n  });\n\n  // Create formatters for each part to build the desired format: \"Wed, 3 September • 11:30\"\n  const weekdayFormatter = new Intl.DateTimeFormat(locale, {\n    weekday: 'short',\n    timeZone: targetTimezone,\n  });\n\n  const dayFormatter = new Intl.DateTimeFormat(locale, {\n    day: 'numeric',\n    timeZone: targetTimezone,\n  });\n\n  const monthFormatter = new Intl.DateTimeFormat(locale, {\n    month: 'long',\n    timeZone: targetTimezone,\n  });\n\n  const timeFormatter = new Intl.DateTimeFormat(locale, {\n    hour: 'numeric',\n    minute: '2-digit',\n    hour12: false,\n    timeZone: targetTimezone,\n  });\n\n  const timezoneFormatter = new Intl.DateTimeFormat(locale, {\n    timeZoneName: 'short',\n    timeZone: targetTimezone,\n  });\n\n  // Get each part\n  const weekday = weekdayFormatter.format(dateObj);\n  const day = dayFormatter.format(dateObj);\n  const month = monthFormatter.format(dateObj);\n  const time = timeFormatter.format(dateObj);\n\n  // Extract timezone abbreviation (e.g., \"CET\", \"PDT\", \"EST\")\n  const timezoneFormatted = timezoneFormatter.format(dateObj);\n  const timezoneRegex = /[A-Z]{2,5}/;\n  const timezoneMatch = timezoneRegex.exec(timezoneFormatted);\n  const timezoneShort = timezoneMatch ? timezoneMatch[0] : '';\n\n  // Construct the desired format: \"Wed, 3 September • 11:30 CET\"\n  const timezoneDisplay = timezoneShort ? ` ${timezoneShort}` : '';\n  return `${weekday}, ${day} ${month} • ${time}${timezoneDisplay}`;\n};\n\nconst getUrgencySignalStatus = (urgencySignals: UrgencySignals | undefined): SignalBadgeStatus | null => {\n  if (!urgencySignals) return null;\n\n  const trueUrgencySignals = Object.keys(urgencySignals).filter(\n    (key) => urgencySignals[key as keyof UrgencySignals] === true,\n  );\n\n  return trueUrgencySignals.length > 0 ? (trueUrgencySignals[0] as SignalBadgeStatus) : null;\n};\n\nconst formatPriceString = (\n  isFree: boolean,\n  formattedPriceString: string | undefined,\n  formatMessage: (descriptor: { id: string }) => string,\n): string | undefined => {\n  if (!isFree && formattedPriceString) {\n    return `${formatMessage({ id: 'Starts at' })} ${formattedPriceString}`;\n  }\n  return undefined;\n};\n\nconst buildFormattedEventData = (\n  relatedEvent: RelatedEvent,\n  locationString: string,\n  formattedEventDateTimeString: string,\n  urgencySignalStatus: SignalBadgeStatus | null,\n  priceString: string | undefined,\n): FormattedEventData => ({\n  id: relatedEvent.id,\n  isFree: relatedEvent.isFree ?? false,\n  imageUrl: relatedEvent.imageUrl ?? '',\n  isOnlineEvent: relatedEvent.isOnlineEvent ?? false,\n  isPromoted: relatedEvent.isPromoted ?? false,\n  locationString,\n  formattedPriceString: relatedEvent.formattedPriceString ?? '',\n  name: relatedEvent.name,\n  urgencySignals: relatedEvent.urgencySignals ?? {},\n  url: relatedEvent.url ?? '#',\n  venue: relatedEvent.venue,\n  formattedEventDateTimeString,\n  urgencySignalStatus,\n  priceString,\n});\n\nexport const useFormattedEventData = (relatedEvent: RelatedEvent | null): FormattedEventData | null => {\n  const { formatMessage } = useIntl();\n  const attendeeTimezone = useAttendeeTimezone(relatedEvent?.isOnlineEvent ?? false);\n\n  // External hooks - must be called unconditionally\n  const locationStringFromHook = useFormattedLocationString({\n    venue: relatedEvent?.venue as ExternalVenue,\n    style: 'full',\n  });\n\n  // Main formatted data\n  const formattedData = useMemo((): FormattedEventData | null => {\n    if (!relatedEvent) {\n      return null;\n    }\n\n    const locationString = relatedEvent.isOnlineEvent\n      ? formatOnlineEventLocation(formatMessage)\n      : formatInPersonEventLocation(locationStringFromHook);\n\n    const formattedEventDateTimeString = formatDateTimeString(\n      relatedEvent.startDate,\n      relatedEvent.startTime,\n      relatedEvent.timezone ?? 'UTC',\n      navigator.language,\n      relatedEvent.isOnlineEvent ?? false,\n      attendeeTimezone,\n    );\n\n    const urgencySignalStatus = getUrgencySignalStatus(relatedEvent.urgencySignals);\n\n    const priceString = formatPriceString(\n      relatedEvent.isFree ?? false,\n      relatedEvent.formattedPriceString,\n      formatMessage,\n    );\n\n    return buildFormattedEventData(\n      relatedEvent,\n      locationString,\n      formattedEventDateTimeString,\n      urgencySignalStatus,\n      priceString,\n    );\n  }, [relatedEvent, formatMessage, locationStringFromHook, attendeeTimezone]);\n\n  return formattedData;\n};\n","import { type FormattedEvent } from '@eventbrite/consumer-search.event-renderer';\nimport { type RelatedEvent } from '../components/RelatedEvents';\nimport { type PromotedEvent } from '../components/RelatedEvents/types';\n\n/**\n * Transforms a promoted event to a related event format\n *\n * @param promotedEvent - The promoted event to transform\n * @returns A related event object\n */\nexport function transformPromotedEventToRelatedEvent(promotedEvent: PromotedEvent): RelatedEvent {\n  return {\n    id: promotedEvent.id,\n    name: promotedEvent.name,\n    url: promotedEvent.url,\n    imageUrl: promotedEvent.image?.url,\n    startDate: promotedEvent.start_date ?? undefined,\n    startTime: promotedEvent.start_time ?? undefined,\n    timezone: promotedEvent.timezone ?? undefined,\n    isFree: promotedEvent.ticket_availability?.is_free || false,\n    isOnlineEvent: promotedEvent.is_online_event,\n    isPromoted: true,\n    formattedPriceString: promotedEvent.ticket_availability?.minimum_ticket_price?.display,\n    venue: {\n      id: promotedEvent.primary_venue?.id ?? '',\n      name: promotedEvent.primary_venue?.name ?? '',\n      address: promotedEvent.primary_venue?.address?.address_1 ?? '',\n      city: promotedEvent.primary_venue?.address?.city ?? '',\n      region: promotedEvent.primary_venue?.address?.region ?? '',\n      country: promotedEvent.primary_venue?.address?.country ?? '',\n    },\n    urgencySignals: {\n      new: promotedEvent.urgency_signals?.messages?.includes('new') || false,\n      salesEndSoon: promotedEvent.urgency_signals?.messages?.includes('salesEndSoon') || false,\n      fewTickets: promotedEvent.urgency_signals?.messages?.includes('fewTickets') || false,\n      popular: promotedEvent.urgency_signals?.messages?.includes('popular') || false,\n      goingFast: promotedEvent.urgency_signals?.messages?.includes('goingFast') || false,\n    },\n    specialDiscounts: {\n      hasBogoTickets: promotedEvent.ticket_availability.has_bogo_tickets ?? false,\n    },\n    promotedListingMetadata: {\n      adId: promotedEvent.promoted_listing_metadata?.ad_id ?? '',\n      indexInSearchResults: promotedEvent.promoted_listing_metadata?.index_in_results ?? 0,\n      isPromotedEvent: promotedEvent.promoted_listing_metadata?.is_promoted_event ?? false,\n      placementId: promotedEvent.promoted_listing_metadata?.placement_id ?? '',\n    },\n    savedByYou: promotedEvent.saves?.saved_by_you ?? false,\n    hasOpenDiscount:\n      (promotedEvent.ticket_availability.open_discount &&\n        promotedEvent.ticket_availability.open_discount.quantity_available > 0) ??\n      false,\n  };\n}\n\n/**\n * Transforms an array of promoted events to related events\n *\n * @param promotedEvents - Array of promoted events to transform\n * @returns Array of related events\n */\nexport function transformPromotedEventsToRelatedEvents(\n  promotedEvents: PromotedEvent[] | null | undefined,\n): RelatedEvent[] {\n  if (!promotedEvents || !Array.isArray(promotedEvents)) {\n    return [];\n  }\n\n  return promotedEvents.map(transformPromotedEventToRelatedEvent);\n}\n\n/**\n * Transforms a related event to a tracking event *\n * @param relatedEvent - The related event to transform\n * @returns A tracking event object\n */\nexport function transformRelatedEventToTrackingEvent(relatedEvent: RelatedEvent): FormattedEvent {\n  return {\n    id: relatedEvent.id ?? '',\n    imageUrl: relatedEvent.imageUrl ?? '',\n    isFree: relatedEvent.isFree ?? false,\n    isPromoted: relatedEvent.isPromoted ?? false,\n    promotedListingMetadata: relatedEvent.promotedListingMetadata,\n    isOnlineEvent: relatedEvent.isOnlineEvent ?? false,\n    locationInfo: '', // Deprecated, but defined as required\n    name: relatedEvent.name ?? '',\n    savedByYou: relatedEvent.savedByYou ?? false,\n    startTime: relatedEvent.startTime ?? '