return () => clearTimeout(timeoutId);\n  }, []);\n\n  // useEffect to control the body's overflow to prevent scrolling the page behind the drawer.\n  useEffect(() => {\n    document.body.style.overflow = 'hidden';\n    return () => {\n      document.body.style.overflow = 'auto';\n    };\n  }, []);\n\n  return (\n    <Portal>\n      <div className={`${styles.listingsBackdrop} ${backdropClasses}`} onClick={closeDrawer}></div>\n      <div className={`${styles.drawer} ${drawerClasses}`}>{children({ closeDrawer })}</div>\n    </Portal>\n  );\n};\n","import { Badge } from '@eventbrite/marmalade';\nimport React from 'react';\nimport styles from './SignalBadge.module.scss';\nimport { defineMessage, FormattedMessage, type MessageDescriptor } from 'react-intl';\nimport { SignalCancel, SignalInfo } from '../Icons';\nimport { DisplayStatusContextType, useDisplayStatus } from '../contexts/DisplayStatusContext';\n\nexport type SignalBadgeStatus = 'soldOut' | 'cancelled' | 'postponed' | 'eventEnded';\n\ntype StatusConfig = {\n  className: string;\n  message: MessageDescriptor;\n  icon: JSX.Element;\n};\n\ntype StatusConfigMap = Record<DisplayStatusContextType['displayStatus'], StatusConfig>;\n\nconst STATUS_CONFIG: Partial<StatusConfigMap> = {\n  SOLD_OUT: {\n    className: styles.soldOut,\n    message: defineMessage({\n      id: 'Sold out',\n      defaultMessage: 'Sold out',\n      description: 'Event status indicating tickets are sold out',\n    }),\n    icon: <SignalCancel />,\n  },\n  CANCELLED: {\n    className: styles.cancelled,\n    message: defineMessage({\n      id: 'Cancelled',\n      defaultMessage: 'Cancelled',\n      description: 'Event status indicating the event has been cancelled',\n    }),\n    icon: <SignalCancel />,\n  },\n  POSTPONED: {\n    className: styles.postponed,\n    message: defineMessage({\n      id: 'Postponed',\n      defaultMessage: 'Postponed',\n      description: 'Event status indicating the event has been postponed',\n    }),\n    icon: <SignalInfo />,\n  },\n  EVENT_ENDED: {\n    className: styles.eventEnded,\n    message: defineMessage({\n      id: 'Event ended',\n      defaultMessage: 'Event ended',\n      description: 'Event ended event badge message',\n    }),\n    icon: <SignalInfo />,\n  },\n  SALES_ENDED: {\n    className: styles.eventEnded,\n    message: defineMessage({\n      id: 'Sales ended',\n      defaultMessage: 'Sales ended',\n      description: 'Sales ended event badge message',\n    }),\n    icon: <SignalInfo />,\n  },\n} as const;\n\nexport const SignalBadge: React.FC = () => {\n  const { displayStatus: status } = useDisplayStatus();\n  const config = status ? STATUS_CONFIG[status as keyof typeof STATUS_CONFIG] : null;\n\n  if (!config) {\n    return null;\n  }\n\n  return (\n    <Badge variant=\"custom\" bordered={true} className={`${styles.badge} ${config.className}`} icon={config.icon}>\n      <FormattedMessage id={config.message.id} />\n    </Badge>\n  );\n};\n","export { SignalBadge, type SignalBadgeStatus } from './SignalBadge';\n","import type { FollowStatus } from '@/components/OrganizerCard/types';\nimport type { Organizer } from '@/types';\n\n// Follow action constants\nexport const FOLLOW_ACTION = 'follow';\nexport const UNFOLLOW_ACTION = 'unfollow';\n\nexport type FollowAction = typeof FOLLOW_ACTION | typeof UNFOLLOW_ACTION;\n\nexport enum FollowButtonVariant {\n  Default = 'default',\n  Organizer = 'organizer',\n}\n\nexport type FollowButtonProps = {\n  organizer: Organizer;\n  pageArea?: string;\n  followStatus?: FollowStatus | null;\n  followStatusLoading?: boolean;\n  variant?: FollowButtonVariant;\n};\n","import { useState, useCallback } from 'react';\nimport { sdkRequest } from '@eventbrite/legacy-infra.http';\nimport type { FollowActionApiResponse } from '@/components/OrganizerCard/types';\nimport { FOLLOW_ACTION, UNFOLLOW_ACTION, type FollowAction } from '@/components/_shared/buttons/FollowButton/types';\n\nexport interface FollowActionResult {\n  success: boolean;\n}\n\nexport interface UseFollowActionsResult {\n  follow: (organizerId: string) => Promise<FollowActionResult>;\n  unfollow: (organizerId: string) => Promise<FollowActionResult>;\n  followActionLoading: boolean;\n}\n\nexport const useFollowActions = (): UseFollowActionsResult => {\n  const [loading, setLoading] = useState(false);\n\n  const performFollowAction = useCallback(\n    async (organizerId: string, action: FollowAction): Promise<FollowActionResult> => {\n      if (!organizerId) {\n        console.error(`Failed to ${action} organizer: Organizer ID is required`);\n        return { success: false };\n      }\n\n      try {\n        setLoading(true);\n        const response: FollowActionApiResponse = await sdkRequest(\n          `/destination/organizers/${organizerId}/${action}/`,\n          {\n            method: 'POST',\n          },\n          process.env.NEXT_PUBLIC_PROXY_API_V3 ? '/e' : '',\n        );\n\n        return {\n          success: response.action_performed,\n        };\n      } catch (error) {\n        console.error(`Error ${action}ing organizer:`, error);\n        return { success: false };\n      } finally {\n        setLoading(false);\n      }\n    },\n    [],\n  );\n\n  const follow = useCallback(\n    (organizerId: string) => performFollowAction(organizerId, FOLLOW_ACTION),\n    [performFollowAction],\n  );\n\n  const unfollow = useCallback(\n    (organizerId: string) => performFollowAction(organizerId, UNFOLLOW_ACTION),\n    [performFollowAction],\n  );\n\n  return {\n    follow,\n    unfollow,\n    followActionLoading: loading,\n  };\n};\n","import { useFollowActions } from '@/components/OrganizerCard/hooks/useFollowActions';\nimport { redirectToSignIn } from '@/utils/utils';\nimport type { FollowAction } from '../types';\nimport { FOLLOW_ACTION } from '../types';\nimport { track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { logEvent } from '@eventbrite/legacy-infra.statsig';\nimport { LISTING_HEAP_IDS, STATSIG_EVENT_NAMES } from '@/components/_shared/constants';\nimport { useStage } from '@/hooks/useStage';\nimport { useOrganizerFollowStatus } from '@/components/_shared/contexts/FollowOrganizerContext';\n\nexport const useFollowButtonActions = (organizerId: string, isAuthenticated: boolean) => {\n  const { follow, unfollow, followActionLoading } = useFollowActions();\n  const { updateFollowStatus, updateNumFollowers, numFollowers } = useOrganizerFollowStatus();\n  const stage = useStage();\n\n  const handleFollowAction = async (action: FollowAction, pageArea?: string) => {\n    trackFollowAction(action, organizerId, pageArea);\n\n    if (action === FOLLOW_ACTION && !isAuthenticated) {\n      redirectToSignIn(organizerId, stage);\n      return;\n    }\n\n    try {\n      const result = action === FOLLOW_ACTION ? await follow(organizerId) : await unfollow(organizerId);\n\n      if (result.success) {\n        const newIsFollowing = action === FOLLOW_ACTION;\n        const newNumFollowers = action === FOLLOW_ACTION ? numFollowers + 1 : numFollowers - 1;\n        updateFollowStatus(newIsFollowing);\n        updateNumFollowers(newNumFollowers);\n      }\n    } catch (error) {\n      console.error(`Failed to ${action} organizer:`, error);\n    }\n  };\n\n  return {\n    followActionLoading,\n    handleFollowAction,\n  };\n};\n\nconst trackFollowAction = (action: FollowAction, organizerId: string, pageArea?: string) => {\n  const followEventName =\n    action === FOLLOW_ACTION ? LISTING_HEAP_IDS.FOLLOW_ORGANIZER : LISTING_HEAP_IDS.UNFOLLOW_ORGANIZER;\n  const statsigEventName =\n    action === FOLLOW_ACTION ? STATSIG_EVENT_NAMES.LISTING_FOLLOW_CLICK : STATSIG_EVENT_NAMES.LISTING_UNFOLLOW_CLICK;\n\n  track({\n    eventName: followEventName,\n    eventData: {\n      organizerId: organizerId,\n      pageArea: pageArea,\n    },\n  });\n  logEvent(statsigEventName);\n};\n","import React from 'react';\nimport { Button, CheckChunkierIcon } from '@eventbrite/marmalade';\nimport styles from './Follo