This tab is visible, return next one if exists\n      if (i + 1 < tabElements.length) {\n        return tabElements[i + 1];\n      }\n    }\n  }\n\n  // If no visible tab found, return first tab\n  return tabElements[0] || null;\n};\n\n/**\n * Find the previous tab to scroll to\n * @param tabList - The container element (tablist)\n * @param tabElements - Array of all tab elements\n * @returns The previous tab element to scroll to, or null if not found\n */\nexport const findPrevTabToScroll = (tabList: HTMLElement | null, tabElements: HTMLElement[]): HTMLElement | null => {\n  if (!tabList || tabElements.length === 0) return null;\n\n  const containerRect = tabList.getBoundingClientRect();\n\n  // Find the leftmost visible tab (or first partially visible on the left)\n  for (let i = 0; i < tabElements.length; i++) {\n    const tabRect = tabElements[i].getBoundingClientRect();\n    if (isTabVisible(tabRect, containerRect)) {\n      // This tab is visible, return previous one if exists\n      if (i - 1 >= 0) {\n        return tabElements[i - 1];\n      }\n    }\n  }\n\n  // If no visible tab found, return last tab\n  return tabElements[tabElements.length - 1] || null;\n};\n","import { useState, useRef, useEffect, useImperativeHandle, forwardRef, useCallback } from 'react';\nimport { Tabs, TabsItem } from '@eventbrite/marmalade';\n\nimport { Tab } from './Tab';\nimport { Slots } from './Slots/Slots';\nimport { calculateScrollState, findNextTabToScroll, findPrevTabToScroll } from './scrollUtils';\n\nimport styles from './Content.module.scss';\n\nexport const MAX_SLOTS_SHOWN_BY_DEFAULT = 3;\n\ninterface Props {\n  tabs: Tab[];\n  showTabs?: boolean;\n  showAllSlots: boolean;\n  onTabChange: (tab: Tab) => void;\n  onScrollStateChange?: (canScrollPrev: boolean, canScrollNext: boolean) => void;\n}\n\nexport interface ContentScrollHandle {\n  scrollToNext: () => void;\n  scrollToPrev: () => void;\n  canScrollPrev: boolean;\n  canScrollNext: boolean;\n}\n\nexport const Content = forwardRef<ContentScrollHandle, Props>(\n  ({ tabs, showTabs, showAllSlots, onTabChange, onScrollStateChange }, ref) => {\n    const [activeTab, setActiveTab] = useState<Tab>(tabs[0]);\n    const tabsWrapperRef = useRef<HTMLDivElement>(null);\n    const [canScrollPrev, setCanScrollPrev] = useState(false);\n    const [canScrollNext, setCanScrollNext] = useState(false);\n\n    const getTabListElement = (): HTMLElement | null => {\n      if (!tabsWrapperRef.current) return null;\n      return tabsWrapperRef.current.querySelector('[role=\"tablist\"]') as HTMLElement;\n    };\n\n    const getTabElements = (): HTMLElement[] => {\n      const tabList = getTabListElement();\n      if (!tabList) return [];\n      return Array.from(tabList.querySelectorAll('[role=\"tab\"]')) as HTMLElement[];\n    };\n\n    // Determines if scrolling is possible in either direction and updates arrow visibility\n    const checkScrollState = useCallback(() => {\n      const tabList = getTabListElement();\n      if (!tabList) return;\n\n      const { scrollLeft, scrollWidth, clientWidth } = tabList;\n      const { canScrollPrev: newCanScrollPrev, canScrollNext: newCanScrollNext } = calculateScrollState(\n        scrollLeft,\n        scrollWidth,\n        clientWidth,\n      );\n\n      setCanScrollPrev(newCanScrollPrev);\n      setCanScrollNext(newCanScrollNext);\n\n      // Notify parent of scroll state changes\n      onScrollStateChange?.(newCanScrollPrev, newCanScrollNext);\n    }, [onScrollStateChange]);\n\n    const getNextTabToScroll = (): HTMLElement | null => {\n      const tabList = getTabListElement();\n      const tabElements = getTabElements();\n      return findNextTabToScroll(tabList, tabElements);\n    };\n\n    const getPrevTabToScroll = (): HTMLElement | null => {\n      const tabList = getTabListElement();\n      const tabElements = getTabElements();\n      return findPrevTabToScroll(tabList, tabElements);\n    };\n\n    const scrollToNext = () => {\n      const nextTab = getNextTabToScroll();\n      if (nextTab) {\n        nextTab.scrollIntoView({\n          behavior: 'smooth',\n          block: 'nearest',\n        });\n      }\n    };\n\n    const scrollToPrev = () => {\n      const prevTab = getPrevTabToScroll();\n      if (prevTab) {\n        prevTab.scrollIntoView({\n          behavior: 'smooth',\n          block: 'nearest',\n        });\n      }\n    };\n\n    useImperativeHandle(ref, () => ({\n      scrollToNext,\n      scrollToPrev,\n      canScrollPrev,\n      canScrollNext,\n    }));\n\n    useEffect(() => {\n      const timeoutId = setTimeout(() => {\n        const tabList = getTabListElement();\n        if (!tabList) return;\n\n        checkScrollState();\n\n        tabList.addEventListener('scroll', checkScrollState);\n        window.addEventListener('resize', checkScrollState);\n      }, 0);\n\n      return () => {\n        clearTimeout(timeoutId);\n        const tabList = getTabListElement();\n        if (tabList) {\n          tabList.removeEventListener('scroll', checkScrollState);\n        }\n        window.removeEventListener('resize', checkScrollState);\n      };\n    }, [tabs, checkScrollState]);\n\n    if (tabs.length === 0) {\n      return null;\n    }\n\n    const slotsToShow = showAllSlots ? activeTab.slots : activeTab.slots?.slice(0, MAX_SLOTS_SHOWN_BY_DEFAULT);\n\n    if (tabs.length === 1 && !showTabs) {\n      return <Slots id={activeTab.name} slots={slotsToShow} />;\n    }\n\n    return (\n      <>\n        <div ref={tabsWrapperRef} className={styles.tabsWrapper}>\n          <Tabs\n            placeholder=\"Agenda\"\n            aria-label=\"Account options\"\n            defaultValue={activeTab.name}\n            className={styles.tabs}\n            onValueChange={(value) => {\n              const newActiveTab = tabs.find((tab) => tab.name === value) as Tab;\n              setActiveTab(newActiveTab);\n              onTabChange(newActiveTab);\n            }}\n          >\n            {tabs.map((tab, index) => (\n              <TabsItem key={tab.name + index} value={tab.name} className={styles.tab}>\n                {tab.name}\n              </TabsItem>\n            ))}\n          </Tabs>\n        </div>\n        <Slots id={activeTab.name} slots={slotsToShow} />\n      </>\n    );\n  },\n);\n\nContent.displayName = 'Content';\n","export const ArrowLeftIcon: React.FC<React.SVGProps<SVGSVGElement>> = (props) => {\n  return (\n    <svg {...props} xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"10\" viewBox=\"0 0 15 10\">\n      <path d=\"M3.21907 4.33398L6.27626 1.27679L5.33345 0.333984L0.666992 5.00044L5.33345 9.6669L6.27626 8.72409L3.21949 5.66732H14.667V4.33398H3.21907Z\" />\n    </svg>\n  );\n};\n","export const ArrowRightIcon: React.FC<React.SVGProps<SVGSVGElement>> = (props) => {\n  return (\n    <svg {...props} xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\">\n      <path\n        d=\"M15.9759 9.16675L12.1544 5.34526L13.3329 4.16675L19.166 9.99982L13.3329 15.8329L12.1544 14.6544L15.9754 10.8334H1.66602V9.16675H15.9759Z\"\n        fill=\"#3659E3\"\n      />\n    </svg>\n  );\n};\n","import styles from './PageNavigation.module.scss';\nimport { IconButton, Icon } from '@eventbrite/marmalade';\nimport { ArrowLeftIcon } from './ArrowLeftIcon';\nimport { ArrowRightIcon } from './ArrowRightIcon';\n\nexport const PageNavigation = ({\n  canScrollPrev,\n  canScrollNext,\n  onScrollPrev,\n  onScrollNext,\n}: {\n  canScrollPrev: boolean;\n  canScrollNext: boolean;\n  onScrollPrev: () => void;\n  onScrollNext: () => void;\n}) => {\n  if (!canScrollPrev && !canScrollNext) {\n    return null;\n  }\n\n  return (\n    <div className={styles.pagers}>\n      <IconButton\n        className={canScrollPrev ? '' : styles.notClickable}\n        variant=\"onLightBackground\"\n        icon={\n          <Icon size=\"xsmall\">\n            <ArrowLeftIcon className={canScrollPrev ? styles.clickableIcon : styles.notClickableIcon} />