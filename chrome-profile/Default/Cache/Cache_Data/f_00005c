ache'];\n\nexport const getBaseDeepLinkAppUrl = (eventId: string, query: ParsedUrlQuery) => {\n  const params = new URLSearchParams();\n  for (const [key, value] of Object.entries(query).filter(([key]) => !QUERY_PARMS_TO_FILTER.includes(key))) {\n    params.append(key, value as string);\n  }\n  const parameters = params.toString() ? `&${params.toString()}` : '';\n\n  return (referrer: string) => `${DEEP_LINK_PACKAGE_NAME}://event/${eventId}/?referrer=${referrer}${parameters}`;\n};\n","import Head from 'next/head';\nimport { ParsedUrlQuery } from 'querystring';\n\nimport type { WebappResponse } from '@eventbrite/event-listing-service-client';\n\nimport { useFormattedDateTimeInLocale } from '@/hooks';\nimport type { BasicInfo } from '@/types';\nimport { shouldIndexEvent } from '@/utils/utils';\n\nimport { getBaseDeepLinkAppUrl } from './getBaseDeepLinkAppUrl';\nimport { getFormattedEndDate, getFormattedStartDate } from '@/utils/dateTime';\n\nconst APP_ID = '487922291';\nconst MOBILE_CLIENT_ATTENDEE_APP = 'com.eventbrite.attendee';\nconst IOS_REFERRER = 'eiosurlxfbk';\nconst ANDROID_REFERRER = 'eandurlxfbk';\nconst ANDROID_BANNER_REFERRER = 'eandurlxgoog';\n\ninterface SEOTagsProps {\n  basicInfo: BasicInfo;\n  query: ParsedUrlQuery;\n  seo: WebappResponse['seo'];\n  ebHost?: string;\n  locale?: string;\n}\n\nconst generateMetaKeywords = (basicInfo: BasicInfo): string => {\n  let keywords = 'Eventbrite';\n\n  const eventName = basicInfo.name;\n  const city = basicInfo.venue?.address?.city;\n\n  if (eventName) {\n    keywords += `, ${eventName}`;\n    keywords += `, ${eventName} tickets`;\n  }\n\n  if (eventName && city) {\n    // Only add city keywords if both name and city are present\n    keywords += `, ${eventName} ${city}`;\n    keywords += `, ${eventName} ${city} tickets`;\n  }\n\n  return keywords;\n};\n\nexport const SEOTags = ({ basicInfo, query, seo, ebHost, locale = 'en' }: SEOTagsProps) => {\n  const formattedDateTime = useFormattedDateTimeInLocale(basicInfo.startDate.local, locale);\n  const latitude = basicInfo.venue?.address?.latitude;\n  const longitude = basicInfo.venue?.address?.longitude;\n  const venueAddress = basicInfo.venue?.address?.localizedMultiLineAddressDisplay?.join(', ');\n  const baseDeepLinkAppUrl = getBaseDeepLinkAppUrl(basicInfo.id, query);\n\n  const startDateFormatted = getFormattedStartDate(basicInfo);\n  const endDateFormatted = getFormattedEndDate(basicInfo);\n\n  // The event is no-indexed if the TLDs that do NOT align with the creator's preferred domain\n  const isIndexable = shouldIndexEvent(basicInfo.url, ebHost, seo?.isIndexable);\n  const robotsContent = isIndexable ? 'index, follow' : 'noindex, nofollow';\n\n  return (\n    <Head>\n      <meta name=\"robots\" content={robotsContent} />\n      <link rel=\"canonical\" href={basicInfo.url} />\n      <link\n        key=\"android-app-alternate\"\n        rel=\"alternate\"\n        href={`android-app://com.eventbrite.attendee/http/www.eventbrite.com/e/${basicInfo.id}?referrer=${ANDROID_BANNER_REFERRER}`}\n      />\n\n      <meta name=\"keywords\" content={generateMetaKeywords(basicInfo)} />\n      <meta property=\"og:determiner\" content=\"an\" />\n      <meta property=\"og:locale\" content={basicInfo.locale} />\n      {latitude && longitude && (\n        <>\n          <meta property=\"event:location:latitude\" content={latitude} />\n          <meta property=\"event:location:longitude\" content={longitude} />\n        </>\n      )}\n      {startDateFormatted && <meta property=\"event:start_time\" content={startDateFormatted} />}\n      {endDateFormatted && <meta property=\"event:end_time\" content={endDateFormatted} />}\n\n      {/* These are deprecated by twitter but still used by Slack */}\n      {venueAddress && (\n        <>\n          <meta name=\"twitter:label1\" content=\"Where\" />\n          <meta name=\"twitter:data1\" content={venueAddress} />\n        </>\n      )}\n      {!basicInfo.hideStartDate && formattedDateTime && (\n     