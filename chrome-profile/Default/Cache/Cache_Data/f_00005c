t.name]);\n\n  return (\n    <div onClick={handleCardClick}>\n      <RelatedEventCard relatedEvent={relatedEvent} affiliateCode={affiliateCode} />\n    </div>\n  );\n};\n","export { MoreOrganizerEventCard } from './MoreOrganizerEventCard';\n","import { OrganizerEventResponse, OrganizerEvent, EventbriteApiResponse, EventbriteApiEvent } from './types';\nimport type { EventInteraction, EventInteractionWithContext } from '@/tracking/types';\n\nconst NUMBER_OF_MORE_EVENTS_TO_SHOW = 3;\n\n// Transform Eventbrite API response to internal format\nexport const transformApiResponseToOrganizerEvents = ({\n  apiResponse,\n  currentEventId,\n}: {\n  apiResponse: EventbriteApiResponse | null;\n  currentEventId: string;\n}): OrganizerEventResponse | null => {\n  if (!apiResponse?.events?.length) {\n    return null;\n  }\n\n  const transformedEvents: OrganizerEvent[] = apiResponse.events.map((event: EventbriteApiEvent) => ({\n    id: event.id,\n    name: event.name?.text || '',\n    url: event.url,\n    imageUrl: event.logo?.url || '',\n    startDate: event.start?.utc?.split('T')[0] || '',\n    startTime: event.start?.utc?.split('T')[1]?.slice(0, 8) || '',\n    timezone: event.start?.timezone || '',\n    isFree: event.is_free || false,\n    isOnlineEvent: event.online_event || false,\n    isPromoted: false, // API doesn't provide this info directly\n    formattedPriceString: formatPriceFromTicketAvailability(event.ticket_availability),\n    venue: undefined, // Would need venue API call to populate this\n    urgencySignals: {}, // API doesn't provide urgency signals directly\n    specialDiscounts: { hasBogoTickets: false }, // API doesn't provide this info directly\n    ticket_availability: {\n      has_available_tickets: event.ticket_availability?.has_available_tickets || false,\n    },\n  }));\n\n  const filteredEvents = getMoreEventsFromThisOrganizerFiltered({\n    currentEventId,\n    events: transformedEvents,\n  });\n\n  return {\n    events: filteredEvents,\n    unrecoverableEventIds: [], // API v3 doesn't provide this info\n  };\n};\n\n// Helper function to format price from ticket availability\nconst formatPriceFromTicketAvailability = (\n  ticketAvailability?: EventbriteApiEvent['ticket_availability'],\n): string | undefined => {\n  if (!ticketAvailability) return undefined;\n\n  if (ticketAvailability.minimum_ticket_price) {\n    const minPrice = ticketAvailability.minimum_ticket_price;\n    return minPrice.display;\n  }\n\n  return undefined;\n};\n\n// Get events to show (limit to 4)\nexport const getEventsToShow = (\n  organizerEvents: OrganizerEventResponse | null,\n  currentEventId: string,\n): OrganizerEvent[] => {\n  if (!organizerEvents?.events?.length) {\n    return [];\n  }\n  // Filter out the current event and limit to 4\n  return organizerEvents.events.filter((event) => event.id !== currentEventId).slice(0, 4);\n};\n\n// Create tracking information getter\nexport const createTrackingInformationGetter = (\n  mainEvent: { id?: string; isOnline?: boolean; isEnded?: boolean },\n  allEvents: OrganizerEvent[] = [],\n  locale: string,\n  sessionInfo: {\n    userId?: string | null;\n    sessionId?: string | null;\n    guestId?: string | null;\n  },\n) => {\n  return (eventInteraction: EventInteraction): EventInteractionWithContext => {\n    // Find the specific event from the events array for rank calculation\n    const eventToTrack = allEvents.find((e) => e.id === eventInteraction.id);\n\n    if (!eventToTrack) {\n      console.error(`Event with id ${eventInteraction.id} not found in organizer events list`);\n      return {} as EventInteractionWithContext;\n    }\n\n    const rank = allEvents.findIndex((e) => e.id === eventInteraction.id) + 1;\n\n    return {\n      id: eventInteraction.id,\n      action: eventInteraction.action,\n      event: eventInteraction.event,\n      user: {\n        id: sessionInfo.userId ?? undefined,\n        locale,\n        guestId: sessionInfo.guestId ?? undefined,\n        sessionId: sessionInfo.sessionId ?? undefined,\n      },\n      place: {\n        name: 'more_organizer_events',\n        position: rank,\n        page: 1,\n        context: {\n          main_event_id: mainEvent.id,\n          is_online: mainEvent.isOnline,\n          is_ended: mainEvent.isEnded,\n          total_organizer_events: allEvents.length,\n        },\n      },\n    };\n  };\n};\n\nexport const getMoreEventsFromThisOrganizerFiltered = ({\n  currentEventId,\n  events,\n}: {\n  currentEventId: string;\n  events: OrganizerEvent[];\n}): OrganizerEvent[] => {\n  return (\n    events\n      ?.filter(\n        (event: OrganizerEvent) => event.ticket_availability?.has_available_tickets && event.id !== currentEventId,\n      )\n      .slice(0, NUMBER_OF_MORE_EVENTS_TO_SHOW) || []\n  );\n};\n","import { useState, useCallback, useEffect, useRef } from 'react';\nimport { useComponentVisibility } from '@/hooks/useComponentVisibility';\nimport type { OrganizerEventResponse, EventbriteApiResponse } from '../types';\nimport type { BasicInfo } from '@/types';\nimport { sdkRequest } from '@eventbrite/legacy-infra.http';\nimport { transformApiResponseToOrganizerEvents } from '../utils';\n\nconst isElementVisible = (element: HTMLElement): boolean => {\n  const rect = element.getBoundingClientRect();\n  const windowHeight = window.innerHeight || document.documentElement.clientHeight;\n  const windowWidth = window.innerWidth || document.documentElement.clientWidth;\n\n  return rect.top < windowHeight && rect.bottom > 0 && rect.left < windowWidth && rect.right > 0;\n};\n\n// Extract fetching logic to reduce complexity\nconst useFetchOrganizerEvents = (organizerId: string | undefined, eventId: string) => {\n  const [organizerEvents, setOrganizerEvents] = useState<OrganizerEventResponse | null>(null);\n  const [isLoading, setIsLoading] = useState(false);\n\n  const fetchEvents = useCallback(async () => {\n    if (!organizerId) return;\n\n    setIsLoading(true);\n    try {\n      const apiResponse: EventbriteApiResponse = await sdkRequest(\n        `/organizers/${organizerId}/events/?expand=ticket_availability&status=live&only_public=true`,\n        undefined,\n        process.env.NEXT_PUBLIC_PROXY_API_V3 ? '/e' : '',\n      );\n\n      if (apiResponse) {\n        const transformedData = transformApiResponseToOrganizerEvents({\n          apiResponse,\n          currentEventId: eventId,\n        });\n        setOrganizerEvents(transformedData);\n      } else {\n        console.error('Failed to fetch organizer events: No response');\n      }\n    } catch (err) {\n      console.error('Failed to fetch organizer events:', err);\n    } finally {\n      setIsLoading(false);\n    }\n  }, [organizerId, eventId]);\n\n  return { organizerEvents, isLoading, fetchEvents };\n};\n\n// Extract scroll handling logic to reduce complexity\nconst useScrollHandler = (isBodyRendered: boolean, checkIfInViewAndLoad: () => void) => {\n  useEffect(() => {\n    if (!isBodyRendered) return;\n\n    let scrollTimer: ReturnType<typeof setTimeout>;\n    const handleScroll = () => {\n      clearTimeout(scrollTimer);\n      scrollTimer = setTimeout(checkIfInViewAndLoad, 100);\n    };\n\n    window.addEventListener('scroll', handleScroll, { passive: true });\n    return () => {\n      window.removeEventListener('scroll', handleScroll);\n      clearTimeout(scrollTimer);\n    };\n  }, [isBodyRendered, checkIfInViewAndLoad]);\n};\n\nexport const useMoreOrganizerEventsLazy = (eventBasicInfo: BasicInfo, eventId?: string, isBodyRendered?: boolean) => {\n  const organizerId = eventBasicInfo.organizer?.id;\n  const { organizerEvents, isLoading, fetchEvents } = useFetchOrganizerEvents(organizerId, eventId || '');\n\n  // Use refs to avoid infinite loops caused by state dependencies\n  const isLoadingRef = useRef(isLoading);\n  const organizerEventsRef = useRef(organizerEvents);\n\n  // Keep refs in sync with state\n  isLoadingRef.current = isLoading;\n  organizerEventsRef.current = organizerEvents;\n\n  const