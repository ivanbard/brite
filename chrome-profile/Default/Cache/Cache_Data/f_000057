ntent":[".g2k {\n  overflow-x: scroll;\n  overflow-y: hidden;\n}\n","@import '../../styles/constants.scss';\n@import '../../styles/mediaqueries.scss';\n\n.wrapper {\n  display: flex;\n  flex-direction: column;\n  z-index: $conversion-bar-z-index;\n  background-color: $color-bg-base;\n  box-shadow: 0 $quarter-spacing $half-spacing 0 $color-shadow-layer-05;\n  width: 100%;\n  position: fixed;\n  bottom: 0;\n  right: 0;\n\n  @include large-up {\n    position: fixed;\n    min-height: auto;\n    padding: 0;\n  }\n}\n\n.hidden {\n  @include large-up {\n    opacity: 0;\n    visibility: hidden;\n  }\n}\n\n.relative {\n  position: relative;\n\n  @include large-up {\n    /* Desktop: flow inside sticky wrapper; no position: fixed */\n    position: relative;\n    width: $conversion-bar-width;\n    border-radius: $border-radius-sm;\n    max-height: calc(100vh - #{$spacing-8});\n    overflow-y: auto;\n  }\n}\n\n.content {\n  display: flex;\n  padding: 0 $spacing-2;\n  border-top: 1px solid $color-core-border-base;\n  border-bottom: 1px solid $color-core-border-base;\n\n  @include small {\n    padding: $spacing-3 $spacing;\n    align-items: center;\n    gap: $spacing-2;\n  }\n  @include medium {\n    padding: $spacing-3 $spacing-4;\n  }\n  @include large {\n    padding: $spacing-3 $spacing-12;\n  }\n\n  @include large-up {\n    padding: $spacing-3;\n    border-top: none;\n    border-bottom: none;\n  }\n\n  @include extra-large-wide {\n    max-width: 700px;\n  }\n}\n\n.infoPanelWrapper {\n  width: 100%;\n  display: block;\n  height: 100%;\n  padding: 0 $spacing-2;\n\n  @include small {\n    width: 100%;\n    flex-shrink: 1;\n    min-width: 0;\n  }\n\n  @include large-up {\n    padding: 0;\n  }\n\n  button {\n    font-size: $typography-font-size-base-md;\n    padding: 0 $spacing-plus-quarter;\n\n    @include large {\n      font-size: $typography-font-size-base-l;\n      padding: 0 $space-and-half;\n    }\n  }\n}\n","@import '~@eventbrite/valkyrie-eds-styles/settings/settings';\n\n$quarter-spacing: 2px;\n$half-spacing: 4px;\n$three-quarter-spacing: 6px;\n$spacing: 8px;\n$spacing-plus-quarter: 10px;\n$space-and-half: 12px;\n$spacing-2: $spacing * 2;\n$spacing-2-and-half: $spacing * 2.5;\n$spacing-3: $spacing * 3;\n$spacing-4: $spacing * 4;\n$spacing-4-and-half: $spacing * 4.5;\n$spacing-5: $spacing * 5;\n$spacing-6: $spacing * 6;\n$spacing-7: $spacing * 7;\n$spacing-8: $spacing * 8;\n$spacing-9: $spacing * 9;\n$spacing-10: $spacing * 10;\n$spacing-12: $spacing * 12;\n$spacing-14: $spacing * 14;\n$spacing-16: $spacing * 16;\n$spacing-33: $spacing * 33;\n$spacing-45: $spacing * 45;\n\n$color-fg-base: #261b36;\n$color-fg-secondary: #585163;\n$color-fg-tertiary: #716b7a;\n$color-core-fg-tertiary: #696c71;\n$color-bg-base: #fff;\n$color-bg-sunken: #f8f7fa;\n$color-bg-modal-overlay: rgba(28, 28, 30, 0.9);\n$color-link-base: #3659e3;\n$color-opportunity-action-base: #324efc;\n$color-core-fg-base: #161719;\n$color-core-border-base: rgba(25, 22, 19, 0.1);\n$color-shadow-layer-05: rgba(0, 0, 0, 0.05);\n$color-shadow-layer-40: rgba(0, 0, 0, 0.4);\n$color-bg-remind-me: rgb(245, 245, 245);\n$color-fg-remind-me: rgb(57, 54, 79);\n\n$color-inverse-inverse-bg-base: #161719;\n$color-button-secondary-base: rgba(145, 141, 153, 0.1);\n$color-action-fg-base: #3659e3;\n$color-button-secondary-bg-base: rgba(145, 141, 153, 0);\n$color-legacy-green-100: #f0fdf4;\n$discount-signal-bg-color: var(--marm-color-brand-static-sea-glass-green, #d9ffd5);\n$color-action-fg-red: var(--eds-color-red-500, $ui-red);\n\n// These ones are not in valkyrie-eds-styles\n$typography-font-size-signal-xs: 9px;\n$typography-font-size-base-s: 12px;\n$typography-font-size-base-sm: 13.5px;\n$typography-font-size-base-md: 15px;\n$typography-font-size-base-md-x: 16px;\n$typography-font-size-base-md-xx: 17px;\n$typography-font-size-base-l: 18px;\n$typography-font-size-base-l-x: 19px;\n$typography-font-size-base-l-xx: 20px;\n$typography-font-size-base-xl: 21px;\n$typography-font-size-plus-sm: 24px;\n