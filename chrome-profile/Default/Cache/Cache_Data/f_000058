00;\n$control-disabled-background-color: $theme-ui-300;\n$control-disabled-border-color: $theme-ui-300;\n$control-disabled-color: $disabled-text-color;\n\n/* ========== Lists =========== */\n\n$list-item-spacing: 16px 20px;\n$list-item-spacing-sub: 36px;\n$list-item-selected-border-height: 2px;\n$list-item-spacing-selected: 17px 24px (17px - $list-item-selected-border-height) 24px;\n$fade-spacing: $grid-unit * 8;\n$list-active-color: $ui-orange;\n$list-dark-highlight: linear-gradient(90deg, rgba(40, 44, 53, 0.8) 0%, rgba(40, 44, 53, 0.3) 100%);\n\n/* ========== Elevation =========== */\n$elevation-0: 0 0 0 0 rgba(0, 0, 0, 0);\n$elevation-1:\n    0 4px 8px 0 rgba(40, 44, 53, 0.06),\n    0 2px 2px 0 rgba(40, 44, 53, 0.06);\n$elevation-2:\n    0 4px 15px 0 rgba(40, 44, 53, 0.06),\n    0 2px 2px 0 rgba(40, 44, 53, 0.08);\n$elevation-3:\n    0 1px 17px 0 rgba(40, 44, 53, 0.1),\n    0 2px 4px 0 rgba(40, 44, 53, 0.1);\n$elevation-4:\n    0 1px 20px 0 rgba(40, 44, 53, 0.1),\n    0 2px 4px 0 rgba(40, 44, 53, 0.1);\n$elevation-5:\n    0 1px 24px 0 rgba(40, 44, 53, 0.1),\n    0 2px 8px 0 rgba(40, 44, 53, 0.1);\n\n/* ========== Layout Peaks  =========== */\n$eds-layout-small-peak-height: 10 * $grid-unit;\n$eds-layout-medium-peak-height: 20 * $grid-unit;\n$eds-layout-large-peak-height: 30 * $grid-unit;\n\n/* ========== Typography Font Sizes =========== */\n\n$typography-font-size-body-small-desktop: 12px;\n$typography-font-size-body-small: 14px;\n$typography-font-size-base: 16px;\n$typography-font-size-body-large-desktop: 18px;\n$typography-font-size-body-large: 20px;\n$typography-font-size-heading-small: 24px;\n$typography-font-size-heading-medium: 28px;\n$typography-font-size-heading-medium-desktop: 30px;\n$typography-font-size-heading-large: 32px;\n$typography-font-size-heading-xl: 52px;\n$typography-font-size-heading-xl-desktop: 84px;\n\n/* ========== Typography Line Heights =========== */\n\n$typography-line-height-quarter: 0.25rem;\n$typography-line-height-base: 1rem;\n$ty