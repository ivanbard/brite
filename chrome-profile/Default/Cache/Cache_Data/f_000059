\n        iconColor: PropTypes.string,\n        /**\n         * Additional attributes to be passed to the span element.\n         */\n        spanAttrs: PropTypes.object,\n    };\n\n    static defaultProps = {\n        style: STYLE_NEUTRAL,\n        isActive: false,\n        isDisabled: false,\n        isOverImage: false,\n        spanAttrs: {},\n    };\n\n    render() {\n        const {\n            style,\n            title,\n            isActive,\n            isDisabled,\n            isOverImage,\n            iconType,\n            onClick,\n            iconColor,\n            iconClassName,\n            buttonClassName,\n            spanAttrs,\n        } = this.props;\n\n        const extraAttrs = getAdditionalProps(this);\n        const iconExtraAttrs = {};\n\n        if (buttonClassName) {\n            extraAttrs.__containerClassName = buttonClassName;\n        }\n\n        if (iconClassName) {\n            iconExtraAttrs.__containerClassName = iconClassName;\n        }\n\n        let buttonStyle = style;\n\n        if (buttonStyle === STYLE_DARK) {\n            buttonStyle = STYLE_NEUTRAL;\n        }\n\n        const iconButtonClasses = classNames(styles.root, {\n            [styles.active]: isActive,\n            [styles.disabled]: isDisabled,\n            [styles.overImage]: isOverImage,\n            [styles[buttonStyle]]: buttonStyle,\n        });\n\n        return (\n            <span className={iconButtonClasses} data-testid=\"icon-button\" {...spanAttrs}>\n                <Button\n                    style={BUTTON_STYLE_NONE}\n                    onClick={onClick}\n                    disabled={isDisabled}\n                    {...extraAttrs}\n                >\n                    <Icon\n                        type={iconType}\n                        title={title}\n                        isBlockLevel={true}\n                        color={iconColor}\n                        {...iconExtraAttrs}\n                    />\n                </Button>\n            </span>\n        );\n    }\n}\n","import * as React from 'react';\n\nexport const ShareIosChunky = (props: React.SVGProps<SVGSVGElement>) => (\n    <svg\n        id=\"share-ios-chunky_svg__eds-icon--share-ios-chunky_svg\"\n        x={0}\n        y={0}\n        viewBox=\"0 0 24 24\"\n        xmlSpace=\"preserve\"\n        {...props}\n    >\n        <path\n            id=\"share-ios-chunky_svg__eds-icon--share-ios-chunky_base\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n            d=\"M18 16v2H6v-2H4v4h16v-4z\"\n        />\n        <path\n            id=\"share-ios-chunky_svg__eds-icon--share-ios-chunky_arrow\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n            d=\"M12 4L7 9l1.4 1.4L11 7.8V16h2V7.8l2.6 2.6L17 9l-5-5z\"\n        />\n    </svg>\n);\n\nShareIosChunky.displayName = 'ShareIosChunkySvg';\n","import debounce from 'lodash.debounce';\nimport { useCallback, useEffect, useRef } from 'react';\n\nexport const useScrollWatcher = (\n    callback: (value: number) => void,\n    {\n        deps = [],\n        interval = 100,\n        selector = '',\n    }: { deps: Array<boolean | number>; interval: number; selector: string },\n) => {\n    const positionRef = useRef<number>(0);\n    const containerRef = useRef<HTMLDivElement | null>(null);\n    useEffect(() => {\n        containerRef.current = document.querySelector(selector);\n    }, [selector]);\n\n    const checkScrollPosition = useCallback(() => {\n        callback(positionRef.current);\n        positionRef.current = containerRef.current?.scrollTop || 0;\n    }, [callback]);\n\n    useEffect(() => {\n        const handleScroll = () => {\n            checkScrollPosition();\n        };\n\n        const debouncedHandleScroll = debounce(handleScroll, interval);\n\n        containerRef.current?.addEventListener('scroll', debouncedHandleScroll);\n\n        return containerRef.current?.removeEventListener('scroll', debouncedHandleScroll);\n    }, [...deps, checkScrollPosition, interval]);\n};\n","import classnames from 'classnames';\nimport { Button } from '@eventbrite/legacy-eds.button';\nimport { Icon } from '@eventbrite/legacy-eds.icon';\nimport { ChevronDownChunky } from '@eventbrite/legacy-eds.iconography';\nimport React, { useEffect, useRef, useState } from 'react';\nimport { useScrollWatcher } from './hooks';\nimport styles from './BarButton.module.scss';\n\nexport interface BarButtonProps {\n    onClick: (e: React.MouseEvent) => void;\n    title?: string;\n}\n\nexport const BarButton: React.FunctionComponent<BarButtonProps> = (props) => {\n    const { onClick, title } = props;\n    const [isSticky, setIsSticky] = useState(false);\n    const [height, setHeight] = useState(36);\n    const buttonRef = useRef<HTMLDivElement>(null);\n    useEffect(() => {\n        if (buttonRef && buttonRef.current) setHeight(buttonRef.current.offsetHeight);\n    }, [buttonRef]);\n\n    useScrollWatcher(\n        (pos) => {\n            const shouldStick = pos > height;\n            if (isSticky !== shouldStick) {\n                setIsSticky(shouldStick);\n            }\n        },\n        {\n            deps: [isSticky, height],\n            interval: 10,\n            selector: '#edsModalContentChildren',\n        },\n    );\n\n    return (\n        <Button data-testid=\"modal-close-bar-button\" style=\"none\" title={title} onClick={onClick}>\n            <div\n                ref={buttonRef}\n                className={classnames(styles['edsModalBarButton'], {\n                    [styles['edsModalBarButtonSticky'] as string]: isSticky,\n                })}\n            >\n                <Icon size=\"medium\" type={<ChevronDownChunky />} />\n            </div>\n        </Button>\n    );\n};\n","export const ROOT_NODE_SELECTOR = '#creator-nav-root';\n\n// modal types\n\nexport enum ModalType {\n    simple = 'simple',\n    aperture = 'aperture',\n    takeover = 'takeover',\n    complex = 'complex',\n}\n\nexport const TYPES = [Modal