ETHOD = 'ShareEventMethodButtonClicked';\nexport const HEAP_SHARE_EVENT_CLOSE_MODAL = 'ShareEventCloseModalButtonClick';\n","export const getHeapPageArea = (affCode?: string) => {\n    if (typeof window === 'undefined') {\n        return null; // Return null for non-browser environments.\n    }\n    const pathname = window.location.pathname;\n\n    if (pathname === '/') {\n        return 'homepage';\n    }\n    if (pathname.includes('/d/')) {\n        if (pathname.includes('/events/')) {\n            return 'city-browse-page';\n        } else {\n            return 'search-results-page';\n        }\n    }\n    if (pathname.startsWith('/e/') && affCode === 'erelpanelorg') {\n        return 'listing-more-events-from-organizer';\n    }\n    if (pathname.startsWith('/e/') && affCode === 'erellivmlt') {\n        return 'listing-other-events-you-may-like';\n    }\n    if (pathname.startsWith('/e/')) {\n        return 'listing-hero-content';\n    }\n    if (pathname.includes('/b/')) {\n        return 'category-browse-page';\n    }\n    if (pathname.includes('/cc/')) {\n        return 'creator-collections-page';\n    }\n\n    if (pathname.includes('/mytickets')) {\n        return 'my-tickets';\n    }\n\n    if (pathname.includes('/u/')) {\n        if (pathname.includes('/favorites/events')) {\n            return 'likes-page';\n        }\n\n        if (pathname.includes('/following')) {\n            return 'profile-following';\n        }\n\n        return 'profile-likes';\n    }\n\n    if (pathname.includes('/checkout-external')) {\n        return 'checkout-confirmation';\n    }\n\n    if (pathname.includes('/o/')) {\n        return 'organizer-profile';\n    }\n\n    return null;\n};\n","import { track } from '@eventbrite/legacy-infra.datalayer-library';\nimport { getHeapPageArea } from './heapPageArea';\n\nexport const reTrackHeapEvent = ({\n    affCode,\n    eventId,\n    heapEventName,\n    shareMethod = null,\n}: {\n    affCode?: string;\n    eventId: string;\n    heapEventName: string;\n    shareMethod?: string | null;\n}) => {\n    if (eventId && heapEventName) {\n        const pageArea = getHeapPageArea(affCode) || 'uncategorized';\n        const eventData = {\n            eventId: eventId,\n            pageArea: pageArea,\n            shareMethod: shareMethod,\n        };\n\n        track({\n            eventName: heapEventName,\n            eventData,\n        });\n    }\n};\n","import { BffRequestHandler } from './helpers/BffRequestHandler';\nimport { getAttributionIDFromLocalStorage } from './utils/index';\n\nexport interface ClickDataInput {\n    organization_id: string;\n    is_server_side_enabled?: boolean;\n    fbclid?: string;\n    fbc?: string;\n    fbp?: string;\n    timestamp?: number;\n}\n\nexport interface ClickData extends ClickDataInput {\n    stable_id: string;\n    user_agent: string;\n}\n\n// Create BFF request handler instance\n// For listings-webapp, use empty baseUrl to make relative requests to same domain\nconst bffHandler = new BffRequestHandler('');\n\n// Helper functions for time-boxed localStorage\nconst PENDING_CLICK_KEY = 'pendingClickData';\n\ninterface PendingClickData {\n    orgId: string;\n    timestamp: number;\n}\n\nexport const storePendingClickInLocalStorage = (orgId: string): void => {\n    try {\n        if (typeof window === 'undefined' || !window.localStorage) {\n            console.warn('localStorage not available for storing pending click data');\n            return;\n        }\n\n        const pendingClickData: PendingClickData = {\n            orgId,\n            timestamp: Date.now(),\n        };\n        localStorage.setItem(PENDING_CLICK_KEY, JSON.stringify(pendingClickData));\n    } catch (error) {\n        console.warn('Failed to store pending click data in localStorage:', error);\n    }\n};\n\nconst getPendingClickFromLocalStorage = (): PendingClickData | null => {\n    try {\n        if (typeof window === 'undefined' || !window.localStorage) {\n            return null;\n        }\n\n        const stored = localStorage.getItem(PENDING_CLICK_KEY);\n        if (!stored) return null;\n\n        const data: PendingClickData = JSON.parse(stored);\n        const fiveMinutesAgo = Date.now() - 5 * 60 * 1000;\n\n        // If timestamp is older than 5 minutes ago, discard it\n        if (data.timestamp < fiveMinutesAgo) {\n            localStorage.removeItem(PENDING_CLICK_KEY);\n            return null;\n        }\n\n        return data;\n    } catch (error) {\n        console.warn('Failed to parse pending click data from localStorage:', error);\n        if (typeof window !== 'undefined' && window.localStorage) {\n            localStorage.removeItem(PENDING_CLICK_KEY);\n        }\n        return null;\n    }\n};\n\nconst clearPendingClickFromLocalStorage = (): void => {\n    try {\n        if (typeof window !== 'undefined' && window.localStorage) {\n            localStorage.removeItem(PENDING_CLICK_KEY);\n        }\n    } catch (error) {\n        console.warn('Failed to clear pending click data from localStorage:', error);\n    }\n};\n\n// Helper function to check and save pending click if consent is granted\nexport const checkAndSavePendingClick = async (\n    canStoreAttributionData?: boolean,\n    isOptInJurisdiction?: boolean,\n    isConsentDecisionMade?: boolean,\n): Promise<void> => {\n    const pendingData = getPendingClickFromLocalStorage();\n    if (!pendingData) return;\n\n    // If consent parameters are provided, check them\n    if (\n        canStoreAttributionData !== undefined &&\n        isOptInJurisdiction !== undefined &&\n        isConsentDecisionMade !== undefined\n    ) {\n        if (!(isOptInJurisdiction && canStoreAttributionData && isConsentDecisionMade)) {\n            return; // Consent not granted\n        }\n    }\n\n    const stableId = getAttributionIDFromLocalStorage();\n    if (!stableId) {\n        console.log('No stable_id available for saving pending click data');\n        return;\n    }\n\n    try {\n        await savePendingClickData(stableId, pendingData.orgId);\n        clearPendingClickFromLocalStorage();\n    } catch (error) {\n        console.warn('Failed to save pending click data:', error);\n    }\n};\n\n// Helper function to send click data to attribution service\nexport const sendClickDataToAttributionService = async (clickData: ClickData): Promise<void> => {\n    try {\n        // Transform the data to match the expected ClickIn interface\n        const requestBody = {\n            fbclid: clickData.fbclid,\n            stable_id: clickData.stable_id,\n            org_id: clickData.organization_id,\n            fbc: clickData.fbc,\n            fbp: clickData.fbp,\n            user_agent: clickData.user_agent,\n        };\n\n        await bffHandler.request('/conversions-manager/api/v1/attribution/click', {\n            method: 'POST',\n            body: JSON.stringify(requestBody),\n        });\n    } catch (error) {\n        console.warn('Attribution service error:', error);\n        // Don't throw - attribution is non-blocking\n    }\n};\n\n// Helper function to store pending click data while awaiting consent\nexport const storePendingClickData = async (clickData: ClickData): Promise<void> => {\n    try {\n        // Transform the data to match the expected ClickIn interface\n        const requestBody = {\n            fbclid: clickData.fbclid,\n            stable_id: clickData.stable_id,\n            org_id: clickData.organization_id,\n            fbc: clickData.fbc,\n            fbp: clickData.fbp,\n            user_agent: clickData.user_agent,\n        };\n\n        await bffHandler.request('/conversions-manager/api/v1/attribution/pending-click/store', {\n            method: 'POST',\n            body: JSON.stringify(requestBody),\n        });\n    } catch (error) {\n        console.warn('Pending click storage error:', error);\n        // Don't throw - attribution is non-blocking\n    }\n};\n\n// Helper function to save pending click data after consent is granted\nexport const savePendingClickData = async (\n    stableId: string,\n    organizationId: string,\n): Promise<void> => {\n    try {\n        const requestBody = {\n            stable_id: stableId,\n            org_id: organizationId,\n        };\n\n        await bffHandler.request('/conversions-manager/api/v1/attribution/pending-click/save', {\n            method: 'POST',\n            body: JSON.stringify(requestBody),\n        });\n    } catch (error) {\n        console.warn('Pending click save error:', error);\n        // Don't throw - attribution is non-blocking\n    }\n};\n\n// Helper function to safely extract a cookie value by name\nconst getCookieValue = (cookieName: string): string | undefined => {\n    if (typeof window === 'undefined' || !document.cookie) {\n        return undefined;\n    }\n\n    try {\n        const cookies = document.cookie.split(';');\n        for (let i = 0; i < cookies.length; i++) {\n            const cookie = cookies[i]?.trim();\n            if (cookie && cookie.startsWith(`${cookieName}=`)) {\n                const value = cookie.substring(cookieName.length + 1);\n                return decodeURIComponent(value);\n            }\n        }\n    } catch (error) {\n        console.warn(`Failed to extract cookie ${cookieName}:`, error);\n    }\n\n    return undefined;\n};\n\n// Helper function to extract Facebook click IDs from URL and cookies\nexport const extractFacebookClickIds = (): {\n    fbclid?: string;\n    fbc?: string;\n    fbp?: string;\n} => {\n    if (typeof window === 'undefined') {\n        return {};\n    }\n\n    // Extract fbclid from URL parameters\n    const urlParams = new URLSearchParams(window.location.search);\n    const fbclid = urlParams.get('fbclid') || undefined;\n\n    // Extract fbc and fbp from cookies\n    const fbc = getCookieValue('_fbc');\n    const fbp = getCookieValue('_fbp');\n\n    return {\n        fbclid,\n        fbc,\n        fbp,\n    };\n};\n","import { BffRequestHandler } from './helpers/BffRequestHandler';\nimport { isServerSideTrackingEnabledForOrganization } from './utils/index';\n\nexport interface AttributionEvent {\n    event_type: string;\n    event_time: string;\n    event_id: string;\n    stable_id: string;\n    org_id: string;\n    pixel_id: string;\n    event_source_url?: string;\n    fbp?: string;\n    user_agent?: string;\n    event_data?: unknown;\n    user_data?: UserData;\n}\n\nexport interface UserData {\n    email?: string;\n    firstName?: string;\n    lastName?: string;\n    zipCode?: string;\n    externalId?: string;\n    phone?: string;\n}\n\ninterface PixelConfig {\n    pixelId: string;\n    id: string;\n    events: Record<string, string>; // Eventbrite event name -> Facebook event name mapping\n}\n\nexport interface TrackingBeacons {\n    'Facebook Pixel'?: PixelConfig[];\n    [key: string]: PixelConfig[] | undefined; // Allow for any pixel type\n}\n\ninterface FacebookPixelEvent {\n    pixelId: string;\n    facebookEventName: string;\n}\n\n// Create BFF request handler instance\n// For listings-webapp, use empty baseUrl to make relative requests to same domain\nconst bffHandler = new BffRequestHandler('');\n\n// Consent check function for attribution calls\nconst checkAttributionConsent = (): boolean => {\n    try {\n        if (typeof window !== 'undefined' && window.airgap?.getConsent) {\n            const consentData = window.airgap.getConsent();\n            const advertisingConsent = consentData?.purposes?.Advertising;\n            const saleOfInfoConsent = consentData?.purposes?.SaleOfInfo;\n\n            // Check if we're in an opt-in jurisdiction\n            const isOptInJurisdiction = (() => {\n                if (window.airgap?.getRegimes) {\n                    const regimes = Array.from(window.airgap.getRegimes());\n                    const optInRegimes = ['GDPR', 'LGPD', 'PIPEDA'];\n                    return optInRegimes.includes(regimes[0] || 'CPRA');\n                }\n                return false;\n            })();\n\n            if (advertisingConsent === true && saleOfInfoConsent === true) {\n                return true;\n            } else if (advertisingConsent === false || saleOfInfoConsent === false) {\n                return false;\n            } else {\n                return !isOptInJurisdiction; // false for opt-in, true for opt-out\n            }\n        }\n    } catch (error) {\n        console.warn('❌ [checkAttributionConsent] Failed to check consent:', error);\n    }\n\n    // Fallback: allow attribution if consent check fails\n    return true;\n};\n\nconst uniqueFacebookEvents = (pixelEvents: FacebookPixelEvent[]): FacebookPixelEvent[] => {\n    const uniqueEvents = Array.from(\n        new Map(\n            pixelEvents.map((item) => [`${item.pixelId}-${item.facebookEventName}`, item]),\n        ).values(),\n    );\n\n    return uniqueEvents;\n};\n\nconst getFacebookEventNames = (\n    eventbriteEventName: string,\n    trackingConfig?: TrackingBeacons,\n): FacebookPixelEvent[] => {\n    try {\n        if (!trackingConfig || !trackingConfig['Facebook Pixel']) {\n            console.warn('⚠️ [getFacebookEventNames] No Facebook Pixel data found');\n            return [];\n        }\n\n        const facebookPixelData = trackingConfig['Facebook Pixel'];\n\n        // Filter to only Facebook pixels and check for event mappings\n        const facebookPixelEvents: FacebookPixelEvent[] = [];\n\n        facebookPixelData.forEach((pixel) => {\n            // Always add the default FB pixel events\n            if (eventbriteEventName === 'event_listing') {\n                facebookPixelEvents.push({\n                    pixelId: pixel.pixelId,\n                    facebookEventName: 'PageView',\n                });\n            } else if (eventbriteEventName === 'event_order_confirmation') {\n                facebookPixelEvents.push({\n                    pixelId: pixel.pixelId,\n                    facebookEventName: 'Purchase',\n                });\n            }\n\n            if (pixel.events && pixel.events[eventbriteEventName]) {\n                const facebookEventName = pixel.events[eventbriteEventName];\n\n                facebookPixelEvents.push({\n                    pixelId: pixel.pixelId,\n                    facebookEventName: facebookEventName,\n                });\n            } else {\n                console.log(\n                    `⏭️ [getFacebookEventNames] No mapping found in pixel ${pixel.id} (${pixel.pixelId}) for ${eventbriteEventName}`,\n                );\n            }\n        });\n\n        const uniqueFacebookPixelEvents = uniqueFacebookEvents(facebookPixelEvents);\n\n        return uniqueFacebookPixelEvents;\n    } catch (error) {\n        console.warn('❌ [getFacebookEventNames] Error getting Facebook event names:', error);\n        return [];\n    }\n};\n\n// Helper function to send event data to attribution service\nexport const sendEventToAttributionService = async (event: AttributionEvent): Promise<void> => {\n    if (!checkAttributionConsent()) {\n        console.log(\n            '🚫 [sendEventToAttributionService] Consent not granted, skipping attribution call',\n        );\n        return;\n    }\n\n    try {\n        await bffHandler.request('/conversions-manager/api/v1/attribution/event', {\n            method: 'POST',\n            body: JSON.stringify(event),\n        });\n    } catch (error) {\n        console.warn('Attribution service error:', error);\n        // Don't throw - attribution is non-blocking\n    }\n};\n\n// Helper function to generate unique event ID for deduplication\nexport const generateEventId = (stableId: string): string => {\n    return `${stableId}_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n};\n\n// Helper function to safely access window.__SERVER_DATA__.user fields\nconst getServerUserField = (field: string): string | undefined => {\n    try {\n        const serverData = (window as any)?.__SERVER_DATA__;\n        return serverData?.user?.[field];\n    } catch (error) {\n        console.warn(`Failed to access window.__SERVER_DATA__.user.${field}:`, error);\n        return undefined;\n    }\n};\n\n// Helper function to extract cookie value from document (with SSR safety)\nconst getCookieValue = (cookieName: string): string | undefined => {\n    // Use window.document.cookie instead of document.cookie to ensure we get the mocked value\n    const cookieString = typeof window !== 'undefined' && window.document?.cookie \n        ? window.document.cookie \n        : (typeof document !== 'undefined' ? document.cookie : '');\n    \n    if (typeof window === 'undefined' || !cookieString) {\n        return undefined;\n    }\n\n    try {\n        const cookies = cookieString.split(';');\n        for (let i = 0; i < cookies.length; i++) {\n            const cookie = cookies[i]?.trim();\n            if (cookie && cookie.startsWith(`${cookieName}=`)) {\n                const value = cookie.substring(cookieName.length + 1);\n                return decodeURIComponent(value);\n            }\n        }\n    } catch (error) {\n        console.warn(`Failed to extract cookie ${cookieName}:`, error);\n    }\n\n    return undefined;\n};\n\n// Helper function to extract fbp from cookies\nconst getFbpFromCookies = (): string | undefined => {\n    return getCookieValue('_fbp');\n};\n\n// Helper function to extract user agent from navigator (with SSR safety)\nconst getUserAgent = (): string | undefined => {\n    if (typeof navigator === 'undefined' || !navigator.userAgent) {\n        return undefined;\n    }\n\n    try {\n        return navigator.userAgent;\n    } catch (error) {\n        console.warn('Failed to extract user agent:', error);\n        return undefined;\n    }\n};\n\n// Main function to send events with proper Facebook event names\nexport const sendEventToCourier = async (\n    eventbriteEventName: string,\n    eventIdForAttribution: string,\n    stableId: string,\n    organizationId: string,\n    trackingBeacons: TrackingBeacons,\n    isServerSideEnabled: boolean,\n    eventData?: unknown,\n    userData?: UserData,\n): Promise<void> => {\n    if (!isServerSideTrackingEnabledForOrganization(organizationId, isServerSideEnabled)) {\n        return;\n    }\n\n    // Get the actual Facebook event names that will be fired\n    const facebookEventsToFire = getFacebookEventNames(eventbriteEventName, trackingBeacons);\n\n    // Enhance userData with server data if needed (and available)\n    let enhancedUserData: UserData | undefined = userData;\n    if (\n        !userData ||\n        !userData.email ||\n        !userData.firstName ||\n        !userData.lastName ||\n        !userData.externalId\n    ) {\n        const serverEmail = getServerUserField('email');\n        const serverFirstName = getServerUserField('firstName');\n        const serverLastName = getServerUserField('lastName');\n        const serverPublicId = getServerUserField('publicId');\n\n        enhancedUserData = {\n            ...(userData?.email || serverEmail ? { email: userData?.email || serverEmail } : {}),\n            ...(userData?.firstName || serverFirstName\n                ? { firstName: userData?.firstName || serverFirstName }\n                : {}),\n            ...(userData?.lastName || serverLastName\n                ? { lastName: userData?.lastName || serverLastName }\n                : {}),\n            ...(userData?.zipCode ? { zipCode: userData.zipCode } : {}),\n            ...(userData?.phone ? { phone: userData.phone } : {}),\n            ...(userData?.externalId || serverPublicId\n                ? { externalId: userData?.externalId || serverPublicId }\n                : {}),\n        };\n    }\n\n    // Extract fbp and user_agent for all events\n    const fbp = getFbpFromCookies();\n    const userAgent = getUserAgent();\n\n    // Send each Facebook event to attribution service\n    for (const facebookEventToFire of facebookEventsToFire) {\n        const eventTime = `${Math.floor(Date.now() / 1000)}`;\n        const eventSourceUrl = window?.location.href;\n\n        sendEventToAttributionService({\n            event_type: facebookEventToFire.facebookEventName, // Use actual Facebook event name\n            event_time: eventTime,\n            event_id: eventIdForAttribution,\n            event_source_url: eventSourceUrl,\n            stable_id: stableId,\n            org_id: organizationId,\n            pixel_id: facebookEventToFire.pixelId,\n            fbp,\n            user_agent: userAgent,\n            event_data: eventData,\n            user_data: enhancedUserData,\n        });\n    }\n};\n","import { fetchEB } from '@eventbrite/legacy-infra.http';\n\nexport class BffRequestHandler {\n    private baseUrl: string;\n\n    constructor(baseUrl: string = '') {\n        this.baseUrl = baseUrl;\n    }\n\n    async request<T = any>(url: string, options: RequestInit = {}): Promise<T> {\n        // Construct the full path - fetchEB will handle default headers and CSRF token\n        // Routes are for conversions-manager-webapp which doesn't use the /e basePath\n        const fullPath = `${this.baseUrl}${url}`;\n        try {\n            const response = await fetchEB(fullPath, options);\n            return (await response.json()) as T;\n        } catch (error) {\n            throw error;\n        }\n    }\n}\n\n","import { useCallback, useEffect } from 'react';\nimport {\n    ClickDataInput,\n    checkAndSavePendingClick,\n    sendClickDataToAttributionService,\n    storePendingClickData,\n    storePendingClickInLocalStorage,\n} from '../clickTracking';\nimport {\n    deleteAttributionIDInLocalStorage,\n    generateUUID,\n    getAttributionIDFromLocalStorage,\n    isServerSideTrackingEnabledForOrganization,\n    setAttributionIDInLocalStorage,\n} from '../utils/index';\nimport { useTranscendConsent } from './useTranscendConsent';\n\nexport const useAttributionClickTracking = () => {\n    const { canStoreAttributionData, isOptInJurisdiction, isConsentDeci