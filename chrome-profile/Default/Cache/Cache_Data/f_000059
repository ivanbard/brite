arget.contains(this.paneContent.current)) {\n            this.props.onPaneClickOutside?.(e);\n        }\n    }\n\n    componentDidUpdate() {\n        this.setState({\n            offsetBottom: this.props.offsetBottom || 0,\n        });\n    }\n\n    render() {\n        const {\n            children,\n            customWrapperClassname,\n            customPaneClassname,\n            customPaneContentClassname,\n            isPaneOpen,\n            pane,\n            paneAriaHidden,\n            paneInteraction,\n        } = this.props;\n\n        const paneClasses = classNames(\n            styles.edsCollapsiblePaneLayoutPane,\n            {\n                [styles.edsCollapsiblePaneLayoutPaneOpen as string]: isPaneOpen,\n                [styles.edsCollapsiblePaneLayoutPaneAsModal as string]:\n                    paneInteraction === PaneLayoutInteractionType.asModal,\n            },\n            customPaneClassname,\n        );\n\n        const paneContentClasses = classNames(\n            styles.edsCollapsiblePaneLayoutPaneContent,\n            {\n                [styles.edsCollapsiblePaneLayoutPaneContentOffset as string]:\n                    !!this.props.offsetBottom &&\n                    paneInteraction === PaneLayoutInteractionType.asModal,\n            },\n            customPaneContentClassname,\n        );\n\n        const paneWrapper = pane ? (\n            <div\n                className={paneClasses}\n                data-spec=\"eds-collapsible-pane-layout-pane\"\n                onClick={this.handlePaneClick.bind(this)}\n            >\n                <div\n                    className={paneContentClasses}\n                    ref={this.paneContent}\n                    style={{ bottom: this.state?.offsetBottom }}\n                >\n                    {pane}\n                </div>\n            </div>\n        ) : null;\n\n        const contentClasses = classNames(styles.edsCollapsiblePaneLayoutContent, {\n            [styles.edsCollapsiblePaneLayou