              />\n            </header>\n        );\n    }\n\n    return component;\n};\n\nconst HeaderAction = ({\n    headerActionIconType,\n    headerActionIconTypeClassName,\n    headerActionTitle,\n    onHeaderAction,\n}) => {\n    let component: React.ReactElement | null = null;\n\n    if (headerActionIconType) {\n        const headerActionIconWrapperClassNames = classNames(\n            styles.edsModalSecondaryHeaderAction,\n            headerActionIconTypeClassName,\n        );\n        component = (\n            <div className={headerActionIconWrapperClassNames}>\n                <IconButton\n                    data-automation=\"modal-header-action-button\"\n                    data-spec=\"secondary-header-action\"\n                    onClick={onHeaderAction}\n                    iconType={headerActionIconType}\n                    title={headerActionTitle}\n                />\n            </div>\n        );\n    }\n\n    return component;\n};\n\nconst TitleHeader = ({\n    hideDivider,\n    secondaryTitle,\n    secondaryTitleClassName,\n    title,\n    titleClassName,\n}) => {\n    const divider = !hideDivider ? (\n        <div className={styles.edsModalTitleSpacing}>\n            <Divider />\n        </div>\n    ) : null;\n\n    return title ? (\n        <div className={classNames(styles.edsModalTitleContainer, styles.edsModalTitleSpacing)}>\n            <h2\n                id={MODAL_TITLE_ID}\n                className={classNames(\n                    styles.edsModalTitle,\n                    'eds-text-color--grey-800',\n                    titleClassName,\n                )}\n                data-spec=\"eds-modal__title\"\n                data-testid=\"eds-modal__title\"\n            >\n                {title}\n            </h2>\n            {secondaryTitle && (\n                <span\n                    className={classNames(\n                        styles.edsModalSecondaryTitle,\n                        'eds-text-color--grey-600',\n                        secondaryTitleClassName,\n                    )}\n                    data-spec=\"eds-modal__secondary-title\"\n                    data-testid=\"eds-modal__secondary-title\"\n                >\n                    {secondaryTitle}\n                </span>\n            )}\n            {divider}\n        </div>\n    ) : null;\n};\n\nconst Illustration = ({ illustration }) => {\n    let component: React.ReactElement | null = null;\n\n    if (illustration) {\n        component = <div className={styles.edsModalIllustration}>{illustration}</div>;\n    }\n\n    return component;\n};\n\nconst PrimaryButton = ({\n    onPrimaryAction,\n    primaryText,\n    primaryType,\n    primarySize,\n    primaryAttributes,\n    primaryIsLoading,\n    primaryIsDisabled,\n    primaryKeepDisabledStyleWhileLoading,\n}) => {\n    let component: React.ReactElement | null = null;\n    const automationSelector = 'eds-modal__primary-button';\n\n    if (primaryText) {\n        component = (\n            <Button\n                {...primaryAttributes}\n                onClick={onPrimaryAction}\n                style={primaryType}\n                disabled={primaryIsDisabled}\n                keepDisabledStyleWhileLoading={primaryKeepDisabledStyleWhileLoading}\n                data-spec={automationSelector}\n                data-automation={automationSelector}\n                isLoading={primaryIsLoading}\n                size={primarySize}\n            >\n                {primaryText}\n            </Button>\n        );\n    }\n\n    return component;\n};\n\nconst SecondaryButton = ({\n    onSecondaryAction,\n    secondaryText,\n    secondaryAttributes,\n    secondaryType,\n    secondaryIsDisabled,\n    secondaryIsLoading,\n}) => {\n    let component: React.ReactElement | null = null;\n\n    if (secondaryText) {\n        component = (\n            <div className=\"eds-l-mar-right-4\">\n                <Button\n                    {...secondaryAttributes}\n                    onClick={onSecondaryAction}\n                    style={secondaryType}\n                    disabled={secondaryIsDisabled}\n                    isLoading={secondaryIsLoading}\n                    data-spec=\"eds-modal__secondary-button\"\n                >\n                    {secondaryText}\n                </Button>\n            </div>\n        );\n    }\n\n    return component;\n};\n\nconst TertiaryButton = ({ onTertiaryAction, tertiaryNode }) => {\n    let component: React.ReactElement | null = null;\n\n    if (tertiaryNode) {\n        component = onTertiaryAction ? (\n            <Button\n                onClick={onTertiaryAction}\n                style=\"none\"\n                __containerClassName={styles.edsModalButtonBarTertiary}\n            >\n                {tertiaryNode}\n            </Button>\n        ) : (\n            <div className={styles.edsModalButtonBarTertiary}>{tertiaryNode}</div>\n        );\n    }\n\n    return component;\n};\n\n/**\n * When there is a message to display in the button bar. returns the requisite markup.\n * When there is no message, returns null.\n *\n * @param {String} message - If null or undefined, the component is null\n * @param {Boolean} hasBlockButton\n * @param {String[]} customClassNames- Custom class names to add to the root node of this component (optional, defaults to [])\n */\nconst ButtonBarMessage = ({\n    message,\n    hasBlockButton,\n    customClassnames = [],\n}: {\n    message: string;\n    hasBlockButton: boolean;\n    customClassnames: string[];\n}) => {\n    let component: React.ReactElement | null = null;\n    let messageClasses;\n    if (message) {\n        messageClasses = classNames(\n            styles.edsModalMessage,\n            'eds-text-bs',\n            'eds-text-color--ui-500',\n            ...customClassnames,\n            {\n                [styles.edsModalMessageRight as string]: !hasBlockButton,\n            },\n        );\n\n        component = <div className={messageClasses}>{message}</div>;\n