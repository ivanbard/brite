er = await sdkRequest('/api/v3/users/me/');\n    return user;\n};\n","import { useEffect, useState } from 'react';\nimport { getUser } from '../api';\nimport { UserEmail } from '../types';\n\n/**\n * @name useUserData\n * @description if authenticated, gets the current user via\n * the API on mount and returns the user object.\n * @param isAuthenticated {boolean} determining if the user is authenticated\n */\nexport const useUserData = (isAuthenticated?: boolean | undefined) => {\n    const [userData, setUserData] = useState<any>({});\n\n    useEffect(() => {\n        if (isAuthenticated) {\n            const getUserData = async () => {\n                try {\n                    const userData = await getUser();\n                    setUserData(userData);\n                } catch {\n                    // expect failure if user isn't logged in\n                    // and handle within calling function\n                }\n            };\n\n            getUserData();\n        }\n    }, [isAuthenticated]);\n\n    return {\n        ...userData,\n        primaryEmail:\n            userData?.emails?.find((email: UserEmail) => email.primary === true)\n                .email || '',\n    };\n};\n","import React from 'react';\nimport { useUserData } from '../hooks';\nimport { User } from '../types';\n\nexport const UserContext = React.createContext<Partial<User> | null>(null);\n\ninterface UserProviderProps {\n    isAuthenticated?: boolean;\n}\n\nexport const UserProvider = (\n    props,\n) => {\n    const userData = useUserData(props.isAuthenticated);\n\n    return (\n        <UserContext.Provider value={userData}>\n            {props.children}\n        </UserContext.Provider>\n    );\n};\n","/**\n * @name isValidEmail\n * @description lightweight helper that tests provided email\n * string for validity and returns boolean result\n * @param email {string}\n * @returns boolean\n */\n\nexport const isValidEmail = (email?: string) =>\n    /^(([^<>()[\\]\\\\.,;:\\s@\\\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/.test(\n        email || '',\n    );\n","import { useIntl } from 'react-intl';\nimport { Dispatch, SetStateAction, useContext, useState } from 'react';\nimport { UserContext } from '../context';\nimport { isValidEmail } from '../util';\n\ninterface Field {\n    value?: string;\n    error: string;\n}\n\n/**\n * @name useForm\n * @description custom hook exposing functionality required by report event form\n * @returns:\n * - fields {object}: a representation of field state, errors and requirements\n * - helpers {object}: contains `useState`-derived setter methods to manage form state and form validation\n */\nexport const useForm = () => {\n    const intl = useIntl();\n    const user = useContext(UserContext);\n    const [email, setEmail] = useState<Field>({\n        value: user?.primaryEmail,\n        error: '',\n    });\n    const [description, setDescription] = useState<Field>({\n        value: '',\n        error: '',\n    });\n    const [required, setRequired] = useState<{\n        email: boolean;\n        description: boolean;\n    }>({\n        email: true,\n        description: true,\n    });\n\n    const validateField = (field: string) => {\n        const validate: {\n            [key: string]: { result: boolean; message: string };\n        } = {\n            email: {\n                result:\n                    required.email &&\n                    (!isValidEmail(email.value) || email.value === ''),\n                message: intl.formatMessage({\n                    id: 'Email is empty or invalid.',\n                    defaultMessage: 'Email is empty or invalid.',\n                }),\n            },\n            description: {\n                result: required.description && description.value === '',\n                message: intl.formatMessage({\n                    id: 'Description is empty.',\n                    defaultMessage: 'Description is empty.',\n                }),\n            },\n        };\n\n        const set: {\n            [key: string]: {\n                helper: Dispatch<SetStateAction<Field>>;\n                field: Field;\n            };\n        } = {\n            email: {\n                helper: setEmail,\n                field: email,\n            },\n            description: {\n                helper: setDescription,\n                field: description,\n            },\n        };\n\n        const error = validate[field];\n\n        if (error?.result) {\n            const setter = set[field];\n            if (setter) {\n                setter.helper({\n                    ...setter.field,\n                    error: error.message,\n                });\n            }\n        } else {\n            const setter = set[field];\n            if (setter) {\n                setter.helper({\n                    ...setter.field,\n                    error: '',\n                });\n            }\n        }\n\n        return error?.result || false;\n    };\n\n    return {\n        fields: {\n            email,\n            description,\n            required: {\n                email: required.email,\n                description: required.description,\n            },\n            userId: user?.id,\n        },\n        helpers: {\n            validateField,\n            setters: {\n                setEmail,\n                setDescription,\n                setRequired,\n            },\n        },\n    };\n};\n","export const EU_COUNTRIES_CODES = [\n    //codes\n    'AT', // 'Austria'\n    'BE', // 'Belgium'\n    'BG', // 'Bulgaria'\n    'HR', // 'Croatia'\n    'CY', // 'Republic of Cyprus'\n    'CZ', // 'Czech Republic'\n    'DK', // 'Denmark'\n    'EE', // 'Estonia'\n    'FI', // 'Finland'\n    'FR', // 'France'\n    'DE', // 'Germany'\n    'GR', // 'Greece'\n    'HU', // 'Hungary'\n    'IE', // 'Ireland'\n    'IT', // 'Italy'\n    'LV', // 'Latvia'\n    'LT', // 'Lithuania'\n    'LU', // 'Luxembourg'\n    'MT', // 'Malta'\n    'NL', // 'Netherlands'\n    'PL', // 'Poland'\n    'PT', // 'Portugal'\n    'RO', // 'Romania'\n    'SK', // 'Slovakia'\n    'SI', // 'Slovenia'\n    'ES', // 'Spain'\n    'SE', // 'Sweden'\n];\n\nexport const EU_TLDS = [\n    'ie', // 'Ireland'\n    'fr', // 'France'\n    'es', // 'Spain'\n    'it', // 'Italy'\n    'pt', // 'Portugal'\n    'de', // 'Germany'\n    'nl', // 'Netherlands'\n    'at', // 'Austria'\n    'be', // 'Belgium'\n    'dk', // 'Denmark'\n    'fi', // 'Finland'\n    'se', // 'Sweden'\n];\n\nexport const EU_COUNTRIES_NAMES = [\n    'Austria',\n    'Belgium',\n    'Bulgaria',\n    'Croatia',\n    'Cyprus',\n    'Czech Republic',\n    'Denmark',\n    'Estonia',\n    'Finland',\n    'France',\n    'Germany',\n    'Greece',\n    'Hungary',\n    'Ireland',\n    'Italy',\n    'Latvia',\n    'Lithuania',\n    'Luxembourg',\n    'Malta',\n    'Netherlands',\n    'Poland',\n    'Portugal',\n    'Romania',\n    'Slovakia',\n    'Slovenia',\n    'Spain',\n    'Sweden',\n];\n\n// Add UK-specific constants\nexport const UK_COUNTRIES_CODES = [\n    'GB', // Great Britain / United Kingdom\n    'UK', // United Kingdom\n];\n\nexport const UK_TLDS = ['co.uk'];\n\nexport const UK_COUNTRIES_NAMES = ['United Kingdom'];\n\nexport const MULTIPART_TLDS = ['co.uk'];\n\n// -----------------------------------------------------------------------------\n// Scalable Regulation helper\n// -----------------------------------------------------------------------------\n\ninterface RegulationConfig {\n    label: string; // e.g. \"EU DSA\", \"UK OSA\"\n    eventLocation: readonly string[];\n    tlds: readonly string[];\n    ipLocation: readonly string[];\n}\n\nexport const REGULATIONS: RegulationConfig[] = [\n    {\n        label: 'EU DSA',\n        eventLocation: EU_COUNTRIES_CODES,\n        tlds: EU_TLDS,\n        ipLocation: EU_COUNTRIES_NAMES,\n    },\n    {\n        label: 'UK OSA',\n        eventLocation: UK_COUNTRIES_CODES,\n        tlds: UK_TLDS,\n        ipLocation: UK_COUNTRIES_NAMES,\n    },\n];\n","import {\n    MULTIPART_TLDS,\n    REGULATIONS,\n} from '../components/ReportEventForm/ReportRadios/constants';\n\nexport { MULTIPART_TLDS, REGULATIONS };\n\n/**\n * Returns the effective top-level domain (TLD) of the current `window.location`.\n * Handles multi-segment TLDs (e.g. \"co.uk\")\n */\nexport const getTld = (): string => {\n    let tld = '';\n\n    if (typeof window !== 'undefined') {\n        const host = window.location.origin\n            .replace(/^https?:\\/\\//, '')\n            .split('/')[0];\n        // Break the hostname into its dot-separated segments (e.g. [\"www\",\"eventbrite\",\"co\",\"uk\"])\n        const hostSegments = host?.split('.') ?? [];\n        // Attempt to match multipart TLDs first (e.g. \"co.uk\"). If none match, fall back to the last segment.\n        const multipartTLD = hostSegments.slice(-2).join('.') ?? '';\n        tld = MULTIPART_TLDS.includes(multipartTLD)\n            ? multipartTLD\n            : hostSegments.pop() || '';\n    }\n\n    return tld;\n};\n\n/*\n * Computes the applicable regulation flag (e.g. \"EU DSA\", \"UK OSA\") for the\n * given event country and user-side information.\n *\n * @param country       Country code for the event location\n * @param userCountry   Country name inferred from the user’s IP\n * @returns The regulation flag label or an empty string if none apply.\n */\nexport const computeRegulationLabel = (\n    country: string,\n    userCountry: string,\n): string => {\n    const tld = getTld();\n    const regulation = REGULATIONS.find(\n        ({ eventLocation, tlds, ipLocation }) =>\n            eventLocation.includes(country) ||\n            tlds.includes(tld) ||\n            ipLocation.includes(userCountry),\n    );\n\n    return regulation ? regulation.label : '';\n};\n","import { Button } from '@eventbrite/marmalade';\nimport { InputField } from '@eventbrite/legacy-eds.input-field';\nimport { useIntl } from 'react-intl';\nimport React, { useEffect, useMemo } from 'react';\nimport styles from './ReportEventFormFields.module.scss';\nimport { reportEvent } from '../../api';\nimport {\n    useErrorDisplayContext,\n    usePaginationDisplayContext,\n    useRadioContext,\n} from '../../context';\nimport { useForm } from '../../hooks';\nimport { Pages } from '../../types';\nimport { computeRegulationLabel } from '../../util';\n\nexport const ReportEventFormFields = (props: {\n    eventId: string;\n    eventName: string;\n    eventUrl: string;\n    country: string;\n    userCountry: string;\n}) => {\n    const intl = useIntl();\n    const { eventId, eventName, eventUrl, country, userCountry } = props;\n    const { fields, helpers } = useForm();\n    const { selection } = useRadioContext();\n    const { setError } = useErrorDisplayContext();\n    const { setPage } = usePaginationDisplayContext();\n    const emailRequired = selection === 'reason_unauthorized_event';\n    const descriptionRequired = [\n        'reason_unauthorized_event',\n        'reason_harmful',\n        'reason_canceled_event',\n    ].includes(selection || '');\n\n    const reportHelperText: { [key: string]: string } = useMemo(() => ({\n        reason_unauthorized_event: intl.formatMessage({\n            id: 'This event is a copy of another event, is reselling tickets, or the tickets I purchased were not valid for entry. Include the URL for the authorized event and your relationship to the event.',\n            defaultMessage: 'This event is a copy of another event, is reselling tickets, or the tickets I purchased were not valid for entry. Include the URL for the authorized event and your relationship to the event.',\n        }),\n        reason_harmful: intl.formatMessage({\n            id: 'Ex: bullying, harmful misinformation',\n            defaultMessage: 'Ex: bullying, harmful misinformation',\n        }),\n        reason_offensive_content: intl.formatMessage({\n            id: 'Ex: drugs, gambling',\n            defaultMessage: 'Ex: drugs, gambling',\n        }),\n        reason_explicit: intl.formatMessage({\n            id: 'Ex: graphic nudity, pornography',\n            defaultMessage: 'Ex: graphic nudity, pornography',\n        }),\n        reason_hateful: intl.formatMessage({\n            id: 'Ex: threats or intimidation of a protected group',\n            defaultMessage: 'Ex: threats or intimidation of a protected group',\n        }),\n        reason_extremism: intl.formatMessage({\n            id: 'Ex: graphic violence, dangerous organizations',\n            defaultMessage: 'Ex: graphic violence, dangerous organizations',\n        }),\n        reason_canceled_event: intl.formatMessage({\n            id: 'The event was canceled, postponed, rescheduled, or did not deliver the advertised experience. Include details about how you were informed of any changes and how the event was different than what was advertised.',\n            defaultMessage: 'The event was canceled, postponed, rescheduled, or did not deliver the advertised experience. Include details about how you were informed of any changes and how the event was different than what was advertised.',\n        }),\n        report_default: intl.formatMessage({\n            id: 'Additional details are required for all reported issues.',\n            defaultMessage: 'Additional details are required for all reported issues.',\n        }),\n        reason_spam_behavior: intl.formatMessage({\n            id: \"The listing is not advertising an event (ex: it promotes a product or service, or it's unclear what is being advertised), is listed repeatedly and is interfering with search results, or it includes deceptive or exaggerated claims about the success of using the advertised services.\",\n            defaultMessage: \"The listing is not advertising an event (ex: it promotes a product or service, or it's unclear what is being advertised), is listed repeatedly and is interfering with search results, or it includes deceptive or exaggerated claims about the success of using the advertised services.\",\n        }),\n        reason_payment_outside: intl.formatMessage({\n            id: 'This event asks for payment at the door or an alternate payment platform such as PayPal, CashApp, or Venmo.',\n            defaultMessage: 'This event asks for payment at the door or an alternate payment platform such as PayPal, CashApp, or Venmo.',\n        }),\n    }), [intl]);\n\n    useEffect(() => {\n        helpers.setters.setRequired({\n            email: emailRequired,\n            description: descriptionRequired,\n        });\n\n        if (!fields.required.email)\n            helpers.setters.setEmail({ ...fields.email, error: '' });\n        if (!fields.required.description)\n            helpers.setters.setDescription({\n                ...fields.description,\n                error: '',\n            });\n    }, []);\n\n    const handleSubmit = (event: React.MouseEvent<HTMLElement>) => {\n        event.preventDefault();\n        let emailError = false;\n        let descriptionError = false;\n\n        if (fields.required.email) emailError = helpers.validateField('email');\n        if (fields.required.description)\n            descriptionError = helpers.validateField('description');\n\n        if (!emailError && !descriptionError) {\n            const regulationLabel = computeRegulationLabel(\n                country,\n                userCountry,\n            );\n            reportEvent({\n                userId: fields.userId,\n                email: fields.email.value || '',\n                eventId,\n                reportMessage: fields.description.value || '',\n                reportReason: selection || 'reason_other',\n                eventUrl,\n                eventName,\n                regulation: regulationLabel,\n            })\n                .then((response: Response) => response.json())\n                .then((status) => {\n                    if (status.message === 'success') {\n                        setPage?.(Pages.success);\n                    } else {\n                        throw new Error('Error submitting report.');\n                    }\n                })\n                .catch(() => {\n                    setError?.(true);\n                });\n        }\n    };\n\n    return (\n        <>\n            <section className={styles.emailSection}>\n                <InputField\n                    id=\"report-email\"\n                    data-testid=\"report-email-input\"\n                    label={intl.formatMessage({\n                        id: 'Your Email',\n                        defaultMessage: 'Your Email',\n                    })}\n                    placeholder={intl.formatMessage({\n                        id: 'name@example.com',\n                        defaultMessage: 'name@example.com',\n                    })}\n                    type=\"email\"\n                    onChange={(text: string) =>\n                        helpers.setters.setEmail({\n                            ...fields.email,\n                            value: text,\n                        })\n                    }\n                    value={fields.email.value}\n                    hasError={!!fields.email.error}\n                    required={fields.required.email}\n                    style=\"static\"\n                />\n                {fields.email.error && (\n                    <p className={styles.errorText}>\n                        {fields.email.error}\n                    </p>\n                )}\n            </section>\n            <section className={styles.descriptionSection}>\n                <InputField\n                    id=\"report-description\"\n                    data-testid=\"report-description-input\"\n                    label={intl.formatMessage({\n                        id: 'Description',\n                        defaultMessage: 'Description',\n                    })}\n                    placeholder={\n                        reportHelperText[selection || 'report_default']\n                    }\n                    onChange={(text: string) =>\n                        helpers.setters.setDescription({\n                            ...fields.description,\n                            value: text,\n                        })\n                    }\n                    value={fields.description.value}\n                    hasError={!!fields.description.error}\n                    required={fields.required.description}\n                    isMultiline={true}\n                    style=\"static\"\n                    type=\"text\"\n                />\n                {fields.description.error && (\n                    <p className={styles.errorText}>\n                        {fields.description.error}\n                    </p>\n                )}\n            </section>\n            <Button\n                data-testid=\"report-event-submit\"\n                onClick={handleSubmit}\n                variant=\"primary\"\n                className={styles.submitButton}\n            >\n                {intl.formatMessage({\n                    id: 'Submit Report',\n                    defaultMessage: 'Submit Report',\n                })}\n            </Button>\n            <Button\n                data-testid=\"report-event-back\"\n                onClick={() => {\n                    setPage?.(Pages.intro);\n                }}\n                variant=\"secondary\"\n                className={styles.backButton}\n            >\n                {intl.formatMessage({\n                    id: 'Go back',\n                    defaultMessage: 'Go back',\n                })}\n            </Button>\n        </>\n    );\n};\n","import { defineMessages } from 'react-intl';\n\nexport const messages = defineMessages({\n    'here': {\n        id: 'here',\n        defaultMessage: 'here',\n    },\n});\n\n","import React from 'react';\n\n/**\n * Inserts a React element (typically a link) into a message string by replacing\n * the specified link text with the provided link element.\n *\n * This utility is used to convert messages with placeholder text (e.g., \"{link}\")\n * that have been formatted with intl.formatMessage() into JSX that includes\n * interactive elements like anchor tags.\n *\n * @param message - The formatted message string containing the link text\n * @param linkText - The text in the message that should be replaced with the link element\n * @param linkElement - The React element (typically an <a> tag) to insert\n * @returns A React node with the link element inserted, or the original message if linkText is not found\n *\n * @example\n * const message = intl.formatMessage({ id: 'Click {link} to learn more' }, { link: 'here' });\n * const link = <a href=\"/help\">here</a>;\n * const result = insertLinkIntoMessage(message, 'here', link);\n * // Returns: ['Click ', <a href=\"/help\">here</a>, ' to learn more']\n */\nexport const insertLinkIntoMessage = (\n    message: string,\n    linkText: string,\n    linkElement: React.ReactElement\n): React.ReactNode => {\n    if (!linkText) {\n        return message;\n    }\n    const parts = message.split(linkText);\n    if (parts.length === 1) {\n        return message;\n    }\n    const nodes: React.ReactNode[] = [];\n    parts.forEach((part, idx) => {\n        nodes.push(part);\n        if (idx < parts.length - 1) {\n            nodes.push(React.cloneElement(linkElement, { key: `link-${idx}` }));\n        }\n    });\n    return nodes;\n};\n\n","import { useIntl } from 'react-intl';\nimport React from 'react';\nimport { messages } from '../../../i18n/messages';\nimport { insertLinkIntoMessage } from '../../../util';\nimport styles from './RefundDisplay.module.scss';\n\nexport const RefundDisplay = (props: { helpCenterLanguage: string }) => {\n    const { helpCenterLanguage } = props;\n    const intl = useIntl();\n    const refundUrl = `/help/${helpCenterLanguage}/articles/721549/can-i-get-a-refund/`;\n    const linkText = intl.formatMessage(messages['here']);\n    const linkTitle = intl.formatMessage({\n        id: 'Link to Requesting a Refund',\n        defaultMessage: 'Link to Requesting a Refund',\n    });\n    const link = (\n        <a\n            href={refundUrl}\n            rel=\"noopener noreferrer\"\n            target=\"_blank\"\n            title={linkTitle}\n        >\n            {linkText}\n        </a>\n    );\n    const message = intl.formatMessage(\n        {\n            id: 'Would like to request a refund? Learn more about how to request a refund {link}',\n            defaultMessage: 'Would like to request a refund? Learn more about how to request a refund {link}',\n        },\n        {\n            link: linkText,\n        }\n    );\n\n    return (\n        <p className={styles.refundText} data-testid=\"reason_refund-radio\">\n            {insertLinkIntoMessage(message, linkText, link)}.\n        </p>\n    );\n};\n","import { useIntl } from 'react-intl';\nimport React from 'react';\nimport { messages } from '../../../i18n/messages';\nimport { insertLinkIntoMessage } from '../../../util';\nimport styles from './FeedbackDisplay.module.scss';\n\nexport const FeedbackDisplay = (props: { helpCenterLanguage: string }) => {\n    const { helpCenterLanguage } = props;\n    const intl = useIntl();\n    const contactOrganizerUrl = `/help/${helpCenterLanguage}/articles/647151/how-to-contact-the-event-organizer/`;\n    const linkText = intl.formatMessage(messages['here']);\n    const linkTitle = intl.formatMessage({\n        id: 'Link to contacting the organizer',\n        defaultMessage: 'Link to contacting the organizer',\n    });\n    const link = (\n        <a\n            href={contactOrganizerUrl}\n            rel=\"noopener noreferrer\"\n            target=\"_blank\"\n            title={linkTitle}\n            aria-label={linkTitle}\n        >\n            {linkText}\n        </a>\n    );\n    const message = intl.formatMessage(\n        {\n            id: 'Questions about the online event link, event location, or event details? Have feedback about the event? Learn how to contact the event organizer {link}',\n            defaultMessage: 'Questions about the online event link, event location, or event details? Have feedback about the event? Learn how to contact the event organizer {link}',\n        },\n        {\n            link: linkText,\n        }\n    );\n\n    return (\n        <p className={styles.feedbackText} data-testid=\"reason_feedback-radio\">\n            {insertLinkIntoMessage(message, linkText, link)}.\n        </p>\n    );\n};\n","import { useIntl } from 'react-intl';\nimport React from 'react';\nimport { messages } from '../../../i18n/messages';\nimport { insertLinkIntoMessage } from '../../../util';\nimport styles from './CopyrightDisplay.module.scss';\n\nexport const CopyrightDisplay = (props: { helpCenterLanguage: string }) => {\n    const { helpCenterLanguage } = props;\n    const intl = useIntl();\n    const copyRightUrl = `/help/${helpCenterLanguage}/articles/609245/how-to-report-copyright-or-trademark-infringement/`;\n    const linkText = intl.formatMessage(messages['here']);\n    const linkTitle = intl.formatMessage({\n        id: 'Link to Reporting Copyright or Trademark Infringement',\n        defaultMessage: 'Link to Reporting Copyright or Trademark Infringement',\n    });\n    const link = (\n        <a\n            href={copyRightUrl}\n            rel=\"noopener noreferrer\"\n            target=\"_blank\"\n            title={linkTitle}\n        >\n            {linkText}\n        </a>\n    );\n    const message = intl.formatMessage(\n        {\n            id: 'Learn more about submitting a Copyright or Trademark Infringement takedown notice {link}',\n            defaultMessage: 'Learn more about submitting a Copyright or Trademark Infringement takedown notice {link}',\n        },\n        {\n            link: linkText,\n        }\n    );\n\n    return (\n        <p className={styles.copyrightText} data-testid=\"reason_copyright-radio\">\n            {insertLinkIntoMessage(message, linkText, link)}.\n        </p>\n    );\n};\n","import { useIntl } from 'react-intl';\nimport React from 'react';\nimport { insertLinkIntoMessage } from '../../../util';\nimport styles from './DSADisplay.module.scss';\n\nexport const DSADisplay = (props: {\n    eventId: string;\n    eventName: string;\n    eventUrl: string;\n}) => {\n    const { eventId, eventName, eventUrl } = props;\n    const intl = useIntl();\n    const illegalContentUrlTest = `https://ebrite-testing.nima.tremau.net/user-reports/?content.content_id=${eventId}&content.title=${eventName}&content.url=${eventUrl}&content.customerSpecific.entityId=${eventId}&content.type.id=IFRAME`;\n    const illegalContentUrlProd = `https://ebrite.nima.tremau.net/user-reports/?content.content_id=${eventId}&content.title=${eventName}&content.url=${eventUrl}&content.customerSpecific.entityId=${eventId}&content.type.id=IFRAME`;\n    const illegalContentUrl = eventUrl.includes('eventbrite')\n        ? illegalContentUrlProd\n        : illegalContentUrlTest;\n    const linkText = intl.formatMessage({\n        id: 'this form',\n        defaultMessage: 'this form',\n    });\n    const link = (\n        <a\n            href={illegalContentUrl}\n            rel=\"noopener noreferrer\"\n            target=\"_blank\"\n            title={linkText}\n        >\n            {linkText}\n        </a>\n    );\n    const message = intl.formatMessage(\n        {\n            id: 'To report other categories of prohibited or illegal content, submit {link}',\n            defaultMessage: 'To report other categories of prohibited or illegal content, submit {link}',\n            description: 'context: To report other categories of prohibited or illegal content, submit \"this form\".',\n        },\n        {\n            link: linkText,\n        }\n    );\n\n    return (\n        <p className={styles.dsaText} data-testid=\"reason_other-radio\">\n            {insertLinkIntoMessage(message, linkText, link)}.\n        </p>\n    );\n};\n","import React from 'react';\nimport { useRadioContext } from '../../context';\nimport { ReportEventFormFields } from './ReportEventFormFields';\nimport {\n    CopyrightDisplay,\n    DSADisplay,\n    FeedbackDisplay,\n    RefundDisplay,\n} from './ReportMessages';\n\nexport const ReportEventFormDisplay = (props: {\n    eventId: string;\n    eventUrl: string;\n    eventName: string;\n    helpCenterLanguage: string;\n    country: string;\n    userCountry: string;\n}) => {\n    const {\n        eventId,\n        eventUrl,\n        eventName,\n        helpCenterLanguage,\n        country,\n        userCountry,\n    } = props;\n    const { selection } = useRadioContext();\n\n    return (\n        <>\n            {selection === 'reason_refund' && (\n                <RefundDisplay helpCenterLanguage={helpCenterLanguage} />\n            )}\n            {selection === 'reason_feedback' && (\n                <FeedbackDisplay helpCenterLanguage={helpCenterLanguage} />\n            )}\n            {selection === 'reason_copyright_infringement' && (\n                <CopyrightDisplay helpCenterLanguage={helpCenterLanguage} />\n            )}\n            {selection === 'reason_other_illegal_eu_dsa' && (\n                <DSADisplay\n                    eventId={eventId}\n                    eventName={eventName}\n                    eventUrl={eventUrl}\n                />\n            )}\n            {selection !== 'reason_copyright_infringement' &&\n                selection !== 'reason_refund' &&\n                selection !== 'reason_feedback' &&\n                selection !== 'reason_other_illegal_eu_dsa' && (\n                    <ReportEventFormFields\n                        eventId={eventId}\n                        eventName={eventName}\n                        eventUrl={eventUrl}\n                        country={country}\n                        userCountry={userCountry}\n                    />\n                )}\n        </>\n    );\n};\n","import React from 'react';\nimport { useRadioContext } from '../../../context';\nimport styles from './RadioInput.module.scss';\n\nexport const RadioInput = (props: {\n    reason: string;\n    children: React.ReactNode;\n    containerClassNames?: string;\n}) => {\n    const { reason, children, containerClassNames } = props;\n    const { selection } = useRadioContext();\n\n    return (\n        <div className={containerClassNames}>\n            <input\n                type=\"radio\"\n                id={reason}\n                data-testid={`${reason}-input`}\n                value={reason}\n                name=\"reason\"\n                defaultChecked={selection === reason}\n                className={styles.radioInput}\n            />\n            <label htmlFor={reason}>{children}</label>\n        </div>\n    );\n};\n","import { useIntl } from 'react-intl';\nimport React from 'react';\nimport { computeRegulationLabel } from '../../../util';\nimport { RadioInput } from './RadioInput';\nimport styles from './ReportEventFormRadios.module.scss';\n\nconst radioClassNames = styles.radioInput;\n\nexport const ReportEventFormRadios = (props: {\n    country: string;\n    userCountry: string;\n}) => {\n    const { country, userCountry } = props;\n    const intl = useIntl();\n    const regulationLabel = computeRegulationLabel(country, userCountry);\n    const showOtherIllegalContent = regulationLabel !== '';\n    const otherIllegalContent = intl.formatMessage({\n        id: 'Other Illegal Content',\n        defaultMessage: 'Other Illegal Content',\n    });\n    const requestRefund = intl.formatMessage({\n        id: 'Request a Refund',\n        defaultMessage: 'Request a Refund',\n    });\n    const askQuestion = intl.formatMessage({\n        id: 'Ask a question or give feedback about the event',\n        defaultMessage: 'Ask a question or give feedback about the event',\n    });\n    const eventNotHappened = intl.formatMessage({\n        id: 'Event did not happen or was not as described',\n        defaultMessage: 'Event did not happen or was not as described',\n    });\n    const spamContent = intl.formatMessage({\n        id: 'Spam or misleading content',\n        defaultMessage: 'Spam or misleading content',\n    });\n    const unauthorizedEvent = intl.formatMessage({\n        id: 'Event not authorised to sell tickets or report invalid tickets',\n        defaultMessage: 'Event not authorised to sell tickets or report invalid tickets',\n    });\n    const paymentOutside = intl.formatMessage({\n        id: 'Payment required outside Eventbrite',\n        defaultMessage: 'Payment required outside Eventbrite',\n    });\n    const harmfulContent = intl.formatMessage({\n        id: 'Harmful Content',\n        defaultMessage: 'Harmful Content',\n    });\n    const regulatedContent = intl.formatMessage({\n        id: 'Regulated Content or Activities',\n        defaultMessage: 'Regulated Content or Activities',\n    });\n    const explicitContent = intl.formatMessage({\n        id: 'Sexually Explicit Content',\n        defaultMessage: 'Sexually Explicit Content',\n    });\n    const hatefulContent = intl.formatMessage({\n        id: 'Hateful Content',\n        defaultMessage: 'Hateful Content',\n    });\n    const violenceExtremism = intl.formatMessage({\n        id: 'Violence or Extremism',\n        defaultMessage: 'Violence or Extremism',\n    });\n    const copyrightInfringement = intl.formatMessage({\n        id: 'Copyright or Trademark Infringement',\n        defaultMessage: 'Copyright or Trademark Infringement',\n    });\n    const radioInputRender = showOtherIllegalContent && (\n        <RadioInput\n            reason=\"reason_other_illegal_eu_dsa\"\n            containerClassNames={radioClassNames}\n        >\n            {otherIllegalContent}\n        </RadioInput>\n    );\n    return (\n        <div className={styles.radioContainer}>\n            <RadioInput\n                reason=\"reason_refund\"\n                containerClassNames={radioClassNames}\n            >\n                {requestRefund}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_feedback\"\n                containerClassNames={radioClassNames}\n            >\n                {askQuestion}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_canceled_event\"\n                containerClassNames={radioClassNames}\n            >\n                {eventNotHappened}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_spam_behavior\"\n                containerClassNames={radioClassNames}\n            >\n                {spamContent}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_unauthorized_event\"\n                containerClassNames={radioClassNames}\n            >\n                {unauthorizedEvent}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_payment_outside\"\n                containerClassNames={radioClassNames}\n            >\n                {paymentOutside}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_harmful\"\n                containerClassNames={radioClassNames}\n            >\n                {harmfulContent}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_offensive_content\"\n                containerClassNames={radioClassNames}\n            >\n                {regulatedContent}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_explicit\"\n                containerClassNames={radioClassNames}\n            >\n                {explicitContent}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_hateful\"\n                containerClassNames={radioClassNames}\n            >\n                {hatefulContent}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_extremism\"\n                containerClassNames={radioClassNames}\n            >\n                {violenceExtremism}\n            </RadioInput>\n            <RadioInput\n                reason=\"reason_copyright_infringement\"\n                containerClassNames={radioClassNames}\n            >\n                {copyrightInfringement}\n            </RadioInput>\n            {radioInputRender}\n        </div>\n    );\n};\n","import React from 'react';\nimport { RadioGroupProvider } from '../../../context';\nimport { ReportEventFormRadios } from './ReportEventFormRadios';\n\nexport const RadioGroup = (props: {\n    children: React.ReactNode;\n    defaultSelection?: string;\n    country: string;\n    userCountry: string;\n}) => {\n    const { children, defaultSelection, country, userCountry } = props;\n\n    return (\n        <RadioGroupProvider selection={defaultSelection}>\n            <ReportEventFormRadios\n                country={country}\n                userCountry={userCountry}\n            />\n            {children}\n        </RadioGroupProvider>\n    );\n};\n","import React from 'react';\nimport { ErrorDisplayProvider } from '../../context';\nimport { ReportEventFormContent } from './ReportEventFormContent';\nimport { ReportEventFormDisplay } from './ReportEventFormDisplay';\nimport { RadioGroup } from './ReportRadios';\n\nexport const ReportEventForm = (props: {\n    eventId: string;\n    country: string;\n    eventName: string;\n    eventUrl: string;\n    helpCenterLanguage: string;\n    userCountry: string;\n}) => {\n    const {\n        eventId,\n        country,\n        eventName,\n        eventUrl,\n        helpCenterLanguage,\n        userCountry,\n    } = props;\n\n    return (\n        <ErrorDisplayProvider error={false}>\n            <ReportEventFormContent>\n                <RadioGroup\n                    defaultSelection=\"reason_refund\"\n                    country={country}\n                    userCountry={userCountry}\n                >\n                    <ReportEventFormDisplay\n                        eventId={eventId}\n                        eventName={eventName}\n                        eventUrl={eventUrl}\n                        helpCenterLanguage={helpCenterLanguage}\n                        country={country}\n                        userCountry={userCountry}\n                    />\n                </RadioGroup>\n            </ReportEventFormContent>\n        </ErrorDisplayProvider>\n    );\n};\n","import { Button } from '@eventbrite/marmalade';\nimport { useIntl } from 'react-intl';\nimport React from 'react';\nimport { insertLinkIntoMessage } from '../../util';\nimport styles from './ReportEventIntro.module.scss';\n\nexport const ReportEventIntro = (props: { onClick: () => void }) => {\n    const { onClick } = props;\n    const intl = useIntl();\n    const startReportMessage = intl.formatMessage({\n        id: 'Start Report',\n        defaultMessage: 'Start Report',\n    });\n    const communityGuidelinesText = intl.formatMessage({\n        id: 'Community Guidelines',\n        defaultMessage: 'Community Guidelines',\n    });\n    const communityGuidelinesLink = (\n        <a\n            href=\"https://www.eventbrite.com/support/articles/en_US/Troubleshooting/community-guidelines\"\n            rel=\"noopener noreferrer\"\n            target=\"_blank\"\n            title={communityGuidelinesText}\n        >\n            {communityGuidelinesText}\n        </a>\n    );\n    const communityGuidelinesMessage = intl.formatMessage(\n        {\n            id: 'Our {communityGuidelinesLink} describe the sort of content we prohibit on Eventbrite. If you suspect an event may be in violation, you can report it to us so we can investigate.',\n            defaultMessage: 'Our {communityGuidelinesLink} describe the sort of content we prohibit on Eventbrite. If you suspect an event may be in violation, you can report it to us so we can investigate.',\n            description: 'context: Our \"Community Guidelines\" describe the sort of content we prohibit on Eventbrite.',\n        },\n        {\n            communityGuidelinesLink: communityGuidelinesText,\n        }\n    );\n    const contactOrganizerText = intl.formatMessage({\n        id: 'contact the organizer',\n        defaultMessage: 'contact the organizer',\n        description: 'context: we encourage you to first \"contact the organizer\" directly.'\n    });\n    const contactOrganizerLink = (\n        <a\n            href=\"https://www.eventbrite.com/support/articles/en_US/How_To/how-to-contact-the-event-organizer\"\n            rel=\"noopener noreferrer\"\n            target=\"_blank\"\n            title={contactOrganizerText}\n        >\n            {contactOrganizerText}\n        </a>\n    );\n    const contactOrganizerMessage = intl.formatMessage(\n        {\n            id: 'If you have a question about an event, need to resolve a dispute, or would like to request a refund, we encourage you to first {contactOrganizerLink} directly.',\n            defaultMessage: 'If you have a question about an event, need to resolve a dispute, or would like to request a refund, we encourage you to first {contactOrganizerLink} directly.',\n        },\n        {\n            contactOrganizerLink: contactOrganizerText,\n        }\n    );\n    const dangerMessage = intl.formatMessage({\n        id: 'If you or someone else is in imminent danger as a result of an event listing, please contact your local law enforcement agency for assistance.',\n        defaultMessage: 'If you or someone else is in imminent danger as a result of an event listing, please contact your local law enforcement agency for assistance.',\n    });\n    return (\n        <div className={styles.introContainer}>\n            <p>\n                {insertLinkIntoMessage(\n                    communityGuidelinesMessage,\n                    communityGuidelinesText,\n                    communityGuidelinesLink\n                )}\n            </p>\n            <ul className={styles.introList}>\n                <li className={styles.introListItem}>\n                    {insertLinkIntoMessage(\n                        contactOrganizerMessage,\n                        contactOrganizerText,\n                        contactOrganizerLink\n                    )}\n                </li>\n                <li>{dangerMessage}</li>\n            </ul>\n            <Button\n                onClick={onClick}\n                variant='primary'\n                className={styles.introButton}\n            >\n                {startReportMessage}\n            </Button>\n        </div>\n    );\n};\n","import { useIntl } from 'react-intl';\nimport React from 'react';\nimport styles from './ReportEventSuccess.module.scss';\n\nexport const ReportEventSuccess = () => {\n    const intl = useIntl();\n    const successMessage = intl.formatMessage({\n        id: 'We have flagged this event for investigation. If you provided contact information, we may follow up with you as needed.',\n        defaultMessage: 'We have flagged this event for investigation. If you provided contact information, we may follow up with you as needed.',\n    });\n    return (\n        <div data-testid=\"report-success-content\">\n            <p className={styles.successMessage}>{successMessage}</p>\n        </div>\n    );\n};\n","import React from 'react';\nimport { usePaginationDisplayContext } from '../../context';\nimport { useLocationData } from '../../hooks';\nimport { Pages } from '../../types';\nimport { ReportEventForm } from '../ReportEventForm';\nimport { ReportEventIntro } from './ReportEventIntro';\nimport { ReportEventSuccess } from './ReportEventSuccess';\n\ninterface ReportEventContentProps {\n    eventId: string;\n    country: string;\n    eventUrl: string;\n    eventName: string;\n    helpCenterLanguage: string;\n}\n\nexport const ReportEventContent: React.FC<ReportEventContentProps> = (props) => {\n    const { eventId, country, eventUrl, eventName, helpCenterLanguage } = props;\n    const { page, setPage } = usePaginationDisplayContext();\n    const userCountry = useLocationData();\n    return (\n        <>\n            {page === Pages.intro && (\n                <ReportEventIntro onClick={() => setPage?.(Pages.form)} />\n            )}\n            {page === Pages.form && (\n                <ReportEventForm\n                    eventId={eventId}\n                    country={country}\n                    eventName={eventName}\n                    eventUrl={eventUrl}\n                    helpCenterLanguage={helpCenterLanguage}\n                    userCountry={userCountry}\n                />\n            )}\n            {page === Pages.success && <ReportEventSuccess />}\n        </>\n    );\n};\n","import { HAS_WINDOW } from './has-window';\n/**\n * Safely gets a property from the window object\n * @param {string} key property on window to retrieve\n */\nexport function getWindowObject(key: string): any {\n    return HAS_WINDOW && (window as any)[key];\n}\n","import { trackAnalyticsEvent } from '@eventbrite/legacy-infra.site-analytics';\nimport { useIntl } from 'react-intl';\nimport React, { useEffect, useState } from 'react';\nimport {\n    GA_ACTION_FORM_DISMISSED,\n    GA_REPORT_EVENT_CATEGORY,\n    SUCCESS_VIEW,\n} from '../constants';\nimport { Pages } from '../types';\nimport { usePaginationDisplayContext } from './Pagination';\n\ninterface OverlayConfigOptions {\n    title: string;\n    onPrimaryAction?: () => void;\n    primaryText?: string;\n    primaryType?: string;\n    onSecondaryAction?: () => void;\n    secondaryText?: string;\n    secondaryType?: string;\n}\n\ninterface OverlayConfig {\n    overlayConfig: OverlayConfigOptions;\n    setOverlayConfig: (config: OverlayConfigOptions) => void;\n}\n\ninterface OverlayVisible {\n    isVisible: boolean;\n    setVisible: (options?: { value?: boolean; noAnalyticsTrack?: boolean }) => void;\n    setCurrentView: (view: string) => void;\n}\n\nexport const OverlayConfigContext = React.createContext<Partial<OverlayConfig>>(\n    {},\n);\nexport const OverlayVisibilityContext = React.createContext<\n    Partial<OverlayVisible>\n>({});\n\ninterface OverlayProviderProps {\n    isVisible: boolean;\n    onClose: () => void;\n    showOverlay?: () => void;\n}\n\nexport const OverlayProvider = (\n    props,\n) => {\n    const intl = useIntl();\n    const [isVisible, setVisible] = useState(props.isVisible);\n    const [currentView, setCurrentView] = useState<string | null>(null);\n    const [overlayConfig, setOverlayConfig] = useState<OverlayConfigOptions>({\n        title: intl.formatMessage({\n            id: 'Report this event',\n            defaultMessage: 'Report this event',\n        }),\n    });\n    const { setPage } = usePaginationDisplayContext();\n\n    useEffect(() => {\n        setVisible(props.isVisible);\n        if (props.isVisible) setPage?.(Pages.intro);\n    }, [props.isVisible, setPage]);\n\n    const handleSetVisible = ({\n        value = false,\n        noAnalyticsTrack = false,\n    } = {}) => {\n        setVisible(value);\n\n        if (!value && props.onClose) {\n            props.onClose();\n        }\n\n        if (!value && currentView !== SUCCESS_VIEW && !noAnalyticsTrack) {\n            trackAnalyticsEvent({\n                action: GA_ACTION_FORM_DISMISSED,\n                category: GA_REPORT_EVENT_CATEGORY,\n                label: currentView,\n            });\n        }\n    };\n\n    return (\n        <OverlayConfigContext.Provider\n            value={{ overlayConfig, setOverlayConfig }}\n        >\n            <OverlayVisibilityContext.Provider\n                value={{\n                    isVisible,\n                    setVisible: handleSetVisible,\n                    setCurrentView: (view: string) => setCurrentView(view),\n                }}\n            >\n                {props.children}\n            </OverlayVisibilityContext.Provider>\n        </OverlayConfigContext.Provider>\n    );\n};\n","import React, { useContext, useEffect, useState } from 'react';\nimport {\n    OverlayConfigContext,\n    OverlayVisibilityContext,\n    usePaginationDisplayContext,\n} from '../context';\nimport { Pages } from '../types';\nimport styles from './ReportEventRenderer/ReportEventRenderer.module.scss';\n\ninterface LazyLoadedLibs {\n    ReactDOM: null | any;\n    Modal: null | any;\n}\n\ninterface ReportEventRendererProps {\n    domNodeId?: string;\n    showOverlay?: () => void;\n    domNode?: Element;\n}\n\nconst getMountingPoint = (\n    domNodeId?: string,\n    domNode?: Element,\n): Element | boolean => {\n    if (domNode) {\n        return domNode;\n    }\n    if (domNodeId) {\n        return document.getElementById(domNodeId) as Element;\n    }\n\n    return false;\n};\n\ninterface RenderViaPortalProps {\n    domNodeId?: string;\n    domNode?: Element;\n    children: React.ReactNode;\n}\n\nconst RenderViaPortal: React.FC<RenderViaPortalProps> = (props) => {\n    const { overlayConfig } = useContext(OverlayConfigContext);\n    const { isVisible, setVisible } = useContext(OverlayVisibilityContext);\n    const [mountPoint, setMountPoint] = useState({});\n    const { page } = usePaginationDisplayContext();\n\n    const [{ ReactDOM, Modal }, setAsyncLibs] = useState<\n        Partial<LazyLoadedLibs>\n    >({\n        ReactDOM: null,\n        Modal: null,\n    });\n\n    const overlayConfigWithVisibility = {\n        ...overlayConfig,\n        isShown: isVisible,\n        dangerouslySetContainerClassName: {\n            __className:\n                page === Pages.form\n                    ? styles.root__tall || ''\n                    : styles.root || '',\n        },\n        onClose: () => setVisible && setVisible({ value: false }),\n    };\n\n    //Only import necessary libs once module is being rendered\n    useEffect(() => {\n        if (isVisible && !ReactDOM && !Modal