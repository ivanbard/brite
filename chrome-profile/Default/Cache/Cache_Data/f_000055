Id: string;\n    latitude: number | null;\n    longitude: number | null;\n    completionTypes?: CompletionType[];\n};\n\nexport const buildAutocompleteUrl = ({\n    query,\n    placeId,\n    latitude,\n    longitude,\n    completionTypes = DEFAULT_COMPLETION_TYPES,\n}: BuildAutocompleteUrlParams) => {\n    const params = new URLSearchParams();\n    params.set('q', query);\n    params.set('completion_types', completionTypes.join(','));\n    params.set('expand.destination_event', 'primary_venue,image');\n    if (!placeId && latitude && longitude) {\n        params.set('latitude', latitude.toString());\n        params.set('longitude', longitude.toString());\n    } else if (placeId) {\n        params.set('place_id', placeId);\n    }\n\n    return `${SEARCH_AUTOCOMPLETE_URL}?${params.toString()}`;\n};\n\nexport const searchAutocomplete = ({\n    query,\n    placeId,\n    latitude,\n    longitude,\n    completionTypes = DEFAULT_COMPLETION_TYPES,\n}: BuildAutocompleteUrlParams): Promise<SearchAutocompleteResponse> => {\n    return sdkRequest(\n        buildAutocompleteUrl({\n            query,\n            placeId,\n            latitude,\n            longitude,\n            completionTypes,\n        }),\n    );\n};\n","import React from 'react';\nimport { CompletionType, DEFAULT_COMPLETION_TYPES } from '../api/searchAutocomplete';\n\ntype SearchInputProviderContextThing = (SearchInputProviderShape & AutocompleteConfig) | undefined;\n\ninterface AutocompleteConfig {\n    usesLanguageSubdirectory?: boolean;\n    locale?: string;\n    completionTypes?: CompletionType[];\n    onAutocompleteCallback?: () => void;\n    pageType?: string;\n}\n\ninterface SearchInputProviderShape {\n    query: string;\n    setQuery: Function;\n}\n\ninterface SearchInputProviderProps {\n    children?: React.ReactNode;\n    initialQuery?: string;\n}\n\nexport const useSearchInputContext = () => {\n    const value = React.useContext(SearchInputProviderContext);\n\n    if (value === undefined) {\n        throw new Error('useSearchInputContext must be used within SearchInputProvider');\n    }\n\n    return value;\n};\n\nexport const SearchInputProviderContext =\n    React.createContext<Partial<SearchInputProviderContextThing>>(undefined);\n\nexport const SearchInputProvider: React.FunctionComponent<\n    SearchInputProviderProps & AutocompleteConfig\n> = (props) => {\n    const [query, setQuery] = React.useState(props.initialQuery || '');\n    const { usesLanguageSubdirectory, locale, onAutocompleteCallback, pageType } = props;\n    const completionTypes = props.completionTypes || DEFAULT_COMPLETION_TYPES;\n\n    return (\n        <SearchInputProviderContext.Provider\n            value={{\n                query,\n                setQuery,\n                usesLanguageSubdirectory,\n                locale,\n                completionTypes,\n                onAutocompleteCallback,\n                pageType,\n            }}\n        >\n            {props.children}\n        </SearchInputProviderContext.Provider>\n    );\n};\n\nexport default SearchInputProvider;\n","export enum Status {\n    Initial = 'Initial',\n    Loading = 'Loading',\n    Ready = 'Ready',\n    Error = 'Error',\n}\n\nexport const isLoading = (status: Status): boolean => {\n    return status === Status.Loading;\n};\n\nexport const isReady = (status: Status): boolean => {\n    return status === Status.Ready;\n};\n\nexport const isError = (status: Status): boolean => {\n    return status === Status.Error;\n};\n","import React from 'react';\n\nexport const SearchIcon = ({\n    fill = '#000000',\n    stroke = '#000000',\n}: {\n    fill?: string;\n    stroke?: string;\n}) => {\n    return (\n        <svg\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 30 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n        >\n            <path\n                fillRule=\"nonzero\"\n                clipRule=\"nonzero\"\n                d=\"M12.9177 14.