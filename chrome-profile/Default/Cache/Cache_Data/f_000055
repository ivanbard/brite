d',\n                domain: ebDomain,\n            },\n        ),\n    },\n];\n\nexport const getMyTicketsQuickLinks = (\n    serverUrl: string,\n    ebDomain: string,\n    requestPath: string,\n    publicId?: string,\n) => [\n    {\n        url: `${serverUrl}/u/${publicId}/`,\n        content: defineMessage({ id: 'Tickets', defaultMessage: 'Tickets' }),\n        iconType: <TicketChunkySvg />,\n        iconColor: 'grey-800',\n        onClick: getAnalyticsClickHandler(\n            {\n                requestPath,\n                action: ACTION_DISCOVER,\n                category: CATEGORY_HEADER,\n            },\n            {\n                checkpointName: 'discover_header_link_clicked',\n                domain: ebDomain,\n            },\n        ),\n    },\n];\n\nexport const getBugQuickLink = () => [\n    {\n        url: 'https://docs.google.com/forms/d/e/1FAIpQLSfgAjPWo5RoQMiChhY1SlrrYycUnUUQjFTPkGAfCc1UCjXyWg/viewform',\n        content: defineMessage({ id: 'Report a Bug', defaultMessage: 'Report a Bug' }),\n        iconType: <BugSvg />,\n    },\n];\n","import type { CoreApplicationContext } from '@eventbrite/legacy-infra.context-types';\nimport { getNarrowMenuInfo } from '@eventbrite/legacy-eds.global-header';\nimport { Icon } from '@eventbrite/legacy-eds.icon';\nimport { PlusChunky } from '@eventbrite/legacy-eds.iconography';\nimport classNames from 'classnames';\nimport { useIntl } from 'react-intl';\nimport {\n    getCreateEventCTA,\n    getHelpMenu,\n    getNonUserQuickLinks,\n    getOrganizeMenu,\n    getUserMenuInfo,\n    logCreateEventCTAClick,\n} from '@eventbrite/legacy-infra.site-header';\nimport React, { useState } from 'react';\nimport type { FeatureFlags, UserShape } from '@eventbrite/consumer-header.global-nav/types';\nimport { CreateEventAlternatives } from '../CreateEventAlternatives';\nimport { Modal } from '@eventbrite/marmalade';\nimport { getLikesQuickLinks, getMyTicketsQuickLinks } from './core-js-global-copies';\nimport { GlobalHeaderMenu, GlobalHeaderQuickLinks } from '../GlobalHeaderNavigationBar';\nimport styles from './ConsumerHeaderLinks.module.scss';\n\ninterface ConsumerHeaderLinksProps {\n    user: UserShape;\n    env: CoreApplicationContext['env'] & {\n        launchNewSignInSignUpLinks?: boolean;\n        isManageOverviewActive?: boolean;\n    };\n    featureFlags?: FeatureFlags;\n    requestPath?: string;\n    isHomePage?: boolean;\n    onAdditionalMenuTextItemSelect?: Function;\n    onClickDropdown?: Function;\n}\n\nconst _showCreateEventCTA = ({ canCreateEvents }: UserShape, isHomePage?: boolean) => {\n    // Only show the Create Event Cta if the user can create events, or is on the homepage\n    return canCreateEvents || isHomePage;\n};\n\nexport const ConsumerHeaderMobileLinks: React.FC<ConsumerHeaderLinksProps> = ({\n    user,\n    env,\n    featureFlags,\n    requestPath,\n    isHomePage,\n    onClickDropdown,\n}) => {\n    // Users only see the ConsumerHeader if they are authenticated. Else they see the GlobalNav\n    const { isAuthenticated } = user;\n    const {\n        adminServerUrl,\n        isManageOverviewActive,\n        logoutUrl,\n        serverUrl,\n        isMobile,\n        organizeUrls,\n        helpUrls,\n        signinUrl,\n        signupUrl,\n        loginUrl,\n        launchNewSignInSignUpLinks,\n        ebDomain,\n    } = env;\n\n    const additionalMenus = [\n        //getOrganizeMenu(organizeUrls, requestPath)\n        getOrganizeMenu(\n            { home: organizeUrls.home, suggested: organizeUrls.suggested },\n            requestPath,\n        ),\n        ...(featureFlags?.showHelpCenterMenu ? [] : [getHelpMenu(helpUrls, requestPath)]),\n    ];\n\n    const userMenuInfo = getUserMenuInfo({\n        adminServerUrl,\n        featureFlags: {\n            ...featureFlags,\n            isDetachInterestsEnabled: false,\n        },\n        isManageOverviewActive,\n        logoutUrl,\n        requestPath,\n        serverUrl,\n        showBrowseEvents: true,\n   