AULT_HREF_PATHS.ORGANIZER_OVERVIEW;\n    if (!serverUrl) return path;\n    const currentUrl = new URL(serverUrl);\n    const url = new URL(path, currentUrl.origin);\n    url.search = currentUrl.search;\n    return url.href;\n};\n\nconst METRIC_NAME_CLICK = 'GlobalNav - Logged out - Click - Intent Toggle';\n\nconst DEFAULT_HREF_PATHS = {\n    ORGANIZER_OVERVIEW: '/organizer/overview',\n    HOMEPAGE: '/',\n} as const;\n\nconst getPathDimension = (urlOrPath: string): string => {\n    try {\n        const fullURL = new URL(urlOrPath);\n        return fullURL.pathname;\n    } catch (TypeError) {\n        return urlOrPath;\n    }\n};\n\nexport const AttendeeCreatorToggle = ({\n    activeOption = IntentToggleOptions.FIND_EVENTS,\n    hostEventsRedirectURL,\n}: AttendeeCreatorToggleProps) => {\n    const { env } = useGlobalNavContext();\n    const lastHandledValueRef = useRef<IntentToggleOptions | null>(null);\n    const findEventsHref = getFindEventsHref(env?.serverUrl);\n    const hostEventsHref = getHostEventsHref(env?.serverUrl, hostEventsRedirectURL);\n    const { formatMessage } = useIntl();\n    const redirectAndTrack = (newValue: string) => {\n        // This is \"hack\" to fix an issue in the Marmalade ToggleGroup\n        // component. See: https://github.com/eventbrite/marmalade/issues/459\n        //\n        // In nutshell, the `onValueChange` property gets called twice. This\n        // duplicates tracking of clicks which is undesired.\n        // The workaround is to keep a status in the AttendeeCreatorToggle\n        // component itself. This way we stora the \"last active option\", then\n        // we can de-duplicate them and only track metrics or redirect when it\n        // actually changed.\n        //\n        // This a best effort until the UI component gets fixed.\n\n        const newOption = newValue as IntentToggleOptions;\n        if (newOption === lastHandledValueRef.current) return;\n\n        const previousOption = lastHandledValueRef.current;\n        lastHandledValueRef.current = newOption;\n\n        const targetHref =\n            newOption === IntentToggleOptions.FIND_EVENTS ? findEventsHref : hostEventsHref;\n\n        // The initial value of the activeOption is set to null. This is to\n        // prevent \"missing clicks\" when the current \"activeOption\" is clicked.\n        // This works for the first time it's clicked.\n        const getFirstStateFallback = () => {\n            return previousOption === null ? activeOption : previousOption;\n        };\n        const dimensions: IntentClickDimensions = {\n            hostEventsRedirectPath: getPathDimension(targetHref),\n            activeOption: getFirstStateFallback(),\n            clickedOption: newOption.toString(),\n        };\n        trackClickWithDimensions(METRIC_NAME_CLICK, dimensions);\n\n        navigateTo(targetHref);\n    };\n\n    return (\n        <div className={styles.toggleContainer}>\n            <ToggleGroup\n                aria-label={formatMessage({\n                    id: 'Choose between finding or hosting events',\n                    defaultMessage: 'Choose between finding or hosting events',\n                })}\n                defaultValue={activeOption}\n                onValueChange={redirectAndTrack}\n                isDeselectable={false}\n                placeholder={formatMessage({\n                    id: 'Choose an option',\n                    defaultMessage: 'Choose an option',\n                })}\n            >\n                <ToggleGroupItem\n                    value={IntentToggleOptions.FIND_EVENTS}\n                    aria-label={formatMessage({ id: 'Find events', defaultMessage: 'Find events' })}\n                >\n                    {formatMessage({ id: 'Find events', defaultMessage: 'Find events' })}\n                </ToggleGroupItem>\n                <ToggleGroupItem\n                    value={IntentToggleOptions.HOST_EVENTS}\n                    aria-label={formatMessage({ id: 'Host events', defaultMessage: 'Host events' })}\n                >\n                    {formatMessage({ id: 'Host events', defaultMessage: 'Host events' })}\n                </ToggleGroupItem>\n            </ToggleGroup>\n        </div>\n    );\n};\n","import React from 'react';\nimport { DropdownItem } from '../../../../types';\nimport { AttendeeCreatorToggle } from '../AttendeeCreatorToggle/AttendeeCreatorToggle';\nimport { IntentToggleOptions } from '../../../../types';\nimport { MobileDropdown } from '../Dropdowns';\nimport styles from './IntentToggle.module.scss';\n\ninterface IntentToggleProps {\n    activeOption: IntentToggleOptions;\n    dropdownItems: DropdownItem[];\n    isMobile?: boolean;\n    hostEventsRedirectURL?: string;\n}\n\nexport const IntentToggle: React.FC<IntentToggleProps> = ({\n    activeOption,\n    dropdownItems,\n    isMobile = false,\n    hostEventsRedirectURL,\n}) => {\n    const containerClass = isMobile ? styles.mobileToggleContainer : styles.toggleContainer;\n\n    if (isMobile) {\n        return (\n            <div\n                data-testid=\"intent-toggle-wrapper\"\n                data-variant=\"mobile\"\n                className={styles.mobileContainer}\n            >\n                <div data-testid=\"toggle-container\" className={containerClass}>\n                    <AttendeeCreatorToggle\n                        activeOption={activeOption}\n                        hostEventsRedirectURL={hostEventsRedirectURL}\n                    />\n                </div>\n                <div data-testid=\"dropdown-container\" className={styles.mobileDropdownContainer}>\n                    <MobileDropdown dropdownItems={dropdownItems} />\n                </div>\n            </div>\n        );\n    }\n\n    return (\n        <>\n            <div data-testid=\"toggle-container\" data-variant=\"desktop\" className={containerClass}>\n                <AttendeeCreatorToggle\n                    activeOption={activeOption}\n                    hostEventsRedirectURL={hostEventsRedirectURL}\n                />\n            </div>\n            <div data-testid=\"dropdown-container\">\n                <MobileDropdown dropdownItems={dropdownItems} />\n            </div>\n        </>\n    );\n};\n","import { Icon } from '@eventbrite/legacy-eds.icon';\nimport { ChevronDownChunky, ChevronUpChunky } from '@eventbrite/legacy-eds.iconography';\nimport React, { useRef } from 'react';\nimport { getHeapDataAttribute, HeapAttributes } from '../../../../../utils/heap-data';\nimport { DropdownContainerProps } from '../../../../../types';\nimport { Dropdown } from '../Dropdown';\nimport styles from './DesktopDropdown.module.scss';\nimport { useIntl } from 'react-intl';\n\nexport const DesktopDropdown = ({\n    dropdownItems,\n    heapIdentifier,\n    translatedText,\n}: DropdownContainerProps) => {\n    const { Teams, Features, Components, Actions } = HeapAttributes;\n    const dropdownRef = useRef<HTMLDivElement>(null);\n    const { formatMessage } = useIntl();\n    const pointerHandler = (e: React.PointerEvent) => {\n        if (dropdownRef.current === document.activeElement) {\n            /**\n             * Prevent Default is used to prevent the browser from doing\n             * it's default action on pointerDown\n             */\n            e.preventDefault();\n            dropdownRef?.current?.blur();\n        }\n    };\n\n    return (\n        <div\n            data-heap-id={getHeapDataAttribute({\n                team: Teams.SEO,\n                feature: Features.GlobalNav,\n                component: Components.Dropdown,\n                name: heapIdentifier.replaceAll(' ', '-').toLowerCase(),\n                action: Actions.Click,\n            })}\n            className={styles.desktopDropdown}\n            tabIndex={0}\n            ref={dropdownRef}\n            onPointerDown={pointerHandler}\n        >\n            <div className={styles.dropdownTitle}>\n                <span>{formatMessage(translatedText)}</s