at\n                </button>\n            </div>\n        </div>\n    );\n};\n","import { getWindowObject } from '@eventbrite/legacy-infra.feature-detection';\nimport { HEAP_EVENTS, HEAP_SCREENS, track } from '../../utils/analytics';\nimport { ExitModal } from '../exit-modal/ExitModal';\nimport styles from './ChatWindow.module.scss';\n\nimport React, { RefObject, useState } from 'react';\n\nexport interface ChatWindowProps {\n    isLoggedIn: boolean;\n    onClose: () => void;\n    messagesSent: number;\n    containerRef: RefObject<HTMLDivElement>;\n    children: React.ReactNode;\n}\n\n/**\n * HOC that renders the window dressing.\n * The window dressing includes CTAs to Exit and additional modal.\n *\n * @param {ChatWindowProps} props\n * @returns {React.ReactNode}\n */\nexport const ChatWindow = (props: ChatWindowProps) => {\n    const [isExitModalOpen, setIsExitModalOpen] = useState(false);\n\n    const handleClickOnBack = (e: React.MouseEvent<HTMLAnchorElement>) => {\n        e.preventDefault();\n        setIsExitModalOpen(true);\n        track({\n            eventName: HEAP_EVENTS.BackButtonClick,\n            eventData: {\n                Screen: HEAP_SCREENS.CONCIERGE,\n                messagesSent: props.messagesSent,\n            },\n        });\n    };\n\n    const handleSwitchToClassicSearch = () => {\n        const storage = getWindowObject('localStorage');\n        storage.setItem('nlsearch-experiment-opt-out', 'true');\n\n        const location = getWindowObject('location');\n        location.assign('/');\n    };\n\n    return (\n        <div ref={props.containerRef} className={styles.root}>\n            <div className={styles.headerContainer}>\n                <div className={styles.primaryHeader}>\n                    <a href=\"https://www.eventbrite.com/#\" onClick={handleClickOnBack}>\n                        <svg\n                            width=\"24\"\n                            height=\"24\"\n                            viewBox=\"0 0 24 24\"\n                            fill=\"none\"\n                            xmlns=\"http://www.w3.org/2000/svg\"\n                        >\n                            <path\n                                d=\"M14.5858 4.41797L7.0036 12.0002L14.5858 19.5823L16 18.1681L9.83203 12.0002L16 5.83218L14.5858 4.41797Z\"\n                                fill=\"#161719\"\n                            />\n                        </svg>\n                    </a>\n                    <svg\n                        width=\"24\"\n                        height=\"24\"\n                        viewBox=\"0 0 24 24\"\n                        fill=\"none\"\n                        xmlns=\"http://www.w3.org/2000/svg\"\n                    >\n                        <path\n                            d=\"M19.3791 15.6226H19.3819L17.1799 13.8682L12.2635 10.0842C12.1426 9.99184 12.2664 9.80516 12.3997 9.87945L15.2408 11.47C16.5285 12.1919 18.1562 11.7738 18.9362 10.5214C19.7581 9.19942 19.3238 7.45839 17.9733 6.67931L13.8036 4.26967C13.6722 4.19253 13.7683 3.99252 13.9112 4.04776L15.8265 4.81446C15.8265 4.81446 15.8761 4.83256 15.8932 4.83922C16.097 4.9097 16.3151 4.94875 16.5428 4.94875C17.5819 4.94875 18.4352 4.12681 18.5086 3.14962C18.6038 1.8848 17.6361 1.00095 16.4799 1.00095C15.9132 1.00095 7.62521 1 7.62521 1C6.48897 1 5.53369 1.92957 5.54893 3.06295C5.55559 3.66584 5.82704 4.20395 6.24896 4.57254C6.56707 4.8497 7.64045 5.70879 8.1519 6.11738C8.24334 6.19071 8.19095 6.33643 8.07476 6.33643H6.32325C4.44602 6.33643 2.93262 7.86507 2.93262 9.7404C2.93262 10.7595 3.37359 11.6624 4.0841 12.2853L14.0903 21.7914C14.856 22.5648 15.9294 23.0334 17.1123 22.9981C19.2981 22.9334 21.062 21.1209 21.0677 18.9361C21.0715 17.5741 20.4039 16.3664 19.3781 15.6235L19.3791 15.6226Z\"\n                            fill=\"#FF5010\"\n                        />\n                    </svg>\n                    {props.isLoggedIn ? (\n                        <div>{/* Empty Div Used as Spacer */}</div>\n                    ) : (\n                        <a href=\"http://www.eventbrite.com/signin\" className={styles.loginCTA}>\n                            <div>Log In</div>\n                        </a>\n                    )}\n                </div>\n                <div className={styles.notificationBanner}>\n                    <div className={styles.optOutBanner}>\n                        We’re trying something new.{' '}\n                        <a href=\"#\" onClick={handleSwitchToClassicSearch}>\n                            Switch to classic search\n                        </a>\n                    </div>\n                </div>\n            </div>\n            {props.children}\n            {isExitModalOpen && (\n                <ExitModal\n                    messagesSent={props.messagesSent}\n                    onLeave={() => {\n                        setIsExitModalOpen(false);\n                        track({\n                            eventName: HEAP_EVENTS.ExitModalLeave,\n                            eventData: {\n                                Screen: HEAP_SCREENS.CONCIERGE,\n                                messagesSent: props.messagesSent,\n                            },\n                        });\n                        props.onClose();\n                    }}\n                    onStay={() => {\n                        setIsExitModalOpen(false);\n                        track({\n                            eventName: HEAP_EVENTS.ExitModalStay,\n                            eventData: {\n                                Screen: HEAP_SCREENS.CONCIERGE,\n                                messagesSent: props.messagesSent,\n                            },\n                        });\n                    }}\n                />\n            )}\n        </div>\n    );\n};\n","export const getBaseUrl = () => {\n    if (window.location.hostname.includes('dev.evbqa.com')) {\n        // Return the QA host so that testers do not need to run the local dev server.\n        // Update this value to https://dev.evbqa.com:4000 if you want to test against local dev.\n        return 'https://www.evbqa.com';\n    }\n\n    return ''; // Use same host as the current page.\n};\n","import { NLRequest, NLError, NLResponse } from './ask.types';\nimport { getBaseUrl } from './utils';\n\nexport const ask = async (payload: NLRequest): Promise<NLResponse | NLError> => {\n    const path = `/alt-search/mobile-bff/relevance/ask`;\n    const url = `${getBaseUrl()}${path}`;\n\n    const responsePromise = fetch(url, {\n        method: 'POST',\n        credentials: 'include',\n        headers: {\n            'Content-Type': 'application/json',\n        },\n        body: JSON.stringify(payload),\n    });\n\n    const response = await responsePromise.catch((error) => {\n        return {\n            status: '400',\n            statusText: 'Unexpected error ' + error,\n            error: error,\n            text: async () => 'Unexpected error.',\n            ok: false,\n        } as any;\n    });\n\n    if (!response.ok) {\n        return {\n            message: `Unable to retrieve results. Status: ${response.statusText}`,\n            status: `${response.status}: ${response.statusText}`,\n            error: await response.text(),\n        };\n    }\n\n    const responseBody: NLResponse = await response.json();\n\n    return responseBody;\n};\n","import { useEffect, useMemo, useState } from 'react';\nimport { NLError, NLRequest, NLResponse } from '../api/ask.types';\nimport { ask } from '../api/ask';\nimport { Status } from '../domain/status';\nimport { RetryConfig } from '../models';\n\nexport type NaturalLanguageRequest = Omit<NLRequest, 'threadId'> & RetryConfig;\n\ninterface NLWebQueryState {\n    request: NaturalLanguageRequest;\n    response: NLResponse | NLError | null;\n    status: Status;\n    threadId: string;\n    error: string | null;\n}\n\n/**\n * Hook to fetch results from for Natural Language Search\n *\n * @param request\n * @returns\n */\nexport const useAsk = (pendingRequest: NaturalLanguageRequest) => {\n    const [threadId, setThreadId] = useState('');\n    const [state, setState] = useState<NLWebQueryState>({\n        request: pendingRequest,\n        response: null,\n        status: Status.Initial,\n        threadId: threadId,\n        error: null,\n    });\n\n    useEffect(() => {\n        if (typeof window !== 'undefined' && window.crypto.randomUUID) {\n            setThreadId(window.crypto.randomUUID());\n        } else {\n            setThreadId(Math.random().toString(36).substring(2, 15));\n        }\n    }, []);\n\n    const { request, response, status, error } = state;\n\n    /**\n     * If the request has changed, reset the state\n     */\n    useEffect(() => {\n        const allKeys = [...new Set([...Object.keys(request), ...Object.keys(pendingRequest)])];\n        const diff = allKeys.filter((key) => {\n            const valueSame = request[key] === pendingRequest[key];\n            if (!valueSame && Array.isArray(request[key]) && Array.isArray(pendingRequest[key])) {\n                return request[key].length !== pendingRequest[key].length;\n            }\n            return !valueSame;\n        });\n\n        if (diff.length === 0) {\n            return;\n        }\n\n        setState((prevState) => ({\n            ...prevState,\n            request: pendingRequest,\n            response: null,\n            status: Status.Initial,\n            error: null,\n        }));\n    }, [pendingRequest, setState, request]);\n\n    /**\n     * If the status is idle, fetch the results\n     */\n    useEffect(() => {\n        if (status !== Status.Initial) {\n            return;\n        }\n\n        if (!request.query) {\n            return;\n        }\n\n        const fetchResults = async () => {\n            setState((prevState) => ({\n                ...prevState,\n                status: Status.Loading,\n            }));\n\n            const res = await ask({ ...request, threadId });\n\n            if ('error' in res) {\n                console.error(\n                    `Error fetching Natural Language results. ${res.message}.`,\n                    res.error,\n                );\n                setState((prevState) => ({\n                    ...prevState,\n                    status: Status.Error,\n                    error: res.message,\n                }));\n\n                return;\n            }\n\n            setState((prevState) => ({\n                ...prevState,\n                request,\n                response: res,\n                status: Status.Ready,\n                error: null,\n            }));\n        };\n\n        fetchResults();\n    }, [request, status, threadId, setState]);\n\n    const result = useMemo(\n        () => ({\n            data: response,\n            status,\n            error,\n        }),\n        [response, status, error],\n    );\n\n    return result;\n};\n","import styles from './ChatbotOverlay.module.scss';\n\nexport interface ChatbotOverlayProps extends React.PropsWithChildren {}\n\n/**\n * ChatbotOverlay\n *\n * A component that displays a chatbot overlay.\n *\n * @param {ChatbotOverlayProps} props - The props for the ChatbotOverlay component.\n *\n * @returns A React component that displays a chatbot overlay.\n */\nexport const ChatbotOverlay = (props: ChatbotOverlayProps) => {\n    return <div className={styles.root}>{props.children}</div>;\n};\n","import { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport { isError, isLoading, Status } from '../domain/status';\nimport { SearchInputControl } from '../components/chat-controls/SeachInputControl';\nimport { MultilineSearchInputControl } from '../components/chat-controls/MultilineSeachInputControl';\nimport { ChatConversation } from '../components/chat-controls/ChatConversation';\nimport { useChatHistory } from './useChatHistory';\nimport { track, HEAP_SCREENS, HEAP_EVENTS } from '../utils/analytics';\nimport { Settings, SettingsPro