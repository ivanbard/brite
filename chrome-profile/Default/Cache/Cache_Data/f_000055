dingRequest);\n\n    const chatHistoryContext = useChatHistory();\n    const { dispatchQuery, dispatchResponse, dispatchStatus, dispatchReset } = chatHistoryContext;\n    const { messages, status } = chatHistoryContext;\n\n    // FIXME: What is this for?\n    const [focusIndex] = useState(0);\n\n    /**\n     * Effect that runs only when the component first loads\n     */\n    useEffect(() => {\n        // Track component load only once\n        if (!hasTrackedInitialLoad.current) {\n            track({\n                eventName: HEAP_EVENTS.ScreenView,\n                eventData: {\n                    Screen: HEAP_SCREENS.CONCIERGE,\n                },\n            });\n            hasTrackedInitialLoad.current = true;\n        }\n    }, []);\n\n    /**\n     * Update the status and messages based on the NLWeb response\n     */\n    useEffect(() => {\n        if (isLoading(requestStatus) && !isLoading(status)) {\n            dispatchStatus(Status.Loading);\n        } else if (!isLoading(requestStatus) && isLoading(status) && data !== null) {\n            dispatchResponse(data as any);\n        }\n    }, [data, status, messages, dispatchResponse, dispatchStatus, requestStatus]);\n\n    /**\n     * Update the list of messages to include the new query\n     */\n    const onSubmit = useCallback(\n        async (query: string) => {\n            const normalizedQuery = query.trim();\n            if (!normalizedQuery) {\n                return;\n            }\n            setMessageSent((count) => count + 1);\n\n            if (pendingRequest.query === normalizedQuery) {\n                return;\n            }\n\n            track({\n                eventName: HEAP_EVENTS.ChatMessageSent,\n                eventData: {\n                    Screen: HEAP_SCREENS.CONCIERGE,\n                    query: normalizedQuery,\n                    messagesSent: messagesSent,\n                },\n            });\n\n            const newRequest: MinimalNLSearchRequest = {\n                location: props.location?.slug,\n                query: normalizedQuery,\n                queryHistory: onlyUserQueries(messages),\n            };\n\n            setPendingRequest(newRequest);\n            dispatchQuery(newRequest);\n        },\n        [messages, pendingRequest, dispatchQuery, props.location, messagesSent],\n    );\n\n    /**\n     * Scroll to the bottom of the chat container when the status is changed to loading\n     */\n    useEffect(() => {\n        if (status !== Status.Loading) {\n            return;\n        }\n\n        if (chatContainerRef.current) {\n            chatContainerRef.current.scrollTo({\n                top: chatContainerRef.current.scrollHeight,\n                behavior: 'smooth',\n            });\n        }\n    }, [status]);\n\n    const handleClose = useCallback(() => {\n        dispatchReset();\n        props.onClose();\n    }, [props.onClose]);\n\n    const currentPlace = props.location?.currentPlace;\n    const greeting = useMemo(() => getGreeting(currentPlace), [currentPlace]);\n    const optionalSuffix = useMemo(() => getLocationSuffix(currentPlace), [currentPlace]);\n    const isLoggedIn = !!props.user?.isAuthenticated;\n\n    return (\n        <SettingsProvider initialSettings={props.settings}>\n            <ChatbotOverlay>\n                <ChatWindow\n                    onClose={handleClose}\n                    isLoggedIn={isLoggedIn}\n                    messagesSent={messagesSent}\n                    containerRef={chatContainerRef}\n                >\n                    <h1 className={styles.tagline} dangerouslySetInnerHTML={{ __html: greeting }} />\n                    {messages.length === 0 && (\n                        <MultilineSearchInputControl\n                            onSubmit={onSubmit}\n                            extKey={focusIndex}\n                            placeholder={`I want to see a comedy show ${optionalSuffix}`}\n                        />\n                    )}\n               