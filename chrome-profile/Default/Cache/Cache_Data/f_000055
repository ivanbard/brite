ts`,\n            onClick: getAnalyticsClickHandler({\n                requestPath,\n                action: ACTION_PROFILE_DROPDOWN,\n                category: CATEGORY_HEADER,\n                label: LABEL_INTERESTS,\n            }),\n        },\n        logout: {\n            type: ANCHOR_LINK,\n            content: defineMessage({ id: 'Log out', defaultMessage: 'Log out' }),\n            path: logoutUrl,\n            onClick: logOutFunctions.bind(null, requestPath),\n        },\n        manageEvents: {\n            type: ANCHOR_LINK,\n            content: defineMessage({ id: 'Manage my events', defaultMessage: 'Manage my events' }),\n            path: creatorUrl(),\n            onClick: getAnalyticsClickHandler({\n                requestPath,\n                action: ACTION_PROFILE_DROPDOWN,\n                category: CATEGORY_HEADER,\n                label: LABEL_MY_EVENTS,\n            }),\n        },\n        organizerProfile: {\n            type: ANCHOR_LINK,\n            content: defineMessage({\n                id: 'Organizer profile',\n                defaultMessage: 'Organizer profile',\n            }),\n            path: `${serverUrl}/myprofile/`,\n            onClick: getAnalyticsClickHandler({\n                requestPath,\n                action: ACTION_PROFILE_DROPDOWN,\n                category: CATEGORY_HEADER,\n                label: LABEL_ORGANIZER_PROFILE,\n            }),\n        },\n        saved: {\n            type: ANCHOR_LINK,\n            content: defineMessage({ id: 'Liked', defaultMessage: 'Liked' }),\n            path: `${serverUrl}/u/${publicId}/saved`,\n            onClick: getAnalyticsClickHandler({\n                requestPath,\n                action: ACTION_PROFILE_DROPDOWN,\n                category: CATEGORY_HEADER,\n                label: LABEL_SAVED,\n            }),\n        },\n        sponsorships: {\n            type: ANCHOR_LINK,\n            content: <Sponsorship />,\n            path: `${serverUrl}/sponsorship/connec