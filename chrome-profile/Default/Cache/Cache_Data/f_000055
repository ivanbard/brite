xtKey, setExtKey] = useState(props.extKey);\n\n    useEffect(() => {\n        if (props.extKey !== extKey) {\n            inputRef.current?.focus();\n            setExtKey(props.extKey);\n        }\n    }, [inputRef, extKey, props.extKey]);\n\n    const handleSubmit = useCallback(() => {\n        const trimmedQuery = query.trim();\n        if (trimmedQuery.length > 0) {\n            onSubmit(query);\n            setQuery('');\n        }\n    }, [onSubmit, query, setQuery]);\n\n    return (\n        <div className={styles.inputContainer}>\n            <div className={styles.input}>\n                {props.status === 'pre-search' ? (\n                    <div className={styles.searchIcon}>\n                        <SearchIcon />\n                    </div>\n                ) : (\n                    <></>\n                )}\n                <div className={styles.textInput}>\n                    <textarea\n                        ref={inputRef}\n                        className={styles.inputControl}\n                        placeholder={placeholder}\n                        value={query}\n                        onKeyUp={(e) => {\n                            if (e.key === 'Enter') {\n                                handleSubmit();\n                            }\n                        }}\n                        onChange={(event) => {\n                            const changedValue = event.target.value;\n                            if (!changedValue.endsWith('\\n')) {\n                                setQuery(changedValue);\n                            }\n                        }}\n                    ></textarea>\n                </div>\n                {props.status === 'post-search' ? (\n                    <div className={styles.searchIcon} onClick={handleSubmit}>\n                        <SearchIcon fill=\"#ffffff\" />\n                    </div>\n                ) : (\n                    <></>\n                )}\n            </div>\n        </div>\n    );\n};\n","import React from 'react';\nimport { useEffect, useRef, useState } from 'react';\nimport styles from './MultilineSeachInputControl.module.scss';\nimport { SearchIcon } from '../internal/icons/SearchIcon';\nimport classNames from 'classnames';\n\nexport interface MultilineSearchInputControlProps {\n    query?: string;\n    onQueryUpdate?: (query: string) => void;\n    onSubmit: (query: string) => void;\n    extKey: number;\n    rows?: number;\n    placeholder?: string;\n}\n\nexport const MultilineSearchInputControl = ({\n    placeholder = 'What is happening this weekend?',\n    rows = 5,\n    ...props\n}: MultilineSearchInputControlProps) => {\n    const [query, setQuery] = useState(props.query || '');\n    const inputRef = useRef<HTMLTextAreaElement | null>(null);\n    const [extKey, setExtKey] = useState(props.extKey);\n    const [isInitialLoad, setIsInitialLoad] = useState(true);\n\n    useEffect(() => {\n        if (props.extKey !== extKey) {\n            inputRef.current?.focus();\n            setExtKey(props.extKey);\n        }\n    }, [inputRef, extKey, props.extKey]);\n\n    useEffect(() => {\n        setQuery(props.query || '');\n    }, [props.query]);\n\n    useEffect(() => {\n        // Only focus the input on initial load if the input is not already focused\n        if (isInitialLoad && inputRef.current) {\n            inputRef.current?.focus();\n            setIsInitialLoad(false);\n        }\n    }, [inputRef, isInitialLoad, setIsInitialLoad]);\n\n    return (\n        <div className={styles.inputContainer}>\n            <div className={styles.input}>\n                <div className={styles.textInput}>\n                    <textarea\n                        ref={inputRef}\n                        className={styles.inputControl}\n                        placeholder={placeholder}\n                        value={query}\n                        rows={rows}\n                        onKeyUp={(e) => {\n                            if (e.key === 'Enter') {\n                                props.onSubmit(query);\n                            }\n                        }}\n                        onChange={(event) => {\n                            const changedValue = event.target.value;\n                            if (!changedValue.endsWith('\\n')) {\n                                setQuery(changedValue);\n                                props.onQueryUpdate?.(changedValue);\n                            }\n                        }}\n                    ></textarea>\n                </div>\n            </div>\n            <div\n                className={classNames(styles.searchIcon, {\n                    [styles.searchIconEnabled!]: query.length > 0,\n                })}\n                onClick={() => {\n                    props.onSubmit(query);\n                }}\n            >\n                <SearchIcon fill={'white'} />\n            </div>\n        </div>\n    );\n};\n","import React, { createContext } from 'react';\n\nexport interface Settings {\n    persona?: number;\n    location?: string;\n    showMore?: boolean;\n    useAlt?: boolean;\n}\n\nexport const SettingsContext = createContext<Settings>({\n    persona: 0,\n    location: 'San Francisco',\n    showMore: true,\n    useAlt: false,\n});\n\nexport const useSettings = () => {\n    const context = React.useContext(SettingsContext);\n    if (context === undefined) {\n        throw new Error('useSettings must be used within a SettingsProvider');\n    }\n    return context;\n};\n\ninterface SettingsProviderProps {\n    children: React.ReactNode;\n    initialSettings?: Settings;\n}\n\nexport const SettingsProvider = ({ children, initialSettings }: SettingsProviderProps) => {\n    const [settings] = React.useState<Settings>(\n        initialSettings || {\n            persona: 0,\n            location: 'San Francisco',\n            showMore: true,\n            useAlt: false,\n        },\n    );\n\n    return <SettingsContext.Provider value={settings}>{children}</SettingsContext.Provider>;\n};\n","import React, { useCallback } from 'react';\nimport styles from './QueryResults.module.scss';\nimport { useSettings } from '../context/SettingsContext';\nimport { HEAP_EVENTS, HEAP_SCREENS, track } from '../../utils/analytics';\n\nconst AFF_CODE = 'ebnlsearchweb';\n\nexport interface Event {\n    id: string;\n    summary: string;\n    url: string;\n    imageUrl: string;\n    title: string;\n    dateTimeLocationRow: string;\n    dateTime?: string;\n    location?: string;\n    priceRow: string;\n}\n\nexport interface CardProps {\n    event: Event;\n    messagesSent: number;\n}\n\ninterface FeedbackElementsProps {\n    eventId: string;\n}\n\nconst FeedbackElements = (props: FeedbackElementsProps) => {\n    // Disabled for v0.\n    // Leaving element for future expansion.\n    const enabled = false;\n    if (!enabled) {\n        return null;\n    }\n\n    return (\n        <div className={styles.feedback}>\n            <p>up</p>\n            <p>down</p>\n        </div>\n    );\n};\n\nconst Card = (props: CardProps) => {\n    const urlWithAffCode = `${props.event.url}?aff=${AFF_CODE}`;\n    return (\n        <div className={styles.cardRoot}>\n            <div className={styles.explanation}>\n                <p className={styles.explanationBody}>{props.event.summary}</p>\n                {/* <div className={styles.explanationCTA}>Read description</div> */}\n            </div>\n            <a\n                className={styles.link}\n                href={urlWithAffCode}\n                target=\"_blank\"\n                onClick={() => {\n                    track({\n                        eventName: HEAP_EVENTS.EventCardClick,\n                        eventData: {\n                            eventId: props.event.id,\n                            url: props.event.url,\n                            messagesSent: props.messagesSent,\n                        },\n                    });\n                }}\n            >\n                <div className={styles.card}>\n                    <div\n                        className={styles.eventImage}\n                        style={{ backgroundImage: `url(${props.event.imageUrl})` }}\n                    ></div>\n                    <div className={styles.details}>\n                        <div className={styles.actions}>\n                            {/* <div\n                className={classNames([styles.eventShareCTA, styles.action])}\n              >\n                <ShareIcon width={20} height={20} />\n              </div> */}\n                            {/* <div className={classNames([styles.eventSaveCTA, styles.action])}>\n                <HeartIcon width={20} height={20} />\n              </div> */}\n                        </div>\n                        <p className={styles.eventDateTime}>{props.event.dateTime}</p>\n                        <div className={styles.eventTitle}>{props.event.title}</div>\n                        {props.event.dateTimeLocationRow}\n                        <p className={styles.eventLocation}>{props.event.location}</p>\n                        <div className={styles.eventPriceRow}>{props.event.priceRow}</div>\n                    </div>\n                </div>\n            </a>\n            <FeedbackElements eventId={props.event.id} />\n        </div>\n    );\n};\n\ninterface QueryResultsProps {\n    results: Array<CardProps['event']>;\n    messagesSent: number;\n}\n\nexport const QueryResults = (props: QueryResultsProps) => {\n    const settings = useSettings();\n    const [showAll, setShowAll] = React.useState(false);\n    const hasMoreResults = props.results.length > 3;\n    const displayedResults =\n        settings.showMore && !showAll ? props.results.slice(0, 3) : props.results;\n\n    const handleShowMore = useCallback(() => {\n        setShowAll(true);\n        track({\n            eventName: HEAP_EVENTS.ShowMoreClick,\n            eventData: {\n                Screen: HEAP_SCREENS.CONCIERGE,\n                resultCount: props.results.length,\n                messagesSent: props.messagesSent,\n            },\n        });\n    }, [setShowAll, props.results, props.messagesSent]);\n\n    return (\n        <div className={styles.results}>\n            {displayedResults.map((event, index) => {\n                return (\n                    <Card key={`card-${index}`} event={event} messagesSent={props.messagesSent} />\n                );\n            })}\n            {settings.showMore && hasMoreResults && !showAll && (\n                <button className={styles.showMoreButton} onClick={handleShowMore}>\n                    Show More\n                </button>\n            )}\n        </div>\n    );\n};\n","import React from 'react';\nimport styles from './LoadingIndicator.module.scss';\n\nexport const LoadingIndicator = () => {\n    return <div className={styles.loadingIndicator}></div>;\n};\n","import React, { useEffect, useMemo } from 'react';\nimport styles from './ChatConversation.module.scss';\nimport { QueryResults } from './QueryResults';\nimport classNames from 'classnames';\nimport { LoadingIndicator } from '../internal/loading/LoadingIndicator';\nimport { Event, ProductGroup } from 'schema-dts';\nimport { Event as CardEvent } from './QueryResults';\nimport {\n    MinimalNLSearchRequest,\n    NLWebAskUserResponse,\n    NLWebResponse,\n    NLWebResultsResponse,\n} from '../../models';\nimport { isError, isLoading, Status } from '../../domain/status';\nimport { SaucerImage } from '../internal/images/SaucerImage';\nimport { HEAP_EVENTS, HEAP_SCREENS, track } from '../../utils/analytics';\n\nexport type Message = MinimalNLSearchRequest | NLWebResponse;\n\nconst QueryMessage = ({ query }: MinimalNLSearchRequest) => {\n    return (\n        <div className={classNames(styles.message, styles.queryMessage, styles.userMessage)}>\n            {query}\n        </div>\n    );\n};\n\n/**\n * @param displayDate string in the format of \"Wed Jul 2 at 6:00pm\"\n */\nconst formatToDisplayDate = (startDate: string | undefined) => {\n    if (!startDate) {\n        return '';\n    }\n\n    const date = new Date(String(startDate));\n    return `${date.toLocaleDateString('en-US', { weekday: 'short' })} ${date.toLocaleDateString('en-US', { month: 'short' })} ${date.getDate()} at ${date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}`;\n};\n\nconst transfromEventResult = (wrapper: any, event: Event): CardEvent => {\n    let priceRow = '';\n    const offers = 'offers' in event ? event.offers : [];\n    if (offers && Array.isArray(offers)) {\n        offers.forEach((offer) => {\n            if (typeof offer === 'object' && 'lowPrice' in offer) {\n                priceRow += `Starts at $${offer.lowPrice}`;\n            }\n        });\n    }\n\n    let location: any = '';\n    if ('location' in event) {\n        const eventLocation: any = event.location;\n        if (eventLocation && 'name' in eventLocation) {\n            location = [eventLocation.name, eventLocation.address?.addressLocality]\n                .filter((x) => x)\n                .join(' - ');\n        } else {\n            location = 'TBD'; // unknown location string.\n        }\n    }\n\n    return {\n        id: event['@id'] as string,\n        summary: wrapper.description,\n        url: wrapper.url,\n        imageUrl: String(event.image),\n        title: wrapper.name,\n        dateTimeLocationRow: '',\n        dateTime: formatToDisplayDate(event.startDate as string),\n        location,\n        priceRow: String(priceRow),\n    };\n};\n\ntype EventGroup = Omit<ProductGroup, 'hasVariant'> & { hasVariant: Array<Event> }; // Event Group is a fictional type based on ProductGroup.\n\nconst transfromEventGroupResult = (wrapper: any, group: EventGroup): CardEvent => {\n    const event = group.hasVariant[0] as Event;\n\n    let priceRow = '';\n    const offers = 'offers' in event ? event.offers : [];\n    if (offers && Array.isArray(offers)) {\n        offers.forEach((offer) => {\n            if (typeof offer === 'object' && 'lowPrice' in offer) {\n                priceRow += `Starts at $${offer.lowPrice}`;\n            }\n        });\n    }\n\n    let location: any = '';\n    if ('location' in group) {\n        location = group.location;\n        if ('name' in location) {\n            location = location.name;\n        }\n    }\n\n    return {\n        id: group['@id'] as string,\n        summary: group.description as string,\n        url: group.url as string,\n        imageUrl: String(group.image),\n        title: group.name as string,\n        dateTimeLocationRow: '',\n        dateTime: formatToDisplayDate(event.startDate as string),\n        location,\n        priceRow: String(priceRow),\n    };\n};\n\nconst transformResults = (results: Array<any>) => {\n    return (results || []).flatMap((result): Array<CardEvent> => {\n        if ('schema_object' in result) {\n            const schemaObject = result.schema_object;\n            if (schemaObject['@type'] === 'Event') {\n                return [transfromEventResult(result, schemaObject)];\n            }\n\n            if (schemaObject['@type'] === 'EventGroup') {\n                return [transfromEventGroupResult(result, schemaObject)];\n            }\n\n            return []; // Unknown type\n        }\n\n        return []; // Filter out this event, as we were unable to map it.\n    });\n};\n\nconst ResultsMessage = ({\n    results,\n    summary,\n    messagesSent,\n}: NLWebResultsResponse & { messagesSent: number }) => {\n    const transformedResults = React.useMemo(() => transformResults(results), [results]);\n    return (\n        <>\n            {summary && summary.message ? (\n                <div className={classNames(styles.askUserMessage, styles.aiMessage)}>\n                    {summary.message}\n                </div>\n            ) : null}\n            <div\n                className={classNames(\n                    // styles.message,\n                    styles.responseMessage,\n                    styles.aiMessage,\n                )}\n            >\n                {/* <ResultSummary summary={props.summary} /> */}\n                <QueryResults results={transformedResults} messagesSent={messagesSent} />\n            </div>\n        </>\n    );\n};\n\nconst AskUserMessage = ({ ask_user }: NLWebAskUserResponse) => {\n    return (\n        <div className={classNames(styles.askUserMessage, styles.aiMessage)}>\n            {ask_user.message}\n        </div>\n    );\n};\n\nconst LoadingState = () => {\n    return (\n        <div className={styles.loadingContainer}>\n            <LoadingIndicator />\n        </div>\n    );\n};\n\nconst ErrorState = (props: { onReload: () => void; messagesSent: number }) => {\n    useEffect(() => {\n        track({\n            eventName: HEAP_EVENTS.ErrorScreenView,\n            eventData: {\n                Screen: HEAP_SCREENS.CONCIERGE,\n                messagesSent: props.messagesSent,\n            },\n        });\n    }, [props.messagesSent]);\n\n    return (\n        <div className={styles.errorContainer}>\n            <SaucerImage altText=\"An Error Occurred While Fetching Results\" />\n            <div className={styles.errorMessage}>Something went wrong on our end</div>\n            <button className={styles.reloadButton} onClick={props.onReload}>\n                Reload\n            </button>\n        </div>\n    );\n};\n\nconst ChatMessage = ({ message, messagesSent }: { message: Message; messagesSent: number }) => {\n    if ('query' in message) {\n        return <QueryMessage {...message} />;\n    }\n    if ('ask_user' in message) {\n        return <AskUserMessage {...message} />;\n    }\n    if ('results' in message) {\n        return <ResultsMessage {...message} messagesSent={messagesSent} />;\n    }\n    return null;\n};\n\ninterface ChatConversationProps {\n    messages: Message[];\n    requestStatus: Status;\n    messagesSent: number;\n    onReload: () => void;\n}\n\nexport const ChatConversation = ({\n    messages,\n    messagesSent,\n    requestStatus,\n    onReload,\n}: ChatConversationProps) => {\n    const isLoadingState = useMemo(() => isLoading(requestStatus), [requestStatus]);\n    const isErrorState = useMemo(() => isError(requestStatus), [requestStatus]);\n\n    return (\n        <div className={styles.root}>\n            {messages.map((message, i) => (\n                <ChatMessage key={i} message={message} messagesSent={messagesSent} />\n            ))}\n            {isLoadingState && <LoadingState />}\n            {isErrorState && <ErrorState onReload={onReload} messagesSent={messagesSent} />}\n        </div>\n    );\n};\n","import { useReducer } from 'react';\n\nimport { Message } from '../components/chat-controls/ChatConversation';\nimport { Status } from '../domain/status';\nimport { NLWebResponse, MinimalNLSearchRequest } from '../models';\n\n/**\n * The state of the chat history.\n *\n * @property messages - Messages in the chat.\n * @property status - Current loading state of the chat.\n */\ntype State = {\n    messages: Message[];\n    status: Status;\n};\n\n/**\n * Enum of actions that can be dispatched to the reducer.\n */\nenum TargetAction {\n    StatusChanged = 'statusChanged',\n    QueryChanged = 'queryChanged',\n    ResponseReceived = 'responseReceived',\n    Reset = 'reset',\n}\n\n/**\n * Available actions to be dispatched to the reducer.\n *\n * @property type - The type of action to be dispatched.\n * @property payload - The payload of the action. The type of the payload is determined by the type of action.\n */\ntype Action =\n    | { type: TargetAction.StatusChanged; payload: Status }\n    | { type: TargetAction.QueryChanged; payload: MinimalNLSearchRequest }\n    | { type: TargetAction.ResponseReceived; payload: NLWebResponse }\n    | { type: TargetAction.Reset };\n\nconst reducer = (state: State, action: Action): State => {\n    switch (action.type) {\n        case TargetAction.StatusChanged: {\n            return {\n                ...state,\n                status: action.payload,\n            };\n        }\n\n        case TargetAction.QueryChanged: {\n            const messages = [...state.messages];\n            if (!action.payload.retry) {\n                messages.push(action.payload);\n            }\n            return {\n                ...state,\n                messages,\n                status: Status.Ready,\n            };\n        }\n\n        case TargetAction.ResponseReceived: {\n            const data: NLWebResponse = action.payload;\n            const prevMessages = state.messages;\n            return {\n                ...state,\n                messages: [...prevMessages, data],\n                status: Status.Ready,\n            };\n        }\n\n        case TargetAction.Reset: {\n            return {\n                ...state,\n                messages: [],\n                status: Status.Initial,\n            };\n        }\n\n        // No-op for unknown actions.\n        default:\n            return state;\n    }\n};\n\n/**\n * Hook to manage the chat history.\n *\n * @returns The current state of the chat history and the dispatch functions.\n */\nexport const useChatHistory = () => {\n    const [state, dispatch] = useReducer(reducer, {\n        messages: [],\n        status: Status.Initial,\n    });\n    const { messages, status } = state;\n\n    const dispatchStatus = (status: Status) => {\n        dispatch({ type: TargetAction.StatusChanged, payload: status });\n    };\n\n    const dispatchQuery = (request: MinimalNLSearchRequest) => {\n        dispatch({ type: TargetAction.QueryChanged, payload: request });\n    };\n\n    const dispatchResponse = (response: NLWebResponse) => {\n        dispatch({ type: TargetAction.ResponseReceived, payload: response });\n    };\n\n    const dispatchReset = () => {\n        dispatch({ type: TargetAction.Reset });\n    };\n\n    return {\n        messages,\n        status,\n        state,\n        dispatchStatus,\n        dispatchQuery,\n        dispatchResponse,\n        dispatchReset,\n    };\n};\n","import { Message } from '../components/chat-controls/ChatConversation';\nimport { MinimalNLSearchRequest, NLWebRequest } from '../models';\n\n/**\n * Initial state for the concierge screen.\n */\nexport const INITIAL_STATE: MinimalNLSearchRequest = {\n    query: '',\n    queryHistory: [],\n};\n\n/**\n * Filter the messages to only include user queries.\n *\n * @param messages Messages.\n * @returns User queries.\n */\nexport const onlyUserQueries = (messages: Array<Message>): Array<string> => {\n    return messages.filter((m): m is NLWebRequest => 'query' in m).map((m) => m.query);\n};\n\n/**\n * Get the location suffix for the concierge screen. If the location is 'your location', return an empty string.\n *\n * @param location The location.\n * @returns The location suffix.\n */\nexport const getLocationSuffix = (location: string | undefined) => {\n    const isGPSPlaceholder = location?.toLowerCase() === 'your location';\n    if (isGPSPlaceholder) {\n        return '';\n    }\n\n    return location ? `in ${location}` : '';\n};\n\nconst GENERIC_GREETING_WITHOUT_LOCATION_NAME = `Hi there!<br />I’m here to help you discover exciting events. Tell me what you want to do and a location.`;\n\n/**\n * Get the greeting for the concierge screen. If the location is 'your location', return the generic greeting.\n *\n * @param location The location.\n * @returns The greeting.\n */\nexport const getGreeting = (location: string | undefined) => {\n    const isGPSPlaceholder = location?.toLowerCase() === 'your location';\n\n    if (isGPSPlaceholder || !location) {\n        return GENERIC_GREETING_WITHOUT_LOCATION_NAME;\n    }\n\n    return `Hi there!<br />Tell me what you’d like to do here in ${location} or anywhere else you’d like.`;\n};\n","import React, { useEffect } from 'react';\nimport styles from './ExitModal.module.scss';\nimport classNames from 'classnames';\nimport { HEAP_EVENTS,